{%- liquid
  assign video_url   = section.settings.video_url
  assign poster      = section.settings.poster
  assign heading     = section.settings.heading
  assign subtext     = section.settings.subtext
  assign btn_label   = section.settings.button_label
  assign btn_link    = section.settings.button_link | default: '#buy'
-%}

{% stylesheet %}

/* ── Diamond hero band ── */
.d-hero {
  position: relative;
  background: var(--palette-ink, #161411);
  color: #fff;
  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-top: 24px;
  margin-bottom: 96px;
  overflow: hidden;
}

/* Video / poster image */
.d-hero__video {
  display: block;
  width: 100%;
  height: min(84vh, 920px);
  object-fit: cover;
  opacity: .94;
}

/* Gradient scrim */
.d-hero::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60%;
  background: linear-gradient(180deg, rgb(0 0 0 / 0), rgb(0 0 0 / .6));
  pointer-events: none;
}

/* Text overlay */
.d-hero__copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 40px 56px;
  max-width: 1600px;
  margin: 0 auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  z-index: 1;
}

.d-hero__heading {
  font-family: var(--font-heading);
  font-weight: var(--font-weight-bold);
  font-size: 52px;
  line-height: 56px;
  letter-spacing: -.025em;
  color: #fff;
  max-width: 16ch;
  margin: 0;
  text-shadow: 0 2px 24px rgb(0 0 0 / .35);
}

.d-hero__sub {
  margin: 10px 0 0;
  max-width: 38ch;
  color: rgb(255 255 255 / .85);
  font-size: 16px;
  line-height: 1.5;
}

/* Button — translucent white on dark background */
.d-hero__btn {
  flex: none;
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, .15);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, .35);
  border-radius: 999px;
  padding: 14px 28px;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 14px;
  letter-spacing: .06em;
  text-transform: uppercase;
  text-decoration: none;
  transition: background .2s;
  white-space: nowrap;
  line-height: 1;
}
.d-hero__btn:hover { background: rgba(255, 255, 255, .25); }

/* Mobile */
@media screen and (max-width: 989px) {
  .d-hero {
    margin-bottom: 0;
  }
  .d-hero__video {
    height: min(64vh, 560px);
  }
  .d-hero__copy {
    padding: 0 16px 28px;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .d-hero__heading {
    font-size: 36px;
    line-height: 40px;
  }
  .d-hero__sub {
    font-size: 14px;
    line-height: 20px;
  }
}

{% endstylesheet %}

<section class="d-hero" id="DiamondHero-{{ section.id }}">

  {%- if video_url != blank -%}
    <video
      class="d-hero__video"
      autoplay
      muted
      loop
      playsinline
      {%- if poster != blank %} poster="{{ poster | image_url: width: 1600 }}"{% endif %}
    >
      <source src="{{ video_url }}" type="video/mp4">
    </video>
  {%- elsif poster != blank -%}
    {{- poster | image_url: width: 1600 | image_tag:
      class: 'd-hero__video',
      alt: heading,
      loading: 'eager',
      fetchpriority: 'high',
      widths: '600,900,1200,1600',
      sizes: '100vw'
    -}}
  {%- endif -%}

  <div class="d-hero__copy">
    <div>
      {%- if heading != blank -%}
        <h2 class="d-hero__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if subtext != blank -%}
        <p class="d-hero__sub">{{ subtext }}</p>
      {%- endif -%}
    </div>
    {%- if btn_label != blank -%}
      <a class="d-hero__btn" href="{{ btn_link }}">{{ btn_label }}</a>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "t:sections.diamond_hero.name",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "t:sections.diamond_hero.settings.video_url.label",
      "info": "t:sections.diamond_hero.settings.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "t:sections.diamond_hero.settings.poster.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_hero.settings.heading.label",
      "default": "The electric heater for your hookah"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "t:sections.diamond_hero.settings.subtext.label",
      "default": "No coals, no lighting, no waiting"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.diamond_hero.settings.button_label.label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.diamond_hero.settings.button_link.label"
    }
  ],
  "presets": [{ "name": "t:sections.diamond_hero.presets.name" }]
}
{% endschema %}
