{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
{{ 'em-manual.css' | asset_url | stylesheet_tag }}
<div class="em-wrap">
  <section class="em-ch em-ch-section" id="in-the-box" style="scroll-margin-top:180px">
    <p class="em-ch__num">03 · Start</p>
    <h2>In the box</h2>
    <p class="em-ch__lead">Everything for the first session, except your tobacco and a USB-C wall adapter.</p>
    <ul class="em-boxl">
      <li>ENSŌ 2026 Edition</li>
      <li>Glass ThermoCap</li>
      <li>Brown leather strap</li>
      <li>Magnetic mouthpiece, 15 cm</li>
      <li>Hose, 1.5 m</li>
      <li>Glass water tank, dip tube and watershield</li>
      <li>Blow-out valve and 5 glass balls</li>
      <li>Battery: standard or Battery Plus, by set</li>
      <li>2 ceramic cups and 10 disposable capsules</li>
      <li>3-in-1 multi-tool with glove</li>
      <li>Cleaning brushes and screen wipe</li>
      <li>2 mesh screens</li>
      <li>5 silicone mouth tips</li>
      <li>USB-C cable, no wall adapter</li>
      <li>Warranty card and printed manual</li>
    </ul>
    <p class="em-small">The standard-battery set also has a spare hose and a short mouthpiece.</p>
  </section>
</div>

{% schema %}
{
  "name": "EM: In the Box",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "EM: In the Box"
    }
  ]
}
{% endschema %}
