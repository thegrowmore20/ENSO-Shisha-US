{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
  assign is_carousel = false
  if section.settings.layout == 'carousel'
    assign is_carousel = true
  endif
-%}

{% render 'carousel-styles',
  section_id: section.id,
  columns_desktop: section.settings.columns,
  columns_mobile: section.settings.columns_mobile,
  gap: section.settings.card_gap,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  padding_top_mobile: section.settings.padding_top_mobile,
  padding_bottom_mobile: section.settings.padding_bottom_mobile
%}

<carousel-slider id="Carousel-{{ section.id }}" class="reviews {{ scheme_class }}">
  <div class="container">
    <div class="carousel__header">
      <div class="reviews__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h-section">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.overall_rating > 0 -%}
          <div class="reviews__summary">
            {%- render 'star-rating', rating: section.settings.overall_rating -%}
            <p class="caption reviews__summary-text">
              {{-
                'sections.reviews.summary'
                | t: rating: section.settings.overall_rating, count: section.settings.overall_count
              -}}
            </p>
          </div>
        {%- endif -%}
      </div>

      {%- if is_carousel -%}
        <div class="carousel__controls">
          <button type="button" class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
            {%- render 'icon-chevron' -%}
          </button>
          <button type="button" class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="{{ 'accessibility.next_slide' | t }}">
            {%- render 'icon-chevron' -%}
          </button>
        </div>
      {%- endif -%}
    </div>

    <div
      class="carousel__track {% unless is_carousel %}carousel__track--grid{% endunless %}"
      {% if is_carousel %}data-carousel-track tabindex="0"{% endif %}
      role="group"
      aria-label="{{ section.settings.heading | escape }}"
    >
      {%- for block in section.blocks -%}
        <figure class="review-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.image.alt | default: block.settings.name | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              class="review-card__image"
            >
          {%- endif -%}
          <div class="review-card__body">
            {%- if block.settings.rating > 0 -%}
              {%- render 'star-rating', rating: block.settings.rating -%}
            {%- endif -%}
            {%- if block.settings.quote != blank -%}
              <blockquote class="review-card__quote body-text">{{ block.settings.quote }}</blockquote>
            {%- endif -%}
            <figcaption class="review-card__meta">
              {%- if block.settings.name != blank -%}
                <span class="review-card__name">{{ block.settings.name }}</span>
              {%- endif -%}
              {%- if block.settings.product != blank -%}
                <a href="{{ block.settings.product.url }}" class="caption review-card__product">
                  {{ block.settings.product.title }}
                </a>
              {%- endif -%}
            </figcaption>
          </div>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</carousel-slider>

{% stylesheet %}
  .reviews__intro {
    max-width: 640px;
  }

  .reviews__summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  .reviews__summary-text {
    color: var(--color-text);
  }

  .review-card {
    display: flex;
    flex-direction: column;
    margin: 0;
    border-radius: var(--radius-lg);
    background-color: var(--color-background-raised);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow 0.3s var(--ease-out);
  }

  .review-card:hover {
    box-shadow: var(--shadow-md);
  }

  .review-card__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .review-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .review-card__quote {
    margin: 0;
    color: var(--color-text);
  }

  .review-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: auto;
  }

  .review-card__name {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 14px;
  }

  .review-card__product {
    color: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews carousel",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Social Proof"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Do People Love ENSŌ?"
    },
    {
      "type": "range",
      "id": "overall_rating",
      "label": "Overall rating",
      "info": "Set to 0 to hide the rating summary",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "text",
      "id": "overall_count",
      "label": "Total review count",
      "default": "1,240"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel (scrollable row)" },
        { "value": "grid", "label": "Simple grid (wraps into rows)" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Cards per row — desktop",
      "options": [
        { "value": "2", "label": "2 cards" },
        { "value": "3", "label": "3 cards" },
        { "value": "4", "label": "4 cards" },
        { "value": "5", "label": "5 cards" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Cards per row — mobile",
      "options": [
        { "value": "1", "label": "1 card" },
        { "value": "2", "label": "2 cards" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between cards",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 0.5, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review text" },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "product", "id": "product", "label": "Product reviewed" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews carousel",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "quote": "I switched from a traditional hookah and never looked back. No coals to manage, no ash, and the flavour is cleaner than anything I've had.", "name": "Marcus T." } },
        { "type": "review", "settings": { "rating": 5, "quote": "Setup takes under a minute and the magnetic mouthpiece makes sharing with friends effortless. It just works.", "name": "Leyla K." } },
        { "type": "review", "settings": { "rating": 5, "quote": "The battery lasts a full evening and I can take it to the balcony or a friend's place without hauling anything else.", "name": "Daniel R." } },
        { "type": "review", "settings": { "rating": 4.5, "quote": "Clouds are genuinely dense — I was sceptical an electric system could match coals, but it does.", "name": "Priya S." } }
      ]
    }
  ]
}
{% endschema %}
