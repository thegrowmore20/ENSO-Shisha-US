{% stylesheet %}

/* ── Section wrapper ── */
.d-heater {
  padding: 80px 0;
}
@media screen and (max-width: 991px) {
  .d-heater { padding: 40px 0; }
}

/* ── Two-column grid ── */
.d-heater__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: var(--d-heater-gap, 56px);
  align-items: center;
}
@media screen and (max-width: 991px) {
  .d-heater__grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }
}

/* ── Image ── */
.d-heater__image {
  border-radius: 28px;
  overflow: hidden;
  background: #f5f5f4;
  aspect-ratio: 4 / 3;
}
.d-heater__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Image position right */
.d-heater__image--right {
  order: 2;
}
@media screen and (max-width: 991px) {
  .d-heater__image--right { order: unset; }
}

/* Image fit: contain (generic) */
.d-heater__image--contain img {
  object-fit: contain;
}

/* ── Tall product shot layout (fits-hookah style) ── */
/* Grid: copy capped at 600px, huge gap, image floats to natural size */
.d-heater__grid--photo {
  grid-template-columns: minmax(0, 600px) auto;
  gap: var(--d-heater-gap, 220px);
  justify-content: center;
}
/* Image: auto aspect, natural width, height capped */
.d-heater__grid--photo .d-heater__image {
  aspect-ratio: auto;
  width: auto;
  background: #fff;
  border-radius: 0;
  overflow: visible;
  justify-self: start;
}
.d-heater__grid--photo .d-heater__image img {
  width: auto;
  height: min(620px, 72vh);
  object-fit: contain;
}
@media screen and (max-width: 991px) {
  .d-heater__grid--photo {
    grid-template-columns: minmax(0, 1fr);
    justify-content: unset;
    gap: 24px;
  }
  .d-heater__grid--photo .d-heater__image {
    justify-self: center;
  }
  .d-heater__grid--photo .d-heater__image img {
    height: min(460px, 56vh);
  }
}

/* ── Copy ── */
.d-heater__eyebrow {
  margin-bottom: 12px;
}

.d-heater__heading {
  font-size: 40px;
  line-height: 44px;
  letter-spacing: -.025em;
  font-weight: var(--font-weight-heavy);
  margin: 0 0 14px;
}
@media screen and (max-width: 991px) {
  .d-heater__heading {
    font-size: 30px;
    line-height: 34px;
  }
}

.d-heater__body {
  color: rgb(0 0 0 / .72);
  font-size: 15px;
  line-height: 1.6;
  margin: 0 0 24px;
  max-width: 52ch;
}

/* ── Fact list ── */
.d-heater__facts {
  display: grid;
  gap: 14px;
}

.d-heater__fact {
  display: grid;
  gap: 2px;
  padding-left: 18px;
  border-left: 2px solid var(--color-accent);
}

.d-heater__fact b {
  display: block;
  font-family: var(--font-accent);
  font-weight: var(--font-weight-heavy);
  font-size: 18px;
  line-height: 24px;
  letter-spacing: -.02em;
}

.d-heater__fact span {
  color: rgb(0 0 0 / .72);
  font-size: 14px;
  line-height: 21px;
}

{% endstylesheet %}

{%- liquid
  assign img_class = 'd-heater__image'
  assign grid_class = 'd-heater__grid'
  if section.settings.image_position == 'right'
    assign img_class = img_class | append: ' d-heater__image--right'
  endif
  if section.settings.image_fit == 'contain'
    assign img_class = img_class | append: ' d-heater__image--contain'
  endif
  if section.settings.image_position == 'right' and section.settings.image_fit == 'contain'
    assign grid_class = grid_class | append: ' d-heater__grid--photo'
  endif
  assign gap_px = section.settings.column_gap | default: 56
-%}

{% style %}
  #shopify-section-{{ section.id }} .d-heater {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    #shopify-section-{{ section.id }} .d-heater {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section class="d-heater" id="DiamondHeater-{{ section.id }}" style="--d-heater-gap: {{ gap_px }}px">
  <div class="container">
    <div class="{{ grid_class }}">

      {%- comment -%} ── IMAGE ── {%- endcomment -%}
      <div class="{{ img_class }}">
        {%- if section.settings.image != blank -%}
          {{- section.settings.image | image_url: width: 900 | image_tag:
            alt: section.settings.image.alt | default: section.settings.heading,
            loading: 'lazy',
            widths: '600,900',
            sizes: '(max-width:989px) 100vw, 50vw'
          -}}
        {%- else -%}
          <svg viewBox="0 0 4 3" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:100%;display:block">
            <rect width="4" height="3" fill="#f0ede8"/>
            <path d="M1.6 1.5 L2 0.9 L2.4 1.5 M1.75 1.5 L2.25 1.5 M2 1.5 L2 2.1" stroke="#c8b89a" stroke-width="0.08" stroke-linecap="round"/>
          </svg>
        {%- endif -%}
      </div>

      {%- comment -%} ── COPY ── {%- endcomment -%}
      <div class="d-heater__copy">

        {%- if section.settings.eyebrow != blank -%}
          <p class="d-heater__eyebrow eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="d-heater__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="d-heater__body">{{ section.settings.body }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="d-heater__facts">
            {%- for block in section.blocks -%}
              <div class="d-heater__fact" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <b>{{ block.settings.title }}</b>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span>{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.diamond_heater.name",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.diamond_heater.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.diamond_heater.settings.image_position.label",
      "options": [
        { "value": "left",  "label": "t:sections.diamond_heater.settings.image_position.options.left" },
        { "value": "right", "label": "t:sections.diamond_heater.settings.image_position.options.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:sections.diamond_heater.settings.image_fit.label",
      "options": [
        { "value": "cover",   "label": "t:sections.diamond_heater.settings.image_fit.options.cover" },
        { "value": "contain", "label": "t:sections.diamond_heater.settings.image_fit.options.contain" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:sections.diamond_heater.settings.column_gap.label",
      "min": 24,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.diamond_heater.settings.eyebrow.label",
      "default": "What it is"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_heater.settings.heading.label",
      "default": "An electric heater for the hookah you already own"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:sections.diamond_heater.settings.body.label",
      "default": "Diamond sits where the bowl sits and replaces the charcoal. No coals, just pure flavour."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "t:sections.diamond_heater.blocks.fact.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.diamond_heater.blocks.fact.settings.title.label"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.diamond_heater.blocks.fact.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.diamond_heater.presets.name",
      "blocks": [
        {
          "type": "fact",
          "settings": {
            "title": "Default mode",
            "text": "Diamond sets the heat for you: 275 °C after a seven-minute pre-heat, held to the end."
          }
        },
        {
          "type": "fact",
          "settings": {
            "title": "Custom temperature",
            "text": "Anywhere from 180 to 320 °C, to the degree. Lower for blonde leaf, higher for dark."
          }
        },
        {
          "type": "fact",
          "settings": {
            "title": "Custom pre-heat",
            "text": "0 to 15 minutes before the first draw. Save it with the heat as a profile."
          }
        }
      ]
    }
  ]
}
{% endschema %}
