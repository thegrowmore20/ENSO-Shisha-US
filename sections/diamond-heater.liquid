{% stylesheet %}

/* ── Section wrapper ── */
.d-heater {
  padding: 96px 0;
}
@media screen and (max-width: 989px) {
  .d-heater { padding: 72px 0; }
}

/* ── Two-column grid ── */
.d-heater__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 56px;
  align-items: center;
}
@media screen and (max-width: 989px) {
  .d-heater__grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }
}

/* ── Image ── */
.d-heater__image {
  border-radius: 28px;
  overflow: hidden;
  background: #f5f5f4;
  aspect-ratio: 4 / 3;
}
.d-heater__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ── Copy ── */
.d-heater__eyebrow {
  margin-bottom: 12px;
}

.d-heater__heading {
  font-size: 40px;
  line-height: 44px;
  letter-spacing: -.025em;
  font-weight: var(--font-weight-heavy);
  margin: 0 0 14px;
}
@media screen and (max-width: 989px) {
  .d-heater__heading {
    font-size: 30px;
    line-height: 34px;
  }
}

.d-heater__body {
  color: rgb(0 0 0 / .72);
  font-size: 15px;
  line-height: 1.6;
  margin: 0 0 24px;
  max-width: 52ch;
}

/* ── Fact list ── */
.d-heater__facts {
  display: grid;
  gap: 14px;
}

.d-heater__fact {
  display: grid;
  gap: 2px;
  padding-left: 18px;
  border-left: 2px solid var(--color-accent);
}

.d-heater__fact b {
  display: block;
  font-family: var(--font-accent);
  font-weight: var(--font-weight-heavy);
  font-size: 18px;
  line-height: 24px;
  letter-spacing: -.02em;
}

.d-heater__fact span {
  color: rgb(0 0 0 / .72);
  font-size: 14px;
  line-height: 21px;
}

{% endstylesheet %}

<section class="d-heater" id="DiamondHeater-{{ section.id }}">
  <div class="container">
    <div class="d-heater__grid">

      {%- comment -%} ── IMAGE ── {%- endcomment -%}
      <div class="d-heater__image">
        {%- if section.settings.image != blank -%}
          {{- section.settings.image | image_url: width: 900 | image_tag:
            alt: section.settings.image.alt | default: section.settings.heading,
            loading: 'lazy',
            widths: '600,900',
            sizes: '(max-width:989px) 100vw, 50vw'
          -}}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- comment -%} ── COPY ── {%- endcomment -%}
      <div class="d-heater__copy">

        {%- if section.settings.eyebrow != blank -%}
          <p class="d-heater__eyebrow eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="d-heater__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="d-heater__body">{{ section.settings.body }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="d-heater__facts">
            {%- for block in section.blocks -%}
              <div class="d-heater__fact" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <b>{{ block.settings.title }}</b>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span>{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.diamond_heater.name",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.diamond_heater.settings.image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.diamond_heater.settings.eyebrow.label",
      "default": "What it is"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_heater.settings.heading.label",
      "default": "An electric heater for the hookah you already own"
    },
    {
      "type": "text",
      "id": "body",
      "label": "t:sections.diamond_heater.settings.body.label",
      "default": "Diamond sits where the bowl sits and replaces the charcoal. No coals, no lighting, no waiting."
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "t:sections.diamond_heater.blocks.fact.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.diamond_heater.blocks.fact.settings.title.label"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.diamond_heater.blocks.fact.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.diamond_heater.presets.name",
      "blocks": [
        {
          "type": "fact",
          "settings": {
            "title": "Default mode",
            "text": "Diamond sets the heat for you: 275 °C after a seven-minute pre-heat, held to the end."
          }
        },
        {
          "type": "fact",
          "settings": {
            "title": "Custom temperature",
            "text": "Anywhere from 180 to 320 °C, to the degree. Lower for blonde leaf, higher for dark."
          }
        },
        {
          "type": "fact",
          "settings": {
            "title": "Custom pre-heat",
            "text": "0 to 15 minutes before the first draw. Save it with the heat as a profile."
          }
        }
      ]
    }
  ]
}
{% endschema %}
