{%- liquid
  assign img = section.settings.image
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body_text = section.settings.text
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign img_alt = img.alt | default: heading | escape
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="enso-exp">
  <div class="container">
    <div class="enso-exp__item">
      <div class="enso-exp__media">
        {%- if img != blank -%}
          <img
            class="enso-exp__image"
            src="{{ img | image_url: width: 2000 }}"
            srcset="
              {{ img | image_url: width: 750 }} 750w,
              {{ img | image_url: width: 1100 }} 1100w,
              {{ img | image_url: width: 1500 }} 1500w,
              {{ img | image_url: width: 2000 }} 2000w
            "
            sizes="(max-width: 749px) 100vw, 100vw"
            alt="{{ img_alt }}"
            width="{{ img.width }}"
            height="{{ img.height }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- else -%}
          <div class="enso-exp__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'enso-exp__placeholder-svg' }}
          </div>
        {%- endif -%}
        <div class="enso-exp__overlay"></div>
      </div>

      <div class="enso-exp__content">
        <div class="enso-exp__content-inner">
          {%- if eyebrow != blank -%}
            <p class="eyebrow enso-exp__eyebrow">{{ eyebrow }}</p>
          {%- endif -%}
          {%- if heading != blank -%}
            <h2 class="enso-exp__heading">{{ heading }}</h2>
          {%- endif -%}
          {%- if body_text != blank -%}
            <p class="enso-exp__text">{{ body_text }}</p>
          {%- endif -%}
          {%- if section.blocks.size > 0 -%}
            <div class="enso-exp__chips">
              {%- for block in section.blocks -%}
                {%- if block.settings.label != blank -%}
                  <span class="enso-exp__chip" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if cta_label != blank -%}
            <a class="enso-exp__btn" href="{{ cta_link | default: '#' }}">
              {{ cta_label }} →
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .enso-exp__item {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    min-height: 540px;
  }

  .enso-exp__media {
    position: absolute;
    inset: 0;
  }

  .enso-exp__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 45%;
    filter: brightness(0.62);
  }

  .enso-exp__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgb(0 0 0 / .55) 0%, rgb(0 0 0 / .3) 50%, rgb(0 0 0 / 0) 75%);
  }

  .enso-exp__content {
    position: relative;
    z-index: 2;
    min-height: 540px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 56px 48px;
  }

  .enso-exp__content-inner {
    max-width: 440px;
  }

  .enso-exp__eyebrow {
    color: rgb(255 255 255 / .75);
    margin: 0 0 16px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .enso-exp__heading {
    margin: 0 0 20px;
    font-size: 40px;
    line-height: 1.1;
    color: #fff;
    font-weight: var(--font-weight-bold);
  }

  .enso-exp__text {
    color: rgb(255 255 255 / .85);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 28px;
  }

  .enso-exp__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .enso-exp__chip {
    display: inline-block;
    border: 1px solid rgb(255 255 255 / .55);
    color: rgb(255 255 255 / .9);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 13px;
    line-height: 1;
    white-space: nowrap;
  }

  .enso-exp__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    color: #000;
    border-radius: 999px;
    padding: 16px 28px;
    font-size: 14px;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .enso-exp__btn:hover {
    opacity: 0.88;
  }

  .enso-exp__placeholder {
    width: 100%;
    height: 100%;
    min-height: 540px;
    background: rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .enso-exp__placeholder-svg {
    width: 30%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .enso-exp__item {
      border-radius: 22px;
      min-height: 520px;
    }

    .enso-exp__image {
      object-position: 38% 50%;
    }

    .enso-exp__overlay {
      background: linear-gradient(0deg, rgb(0 0 0 / .7) 0%, rgb(0 0 0 / .35) 60%, rgb(0 0 0 / 0) 85%);
    }

    .enso-exp__content {
      min-height: 520px;
      padding: 28px 20px;
      justify-content: flex-end;
    }

    .enso-exp__content-inner {
      max-width: none;
    }

    .enso-exp__heading {
      font-size: 28px;
    }

    .enso-exp__chips {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.enso_experience.name",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.enso_experience.settings.image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.enso_experience.settings.eyebrow.label",
      "default": "ENSŌ Experience"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.enso_experience.settings.heading.label",
      "default": "You have seen what it is<br>Now see how it is used"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.enso_experience.settings.text.label",
      "default": "The 2026 Edition, told the other way round: the first session step by step, the manual, cleaning, the flavour guide and the firmware app. Made for the phone."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.enso_experience.settings.cta_label.label",
      "default": "Open ENSŌ Experience"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.enso_experience.settings.cta_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "t:sections.enso_experience.blocks.chip.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.enso_experience.blocks.chip.settings.label.label",
          "default": "Quick start"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.enso_experience.presets.name",
      "blocks": [
        { "type": "chip", "settings": { "label": "Quick start" } },
        { "type": "chip", "settings": { "label": "Full manual" } },
        { "type": "chip", "settings": { "label": "FAQ" } },
        { "type": "chip", "settings": { "label": "Warranty" } },
        { "type": "chip", "settings": { "label": "Firmware app" } }
      ]
    }
  ]
}
{% endschema %}
