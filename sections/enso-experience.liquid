{%- liquid
  assign img = section.settings.image
  assign heading = section.settings.heading
  assign body_text = section.settings.text
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign img_alt = img.alt | default: heading | escape
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="enso-exp">
  <div class="container">
  <div class="enso-exp__item">
    <div class="enso-exp__media">
      {%- if img != blank -%}
        <img
          class="enso-exp__image"
          src="{{ img | image_url: width: 2000 }}"
          srcset="
            {{ img | image_url: width: 750 }} 750w,
            {{ img | image_url: width: 1100 }} 1100w,
            {{ img | image_url: width: 1500 }} 1500w,
            {{ img | image_url: width: 2000 }} 2000w
          "
          sizes="(max-width: 749px) 100vw, (max-width: 989px) 100vw, 100vw"
          alt="{{ img_alt }}"
          width="{{ img.width }}"
          height="{{ img.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <div class="enso-exp__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'enso-exp__placeholder-svg' }}
        </div>
      {%- endif -%}
      <div class="enso-exp__overlay"></div>
    </div>

    <div class="enso-exp__content">
      <div class="enso-exp__content-inner">
        {%- if heading != blank -%}
          <h2 class="enso-exp__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if body_text != blank -%}
          <div class="enso-exp__subheading">
            <p>{{ body_text }}</p>
          </div>
        {%- endif -%}
        {%- if cta_label != blank -%}
          <a class="btn enso-exp__btn" href="{{ cta_link | default: '#' }}">
            {{ cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
  </div>
</section>

{% stylesheet %}
  .enso-exp {
    /* spacing controlled by {% style %} on the Shopify wrapper */
  }

  .enso-exp__item {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    min-height: 600px;
  }

  /* ── Image fills the card ── */
  .enso-exp__media {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .enso-exp__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
  }

  /* ── Gradient overlays ── */
  /* Bottom-to-top base fade */
  .enso-exp__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 25%, rgb(0 0 0 / .75) 100%);
  }

  /* Desktop: left-to-right directional gradient */
  .enso-exp__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / .7) 0%, rgb(0 0 0 / .45) 38%, rgb(0 0 0 / 0) 64%);
    pointer-events: none;
  }

  /* ── Content vertically centered, left-aligned ── */
  .enso-exp__content {
    position: relative;
    z-index: 2;
    min-height: 600px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 32px 20px 32px 48px;
  }

  .enso-exp__content-inner {
    max-width: 410px;
  }

  .enso-exp__heading {
    margin: 0 0 26px;
    font-size: 44px;
    line-height: 48px;
    color: #fff;
  }

  .enso-exp__subheading {
    color: #fff;
    margin-bottom: 36px;
    max-width: 44ch;
  }

  .enso-exp__subheading p {
    margin: 0;
  }

  /* Gold/sand button on this dark photo background */
  .enso-exp__btn {
    background: var(--palette-sand, #c8943a);
    border-color: var(--palette-sand, #c8943a);
    color: #fff;
    padding: 16px 28px;
  }

  .enso-exp__btn:hover {
    background: var(--palette-sand-deep, #b3832f);
    border-color: var(--palette-sand-deep, #b3832f);
    color: #fff;
  }

  .enso-exp__placeholder {
    width: 100%;
    height: 100%;
    min-height: 600px;
    background: rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .enso-exp__placeholder-svg {
    width: 30%;
    opacity: 0.3;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {
    .enso-exp__item {
      border-radius: 22px;
      min-height: 600px;
    }

    .enso-exp__image {
      /* Pull left so device is visible, not background */
      object-position: 38% 50%;
    }

    /* Stronger bottom-to-top fade on mobile */
    .enso-exp__overlay {
      background: linear-gradient(180deg, rgb(0 0 0 / 0) 35%, rgb(0 0 0 / .85) 100%);
    }

    /* Mobile: swap to bottom-to-top directional gradient */
    .enso-exp__media::after {
      background: linear-gradient(0deg, rgb(0 0 0 / .72) 0%, rgb(0 0 0 / .35) 50%, rgb(0 0 0 / 0) 75%);
    }

    .enso-exp__content {
      min-height: 600px;
      padding: 24px 20px;
    }

    .enso-exp__content-inner {
      max-width: none;
    }

    .enso-exp__heading {
      font-size: 30px;
      line-height: 34px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.enso_experience.name",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.enso_experience.settings.image.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.enso_experience.settings.heading.label",
      "default": "ENSŌ Experience"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:sections.enso_experience.settings.text.label",
      "default": "Everything you need to know: your first session step by step, how to pack the cup, which temperature suits which blend, cleaning and care, and firmware updates."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.enso_experience.settings.cta_label.label",
      "default": "Open ENSŌ Experience"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.enso_experience.settings.cta_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:sections.enso_experience.presets.name"
    }
  ]
}
{% endschema %}
