{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}
<nav class="xnav" aria-label="ENSŌ Diamond guides">
  <a class="xnav__back" href="/pages/enso-experience#diamond">‹ ENSŌ Experience <span aria-hidden="true">/</span> <b>ENSŌ Diamond</b></a>
  <div class="xnav__row">
    <a href="/pages/enso-diamond-quick-start"{% if section.settings.active_tab == 'quick-start' %} aria-current="page"{% endif %}>Quick start</a>
    <a href="/pages/enso-diamond-manual"{% if section.settings.active_tab == 'manual' %} aria-current="page"{% endif %}>Full manual</a>
    <a href="/pages/diamond-packing-guide"{% if section.settings.active_tab == 'packing' %} aria-current="page"{% endif %}>Pack the cup</a>
    <a href="/pages/enso-diamond-cleaning"{% if section.settings.active_tab == 'cleaning' %} aria-current="page"{% endif %}>Cleaning</a>
    <a href="/pages/enso-diamond-manual#troubleshooting"{% if section.settings.active_tab == 'troubleshooting' %} aria-current="page"{% endif %}>Troubleshooting</a>
    <a href="/pages/enso-diamond-software"{% if section.settings.active_tab == 'software' %} aria-current="page"{% endif %}>Software updates</a>
  </div>
</nav>

{% schema %}
{
  "name": "Experience nav",
  "presets": [{ "name": "Experience nav" }],
  "settings": [
    {
      "type": "select",
      "id": "active_tab",
      "label": "Active tab",
      "options": [
        { "value": "quick-start", "label": "Quick start" },
        { "value": "manual", "label": "Full manual" },
        { "value": "packing", "label": "Pack the cup" },
        { "value": "cleaning", "label": "Cleaning" },
        { "value": "troubleshooting", "label": "Troubleshooting" },
        { "value": "software", "label": "Software updates" }
      ],
      "default": "manual"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 40, "step": 4, "unit": "px", "label": "Top padding", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 40, "step": 4, "unit": "px", "label": "Bottom padding", "default": 0 }
  ]
}
{% endschema %}
