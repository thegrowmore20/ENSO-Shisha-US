{% stylesheet %}

.dg-hero {
  /* padding-top / padding-bottom set by {% style %} */
}

.dg-hero__grid {
  display: grid;
  grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  gap: 24px;
  align-items: center;
}

.dg-hero__brand {
  font-size: 22px;
  line-height: 28px;
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
  letter-spacing: 0;
  text-transform: none;
  margin: 0 0 14px;
}

.dg-hero__h1 {
  font-size: 56px;
  line-height: 60px;
  font-weight: var(--font-weight-heavy);
  letter-spacing: -.03em;
  margin: 0 0 12px;
  font-family: var(--font-heading);
}

.dg-hero__sub {
  font-size: 17px;
  line-height: 1.6;
  color: rgb(0 0 0 / .72);
  margin: 0 0 36px;
  max-width: 34ch;
}

.dg-hero__entries {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  border-top: 1px solid var(--color-border);
}

.dg-hero__entry {
  border-bottom: 1px solid var(--color-border);
}

.dg-hero__entry a {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16px;
  padding: 16px 0;
  text-decoration: none;
  color: var(--color-text);
}
.dg-hero__entry a:hover strong {
  text-decoration: underline;
  text-underline-offset: 4px;
}

.dg-hero__entry strong {
  font-weight: var(--font-weight-bold);
  font-size: 18px;
}

.dg-hero__entry span {
  font-size: 14px;
  color: rgb(0 0 0 / .55);
  text-align: right;
}

.dg-hero__entry--primary a {
  padding: 20px 0;
}

.dg-hero__entry--primary strong {
  font-size: 22px;
}

.dg-hero__entry--primary strong::after {
  content: " ↓";
  font-weight: var(--font-weight-regular);
}

.dg-hero__stage {
  line-height: 0;
}

.dg-hero__stage img {
  width: 100%;
  height: auto;
  display: block;
}

.dg-hero__placeholder {
  width: 100%;
  aspect-ratio: 7 / 8;
  overflow: hidden;
}

@media screen and (max-width: 989px) {
  .dg-hero__grid {
    grid-template-columns: 1fr;
  }
  .dg-hero__copy { order: 2; }
  .dg-hero__stage { order: 1; }
  .dg-hero__brand {
    font-size: 19px;
    line-height: 24px;
  }
  .dg-hero__h1 {
    font-size: 40px;
    line-height: 44px;
  }
}

{% endstylesheet %}

{% style %}
  #shopify-section-{{ section.id }} .dg-hero {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .dg-hero {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<div class="dg-hero" id="DgHero-{{ section.id }}">
  <div class="container">
  <div class="dg-hero__grid">
  <div class="dg-hero__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="dg-hero__brand">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="dg-hero__h1">{{ section.settings.heading | default: 'Start here' | escape }}</h1>

    {%- if section.settings.subheading != blank -%}
      <p class="dg-hero__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="dg-hero__entries">
        {%- for block in section.blocks -%}
          <li class="dg-hero__entry{% if block.settings.is_primary %} dg-hero__entry--primary{% endif %}" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.url | default: '#' }}">
              <strong>{{ block.settings.label | escape }}</strong>
              {%- if block.settings.sublabel != blank -%}
                <span>{{ block.settings.sublabel | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="dg-hero__stage">
    {%- if section.settings.image != blank -%}
      {{- section.settings.image | image_url: width: 900 | image_tag:
        alt: section.settings.image.alt | default: section.settings.heading,
        loading: 'lazy',
        widths: '600,900,1200',
        sizes: '(max-width: 989px) 100vw, 50vw'
      -}}
    {%- else -%}
      <div class="dg-hero__placeholder">
        <svg viewBox="0 0 4 3" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:100%;display:block">
          <rect width="4" height="3" fill="#f0ede8"/>
          <path d="M1.6 1.5 L2 0.9 L2.4 1.5 M1.75 1.5 L2.25 1.5 M2 1.5 L2 2.1" stroke="#c8b89a" stroke-width="0.08" stroke-linecap="round"/>
        </svg>
      </div>
    {%- endif -%}
  </div>
  </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.diamond_guide_hero.name",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.diamond_guide_hero.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_guide_hero.settings.heading.label",
      "default": "Start here"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.diamond_guide_hero.settings.subheading.label",
      "default": "Everything for your first session and the ones after it, in the order you will need it."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.diamond_guide_hero.settings.image.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48
    }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "t:sections.diamond_guide_hero.blocks.entry.name",
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "t:sections.diamond_guide_hero.blocks.entry.settings.url.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.diamond_guide_hero.blocks.entry.settings.label.label",
          "default": "Guide link"
        },
        {
          "type": "text",
          "id": "sublabel",
          "label": "t:sections.diamond_guide_hero.blocks.entry.settings.sublabel.label"
        },
        {
          "type": "checkbox",
          "id": "is_primary",
          "label": "t:sections.diamond_guide_hero.blocks.entry.settings.is_primary.label",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "t:sections.diamond_guide_hero.presets.name"
    }
  ]
}
{% endschema %}
