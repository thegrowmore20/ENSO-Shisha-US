{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
  assign products_per_page = section.settings.products_per_page
  assign pagination_type = section.settings.pagination_type
  assign nav_menu = linklists[section.settings.nav_menu]
  assign has_quick_links = false
  if section.settings.quick_link_1_text != blank and section.settings.quick_link_1_url != blank
    assign has_quick_links = true
  endif
  if section.settings.quick_link_2_text != blank and section.settings.quick_link_2_url != blank
    assign has_quick_links = true
  endif
  assign mobile_columns_class = 'collection--mobile-cols-' | append: section.settings.mobile_columns
-%}

<div
  class="collection {{ scheme_class }} section-padding {{ mobile_columns_class }}"
  data-section-id="{{ section.id }}"
  data-pagination-type="{{ pagination_type }}"
>
  <div class="container">
    {%- render 'breadcrumbs' -%}

    {% if section.settings.enable_collection_content %}
      <div class="collection__header text-center">
        <h1 class="h-section">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <div class="body-text text-muted collection__description">{{ collection.description }}</div>
        {%- endif -%}
      </div>
    {% endif %}

    <div class="mobile-collection-tabs">
      {% for link in section.settings.tabs_menu.links limit: 2 %}
        {%- if link.type == 'collection_link' and link.object -%}
          {%- assign link_count = link.object.all_products_count | default: link.object.products_count -%}
        {%- endif -%}
        <a href="{{ link.url }}" data-count="{{ link_count }}" {% if link.current %}class="active-tab"{% endif %}>
          {% if link.handle == 'devices' %}{% render 'icon-tab-devices' %}{% elsif link.handle == 'accessories' %}{% render 'icon-tab-accessories' %}{% endif %}
          <span>{{ link.title }}{% if link_count != blank %}<span class="collection-tabs-count">&nbsp;({{ link_count }})</span>{% endif %}</span>
        </a>
      {% endfor %}
    </div>

    {%- paginate collection.products by products_per_page -%}
      <div class="collection__layout{% unless section.settings.enable_filtering %} collection__layout--no-sidebar{% endunless %}">

        {%- if section.settings.enable_filtering -%}
          <div class="collection__sidebar-overlay" data-sidebar-close></div>

          <aside
            class="collection__sidebar"
            id="CollectionSidebar-{{ section.id }}"
            aria-hidden="true"
          >
            <div class="collection__sidebar-header">
              <p class="h-4">{{ 'collections.general.filter_and_sort' | t }}</p>
              <button
                type="button"
                class="collection__sidebar-close"
                data-sidebar-close
                aria-label="{{ 'accessibility.close' | t }}"
              >{% render 'icon-close' %}</button>
            </div>

            {%- comment -%}
              Drawer-only sort control. On mobile the sidebar becomes the
              filter/sort drawer, so sort lives here instead of the toolbar.
              The toolbar's own sort instance is hidden below 990px via CSS
              in snippets/sort-by.liquid; both stay in sync via facets.js.
            {%- endcomment -%}
            {%- if section.settings.enable_sorting -%}
              {%- render 'sort-by', results: collection, section: section, variant: 'drawer', id_suffix: 'Drawer' -%}
            {%- endif -%}

            {%- render 'facets',
              results: collection,
              nav_menu: nav_menu,
              has_quick_links: has_quick_links,
              section: section
            -%}

            <button type="button" class="btn btn--primary collection__sidebar-apply" data-sidebar-close>
              {{ 'collections.general.view_results' | t }} ({{ collection.products_count }})
            </button>
          </aside>
        {%- endif -%}

        <div class="collection__main">
          <div class="collection__toolbar" id="CollectionToolbar-{{ section.id }}">
            {%- comment -%}
              Mobile: [ toggle .......... count ]  (sort lives in the drawer)
              Desktop: [ count .......... sort ]  (toggle is display:none)
              Achieved with justify-content: space-between + each side's own
              display:none at the relevant breakpoint — no JS reordering needed.
            {%- endcomment -%}
            {%- if section.settings.enable_filtering -%}
              <button
                type="button"
                class="btn btn--secondary collection__filter-toggle"
                aria-expanded="false"
                aria-controls="CollectionSidebar-{{ section.id }}"
              >
                {{ 'collections.general.filter_and_sort' | t }}
                <span class="filter-toggle-icon">
                  <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9.375 3.125C8.56687 3.125 7.87813 3.6525 7.61688 4.375H2.5V5.625H7.6175C7.87812 6.3475 8.56687 6.875 9.375 6.875C10.1831 6.875 10.8719 6.3475 11.1331 5.625H17.5V4.375H11.1325C10.8719 3.6525 10.1838 3.125 9.375 3.125ZM9.375 4.375C9.72687 4.375 10 4.64875 10 5C10 5.35188 9.72625 5.625 9.375 5.625C9.02313 5.625 8.75 5.35125 8.75 5C8.75 4.64812 9.02375 4.375 9.375 4.375ZM13.75 8.125C12.9419 8.125 12.2531 8.6525 11.9919 9.375H2.5V10.625H11.9925C12.2531 11.3475 12.9419 11.875 13.75 11.875C14.5581 11.875 15.2469 11.3475 15.5081 10.625H17.5V9.375H15.5075C15.2469 8.6525 14.5581 8.125 13.75 8.125ZM13.75 9.375C14.1019 9.375 14.375 9.64875 14.375 10C14.375 10.3519 14.1012 10.625 13.75 10.625C13.3981 10.625 13.125 10.3513 13.125 10C13.125 9.64813 13.3988 9.375 13.75 9.375ZM6.875 13.125C6.06687 13.125 5.37813 13.6525 5.11688 14.375H2.5V15.625H5.1175C5.37812 16.3475 6.06687 16.875 6.875 16.875C7.68313 16.875 8.37187 16.3475 8.63312 15.625H17.5V14.375H8.6325C8.37188 13.6525 7.68313 13.125 6.875 13.125ZM6.875 14.375C7.22687 14.375 7.5 14.6488 7.5 15C7.5 15.3519 7.22625 15.625 6.875 15.625C6.52313 15.625 6.25 15.3512 6.25 15C6.25 14.6481 6.52375 14.375 6.875 14.375Z" fill="currentColor"></path>
                  </svg>
                </span>
              </button>
            {%- endif -%}

            <p class="collection__count body-text text-muted">
              {{ 'collections.general.items_with_count' | t: count: collection.products_count }}
            </p>

            {%- if section.settings.enable_sorting -%}
              {%- render 'sort-by', results: collection, section: section, variant: 'toolbar', id_suffix: 'Toolbar' -%}
            {%- endif -%}
          </div>

          <div id="ProductGridContainer-{{ section.id }}" aria-live="polite">
            {%- if collection.products.size > 0 -%}
              <div class="grid grid--3 collection__grid" id="ProductGrid-{{ section.id }}">
                {%- for product in collection.products -%}
                  {%- render 'card-product', product: product, section: section -%}
                {%- endfor -%}
              </div>
            {%- else -%}
              <p class="body-text text-muted text-center collection__empty">{{ 'collections.general.no_matches' | t }}</p>
            {%- endif -%}
          </div>

          {%- comment -%}
            This wrapper ALWAYS renders, even when there's nothing to paginate.
            It must never be conditionally omitted: the AJAX swap targets this
            element by id, and if the fetched HTML doesn't contain it (because
            a filter reduced results to one page), the JS falls back to
            clearing it out. If the div itself were missing here too, a stale
            "load more" button / pagination nav from before the filter was
            applied would stay live — which is exactly the bug where filtered
            pagination silently loads unfiltered results.
          {%- endcomment -%}
          <div class="collection__pagination-wrapper" id="PaginationWrapper-{{ section.id }}">
            {%- if paginate.pages > 1 -%}
              {%- if pagination_type == 'load_more' -%}
                {%- if paginate.next -%}
                  <button
                    type="button"
                    class="btn btn--primary collection__load-more"
                    data-load-more-url="{{ paginate.next.url }}"
                  >
                    {{ 'collections.general.load_more' | t }}
                  </button>
                {%- endif -%}
              {%- else -%}
                {%- render 'pagination', paginate: paginate -%}
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</div>

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .collection__layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-6, 2rem);
    align-items: start;
  }

  .collection__layout--no-sidebar {
    grid-template-columns: 1fr;
  }

  .collection__sidebar-overlay {
    display: none;
  }

  .collection__sidebar-header,
  .collection__sidebar-apply {
    display: none;
  }

  .collection__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4, 1rem);
    margin-bottom: var(--space-5, 1.5rem);
  }

  .collection__filter-toggle {
    display: none;
  }

  .collection__count {
    margin: 0;
  }

  .collection__pagination-wrapper {
    margin-top: var(--space-7, 2.5rem);
    display: flex;
    justify-content: center;
  }

  .collection__pagination-wrapper:empty {
    margin-top: 0;
  }

  .collection__load-more[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .collection--loading .collection__main {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .mobile-collection-tabs {
    display: none;
  }

  /* Mobile: sidebar becomes an off-canvas drawer */
  @media (max-width: 989px) {
    .mobile-collection-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      justify-content: center;
      justify-items: center;
      margin-bottom: 12px;
    }
    .mobile-collection-tabs a {
      width: 100%;
      text-align: center;
      padding: 14px;
      border: 1px solid var(--color-primary-button-background);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      color: var(--color-primary-button-background);
    }
    .mobile-collection-tabs a.active-tab {
        background: var(--color-primary-button-background);
        color: var(--color-primary-button-label);
    }
    .mobile-collection-tabs a:last-of-type {
        border-left: 0;
    }
    .mobile-collection-tabs a svg {
      width: 20px;
      height: 20px;
    }
    .collection__filter-toggle {
      display: inline-flex;
      padding-inline: 15px;
    }

    .collection__filter-toggle .filter-toggle-icon svg {
      width: 20px;
      height: 20px;
      display: block; 
    }

    .collection__sidebar-overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease;
      z-index: 40;
    }

    .collection__sidebar-overlay.is-open {
      opacity: 1;
      visibility: visible;
    }

    .collection__sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(340px, 88vw);
      background: var(--color-background, #fff);
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      z-index: 41;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      padding: var(--space-4, 1rem);
    }

    .collection__sidebar.is-open {
      transform: translateX(0);
    }

    .collection__sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--space-4, 1rem);
    }

    .collection__sidebar-close {
      background: none;
      border: 0;
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
      padding-right: 0;
    }

    .collection__sidebar-apply {
      display: block;
      margin-top: auto;
      width: 100%;
    }

    .collection__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 990px) {
    .collection__sidebar {
      position: static;
    }
  }

  /* Facets */
  .facets__group {
    border-bottom: 1px solid var(--color-border, #e5e5e5);
    padding: var(--space-3, 0.75rem) 0;
  }

  .facets__group--link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .facets__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
  }

  .facets__summary::-webkit-details-marker {
    display: none;
  }

  .facets__chevron {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .facets__chevron--down {
    transform: rotate(45deg);
  }

  .facets__group[open] > .facets__summary .facets__chevron--down {
    transform: rotate(225deg);
  }

  .facets__chevron--right {
    transform: rotate(-45deg);
  }

  .facets__body {
    padding-top: var(--space-3, 0.75rem);
  }

  .facets__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .facets__checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    cursor: pointer;
  }

  /* Fully custom checkbox: native input, appearance suppressed, checkmark
     revealed via background-image + animated background-size so it draws
     in on check instead of just appearing. */
  .facets__checkbox {
    appearance: none;
    width: 20px;
    height: 20px;
    background-color: color-mix(in srgb, var(--color-text) 6%, transparent);
    background-repeat: no-repeat;
    background-position: center;
    background-size: 0%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 26 26' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M21.9865 6.8196L9.75033 19.0558L4.55575 13.8612' stroke='white' stroke-width='2.5'/%3E%3C/svg%3E");
    border: none;
    border-radius: var(--radius-sm);
    transition: background-size 100ms, background-color 100ms;
    cursor: pointer;
    flex-shrink: 0;
  }

  .facets__checkbox:hover {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-text) 10%, transparent);
  }

  .facets__checkbox:checked {
    background-color: var(--color-text);
    background-size: 75%;
  }

  .facets__item--disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .facets__item--disabled .facets__checkbox-label {
    cursor: not-allowed;
  }

  .facets__count {
    margin-left: auto;
    font-size: 0.85em;
    opacity: 0.5;
  }

  /* Active filter pills */
  .active-filters {
    margin-bottom: var(--space-4, 1rem);
    padding-bottom: var(--space-4, 1rem);
    border-bottom: 1px solid var(--color-border, #e5e5e5);
  }

  .active-filters__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
    margin-bottom: var(--space-3, 0.75rem);
  }

  .active-filters__pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 999px;
    font-size: 0.85em;
    text-decoration: none;
    color: inherit;
    background: none;
    cursor: pointer;
  }

  .active-filters__remove,
  .active-filters__remove-icon {
    font-size: 1em;
    line-height: 1;
  }

  .active-filters__remove {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: inherit;
  }

  .active-filters__remove svg.icon-close,
  .active-filters__pill svg,
  .collection__sidebar-close svg {
    min-width: 14px;
    min-height: 14px;
  }

  .active-filters__clear-all {
    display: inline-block;
    font-size: 0.9em;
    text-decoration: underline;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Mobile columns override — scoped under the section's own modifier class
     so it never bleeds into other grids on the page. Uses !important
     deliberately: this is specifically overriding a global theme rule that
     forces 1 column below 589px, and specificity alone isn't guaranteed to
     win against it depending on load order. If your global rule doesn't use
     !important itself, you can safely drop it here too. */
  @media (max-width: 589px) {
    .collection--mobile-cols-2 .collection__grid.grid--3 {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: var(--space-4)
    }

    .collection--mobile-cols-1 .collection__grid.grid--3 {
      grid-template-columns: repeat(1, 1fr) !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main-collection.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.header.settings.color_scheme.label",
      "default": "scheme-paper"
    },
    {
      "type": "checkbox",
      "id": "enable_collection_content",
      "label": "Show Collection Title & Description",
      "default": false,
      "info": "If using banner image above this should be disabled to avoid repetition."
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filter sidebar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 1,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_quickadd",
      "label": "Enable quick add"
    },
    {
      "type": "select",
      "id": "quickadd_design",
      "label": "Quickadd Design",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "secondary"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "Pagination style",
      "options": [
        { "value": "pagination", "label": "Pagination" },
        { "value": "load_more", "label": "Load more button" }
      ],
      "default": "pagination"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Products per row on mobile",
      "info": "Below 589px. Overrides the theme's default 1-column mobile grid for this section only.",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Navigation filter group"
    },
    {
      "type": "link_list",
      "id": "nav_menu",
      "label": "Navigation menu",
      "info": "Rendered as a filter-style checkbox group. Selecting a link navigates instead of filtering; the current page's link shows as checked."
    },
    {
      "type": "header",
      "content": "Quick links"
    },
    {
      "type": "text",
      "id": "quick_link_1_text",
      "label": "Quick link 1 text"
    },
    {
      "type": "url",
      "id": "quick_link_1_url",
      "label": "Quick link 1 URL"
    },
    {
      "type": "text",
      "id": "quick_link_2_text",
      "label": "Quick link 2 text"
    },
    {
      "type": "url",
      "id": "quick_link_2_url",
      "label": "Quick link 2 URL"
    },
    {
      "type": "link_list",
      "id": "tabs_menu",
      "label": "Mobile Tabs",
      "info": "Supports upto two items only"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ]
}
{% endschema %}
