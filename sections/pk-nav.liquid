{% schema %}
{
  "name": "PK: Experience nav",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 40, "step": 4, "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 40, "step": 4, "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "presets": [{ "name": "PK: Experience nav" }]
}
{% endschema %}
