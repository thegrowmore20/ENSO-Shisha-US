{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
{%- liquid
  assign cup_blocks   = section.blocks | where: "type", "cup_step"
  assign wash_blocks  = section.blocks | where: "type", "wash_step"
  assign cap_blocks   = section.blocks | where: "type", "cap_step"
  assign shaft_blocks = section.blocks | where: "type", "shaft_step"
  assign never_blocks = section.blocks | where: "type", "never_step"
-%}
<div class="wrap">
  <section class="ch" id="cleaning"><p class="ch__num">12 · Care</p><h2>Cleaning</h2><p class="ch__lead">The heating element never clogs: it stays clean, that is the whole idea of Diamond. Only the cup, the mesh, the cap and the shaft need a rinse.</p><h3>After every session: the cup and the cap</h3><p class="h3lead">The cup, the mesh and the cap need it every time. Give Diamond 20–30 minutes to cool first.</p>
  {%- if cup_blocks.size > 0 -%}
    <div class="slider tslider" style="--n:{{ cup_blocks.size }}"><div class="slides">
      {%- for block in cup_blocks -%}
        <figure class="slide ts" {{ block.shopify_attributes }}><figcaption class="ts__tx"><span class="st__n">{{ forloop.index }}</span><b>{{ block.settings.step_title }}</b><p>{{ block.settings.step_body }}</p></figcaption><div class="ts__pic ts__pic--img">
          {%- if block.settings.image != blank -%}
            {{- block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: '' -}}
          {%- else -%}
            <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto"><rect width="400" height="300" rx="16" fill="#f0ede8"/><path d="M160 100a40 40 0 1 1 80 0 40 40 0 0 1-80 0zm-40 80 60-60 40 40 40-40 60 60H120z" fill="#c8b89a"/></svg>
          {%- endif -%}
        </div></figure>
      {%- endfor -%}
    </div><button class="nav prev" aria-label="Previous">‹</button><button class="nav next" aria-label="Next">›</button></div>
  {%- endif -%}
  <h3>Wash the cup and the mesh</h3><p class="h3lead">Warm water and a normal sponge. The same for the cup, the basket and the flat screens.</p>
  {%- if wash_blocks.size > 0 -%}
    <div class="slider tslider slider--grid" style="--n:{{ wash_blocks.size }}"><div class="slides">
      {%- for block in wash_blocks -%}
        <figure class="slide ts" {{ block.shopify_attributes }}><figcaption class="ts__tx"><span class="st__n">{{ forloop.index }}</span><b>{{ block.settings.step_title }}</b><p>{{ block.settings.step_body }}</p></figcaption><div class="ts__pic ts__pic--img">
          {%- if block.settings.image != blank -%}
            {{- block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: '' -}}
          {%- else -%}
            <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto"><rect width="400" height="300" rx="16" fill="#f0ede8"/><path d="M160 100a40 40 0 1 1 80 0 40 40 0 0 1-80 0zm-40 80 60-60 40 40 40-40 60 60H120z" fill="#c8b89a"/></svg>
          {%- endif -%}
        </div></figure>
      {%- endfor -%}
    </div><button class="nav prev" aria-label="Previous">‹</button><button class="nav next" aria-label="Next">›</button></div>
  {%- endif -%}
  <h3>The cap</h3><p class="h3lead">No electronics in the cap: all three parts go under the tap.</p>
  {%- if cap_blocks.size > 0 -%}
    <div class="slider tslider slider--grid" style="--n:{{ cap_blocks.size }}"><div class="slides">
      {%- for block in cap_blocks -%}
        <figure class="slide ts" {{ block.shopify_attributes }}><figcaption class="ts__tx"><span class="st__n">{{ forloop.index }}</span>{%- if block.settings.freq != blank -%}<small class="st__freq">{{ block.settings.freq }}</small>{%- endif -%}<b>{{ block.settings.step_title }}</b><p>{{ block.settings.step_body }}</p></figcaption><div class="ts__pic ts__pic--img">
          {%- if block.settings.image != blank -%}
            {{- block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: '' -}}
          {%- else -%}
            <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto"><rect width="400" height="300" rx="16" fill="#f0ede8"/><path d="M160 100a40 40 0 1 1 80 0 40 40 0 0 1-80 0zm-40 80 60-60 40 40 40-40 60 60H120z" fill="#c8b89a"/></svg>
          {%- endif -%}
        </div></figure>
      {%- endfor -%}
    </div><button class="nav prev" aria-label="Previous">‹</button><button class="nav next" aria-label="Next">›</button></div>
  {%- endif -%}
  <div class="note note--tip"><b>Tip:</b> Between sessions, wipe the top of Diamond around the chamber with a soft dry cloth. Only when it is cool.</div>
  <a class="cl-glove" href="/collections/accessories">
    {%- if section.settings.acc_glove != blank -%}
      {{- section.settings.acc_glove | image_url: width: 600 | image_tag: loading: 'lazy', alt: section.settings.acc_glove.alt | default: 'The ENSŌ Cleaning Glove', width: section.settings.acc_glove.width, height: section.settings.acc_glove.height -}}
    {%- else -%}
      <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto"><rect width="400" height="300" rx="16" fill="#f0ede8"/><path d="M160 100a40 40 0 1 1 80 0 40 40 0 0 1-80 0zm-40 80 60-60 40 40 40-40 60 60H120z" fill="#c8b89a"/></svg>
    {%- endif -%}
    <span><b>Quicker with the ENSŌ Cleaning Glove</b>Its steel mesh palm cleans the cup, the basket and the screens in a few strokes.<em>See the Cleaning Glove ›</em></span>
  </a>
  <h3>Every few sessions: the shaft</h3><p class="h3lead">The heating element never clogs. The shaft below it gets a brush and a rinse every few sessions. Always with the battery in.</p>
  {%- if shaft_blocks.size > 0 -%}
    <div class="slider tslider slider--grid" style="--n:{{ shaft_blocks.size }}"><div class="slides">
      {%- for block in shaft_blocks -%}
        <figure class="slide ts" {{ block.shopify_attributes }}><figcaption class="ts__tx"><span class="st__n">{{ forloop.index }}</span><b>{{ block.settings.step_title }}</b><p>{{ block.settings.step_body }}</p></figcaption><div class="ts__pic ts__pic--img">
          {%- if block.settings.image != blank -%}
            {{- block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: '' -}}
          {%- else -%}
            <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto"><rect width="400" height="300" rx="16" fill="#f0ede8"/><path d="M160 100a40 40 0 1 1 80 0 40 40 0 0 1-80 0zm-40 80 60-60 40 40 40-40 60 60H120z" fill="#c8b89a"/></svg>
          {%- endif -%}
        </div></figure>
      {%- endfor -%}
    </div><button class="nav prev" aria-label="Previous">‹</button><button class="nav next" aria-label="Next">›</button></div>
  {%- endif -%}
  <h3>Never</h3><p class="h3lead">The battery and the contacts never get wet.</p>
  {%- if never_blocks.size > 0 -%}
    <div class="slider tslider slider--grid slider--never" style="--n:{{ never_blocks.size }}"><div class="slides">
      {%- for block in never_blocks -%}
        <figure class="slide ts" {{ block.shopify_attributes }}><figcaption class="ts__tx"><span class="st__n">{{ forloop.index }}</span><b>{{ block.settings.step_title }}</b><p>{{ block.settings.step_body }}</p></figcaption><div class="ts__pic ts__pic--img">
          {%- if block.settings.image != blank -%}
            {{- block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: '' -}}
          {%- else -%}
            <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto"><rect width="400" height="300" rx="16" fill="#f0ede8"/><path d="M160 100a40 40 0 1 1 80 0 40 40 0 0 1-80 0zm-40 80 60-60 40 40 40-40 60 60H120z" fill="#c8b89a"/></svg>
          {%- endif -%}
        </div></figure>
      {%- endfor -%}
    </div><button class="nav prev" aria-label="Previous">‹</button><button class="nav next" aria-label="Next">›</button></div>
  {%- endif -%}
  {%- if section.settings.multitool_product != blank -%}
    {%- liquid
      assign mt_product = section.settings.multitool_product
      assign mt_price = mt_product.price | money
      assign mt_url = mt_product.url
      assign mt_title = mt_product.title
      assign mt_img = mt_product.featured_image
      assign mt_subtitle = mt_product.metafields.custom.headline | metafield_tag | strip_html | strip
    -%}
    <p class="sp-label">MAKES IT QUICKER</p>
    <div class="spares">
      <a class="spare" href="{{ mt_url }}">
        {%- if mt_img != blank -%}
          {{- mt_img | image_url: width: 400 | image_tag: loading: 'lazy', alt: mt_img.alt | default: mt_title, width: 80, height: 80 -}}
        {%- elsif section.settings.acc_multi_tool != blank -%}
          {{- section.settings.acc_multi_tool | image_url: width: 400 | image_tag: loading: 'lazy', alt: section.settings.acc_multi_tool.alt | default: mt_title, width: 80, height: 80 -}}
        {%- else -%}
          <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:80px;height:80px"><rect width="80" height="80" rx="12" fill="#f0ede8"/><path d="M28 40a12 12 0 1 1 24 0 12 12 0 0 1-24 0zm-6 16 10-12 8 8 8-10 14 14H22z" fill="#c8b89a"/></svg>
        {%- endif -%}
        <span><b>{{ mt_title }}</b><small>{{ mt_subtitle }}</small></span>
        <em>{{ mt_price }}</em>
      </a>
    </div>
  {%- elsif section.settings.acc_multi_tool != blank -%}
    <p class="sp-label">MAKES IT QUICKER</p>
    <div class="spares">
      <a class="spare" href="/products/enso-4-in-1-multi-tool">
        {{- section.settings.acc_multi_tool | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'ENSŌ 4-in-1 Multi-Tool', width: 80, height: 80 -}}
        <span><b>ENSŌ 4-in-1 Multi-Tool</b><small>For cleaning and packing</small></span>
      </a>
    </div>
  {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "DM: Cleaning",
  "settings": [
    {
      "type": "header",
