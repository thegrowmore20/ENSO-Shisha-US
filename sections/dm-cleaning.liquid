        },
        {
          "type": "text",
          "id": "step_title",
          "label": "Step title"
        },
        {
          "type": "textarea",
          "id": "step_body",
          "label": "Step description"
        }
      ]
    },
    {
      "type": "wash_step",
      "name": "Washing step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step image"
        },
        {
          "type": "text",
          "id": "step_title",
