{%- doc -%}
  ENSŌ Experience banner — full-bleed image card with gradient overlay,
  white heading + body, and a gold CTA button.
  Matches the split_showcase section in the handoff (partner-v2/index.html).
{%- enddoc -%}

{% style %}
  #exp-banner-{{ section.id }} {
    padding: {{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #exp-banner-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section id="exp-banner-{{ section.id }}" class="exp-banner-section">
  <div class="exp-banner__inner">
    <div class="exp-banner">

      <div class="exp-banner__media">
        {%- if section.settings.image != blank -%}
          {%- assign banner_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '750, 1100, 1440, 1600',
              sizes: '(max-width: 749px) 100vw, calc(100vw - 80px)',
              alt: banner_alt,
              loading: 'lazy',
              class: 'exp-banner__img'
          }}
        {%- else -%}
          <div class="exp-banner__img-placeholder" aria-hidden="true"></div>
        {%- endif -%}
        <div class="exp-banner__overlay" aria-hidden="true"></div>
      </div>

      <div class="exp-banner__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="exp-banner__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="exp-banner__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--accent exp-banner__btn" href="{{ section.settings.cta_link | default: '#' }}">
            {{ section.settings.cta_label | escape }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
  .exp-banner__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .exp-banner {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    min-height: 600px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* ── Media ── */
  .exp-banner__media {
    position: absolute;
    inset: 0;
  }

  .exp-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    display: block;
  }

  .exp-banner__img-placeholder {
    width: 100%;
    height: 100%;
    background: var(--palette-graphite, #1a1813);
  }

  /* Desktop: left-to-right fade so content reads on the left */
  .exp-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.45) 38%,
      rgba(0, 0, 0, 0) 64%
    );
    pointer-events: none;
  }

  /* ── Content ── */
  .exp-banner__content {
    position: relative;
    z-index: 2;
    padding: 0 28px 56px;
    max-width: 440px;
  }

  .exp-banner__heading {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    font-size: 44px;
    line-height: 48px;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 12px;
  }

  .exp-banner__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 26px;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 24px;
    max-width: 44ch;
  }

  .exp-banner__btn {
    padding: 16px 28px;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {
    .exp-banner {
      min-height: 600px;
      border-radius: 22px;
    }

    .exp-banner__img {
      object-position: 38% 50%;
    }

    /* Mobile: bottom-to-top fade so text reads at the bottom */
    .exp-banner__overlay {
      background: linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.72) 0%,
        rgba(0, 0, 0, 0.35) 50%,
        rgba(0, 0, 0, 0) 75%
      );
    }

    .exp-banner__content {
      padding: 0 20px 28px;
      max-width: none;
    }

    .exp-banner__heading {
      font-size: 30px;
      line-height: 34px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.enso_experience_banner.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.enso_experience_banner.settings.image.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.enso_experience_banner.settings.heading.label",
      "default": "ENSŌ Experience"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.enso_experience_banner.settings.text.label",
      "default": "Everything you need to know: your first session step by step, how to pack the cup, which temperature suits which blend, cleaning and care, and firmware updates. Short guides with photos, made for the phone."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.enso_experience_banner.settings.cta_label.label",
      "default": "Open ENSŌ Experience"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.enso_experience_banner.settings.cta_link.label"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:sections.enso_experience_banner.presets.name"
    }
  ]
}
{% endschema %}
