{%- assign st = section.settings -%}
{%- assign callouts = section.blocks | where: 'type', 'callout' -%}
{%- assign tiles = section.blocks | where: 'type', 'tile' -%}
{%- assign items = section.blocks | where: 'type', 'list_item' -%}

<section
  class="enso-witb"
  id="shopify-section-{{ section.id }}"
  style="
    --witb-pt: {{ st.padding_top }}px;
    --witb-pb: {{ st.padding_bottom }}px;
    --witb-pt-m: {{ st.padding_top_mobile }}px;
    --witb-pb-m: {{ st.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">

    {%- if st.eyebrow != blank or st.heading != blank -%}
      <div class="enso-witb__head">
        {%- if st.eyebrow != blank -%}
          <p class="eyebrow">{{ st.eyebrow }}</p>
        {%- endif -%}
        {%- if st.heading != blank -%}
          <h2 class="h2">{{ st.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="enso-witb__grid">

      <!-- Device callout image + hotspots -->
      <div class="enso-witb__dev">
        {%- if st.device_image != blank -%}
          {{
            st.device_image
            | image_url: width: 900
            | image_tag:
              widths: '450, 600, 900',
              sizes: '(min-width: 992px) 55vw, 100vw',
              alt: st.device_image.alt | default: 'ENSŌ 2026 Edition with parts labelled',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'enso-witb__dev-placeholder' }}
        {%- endif -%}

        {%- for block in callouts -%}
          {%- assign b = block.settings -%}
          <button
            type="button"
            class="enso-witb__co{% if b.align_left %} enso-witb__co--left{% endif %}"
            style="left:{{ b.pos_x }}%;top:{{ b.pos_y }}%;"
            data-popup-title="{{ b.popup_title | escape }}"
            data-popup-body="{{ b.popup_body | escape }}"
            aria-label="{{ b.label | escape }}"
            {{ block.shopify_attributes }}
          >
            <span class="enso-witb__co-dot" aria-hidden="true"></span>
            <span class="enso-witb__co-line" aria-hidden="true"></span>
            <span class="enso-witb__co-lbl" aria-hidden="true">
              <i class="enso-witb__co-l">{{ b.label }}</i>
              <i class="enso-witb__co-s">{{ b.label_short | default: b.label }}</i>
            </span>
          </button>
        {%- endfor -%}
      </div>

      <!-- Accessory tiles -->
      {%- if tiles.size > 0 -%}
        <div class="enso-witb__tiles">
          {%- for block in tiles -%}
            {%- assign b = block.settings -%}
            <div class="enso-witb__tile" {{ block.shopify_attributes }}>
              <div class="enso-witb__tile-img">
                {%- if b.image != blank -%}
                  {{
                    b.image
                    | image_url: width: 300
                    | image_tag:
                      widths: '150, 200, 300',
                      sizes: '(min-width: 992px) 15vw, 30vw',
                      alt: b.alt | default: b.name,
                      loading: 'lazy'
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'enso-witb__tile-placeholder' }}
                {%- endif -%}
              </div>
              <div class="enso-witb__tile-cap">
                <b>{{ b.name }}</b>
                {%- if b.quantity != blank -%}
                  <i>{{ b.quantity }}</i>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Items list -->
      {%- if items.size > 0 -%}
        <ul class="enso-witb__list">
          {%- for block in items -%}
            {%- assign b = block.settings -%}
            <li {{ block.shopify_attributes }}>
              <em>{{ b.quantity }}</em>
              <span>
                <b>{{ b.name }}</b>
                {%- if b.note != blank -%} · {{ b.note }}{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

    </div>

    {%- if st.hint_text != blank -%}
      <p class="enso-witb__hint">{{ st.hint_text }}</p>
    {%- endif -%}

  </div>

  <!-- Part detail popup -->
  <div class="enso-witb-pop" id="EnsoWitbPop-{{ section.id }}" hidden role="dialog" aria-modal="true" aria-labelledby="EnsoWitbPopT-{{ section.id }}">
    <div class="enso-witb-pop__box">
      <button type="button" class="enso-witb-pop__x" aria-label="{{ 'accessibility.close' | t }}">&#215;</button>
      <h3 class="enso-witb-pop__title" id="EnsoWitbPopT-{{ section.id }}"></h3>
      <p class="enso-witb-pop__body"></p>
    </div>
  </div>

</section>

{% style %}
  .enso-witb {
    padding-top: var(--witb-pt-m, 40px);
    padding-bottom: var(--witb-pb-m, 24px);
  }
  @media screen and (min-width: 750px) {
    .enso-witb {
      padding-top: var(--witb-pt, 80px);
      padding-bottom: var(--witb-pb, 40px);
    }
  }

  /* Head */
  .enso-witb__head {
    text-align: center;
    margin: 0 auto 40px;
  }
  .enso-witb__head .h2 {
    margin: 8px 0 0;
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    letter-spacing: -0.025em;
  }

  /* Main grid */
  .enso-witb__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 28px;
    align-items: start;
  }
  @media screen and (max-width: 991px) {
    .enso-witb__grid { grid-template-columns: 1fr; }
  }

  /* Device callout */
  .enso-witb__dev {
    position: relative;
    border: 1px solid rgb(0 0 0 / .1);
    border-radius: 24px;
    background: #fff;
    overflow: hidden;
    aspect-ratio: 1;
  }
  .enso-witb__dev img,
  .enso-witb__dev .enso-witb__dev-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Hotspot callout buttons */
  .enso-witb__co {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font: inherit;
    color: #000;
  }
  .enso-witb__co-dot {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid #111;
    box-shadow: 0 0 0 3px rgb(255 255 255 / .85);
    flex: none;
  }
  .enso-witb__co-line {
    height: 1.5px;
    background: #111;
    width: 30px;
    flex: none;
  }
  .enso-witb__co-lbl {
    font: 600 12.5px/1 var(--font-heading);
    background: #fff;
    border: 1px solid #dcdcdc;
    border-radius: 999px;
    padding: 8px 13px;
    white-space: nowrap;
    box-shadow: 0 1px 4px rgb(0 0 0 / .06);
    transition: background .2s, color .2s;
  }
  .enso-witb__co:hover .enso-witb__co-lbl,
  .enso-witb__co:focus-visible .enso-witb__co-lbl {
    background: #111;
    color: #fff;
    border-color: #111;
  }
  .enso-witb__co--left { flex-direction: row-reverse; }
  .enso-witb__co-l { font-style: normal; }
  .enso-witb__co-s { font-style: normal; display: none; }

  @media screen and (max-width: 991px) {
    .enso-witb__co-lbl  { font-size: 10.5px; padding: 6px 9px; }
    .enso-witb__co-line { width: 14px; }
    .enso-witb__co-dot  { width: 10px; height: 10px; border-width: 2.5px; }
    .enso-witb__co-l    { display: none; }
    .enso-witb__co-s    { display: inline; }
  }

  /* Tiles grid */
  .enso-witb__tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  @media screen and (min-width: 750px) {
    .enso-witb__tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 991px) {
    .enso-witb__tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .enso-witb__tile {
    border: 1px solid rgb(0 0 0 / .1);
    border-radius: 16px;
    background: #fff;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform .2s, box-shadow .2s;
  }
  .enso-witb__tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgb(0 0 0 / .08);
  }
  .enso-witb__tile-img {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: #fff;
    padding: 12px;
  }
  .enso-witb__tile-img img,
  .enso-witb__tile-placeholder {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .enso-witb__tile-cap {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 8px 10px 9px;
    border-top: 1px solid #eee;
  }
  .enso-witb__tile-cap b {
    font: 700 11.5px/1.3 var(--font-heading);
  }
  .enso-witb__tile-cap i {
    font: 600 11.5px var(--font-heading);
    font-style: normal;
    color: #8a8a8a;
    white-space: nowrap;
  }

  /* Items list */
  .enso-witb__list {
    grid-column: 1 / -1;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 28px;
  }
  .enso-witb__list li {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: 10px;
    padding: 11px 0;
    border-top: 1px solid rgb(0 0 0 / .1);
    font-size: 15px;
    line-height: 22px;
    color: rgb(0 0 0 / .7);
  }
  .enso-witb__list em {
    font-style: normal;
    font-weight: 700;
    color: var(--palette-bronze, #96671f);
  }
  .enso-witb__list b { color: #000; font-weight: 600; }
  @media screen and (max-width: 749px) {
    .enso-witb__list { grid-template-columns: 1fr; }
  }

  /* Hint */
  .enso-witb__hint {
    text-align: center;
    color: #8a8a8a;
    font-size: 13px;
    margin: 14px 0 0;
  }

  /* Popup */
  .enso-witb-pop {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgb(0 0 0 / .45);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .enso-witb-pop[hidden] { display: none !important; }
  .enso-witb-pop__box {
    background: #fff;
    border-radius: 24px;
    max-width: 420px;
    width: 100%;
    padding: 28px;
    position: relative;
  }
  .enso-witb-pop__title {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    font-size: 24px;
    letter-spacing: -.02em;
    margin: 0 0 8px;
  }
  .enso-witb-pop__body {
    margin: 0;
    color: rgb(0 0 0 / .72);
    font-size: 15px;
    line-height: 24px;
  }
  .enso-witb-pop__x {
    position: absolute;
    right: 14px; top: 14px;
    width: 36px; height: 36px;
    border-radius: 50%;
    border: 1px solid rgb(0 0 0 / .12);
    background: #fff;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
{% endstyle %}

{% javascript %}
  (function () {
    var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    var pop   = document.getElementById('EnsoWitbPop-{{ section.id }}');
    var popT  = document.getElementById('EnsoWitbPopT-{{ section.id }}');
    var popB  = pop ? pop.querySelector('.enso-witb-pop__body') : null;
    var popX  = pop ? pop.querySelector('.enso-witb-pop__x') : null;

    function closePop() { if (pop) pop.hidden = true; }
    function openPop(title, body) {
      if (!pop || !popT || !popB) return;
      popT.textContent = title;
      popB.textContent = body;
      pop.hidden = false;
      popX.focus();
    }

    if (popX) popX.addEventListener('click', closePop);
    if (pop) {
      pop.addEventListener('click', function (e) { if (e.target === pop) closePop(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !pop.hidden) closePop(); });
    }

    sectionEl.querySelectorAll('.enso-witb__co').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var title = btn.dataset.popupTitle;
        var body  = btn.dataset.popupBody;
        if (title && body) openPop(title, body);
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "ENSŌ in the box",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What is in the box"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything to start a session"
    },
    {
      "type": "image_picker",
      "id": "device_image",
      "label": "Device callout image"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint text",
      "default": "Tap a part to see what it is and where to get a spare. The wall adapter is not included."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — desktop",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — desktop",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24
    }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Hotspot",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label (desktop)"
        },
        {
          "type": "text",
          "id": "label_short",
          "label": "Label (mobile, short)"
        },
        {
          "type": "range",
          "id": "pos_x",
          "label": "Horizontal position",
          "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50
        },
        {
          "type": "range",
          "id": "pos_y",
          "label": "Vertical position",
          "min": 0, "max": 100, "step": 1, "unit": "%", "default": 10
        },
        {
          "type": "checkbox",
          "id": "align_left",
          "label": "Label on left side",
          "default": false
        },
        {
          "type": "text",
          "id": "popup_title",
          "label": "Popup title"
        },
        {
          "type": "textarea",
          "id": "popup_body",
          "label": "Popup description"
        }
      ]
    },
    {
      "type": "tile",
      "name": "Accessory tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "quantity",
          "label": "Quantity (e.g. 1×)"
        }
      ]
    },
    {
      "type": "list_item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "quantity",
          "label": "Quantity",
          "default": "1×"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Item name"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ENSŌ in the box",
      "blocks": [
        { "type": "callout", "settings": { "label": "Glass ThermoCap", "label_short": "ThermoCap", "pos_x": 50, "pos_y": 10, "align_left": false } },
        { "type": "callout", "settings": { "label": "Brown leather strap", "label_short": "Strap", "pos_x": 41, "pos_y": 19, "align_left": true } },
        { "type": "callout", "settings": { "label": "Mouthpiece · 15 cm", "label_short": "Mouthpiece", "pos_x": 63, "pos_y": 30, "align_left": false } },
        { "type": "callout", "settings": { "label": "Blow-out valve", "label_short": "Valve", "pos_x": 34, "pos_y": 47, "align_left": true } },
        { "type": "callout", "settings": { "label": "Hose · 1.5 m", "label_short": "Hose", "pos_x": 70, "pos_y": 62, "align_left": false } },
        { "type": "callout", "settings": { "label": "Glass water tank", "label_short": "Tank", "pos_x": 41, "pos_y": 87, "align_left": true } },
        { "type": "callout", "settings": { "label": "Dip tube", "label_short": "Dip tube", "pos_x": 50, "pos_y": 84, "align_left": false } },
        { "type": "tile", "settings": { "name": "Battery", "quantity": "1×" } },
        { "type": "tile", "settings": { "name": "Ceramic cups", "quantity": "2×" } },
        { "type": "tile", "settings": { "name": "Disposable capsules", "quantity": "10×" } },
        { "type": "tile", "settings": { "name": "3-in-1 multi-tool + glove", "quantity": "1×" } },
        { "type": "tile", "settings": { "name": "Mesh screens", "quantity": "2×" } },
        { "type": "list_item", "settings": { "quantity": "1×", "name": "USB-C cable", "note": "wall adapter not included" } },
        { "type": "list_item", "settings": { "quantity": "5×", "name": "Silicone mouth tips" } },
        { "type": "list_item", "settings": { "quantity": "1 set", "name": "Cleaning brushes", "note": "for the shaft" } },
        { "type": "list_item", "settings": { "quantity": "5×", "name": "Glass balls", "note": "for the blow-out valve" } },
        { "type": "list_item", "settings": { "quantity": "1×", "name": "ENSŌ screen wipe" } },
        { "type": "list_item", "settings": { "quantity": "1×", "name": "Warranty card" } },
        { "type": "list_item", "settings": { "quantity": "1×", "name": "User manual" } }
      ]
    }
  ]
}
{% endschema %}
