{%- assign st = section.settings -%}
{%- assign sid = section.id -%}
{%- assign callouts = section.blocks | where: 'type', 'callout' -%}
{%- assign tiles    = section.blocks | where: 'type', 'tile' -%}
{%- assign items    = section.blocks | where: 'type', 'list_item' -%}

{%- comment -%} Pre-rendered product data: one <template> per tile that has a product {%- endcomment -%}
{%- for block in tiles -%}
  {%- assign b = block.settings -%}
  {%- if b.product != blank -%}
    {%- assign prod = b.product -%}
    {%- assign av_variant = prod.first_available_variant | default: prod.variants.first -%}
    <template
      id="witb-tpl-{{ block.id }}"
      data-title="{{ prod.title | escape }}"
      data-fits="{{ prod.metafields.custom.compatiblity_with | default: b.fits_label | default: st.default_fits_label | escape }}"
      data-price="{{ av_variant.price | money }}"
      data-available="{{ prod.available }}"
      data-vid="{{ av_variant.id | default: prod.variants.first.id }}"
      data-url="{{ prod.url }}"
    >
      {%- for img in prod.images limit: 3 -%}
        <img src="{{ img | image_url: width: 900 }}" alt="{{ img.alt | default: prod.title | escape }}">
      {%- endfor -%}
      <div class="witb-d-headline">{{ prod.metafields.custom.headline | metafield_tag }}</div>
      <div class="witb-d-what">
        {%- if prod.metafields.custom.short_description != blank -%}
          {{ prod.metafields.custom.short_description | metafield_tag }}
        {%- else -%}
          <p>{{ prod.description | strip_html | truncatewords: 60 }}</p>
        {%- endif -%}
      </div>
      <div class="witb-d-variants">
        {%- for v in prod.variants -%}
          <span data-vid="{{ v.id }}" data-price="{{ v.price | money }}" data-available="{{ v.available }}">{{ v.title | escape }}</span>
        {%- endfor -%}
      </div>
    </template>
  {%- endif -%}
{%- endfor -%}

<section
  class="enso-witb"
  id="shopify-section-{{ sid }}"
  data-sid="{{ sid }}"
  style="
    --witb-pt: {{ st.padding_top }}px;
    --witb-pb: {{ st.padding_bottom }}px;
    --witb-pt-m: {{ st.padding_top_mobile }}px;
    --witb-pb-m: {{ st.padding_bottom_mobile }}px;
  "
>
  <div class="container">

    {%- if st.eyebrow != blank or st.heading != blank -%}
      <div class="witb__head">
        {%- if st.eyebrow != blank -%}<p class="eyebrow">{{ st.eyebrow }}</p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="witb__h2">{{ st.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="witb__grid">

      <!-- Left: device image + hotspot callouts -->
      <div class="witb__dev">
        {%- if st.device_image != blank -%}
          {{
            st.device_image
            | image_url: width: 900
            | image_tag:
              widths: '450,600,900',
              sizes: '(min-width:992px) 55vw, 100vw',
              alt: st.device_image.alt | default: 'ENSO 2026 Edition with its parts labelled',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'witb__dev-ph' }}
        {%- endif -%}

        {%- for block in callouts -%}
          {%- assign b = block.settings -%}
          {%- liquid
            if b.align_left
              assign co_x = 100 | minus: b.pos_x
              assign co_style = 'right:' | append: co_x | append: '%;top:' | append: b.pos_y | append: '%'
            else
              assign co_style = 'left:' | append: b.pos_x | append: '%;top:' | append: b.pos_y | append: '%'
            endif
            assign pop_img_url = ''
            if b.popup_image != blank
              assign pop_img_url = b.popup_image | image_url: width: 600
            endif
          -%}
          <button
            type="button"
            class="witb__co{% if b.align_left %} witb__co--left{% endif %}"
            style="{{ co_style }}"
            data-witb-id="{{ block.id }}"
            data-pop-title="{{ b.label | escape }}"
            data-pop-img="{{ pop_img_url }}"
            aria-label="{{ b.label | escape }}"
            {{ block.shopify_attributes }}
          >
            <span class="witb__co-dot" aria-hidden="true"></span>
            <span class="witb__co-line" aria-hidden="true"></span>
            <span class="witb__co-lbl" aria-hidden="true">
              <i class="witb__co-l">{{ b.label }}</i>
              <i class="witb__co-s">{{ b.label_short | default: b.label }}</i>
            </span>
          </button>
          {%- if b.popup_desc != blank -%}
            <template data-pop-desc-for="{{ block.id }}">{{ b.popup_desc }}</template>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Right: tiles + list stacked -->
      <div class="witb__side">

        {%- if tiles.size > 0 -%}
          <div class="witb__tiles">
            {%- for block in tiles -%}
              {%- assign b = block.settings -%}
              {%- liquid
                assign pop_title = b.popup_title
                if pop_title == blank
                  assign pop_title = b.name
                endif
                if pop_title == blank and b.product != blank
                  assign pop_title = b.product.title
                endif
                assign pop_img_url = ''
                if b.popup_image != blank
                  assign pop_img_url = b.popup_image | image_url: width: 600
                endif
                assign has_pop_data = false
                if b.popup_image != blank or b.popup_desc != blank
                  assign has_pop_data = true
                endif
              -%}
              <button
                type="button"
                class="witb__tile{% if b.product != blank or has_pop_data %} witb__tile--link{% endif %}"
                data-witb-id="{{ block.id }}"
                {%- if has_pop_data -%}
                  data-pop-title="{{ pop_title | escape }}"
                  data-pop-img="{{ pop_img_url }}"
                {%- endif -%}
                {{ block.shopify_attributes }}
              >
                <span class="witb__tile-img">
                  {%- if b.image != blank -%}
                    {{
                      b.image
                      | image_url: width: 300
                      | image_tag:
                        widths: '150,200,300',
                        sizes: '(min-width:992px) 15vw, 25vw',
                        alt: b.image.alt | default: b.name,
                        loading: 'lazy'
                    }}
                  {%- elsif b.product != blank and b.product.featured_image != blank -%}
                    {{
                      b.product.featured_image
                      | image_url: width: 300
                      | image_tag:
                        widths: '150,200,300',
                        sizes: '(min-width:992px) 15vw, 25vw',
                        alt: b.product.featured_image.alt | default: b.product.title,
                        loading: 'lazy'
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'witb__tile-ph' }}
                  {%- endif -%}
                </span>
                <span class="witb__tile-cap">
                  <b>{{ b.name | default: b.product.title }}</b>
                  {%- if b.quantity != blank -%}<i>{{ b.quantity }}</i>{%- endif -%}
                </span>
              </button>
              {%- if b.popup_desc != blank -%}
                <template data-pop-desc-for="{{ block.id }}">{{ b.popup_desc }}</template>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if items.size > 0 -%}
          <ul class="witb__list">
            {%- for block in items -%}
              {%- assign b = block.settings -%}
              <li {{ block.shopify_attributes }}>
                <em>{{ b.quantity }}</em>
                <span>
                  <b>{{ b.name }}</b>
                  {%- if b.note != blank %} · <span class="witb__list-note">{{ b.note }}</span>{%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

      </div>
    </div>

    {%- if st.hint_text != blank -%}
      <p class="witb__hint">{{ st.hint_text }}</p>
    {%- endif -%}

  </div>

  <!-- Simple info popup: hotspot callouts + info-only tiles -->
  <div class="witb__pop" hidden role="dialog" aria-modal="true" aria-labelledby="witb-pop-title-{{ sid }}">
    <div class="witb__pop-box">
      <button type="button" class="witb__pop-x" aria-label="Close">×</button>
      <img class="witb__pop-img" alt="" hidden>
      <p class="witb__pop-eye">In the box</p>
      <h3 class="witb__pop-title" id="witb-pop-title-{{ sid }}"></h3>
      <p class="witb__pop-desc"></p>
    </div>
  </div>

</section>

{% stylesheet %}
.enso-witb {
  padding-top: var(--witb-pt-m, 40px);
  padding-bottom: var(--witb-pb-m, 24px);
}
@media screen and (min-width: 750px) {
  .enso-witb {
    padding-top: var(--witb-pt, 80px);
    padding-bottom: var(--witb-pb, 40px);
  }
}

/* Heading */
.witb__head { text-align: center; margin: 0 auto 40px; }
.witb__head .eyebrow { font-size: 15px; color: var(--color-text-muted, #666); }
.witb__h2 {
  margin: 8px 0 0;
  font-family: var(--font-accent);
  font-weight: var(--font-weight-heavy);
  letter-spacing: -0.025em;
}

/* Grid: device left | side right */
.witb__grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 28px;
  align-items: start;
}
@media screen and (max-width: 991px) {
  .witb__grid { grid-template-columns: minmax(0, 1fr); }
}

/* Device callout image */
.witb__dev {
  position: relative;
  border: 1px solid rgb(0 0 0 / .1);
  border-radius: 24px;
  background: #fff;
  overflow: hidden;
  aspect-ratio: 1;
}
.witb__dev img,
.witb__dev-ph { width: 100%; height: 100%; object-fit: cover; display: block; }

/* Hotspot callouts */
.witb__co {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 8px;
  background: none; border: 0; padding: 0;
  cursor: pointer; font: inherit; color: #000;
}
.witb__co-dot {
  width: 12px; height: 12px;
  border-radius: 50%;
  background: #fff;
  border: 3px solid #111;
  box-shadow: 0 0 0 3px rgb(255 255 255 / .85);
  flex: none;
}
.witb__co-line { height: 1.5px; background: #111; width: 30px; flex: none; }
.witb__co-lbl {
  font: 600 12.5px/1 var(--font-heading);
  background: #fff;
  border: 1px solid #dcdcdc;
  border-radius: 999px;
  padding: 8px 13px;
  white-space: nowrap;
  box-shadow: 0 1px 4px rgb(0 0 0 / .06);
  transition: background .2s, color .2s;
}
.witb__co:hover .witb__co-lbl,
.witb__co:focus-visible .witb__co-lbl { background: #111; color: #fff; border-color: #111; }
.witb__co--left { flex-direction: row-reverse; }
.witb__co-l { font-style: normal; }
.witb__co-s { font-style: normal; display: none; }
@media screen and (max-width: 991px) {
  .witb__co-lbl  { font-size: 10.5px; padding: 6px 9px; }
  .witb__co-line { width: 14px; }
  .witb__co-dot  { width: 10px; height: 10px; border-width: 2.5px; }
  .witb__co-l    { display: none; }
  .witb__co-s    { display: inline; }
}

/* Right side column */
.witb__side {
  display: flex;
  flex-direction: column;
  gap: 18px;
  min-width: 0;
}

/* Tiles */
.witb__tiles {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8px;
}
@media screen and (max-width: 1199px) {
  .witb__tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media screen and (max-width: 991px) {
  .witb__tiles { grid-template-columns: repeat(5, minmax(0, 1fr)); }
}
@media screen and (max-width: 599px) {
  .witb__tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

.witb__tile {
  border: 1px solid rgb(0 0 0 / .1);
  border-radius: 16px;
  background: #fff;
  display: flex; flex-direction: column;
  padding: 0; text-align: left; font: inherit; color: #000; overflow: hidden;
}
.witb__tile--link { cursor: pointer; transition: transform .2s, box-shadow .2s; }
.witb__tile--link:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgb(0 0 0 / .08); }

.witb__tile-img {
  display: grid; place-items: center;
  aspect-ratio: 1; background: #fff; padding: 12px;
}
.witb__tile-img img,
.witb__tile-ph { width: 100%; height: 100%; object-fit: contain; display: block; }

.witb__tile-cap {
  display: flex; flex-direction: column; gap: 1px;
  padding: 8px 10px 9px; border-top: 1px solid #eee;
}
.witb__tile-cap b { font: 700 11.5px/1.3 var(--font-heading); color: #000 !important; text-wrap: balance; }
.witb__tile-cap i { font: 600 11.5px var(--font-heading); font-style: normal; color: #8a8a8a; white-space: nowrap; }
@media screen and (max-width: 991px) {
  .witb__tile-cap { padding: 8px 9px; }
  .witb__tile-cap b { font-size: 11px; }
}

/* List */
.witb__list {
  list-style: none; margin: 0; padding: 0;
  border-bottom: 1px solid rgb(0 0 0 / .1);
}
.witb__list li {
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr);
  gap: 10px; padding: 16px 0;
  border-top: 1px solid rgb(0 0 0 / .1);
  font-size: 15px; line-height: 22px; color: rgb(0 0 0 / .7);
}
@media screen and (max-width: 749px) {
  .witb__list li { padding: 13px 0; }
}
.witb__list em { font-style: normal; font-weight: 700; color: var(--palette-sand, #c8943a); }
.witb__list b  { color: #000; font-weight: 600; }
.witb__list-note { color: rgb(0 0 0 / .5); }

/* Footer hint */
.witb__hint { text-align: center; color: #8a8a8a; font-size: 13px; margin: 14px 0 0; }

/* ── Simple info popup ── */
.witb__pop {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgb(0 0 0 / .45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}
.witb__pop[hidden] { display: none !important; }

.witb__pop-box {
  background: #fff;
  border-radius: 24px;
  max-width: 420px;
  width: 100%;
  padding: 28px;
  position: relative;
}

.witb__pop-x {
  position: absolute;
  right: 14px; top: 14px;
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 1px solid rgb(0 0 0 / .12);
  background: #fff;
  font-size: 18px;
  cursor: pointer;
  display: grid;
  place-items: center;
  line-height: 1;
}
.witb__pop-x:hover { background: rgb(0 0 0 / .05); }

.witb__pop-img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: contain;
  background: #faf8f4;
  border: 1px solid rgb(0 0 0 / .08);
  border-radius: 16px;
  margin: 0 0 18px;
}
.witb__pop-img[hidden] { display: none !important; }

.witb__pop-eye {
  font: 600 12px/1 var(--font-heading);
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #8a8a8a;
  margin: 0 0 10px;
}
.witb__pop-title {
  font-family: var(--font-accent);
  font-weight: var(--font-weight-heavy);
  font-size: 24px;
  line-height: 1.2;
  letter-spacing: -0.02em;
  margin: 0 0 8px;
}
.witb__pop-desc {
  margin: 0;
  color: rgb(0 0 0 / .72);
  font-size: 15px;
  line-height: 24px;
}
.witb__pop-desc p { margin: 0 0 8px; }
.witb__pop-desc p:last-child { margin-bottom: 0; }
.witb__pop-desc strong { font-weight: var(--font-weight-semibold); }
.witb__pop-desc ul, .witb__pop-desc ol { padding-left: 20px; margin: 0 0 8px; }
.witb__pop-desc li { margin-bottom: 4px; }
{% endstylesheet %}

{% javascript %}
(function () {
  var sectionEl = document.querySelector('.enso-witb[data-sid]');
  if (!sectionEl) return;

  /* ── Simple info popup ── */
  var pop      = sectionEl.querySelector('.witb__pop');
  var popImg   = pop && pop.querySelector('.witb__pop-img');
  var popTitle = pop && pop.querySelector('.witb__pop-title');
  var popDesc  = pop && pop.querySelector('.witb__pop-desc');
  var popX     = pop && pop.querySelector('.witb__pop-x');
  var lastFocus = null;

  function openSimplePop(btn) {
    var img   = btn.dataset.popImg   || '';
    var title = btn.dataset.popTitle || '';
    var descTpl = sectionEl.querySelector('[data-pop-desc-for="' + btn.dataset.witbId + '"]');
    popTitle.textContent = title;
    popDesc.innerHTML = descTpl ? descTpl.innerHTML : '';
    if (img) {
      popImg.src    = img;
      popImg.alt    = title;
      popImg.hidden = false;
    } else {
      popImg.hidden = true;
    }
    lastFocus = document.activeElement;
    pop.hidden = false;
    document.body.style.overflow = 'hidden';
    if (popX) popX.focus();
  }

  function closePop() {
    pop.hidden = true;
    document.body.style.overflow = '';
    if (lastFocus) lastFocus.focus();
  }

  if (pop) {
    popX.addEventListener('click', closePop);
    pop.addEventListener('click', function (e) { if (e.target === pop) closePop(); });
  }
  document.addEventListener('keydown', function (e) {
    if (pop && !pop.hidden && e.key === 'Escape') closePop();
  });

  /* ── Product popup (tiles with linked product) ── */
  function openFromTemplate(tpl) {
    if (!tpl) return;
    var d        = tpl.dataset;
    var imgs     = Array.from(tpl.content.querySelectorAll('img'));
    var images   = imgs.map(function (img) { return { src: img.src, alt: img.alt }; });
    var headlineEl = tpl.content.querySelector('.witb-d-headline');
    var whatEl     = tpl.content.querySelector('.witb-d-what');
    var varEl      = tpl.content.querySelector('.witb-d-variants');
    var varSpans   = varEl ? Array.from(varEl.querySelectorAll('[data-vid]')) : [];
    var variants   = varSpans.length > 1 ? varSpans.map(function (vs) {
      return { vid: vs.dataset.vid, price: vs.dataset.price, available: vs.dataset.available, title: vs.textContent.trim() };
    }) : [];
    document.dispatchEvent(new CustomEvent('product:popup', {
      bubbles: true,
      detail: {
        title:     d.title    || '',
        fits:      d.fits     || '',
        price:     d.price    || '',
        available: d.available !== 'false',
        vid:       d.vid      || '',
        url:       d.url      || '',
        images:    images,
        headline:  headlineEl ? headlineEl.innerHTML : '',
        shortdesc: whatEl     ? whatEl.innerHTML     : '',
        variants:  variants
      }
    }));
  }

  /* ── Click routing ── */
  sectionEl.querySelectorAll('[data-witb-id]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      /* Callout hotspots → always simple popup */
      if (btn.classList.contains('witb__co')) {
        if (pop) openSimplePop(btn);
        return;
      }
      /* Tiles: popup data → simple popup; product → product popup */
      if (btn.dataset.popTitle && pop) {
        openSimplePop(btn);
        return;
      }
      openFromTemplate(document.getElementById('witb-tpl-' + btn.dataset.witbId));
    });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "ENSO in the box",
  "tag": "div",
  "settings": [
    { "type": "text",         "id": "eyebrow",            "label": "Eyebrow",                    "default": "What is in the box" },
    { "type": "text",         "id": "heading",            "label": "Heading",                    "default": "Everything to start a session" },
    { "type": "image_picker", "id": "device_image",       "label": "Device callout image" },
    { "type": "text",         "id": "hint_text",          "label": "Hint text",                  "default": "Tap a part to see what it is. The wall adapter is not included." },
    { "type": "text",         "id": "default_fits_label", "label": "Default Fits label",          "default": "Fits ENSO 2026 Edition" },
    { "type": "header",       "content": "Section spacing" },
    { "type": "range", "id": "padding_top",           "label": "Padding top — desktop",   "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom",        "label": "Padding bottom — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_top_mobile",    "label": "Padding top — mobile",    "min": 0, "max": 80,  "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom — mobile", "min": 0, "max": 80,  "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Hotspot",
      "settings": [
        { "type": "text",         "id": "label",        "label": "Label (desktop)" },
        { "type": "text",         "id": "label_short",  "label": "Label (mobile short)" },
        { "type": "range",        "id": "pos_x",        "label": "Horizontal % (from left)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range",        "id": "pos_y",        "label": "Vertical % (from top)",    "min": 0, "max": 100, "step": 1, "unit": "%", "default": 10 },
        { "type": "checkbox",     "id": "align_left",   "label": "Label on left side",       "default": false },
        { "type": "header",       "content": "Popup content" },
        { "type": "image_picker", "id": "popup_image",  "label": "Popup image" },
        { "type": "richtext",     "id": "popup_desc",   "label": "Popup description" }
      ]
    },
    {
      "type": "tile",
      "name": "Accessory tile",
      "settings": [
        { "type": "product",      "id": "product",      "label": "Product (opens product sheet on click)" },
        { "type": "image_picker", "id": "image",        "label": "Override image" },
        { "type": "text",         "id": "name",         "label": "Name" },
        { "type": "text",         "id": "quantity",     "label": "Quantity (e.g. 1×)" },
        { "type": "text",         "id": "fits_label",   "label": "Override Fits label" },
        { "type": "header",       "content": "Info popup (overrides product sheet)" },
        { "type": "image_picker", "id": "popup_image",  "label": "Popup image" },
        { "type": "text",         "id": "popup_title",  "label": "Popup title (defaults to name)" },
        { "type": "richtext",     "id": "popup_desc",   "label": "Popup description" }
      ]
