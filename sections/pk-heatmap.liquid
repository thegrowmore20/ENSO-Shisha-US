{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
<div class="pk-sec">
  <h2>Mix in layers</h2>
  <div class="pk-heatmap">
    {%- render 'mix-layers-schema' -%}
    <div>
      <p class="pk-lead" style="margin:0">Diamond heats the cup from the sides and from below at the same time; the tobacco at the bottom gets it most. So the bottom layer is your main flavor and opens first, and the top layer is the accent that comes through as the cup warms. Two flavors are plenty.</p>
    </div>
  </div>
  <p class="pk-note">Most people smoke one flavor, and that is fine. With two, keep the stronger one below as the main flavor.</p>
</div>

{% stylesheet %}
.pk-heatmap {
  display: grid;
  grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
  gap: 32px;
  align-items: center;
  margin: 0 0 20px;
}
.pk-heatmap svg { width: 100%; height: auto; }
.pk-heatmap .hu { animation: pk-hu 1.6s ease-in-out infinite; }
.pk-heatmap .hl { animation: pk-hl 1.6s ease-in-out infinite; }
.pk-heatmap .hr { animation: pk-hr 1.6s ease-in-out infinite; }
.pk-heatmap .hu:nth-child(2) { animation-delay: .25s; }
.pk-heatmap .hu:nth-child(3) { animation-delay: .5s; }
@keyframes pk-hu { 0% { transform: translateY(8px); opacity: 0; } 40% { opacity: 1; } 100% { transform: translateY(-24px); opacity: 0; } }
@keyframes pk-hl { 0% { transform: translateX(-8px); opacity: 0; } 40% { opacity: 1; } 100% { transform: translateX(14px); opacity: 0; } }
@keyframes pk-hr { 0% { transform: translateX(8px); opacity: 0; } 40% { opacity: 1; } 100% { transform: translateX(-14px); opacity: 0; } }
@media (prefers-reduced-motion: reduce) {
  .pk-heatmap .hu, .pk-heatmap .hl, .pk-heatmap .hr { animation: none; }
}
@media screen and (max-width: 767px) {
  .pk-heatmap { grid-template-columns: 1fr; }
  .pk-heatmap svg { max-width: 400px; margin: 0 auto; display: block; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "PK: Mix in layers",
  "presets": [{ "name": "PK: Mix in layers" }],
  "settings": [
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top padding (mobile)", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom padding (mobile)", "default": 40 }
  ]
}
{% endschema %}
