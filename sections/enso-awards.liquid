{%- doc -%}
  World-class performance and design — awards section.
  Two-column grid: left = square product photo; right = list of award items.
  Matches handoff section #enso-awards.
{%- enddoc -%}

{% style %}
  #section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    #section-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section id="section-{{ section.id }}" class="enso-awards-section" aria-labelledby="awards-heading-{{ section.id }}">
  <div class="enso-awards__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="enso-awards__heading" id="awards-heading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    <div class="enso-awards__grid">
      <figure class="enso-awards__img">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              widths: '450, 600, 900',
              sizes: '(max-width: 991px) 100vw, 50vw',
              alt: section.settings.image.alt | default: section.settings.heading,
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'enso-awards__placeholder' }}
        {%- endif -%}
      </figure>

      {%- if section.blocks.size > 0 -%}
        <ul class="enso-awards__list">
          {%- for block in section.blocks -%}
            <li class="enso-awards__item" {{ block.shopify_attributes }}>
              <div class="enso-awards__logo-wrap">
                {%- if block.settings.logo != blank -%}
                  {{
                    block.settings.logo
                    | image_url: width: 144
                    | image_tag:
                      widths: '72, 144',
                      sizes: '72px',
                      class: 'enso-awards__logo',
                      alt: block.settings.logo.alt | default: block.settings.title,
                      loading: 'lazy',
                      width: 72,
                      height: 72
                  }}
                {%- else -%}
                  <div class="enso-awards__logo-placeholder" aria-hidden="true"></div>
                {%- endif -%}
              </div>
              <div class="enso-awards__text">
                {%- if block.settings.title != blank -%}
                  <h3 class="enso-awards__item-heading">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="enso-awards__item-body">{{ block.settings.body | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .enso-awards__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .enso-awards__heading {
    text-align: center;
    font-family: var(--font-accent);
    font-weight: var(--font-weight-semibold);
    font-size: 40px;
    line-height: 46px;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0 0 48px;
  }

  .enso-awards__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .enso-awards__img {
    margin: 0;
    aspect-ratio: 1;
    border-radius: 22px;
    overflow: hidden;
    background: #e9e4dc;
  }

  .enso-awards__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .enso-awards__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.25;
  }

  .enso-awards__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .enso-awards__item {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    padding: 32px 0;
  }

  .enso-awards__item + .enso-awards__item {
    border-top: 1px solid rgb(0 0 0 / 0.1);
  }

  .enso-awards__item:first-child { padding-top: 0; }
  .enso-awards__item:last-child { padding-bottom: 0; }

  .enso-awards__logo {
    width: 72px;
    height: 72px;
    object-fit: contain;
    display: block;
  }

  .enso-awards__logo-placeholder {
    width: 72px;
    height: 72px;
    background: rgb(0 0 0 / 0.08);
    border-radius: 12px;
  }

  .enso-awards__item-heading {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    font-size: 24px;
    line-height: 30px;
    text-wrap: balance;
    margin: 0 0 8px;
  }

  .enso-awards__item-body {
    font-size: 15px;
    line-height: 24px;
    color: rgb(0 0 0 / 0.66);
    text-wrap: pretty;
    margin: 0;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 991px) {
    .enso-awards__inner {
      padding: 0 16px;
    }

    .enso-awards__heading {
      font-size: 28px;
      line-height: 34px;
      margin-bottom: 28px;
    }

    .enso-awards__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .enso-awards__item {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 18px;
      padding: 24px 0;
    }

    .enso-awards__logo {
      width: 56px;
      height: 56px;
    }

    .enso-awards__item-heading {
      font-size: 20px;
      line-height: 26px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.enso_awards.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.enso_awards.settings.heading.label",
      "default": "World-class performance and design"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.enso_awards.settings.image.label"
    },
    {
      "type": "header",
      "content": "t:sections.enso_awards.settings.padding_header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.enso_awards.settings.padding_top.label",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.enso_awards.settings.padding_bottom.label",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.enso_awards.settings.padding_top_mobile.label",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.enso_awards.settings.padding_bottom_mobile.label",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24
    }
  ],
  "blocks": [
    {
      "type": "award",
      "name": "t:sections.enso_awards.blocks.award.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.enso_awards.blocks.award.settings.logo.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.enso_awards.blocks.award.settings.title.label",
          "default": "Award name"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "t:sections.enso_awards.blocks.award.settings.body.label",
          "default": "Award description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.enso_awards.presets.name",
      "blocks": [
        {
          "type": "award",
          "settings": {
            "title": "Best Hookah, ShishaMesse 2025",
            "body": "Named Best Hookah at ShishaMesse 2025 in Frankfurt: a modern alternative to the traditional setup, with clean electric heat, premium design and a refined session."
          }
        },
        {
          "type": "award",
          "settings": {
            "title": "Red Dot Design Award 2026",
            "body": "A Red Dot in Product Design, an outside confirmation of the direction the brand has held from day one: a modern, international object made around the ritual."
          }
        }
      ]
    }
  ]
}
{% endschema %}
