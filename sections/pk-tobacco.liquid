{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
<div class="pk-sec">
  <h2>By tobacco</h2>
  <div class="pk-cards">
    <article>
      {%- if section.settings.img_virginia != blank -%}
        {{- section.settings.img_virginia | image_url: width: 800 | image_tag: loading: 'lazy', class: 'pk-cardimg', alt: section.settings.img_virginia.alt | default: 'A cup packed with blonde leaf tobacco', width: section.settings.img_virginia.width, height: section.settings.img_virginia.height -}}
      {%- endif -%}
      <h3>Virginia, blonde leaf</h3>
      <p class="pk-eg">Starline, Fumari, Adalya</p>
      <p>Pre-heat 7 minutes at about 255 °C, then turn it down as the session goes.</p>
      <p class="pk-tip">Very minty or perfumed blends: less heat, around 235 °C, and let the cup open up over time.</p>
    </article>
    <article>
      {%- if section.settings.img_dark != blank -%}
        {{- section.settings.img_dark | image_url: width: 800 | image_tag: loading: 'lazy', class: 'pk-cardimg', alt: section.settings.img_dark.alt | default: 'A cup packed with dark leaf tobacco', width: section.settings.img_dark.width, height: section.settings.img_dark.height -}}
      {%- endif -%}
      <h3>Burley, dark leaf</h3>
      <p class="pk-eg">Darkside, MustHave, BlackBurn</p>
      <p>Pack it airy in the basket mesh. Pre-heat 7 minutes, like every blend; the strongest like it at up to 290 °C.</p>
      <p class="pk-tip">Try Oracle, the fourth profile.</p>
    </article>
  </div>
</div>

{% stylesheet %}
.pk-cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}
.pk-cards article {
  border: 1.5px solid rgb(0 0 0 / .1);
  border-radius: 22px;
  padding: 20px 22px;
}
.pk-cards h3 {
  font-size: 20px;
  line-height: 26px;
  font-family: var(--font-accent);
  font-weight: var(--font-weight-heavy);
  margin: 0 0 6px;
}
.pk-cards p {
  margin: 0 0 10px;
  font-size: 15.5px;
  line-height: 24px;
  color: rgb(0 0 0 / .76);
}
.pk-cardimg {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  border-radius: 14px;
  margin: -6px 0 14px;
  background: #f5f5f4;
  display: block;
}
.pk-eg {
  font-size: 13px;
  line-height: 18px;
  font-weight: 600;
  color: #8a5d17;
  margin: 0 0 10px;
}
.pk-tip {
  background: #f5f5f4;
  border-radius: 12px;
  padding: 10px 12px;
  font-size: 14px;
  line-height: 21px;
  margin: 0;
}
@media screen and (max-width: 767px) {
  .pk-cards { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "PK: By tobacco",
  "presets": [{ "name": "PK: By tobacco" }],
  "settings": [
    { "type": "image_picker", "id": "img_virginia", "label": "Virginia card image" },
    { "type": "image_picker", "id": "img_dark", "label": "Dark leaf card image" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top padding (mobile)", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom padding (mobile)", "default": 40 }
  ]
}
{% endschema %}
