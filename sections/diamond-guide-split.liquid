{% stylesheet %}

.dg-split {
  /* outer wrapper — no border or padding; both live on .dg-split__inner */
}

.dg-split__inner {
  padding: 96px 0;
  border-top: 1px solid var(--color-border);
}

.dg-split__grid {
  display: grid;
  grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
  gap: 64px;
  align-items: center;
}

.dg-split--img-right .dg-split__media {
  order: 2;
}
.dg-split--img-right .dg-split__copy {
  order: 1;
}

.dg-split__media {
  aspect-ratio: 4 / 5;
  border-radius: 28px;
  overflow: hidden;
  line-height: 0;
  max-width: 520px;
  justify-self: center;
  width: 100%;
}

.dg-split__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.dg-split__placeholder {
  width: 100%;
  aspect-ratio: 4 / 5;
  display: block;
  border-radius: 28px;
}

.dg-split__eyebrow {
  margin: 0 0 10px;
  font-size: 13px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.dg-split__h {
  font-family: var(--font-accent);
  font-weight: 800;
  font-size: 44px;
  line-height: 50px;
  letter-spacing: -.025em;
  margin: 0 0 16px;
  text-wrap: balance;
}

.dg-split__body {
  font-size: 15px;
  line-height: 1.6;
  color: rgb(0 0 0 / .72);
  margin: 0;
}

.dg-split__steps {
  list-style: none;
  counter-reset: s;
  margin: 28px 0 0;
  padding: 0;
  display: grid;
  gap: 16px;
}

.dg-split__steps li {
  counter-increment: s;
  display: grid;
  grid-template-columns: 36px 1fr;
  column-gap: 14px;
}

.dg-split__steps li::before {
  content: counter(s);
  grid-row: span 2;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--color-border);
  display: grid;
  place-items: center;
  font-size: 13px;
  font-weight: 700;
}

.dg-split__steps b {
  font-size: 17px;
  font-weight: var(--font-weight-semibold);
}

.dg-split__steps span {
  font-size: 15px;
  line-height: 23px;
  color: rgb(0 0 0 / .72);
}

.dg-split__note {
  margin-top: 16px;
  font-size: 14px;
  color: rgb(0 0 0 / .55);
  font-style: normal;
}

@media screen and (max-width: 991px) {
  .dg-split { padding: 64px 0; }
  .dg-split__grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .dg-split__media { order: 1 !important; }
  .dg-split__copy  { order: 2 !important; }
  .dg-split__h {
    font-size: 30px;
    line-height: 36px;
  }
}

{% endstylesheet %}

{% style %}
  #shopify-section-{{ section.id }} .dg-split__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    #shopify-section-{{ section.id }} .dg-split__inner {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

{%- liquid
  assign img_right = false
  if section.settings.image_side == 'right'
    assign img_right = true
  endif
-%}

<section class="dg-split{% if img_right %} dg-split--img-right{% endif %}" id="{{ section.settings.section_id | default: section.id }}">
  <div class="container">
    <div class="dg-split__inner">
    <div class="dg-split__grid">

      <div class="dg-split__media">
        {%- if section.settings.image != blank -%}
          {{- section.settings.image | image_url: width: 900 | image_tag:
            alt: section.settings.image.alt | default: section.settings.heading,
            loading: 'lazy',
            widths: '600,900',
            sizes: '(max-width: 991px) 100vw, 50vw'
          -}}
        {%- else -%}
          <svg class="dg-split__placeholder" viewBox="0 0 4 3" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="4" height="3" fill="#f0ede8"/>
            <path d="M1.6 1.5 L2 0.9 L2.4 1.5 M1.75 1.5 L2.25 1.5 M2 1.5 L2 2.1" stroke="#c8b89a" stroke-width="0.08" stroke-linecap="round"/>
          </svg>
        {%- endif -%}
      </div>

      <div class="dg-split__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow dg-split__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 class="dg-split__h">{{ section.settings.heading | escape }}</h2>

        {%- if section.settings.body != blank -%}
          <p class="dg-split__body">{{ section.settings.body | escape }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ol class="dg-split__steps">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <b>{{ block.settings.label | escape }}</b>
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="dg-split__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>

    </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.diamond_guide_split.name",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "t:sections.diamond_guide_split.settings.section_id.label",
      "info": "t:sections.diamond_guide_split.settings.section_id.info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.diamond_guide_split.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "t:sections.diamond_guide_split.settings.image_side.label",
      "options": [
        { "value": "left",  "label": "t:sections.diamond_guide_split.settings.image_side.options.left" },
        { "value": "right", "label": "t:sections.diamond_guide_split.settings.image_side.options.right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.diamond_guide_split.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_guide_split.settings.heading.label",
      "default": "Section heading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:sections.diamond_guide_split.settings.body.label"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "t:sections.diamond_guide_split.settings.note.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.diamond_guide_split.blocks.step.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.diamond_guide_split.blocks.step.settings.label.label",
          "default": "Step label"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.diamond_guide_split.blocks.step.settings.text.label"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:sections.diamond_guide_split.presets.name"
    }
  ]
}
{% endschema %}
