          "type": "header",
          "content": "t:sections.diamond_quick_start.blocks.step.settings.images_heading"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "t:sections.diamond_quick_start.blocks.step.settings.image_1.label"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "t:sections.diamond_quick_start.blocks.step.settings.image_2.label"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "t:sections.diamond_quick_start.blocks.step.settings.image_3.label"
        },
        {
          "type": "image_picker",
          "id": "image_4",
