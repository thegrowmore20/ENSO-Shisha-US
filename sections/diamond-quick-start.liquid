{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{%- liquid
  assign back_url   = section.settings.back_url   | default: '/pages/enso-experience'
  assign back_label = section.settings.back_label | default: 'ENSŌ Experience'
  assign dev_label  = section.settings.device_label | default: 'ENSŌ Diamond'
-%}

<div class="qs-wrap">

  <nav class="xnav" aria-label="{{ dev_label }} guides">
    <a class="xnav__back" href="{{ back_url }}">
      ‹ {{ back_label }} <span aria-hidden="true">/</span> <b>{{ dev_label }}</b>
    </a>
  </nav>

  <section class="qs__hero" aria-labelledby="QsH-{{ section.id }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 id="QsH-{{ section.id }}">{{ section.settings.heading | default: 'Quick start' }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.safety_note != blank -%}
      <p class="qs__rule">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 3c3 4 5 6.5 5 9.5a5 5 0 0 1-10 0C7 9.5 9 7 12 3z"/>
          <path d="M4 4l16 16"/>
        </svg>
        {{ section.settings.safety_note }}
      </p>
    {%- endif -%}
  </section>

  {%- if section.blocks.size > 0 -%}
    <ol class="qs">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img_count = 0
          if block.settings.image_1 != blank
            assign img_count = img_count | plus: 1
          endif
          if block.settings.image_2 != blank
            assign img_count = img_count | plus: 1
          endif
          if block.settings.image_3 != blank
            assign img_count = img_count | plus: 1
          endif
          if block.settings.image_4 != blank or block.settings.use_device_screen
            assign img_count = img_count | plus: 1
          endif
          assign has_images = false
          if img_count > 0
            assign has_images = true
          endif
          if block.settings.use_pack_level
            assign has_images = true
          endif
        -%}
        <li class="qs__s" id="{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="qs__tx">
            <span class="qs__n" aria-hidden="true">{{ forloop.index }}</span>
            <h2>{{ block.settings.heading }}</h2>
            {%- if block.settings.body != blank -%}
              <p>{{ block.settings.body }}</p>
            {%- endif -%}
          </div>

          {%- if has_images -%}
            {%- if block.settings.use_pack_level -%}
              <div class="qs__pic">
                {%- if block.settings.pack_level_variant == 'flat' -%}
                  <picture><source media="(max-width:749px)" srcset="{{ 'pack-level-m.webp' | file_url }}"><img src="{{ 'pack-level.webp' | file_url }}" alt="Flat screen cup filled to the curve of the cup" loading="lazy" style="width:100%;height:100%;object-fit:cover"></picture>
                {%- else -%}
                  <picture><source media="(max-width:749px)" srcset="{{ 'pack-level-basket-m.webp' | file_url }}"><img src="{{ 'pack-level-basket.webp' | file_url }}" alt="Basket mesh filled to the edge of the basket" loading="lazy" style="width:100%;height:100%;object-fit:cover"></picture>
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="qs__pic qs__pic--seq">
                <div class="qs__track" aria-label="{{ block.settings.heading }} — step images">
                  {%- if block.settings.image_1 != blank -%}
                    {{- block.settings.image_1 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 600px, 100vw', alt: block.settings.heading -}}
                  {%- endif -%}
                  {%- if block.settings.image_2 != blank -%}
                    {{- block.settings.image_2 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 600px, 100vw', alt: block.settings.heading -}}
                  {%- endif -%}
                  {%- if block.settings.image_3 != blank -%}
                    {{- block.settings.image_3 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 600px, 100vw', alt: block.settings.heading -}}
                  {%- endif -%}
                  {%- if block.settings.use_device_screen -%}
                    {%- liquid
                      if block.settings.device_bg != blank
                        assign dev_bg_src = block.settings.device_bg | image_url: width: 900
                        assign dev_bg_tag = block.settings.device_bg | image_url: width: 900 | image_tag: loading: 'lazy', alt: ''
                      else
                        assign dev_bg_src = 'closed-start.webp' | file_url
                        assign dev_bg_tag = nil
                      endif
                    -%}
                    <div class="qs__mac">
                      <div class="mac">
                        <div class="dev">
                          {%- if block.settings.device_bg != blank -%}
                            {{- dev_bg_tag -}}
                          {%- else -%}
                            <img src="{{ dev_bg_src }}" alt="" loading="lazy">
                          {%- endif -%}
                          <div class="lv" data-qs-scene="{{ block.settings.device_scene | default: 'level' }}" role="img" aria-label="{{ block.settings.heading }}"></div>
                        </div>
                        <span class="finger" aria-hidden="true"></span>
                      </div>
                    </div>
                  {%- elsif block.settings.image_4 != blank -%}
                    {%- if block.settings.image_4_contain -%}
                      {{- block.settings.image_4 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 600px, 100vw', alt: block.settings.heading, style: 'object-fit:contain;background:#fff' -}}
                    {%- else -%}
                      {{- block.settings.image_4 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 600px, 100vw', alt: block.settings.heading -}}
                    {%- endif -%}
                  {%- endif -%}
                </div>
                {%- if img_count > 1 -%}
                  <div class="qs__dots" aria-hidden="true">
                    {%- assign dot_first = true -%}
                    {%- if block.settings.image_1 != blank -%}<i{% if dot_first %} class="on"{% endif %}></i>{%- assign dot_first = false -%}{%- endif -%}
                    {%- if block.settings.image_2 != blank -%}<i{% if dot_first %} class="on"{% endif %}></i>{%- assign dot_first = false -%}{%- endif -%}
                    {%- if block.settings.image_3 != blank -%}<i{% if dot_first %} class="on"{% endif %}></i>{%- assign dot_first = false -%}{%- endif -%}
                    {%- if block.settings.image_4 != blank or block.settings.use_device_screen -%}<i{% if dot_first %} class="on"{% endif %}></i>{%- assign dot_first = false -%}{%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  {%- endif -%}

  {%- unless section.settings.hide_footer -%}
    {%- if section.settings.more_url != blank -%}
      <p class="qs__more">
        <a href="{{ section.settings.more_url }}">{{ section.settings.more_label | default: 'Read more in the full manual ›' }}</a>
        {%- if section.settings.more_note != blank -%}
          <span>{{ section.settings.more_note }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    <div class="cl-back">
      <a href="{{ back_url }}">‹ Back to {{ back_label }}</a>
    </div>
  {%- endunless -%}

</div>

{% stylesheet %}
  .qs-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Breadcrumb nav */
  .xnav { padding: 18px 0 0; }
  .xnav__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: rgba(0,0,0,.6);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }
  .xnav__back:hover { color: var(--color-text); }
  .xnav__back b { color: var(--color-text); font-weight: var(--font-weight-bold); }

  /* Hero */
  .qs__hero {
    padding: 48px 0 24px;
    max-width: 720px;
  }
  .qs__hero .eyebrow {
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: .08em;
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    margin: 0 0 8px;
  }
  .qs__hero h1 {
    font-family: var(--font-accent);
    font-size: 48px;
    line-height: 52px;
    letter-spacing: -.02em;
    font-weight: var(--font-weight-heavy);
    margin: 0 0 12px;
    color: var(--color-text);
  }
  .qs__hero > p {
    margin: 0;
    font-size: 17px;
    line-height: 27px;
    color: rgba(0,0,0,.72);
  }

  /* Safety rule */
  .qs__rule {
    margin-top: 16px !important;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px !important;
    line-height: 20px !important;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text) !important;
  }
  .qs__rule svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--palette-sand, #c8943a);
    stroke-width: 1.8;
    stroke-linecap: round;
    flex: none;
  }

  /* Steps list */
  .qs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .qs__s {
    display: grid;
    grid-template-columns: minmax(0,1fr) minmax(0,1.15fr);
    gap: 40px;
    align-items: center;
    background: var(--palette-mist, #F5F5F4);
    border-radius: 28px;
    padding: 28px 28px 28px 40px;
  }

  /* Step text */
  .qs__n {
    display: inline-block;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-background);
    font-family: var(--font-accent);
    font-size: 17px;
    line-height: 40px;
    font-weight: var(--font-weight-heavy);
    text-align: center;
    margin-bottom: 16px;
  }
  .qs__tx h2 {
    font-family: var(--font-accent);
    font-size: 34px;
    line-height: 40px;
    letter-spacing: -.02em;
    font-weight: var(--font-weight-heavy);
    margin: 0 0 10px;
    color: var(--color-text);
  }
  .qs__tx p {
    margin: 0;
    font-size: 17px;
    line-height: 27px;
    color: rgba(0,0,0,.74);
    max-width: 40ch;
  }

  /* Image carousel */
  .qs__pic {
    position: relative;
    aspect-ratio: 5/4;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
  }
  .qs__track {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .qs__track::-webkit-scrollbar { display: none; }
  .qs__track img {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #fff;
    scroll-snap-align: center;
  }
  .qs__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 7px;
    pointer-events: none;
  }
  .qs__dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(0,0,0,.18);
    cursor: pointer;
    pointer-events: auto;
    transition: all .2s;
  }
  .qs__dots i.on {
    background: #000;
    width: 22px;
    border-radius: 999px;
  }

  /* Animated device screen slide */
  .qs__mac{flex:0 0 100%;height:100%;scroll-snap-align:center;position:relative}
  .qs__mac .mac{position:absolute;inset:0;aspect-ratio:auto;overflow:hidden;background:#fff}
  .qs__mac .mac .dev{position:absolute;width:330%;max-width:none;left:50%;top:50%;transform:translate(-50.17%,-57.6%);margin:0}
  .qs__mac .mac .dev>img{width:100%;height:auto;object-fit:initial;background:none;display:block}
  .qs__mac .lv{position:absolute;left:50.17%;top:57.6%;width:21.4%;transform:translate(-50%,-50%);aspect-ratio:1;border-radius:50%;background:#0a0a0c;box-shadow:none;max-width:none;container-type:inline-size;overflow:hidden;font-family:Inter,system-ui,sans-serif;color:#f0e8d8}
  .qs__mac .lv__s{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;opacity:0;transition:opacity .22s}
  .qs__mac .lv__s.on{opacity:1}
  .qs__mac .lv__bat{position:absolute;left:0;right:0;top:15.5%;text-align:center;font:500 3.9cqw/1 Inter,sans-serif;letter-spacing:.01em;display:flex;align-items:center;justify-content:center;gap:.8cqw}
  .qs__mac .lv__bat svg{width:2.6cqw;height:3.6cqw;fill:#e2614c}
  .qs__mac .t-big{font:700 15.6cqw/1.08 Inter,sans-serif;font-variant-numeric:tabular-nums}
  .qs__mac .t-cap{font:500 2.9cqw/1 Inter,sans-serif;letter-spacing:.14em;color:#a6a39b;margin-top:2.6cqw;text-transform:uppercase}
  .qs__mac .finger{display:none}
  @media (prefers-reduced-motion:reduce){.qs__mac .lv__s,.qs__mac .lv{transition:none}}

  /* Manual link */
  .qs__more {
    display: grid;
    gap: 4px;
    margin: 32px 0 64px;
  }
  .qs__more a {
    font-family: var(--font-accent);
    font-size: 20px;
    line-height: 26px;
    font-weight: var(--font-weight-heavy);
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px solid var(--palette-sand, #c8943a);
    justify-self: start;
    padding-bottom: 2px;
  }
  .qs__more a:hover { border-bottom-color: var(--color-text); }
  .qs__more span {
    font-size: 15px;
    color: rgba(0,0,0,.55);
  }

  /* Back link */
  .cl-back {
    padding: 0 0 8px;
  }
  .cl-back a {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 16px;
    line-height: 22px;
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px solid var(--palette-sand, #c8943a);
    padding-bottom: 2px;
  }
  .cl-back a:hover { border-bottom-color: var(--color-text); }

  /* Tablet / Mobile layout */
  @media screen and (max-width: 991px) {
    .qs__s {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 20px 16px;
      border-radius: 22px;
    }
    .qs__pic { aspect-ratio: 4/5; }
  }

  /* Mobile only */
  @media screen and (max-width: 749px) {
    .qs-wrap { padding: 0 16px; }
    .xnav { padding: 14px 0 0; }
    .qs__hero { padding: 28px 0 16px; }
    .qs__hero h1 { font-size: 36px; line-height: 40px; }
    .qs__tx h2 { font-size: 26px; line-height: 32px; }
    .qs__tx p { font-size: 16px; line-height: 24px; }
    .qs__n { width: 34px; height: 34px; font-size: 15px; line-height: 34px; margin-bottom: 10px; }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.qs__pic--seq').forEach(function(pic) {
    if (pic.dataset.bound) return;
    pic.dataset.bound = '1';

    const track = pic.querySelector('.qs__track');
    const dots = pic.querySelectorAll('.qs__dots i');
    if (!track) return;

    function updateDots() {
      if (!dots.length) return;
      const index = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach(function(dot, i) { dot.classList.toggle('on', i === index); });
      pic.querySelectorAll('.qs__caps span').forEach(function(cap, i) {
        cap.classList.toggle('on', i === index);
      });
    }

    track.addEventListener('scroll', updateDots, { passive: true });

    dots.forEach(function(dot, i) {
      dot.addEventListener('click', function() {
        track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
      });
    });

    // Mouse / trackpad drag
    // Disable scroll-snap during drag (Chromium snaps on programmatic scrollLeft),
    // restore via scrollend event or 400ms timeout after mouseup.
    let dragging = false;
    let startX = 0;
    let startScroll = 0;

    function snapToNearest() {
      const w = track.clientWidth;
      const index = Math.round(track.scrollLeft / w);
      track.scrollTo({ left: index * w, behavior: 'smooth' });
      // Re-enable snap once the scroll settles
      if ('onscrollend' in window) {
        track.addEventListener('scrollend', function restoreSnap() {
          track.style.scrollSnapType = '';
          track.removeEventListener('scrollend', restoreSnap);
          updateDots();
        });
      } else {
        setTimeout(function() {
          track.style.scrollSnapType = '';
          updateDots();
        }, 400);
      }
    }

    track.addEventListener('mousedown', function(e) {
      dragging = true;
      startX = e.clientX;
      startScroll = track.scrollLeft;
      track.style.cursor = 'grabbing';
      track.style.scrollSnapType = 'none';
      e.preventDefault();
    });

    window.addEventListener('mousemove', function(e) {
      if (!dragging) return;
      track.scrollLeft = startScroll - (e.clientX - startX);
    });

    window.addEventListener('mouseup', function() {
      if (!dragging) return;
      dragging = false;
      track.style.cursor = '';
      snapToNearest();
    });

    track.querySelectorAll('img').forEach(function(img) {
      img.addEventListener('dragstart', function(e) { e.preventDefault(); });
    });
  });

  // Inline battery-level animation for device-screen slides (data-qs-scene)
  (function() {
    var BAT = '<svg viewBox="0 0 60 30" style="width:24cqw;height:12cqw">'
      + '<rect x="1.5" y="1.5" width="51" height="27" rx="5" fill="none" stroke="#f0e8d8" stroke-width="3"/>'
      + '<rect x="55" y="9" width="4" height="12" rx="1.5" fill="#f0e8d8"/>'
      + '<rect x="6" y="6" width="42" height="18" rx="2" fill="#7eae82"/>'
      + '</svg><div class="t-big" style="margin-top:3cqw">100%</div>'
      + '<div class="t-cap">Battery</div>';

    function initLv(el) {
      if (el._lvInit) return;
      el._lvInit = true;
      el.innerHTML = '<div class="lv__s"></div><div class="lv__s">' + BAT + '</div>';
      var screens = el.querySelectorAll('.lv__s');
      var off = screens[0], bat = screens[1];
      var timer = null;
      function tick(phase) {
        clearTimeout(timer);
        if (phase === 0) {
          off.classList.add('on'); bat.classList.remove('on');
          timer = setTimeout(function() { tick(1); }, 1600);
        } else {
          bat.classList.add('on'); off.classList.remove('on');
          timer = setTimeout(function() { tick(0); }, 2400);
        }
      }
      el._lvStart = function() { if (timer !== null) return; tick(0); };
      el._lvPause = function() {
        clearTimeout(timer); timer = null;
        off.classList.remove('on'); bat.classList.remove('on');
      };
    }

    document.querySelectorAll('.qs__pic--seq').forEach(function(pic) {
      var track = pic.querySelector('.qs__track');
      if (!track) return;
      var mac = track.querySelector('.qs__mac');
      if (!mac) return;
      var lv = mac.querySelector('.lv[data-qs-scene]');
      if (!lv) return;
      var macIndex = Array.from(track.children).indexOf(mac);

      function checkLv() {
        var index = Math.round(track.scrollLeft / track.clientWidth);
        initLv(lv);
        if (index === macIndex) { lv._lvStart(); }
        else { lv._lvPause(); }
      }

      track.addEventListener('scroll', checkLv, { passive: true });
    });
  }());
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.diamond_quick_start.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.diamond_quick_start.settings.nav_heading"
    },
    {
      "type": "url",
      "id": "back_url",
      "label": "t:sections.diamond_quick_start.settings.back_url.label"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "t:sections.diamond_quick_start.settings.back_label.label",
      "default": "ENSŌ Experience"
    },
    {
      "type": "text",
      "id": "device_label",
      "label": "t:sections.diamond_quick_start.settings.device_label.label",
      "default": "ENSŌ Diamond"
    },
    {
      "type": "header",
      "content": "t:sections.diamond_quick_start.settings.hero_heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.diamond_quick_start.settings.eyebrow.label",
      "default": "ENSŌ Experience · Diamond"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_quick_start.settings.heading.label",
      "default": "Quick start"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.diamond_quick_start.settings.subheading.label",
      "default": "Your first session in five steps."
    },
    {
      "type": "text",
      "id": "safety_note",
      "label": "t:sections.diamond_quick_start.settings.safety_note.label",
      "default": "Keep the battery and its contacts dry."
    },
    {
      "type": "header",
      "content": "t:sections.diamond_quick_start.settings.footer_heading"
    },
    {
      "type": "checkbox",
      "id": "hide_footer",
      "label": "t:sections.diamond_quick_start.settings.hide_footer.label",
      "info": "t:sections.diamond_quick_start.settings.hide_footer.info",
      "default": false
    },
    {
      "type": "url",
      "id": "more_url",
      "label": "t:sections.diamond_quick_start.settings.more_url.label"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "t:sections.diamond_quick_start.settings.more_label.label",
      "default": "Read more in the full manual ›"
    },
    {
      "type": "text",
      "id": "more_note",
      "label": "t:sections.diamond_quick_start.settings.more_note.label",
      "default": "Temperature in coals, profiles, the cap, cleaning and more"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.padding_desktop_heading"
    },
    {
      "type": "range",
