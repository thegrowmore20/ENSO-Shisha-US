{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text
  assign ig_handle = section.settings.handle | default: 'enso.future'
-%}

<instagram-reels class="instagram-reels {{ scheme_class }} section-padding">
  <div class="container">
    <div class="instagram-reels__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="instagram-reels__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <a
          href="{{ section.settings.cta_link | default: settings.social_instagram_link | default: '#' }}"
          class="instagram-reels__cta"
          target="_blank"
          rel="noopener"
        >
          {%- render 'icon-instagram' -%}
          {{ section.settings.cta_label }} ›
        </a>
      {%- endif -%}
    </div>

    <div class="instagram-reels__track">
      <div class="instagram-reels__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_video = false
            if block.settings.video and block.settings.video.sources.size > 0
              assign has_video = true
            endif
          -%}
          <a href="{{ block.settings.link | default: '#' }}"
             class="reel"
             data-igp="{{ forloop.index0 }}"
             data-ig-link="{{ block.settings.link | escape }}"
             data-ig-likes="{{ block.settings.like_count | default: '' }}"
             data-ig-comments="{{ block.settings.comment_count | default: '' }}"
             data-ig-caption="{{ block.settings.caption | escape }}"
             {%- for source in block.settings.video.sources -%}
               {%- if source.format == 'mp4' -%}data-ig-video="{{ source.url }}"{%- endif -%}
             {%- endfor -%}
             aria-label="Open Instagram reel"
             {{ block.shopify_attributes }}>
            <div class="reel__media">
              {%- if block.settings.thumbnail -%}
                <img
                  src="{{ block.settings.thumbnail | image_url: width: 500 }}"
                  alt="{{ block.settings.thumbnail.alt | escape }}"
                  width="{{ block.settings.thumbnail.width }}"
                  height="{{ block.settings.thumbnail.height }}"
                  loading="lazy"
                  class="reel__poster"
                >
              {%- else -%}
                <img
                  src="https://cdn.shopify.com/s/files/1/0773/3218/5401/files/Screenshot_2026-09-21_111535-removebg-preview.png?v=1789971478"
                  alt=""
                  loading="lazy"
                  class="reel__poster"
                >
              {%- endif -%}

              {%- if has_video -%}
                <template data-video-template>
                  <video class="reel__video" muted loop playsinline preload="none">
                    {%- for source in block.settings.video.sources -%}
                      {%- if source.format == 'mp4' -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {%- endif -%}
                    {%- endfor -%}
                  </video>
                </template>
              {%- endif -%}

              <span class="reel__play">{%- render 'icon-play' -%}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
      <div class="igr-nav">
        <button class="igr-nav__btn" data-igr-prev aria-label="Previous posts">&#x2039;</button>
        <button class="igr-nav__btn" data-igr-next aria-label="Next posts">&#x203a;</button>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div class="igv" id="igv-{{ section.id }}" hidden role="dialog" aria-modal="true" aria-label="Instagram reel">
    <div class="igv__backdrop"></div>

    <!-- Close — top-right of viewport -->
    <button class="igv__close" data-ig-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>

    <!-- Navigation — flanking the card in the backdrop -->
    <button class="igv__arr igv__arr--l" data-ig-prev aria-label="Previous reel">&#x2039;</button>
    <button class="igv__arr igv__arr--r" data-ig-next aria-label="Next reel">&#x203a;</button>

    <div class="igv__card">

      <!-- Profile header — overlaid at top of video -->
      <div class="igv__top">
        <div class="igv__av" aria-hidden="true">
          {%- if settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: 52 }}" alt="" width="26" height="26" loading="eager">
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="6" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
            </svg>
          {%- endif -%}
        </div>
        <span class="igv__handle">{{ ig_handle | escape }}</span>
        <a class="igv__view-link" href="#" target="_blank" rel="noopener" data-ig-href>View post</a>
      </div>

      <!-- Video -->
      <div class="igv__media">
        <video class="igv__video" muted playsinline preload="none" loop></video>
      </div>

      <!-- Footer — overlaid at bottom of video -->
      <div class="igv__foot">
        <button class="igv__snd" type="button" aria-label="Sound on" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linejoin="round" d="M4 9v6h4l5 4V5L8 9H4z"/>
            <path class="igv__mute-lines" d="M17 9l4 6M21 9l-4 6" stroke-linecap="round"/>
          </svg>
        </button>
        <p class="igv__cap" data-ig-caption></p>
      </div>

    </div>
  </div>
</instagram-reels>

{% stylesheet %}
  .instagram-reels__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    margin-bottom: 32px;
  }

  .instagram-reels__heading {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size: 36px;
    line-height: 1.15;
    margin: 0 0 8px;
  }

  .instagram-reels__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    text-decoration: none;
  }

  .instagram-reels__cta:hover {
    text-decoration: underline;
  }

  .instagram-reels__cta .icon-instagram {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .instagram-reels__track {
    max-width: 1040px;
    margin: 0 auto;
  }

  .instagram-reels__grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 20px;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
  }

  .instagram-reels__grid::-webkit-scrollbar {
    display: none;
  }

  .instagram-reels__grid.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .igr-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

  .igr-nav__btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);
    background: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease;
    font-family: inherit;
    padding: 0;
  }

  .igr-nav__btn:hover {
    border-color: rgba(0, 0, 0, 0.7);
  }

  .reel {
    flex: 0 0 calc((100% - 40px) / 3);
    scroll-snap-align: start;
  }

  .reel__media {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-background-raised);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.3s var(--ease-out);
  }

  .reel:hover .reel__media {
    box-shadow: var(--shadow-md);
  }

  .reel__poster,
  .reel__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .reel:hover .reel__poster {
    transform: scale(1.06);
  }

  .reel__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(10, 10, 10, 0.45) 0%, rgba(10, 10, 10, 0) 35%);
    pointer-events: none;
  }

  .reel__video {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .reel__media.is-ready .reel__video {
    opacity: 1;
  }

  .reel__play {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    width: 26px;
    height: 26px;
    color: #F5F1E6;
    transition: opacity 0.2s ease;
  }

  .reel__media.is-ready .reel__play {
    opacity: 0;
  }

  @media screen and (max-width: 749px) {
    .instagram-reels__heading {
      font-size: 28px;
    }

    .instagram-reels__track {
      max-width: none;
      margin: 0;
    }

    .instagram-reels__grid {
      margin: 0 -16px;
      padding: 0 16px;
    }

    .reel {
      flex: 0 0 62%;
      scroll-snap-align: center;
    }

    .igr-nav {
      display: none;
    }
  }

  /* ── Lightbox ── */
  .igv {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .igv[hidden] {
    display: none;
  }

  .igv__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.85);
    cursor: pointer;
  }

  /* Card */
  .igv__card {
    position: relative;
    z-index: 1;
    width: min(446px, 92vw);
    aspect-ratio: 9 / 16;
    max-height: 88vh;
    border-radius: 22px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
  }

  /* Media fills the card */
  .igv__media {
    position: absolute;
    inset: 0;
  }

  .igv__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Profile header — overlaid top */
  .igv__top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 20px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.5), transparent);
  }

  .igv__av {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .igv__av img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .igv__av svg {
    width: 18px;
    height: 18px;
    color: #111;
  }

  .igv__handle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    color: #fff;
    flex: 1;
  }

  .igv__view-link {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    margin-left: auto;
  }

  .igv__view-link:hover {
    text-decoration: underline;
  }

  /* Footer — overlaid bottom */
  .igv__foot {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 44px 20px 22px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.35) 60%, transparent 100%);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  /* Mute button */
  .igv__snd {
    margin-left: auto;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #fff;
    flex-shrink: 0;
  }

  .igv__snd:hover {
    background: rgba(0, 0, 0, 0.65);
  }

  .igv__snd svg {
    width: 20px;
    height: 20px;
  }

  .igv__snd.is-on .igv__mute-lines {
    display: none;
  }

  /* Caption */
  .igv__cap {
    flex-basis: 100%;
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 18px;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Close button */
  .igv__close {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 9002;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: background 0.2s ease;
  }

  .igv__close:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .igv__close svg {
    width: 20px;
    height: 20px;
  }

  /* Navigation arrows — outside the card */
  .igv__arr {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 9001;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    font-family: inherit;
    padding: 0;
  }

  .igv__arr:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .igv__arr--l {
    left: max(12px, calc(50% - 270px));
  }

  .igv__arr--r {
    right: max(12px, calc(50% - 270px));
  }

  /* Focus rings */
  .igv__close:focus-visible,
  .igv__arr:focus-visible,
  .igv__snd:focus-visible,
  .igv__view-link:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media screen and (max-width: 600px) {
    .igv__arr {
      top: auto;
      bottom: 18px;
      transform: none;
    }

    .igv__card {
      max-height: 82vh;
    }
  }
{% endstylesheet %}

{% javascript %}
  class InstagramReels extends HTMLElement {
    #reels = [];
    #currentIndex = 0;
    #modal = null;
    #modalVideo = null;
    #modalHref = null;
    #muted = true;

    connectedCallback() {
      this.#reels = [...this.querySelectorAll('a[data-igp]')];
      this.#modal = this.querySelector('.igv');
      if (!this.#modal) return;

      this.#modalVideo = this.#modal.querySelector('.igv__video');
      this.#modalHref = this.#modal.querySelector('[data-ig-href]');

      for (const reel of this.#reels) {
        reel.addEventListener('click', (e) => {
          e.preventDefault();
          this.#open(parseInt(reel.dataset.igp, 10));
        });
      }

      this.#initGridNav();
      this.#initDrag();
      this.#initMute();

      this.#modal.querySelector('[data-ig-close]').addEventListener('click', () => this.#close());
      this.#modal.querySelector('.igv__backdrop').addEventListener('click', () => this.#close());

      this.#modal.querySelector('[data-ig-prev]').addEventListener('click', () => {
        this.#open((this.#currentIndex - 1 + this.#reels.length) % this.#reels.length);
      });
      this.#modal.querySelector('[data-ig-next]').addEventListener('click', () => {
        this.#open((this.#currentIndex + 1) % this.#reels.length);
      });

      document.addEventListener('keydown', (e) => {
        if (this.#modal.hidden) return;
        if (e.key === 'Escape') this.#close();
        if (e.key === 'ArrowLeft') this.#open((this.#currentIndex - 1 + this.#reels.length) % this.#reels.length);
        if (e.key === 'ArrowRight') this.#open((this.#currentIndex + 1) % this.#reels.length);
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              this.#loadPreview(entry.target.querySelector('.reel__media'));
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '200px' }
        );
        for (const reel of this.#reels) observer.observe(reel);
      }
    }

    #initGridNav() {
      const grid = this.querySelector('.instagram-reels__grid');
      const prev = this.querySelector('[data-igr-prev]');
      const next = this.querySelector('[data-igr-next]');
      if (!grid || !prev || !next) return;
      prev.addEventListener('click', () => grid.scrollBy({ left: -grid.clientWidth, behavior: 'smooth' }));
      next.addEventListener('click', () => grid.scrollBy({ left: grid.clientWidth, behavior: 'smooth' }));
    }

    #initDrag() {
      const grid = this.querySelector('.instagram-reels__grid');
      if (!grid) return;
      let dragging = false;
      let startX = 0;
      let scrollStart = 0;

      grid.addEventListener('mousedown', (e) => {
        dragging = true;
        startX = e.pageX;
        scrollStart = grid.scrollLeft;
        grid.classList.add('is-dragging');
        e.preventDefault();
      });

      window.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        grid.scrollLeft = scrollStart - (e.pageX - startX);
      });

      const stopDrag = () => {
        if (!dragging) return;
        dragging = false;
        grid.classList.remove('is-dragging');
      };
      window.addEventListener('mouseup', stopDrag);
      window.addEventListener('mouseleave', stopDrag);
    }

    #initMute() {
      const btn = this.#modal && this.#modal.querySelector('.igv__snd');
      if (!btn) return;
      btn.addEventListener('click', () => {
        this.#muted = !this.#muted;
        if (this.#modalVideo) this.#modalVideo.muted = this.#muted;
        btn.classList.toggle('is-on', !this.#muted);
        btn.setAttribute('aria-label', this.#muted ? 'Sound on' : 'Sound off');
      });
    }

    #open(index) {
      const reel = this.#reels[index];
      if (!reel) return;
      this.#currentIndex = index;

      const videoSrc = reel.dataset.igVideo || '';
      const igLink = reel.dataset.igLink || '#';
      const caption = reel.dataset.igCaption || '';

      if (this.#modalHref) this.#modalHref.href = igLink;

      const captionEl = this.#modal.querySelector('[data-ig-caption]');
      if (captionEl) captionEl.textContent = caption;

      const sndBtn = this.#modal.querySelector('.igv__snd');
      if (sndBtn) {
        sndBtn.hidden = !videoSrc;
        sndBtn.classList.toggle('is-on', !this.#muted);
      }

      if (this.#modalVideo) {
        this.#modalVideo.pause();
        this.#modalVideo.src = videoSrc;
        this.#modalVideo.muted = this.#muted;
        if (videoSrc) {
          this.#modalVideo.load();
          this.#modalVideo.play().catch(() => {});
        }
      }

      this.#modal.hidden = false;
      document.body.style.overflow = 'hidden';
      this.#modal.querySelector('[data-ig-close]').focus();
    }

    #close() {
      if (this.#modalVideo) {
        this.#modalVideo.pause();
        this.#modalVideo.src = '';
      }
      this.#modal.hidden = true;
      document.body.style.overflow = '';
    }

    #loadPreview(media) {
      if (!media) return;
      const template = media.querySelector('[data-video-template]');
      if (!template) return;
      const video = template.content.firstElementChild.cloneNode(true);
      video.addEventListener('canplay', () => media.classList.add('is-ready'), { once: true });
      media.append(video);
      video.play().catch(() => {});
    }
  }

  if (!customElements.get('instagram-reels')) {
    customElements.define('instagram-reels', InstagramReels);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.instagram_reels.name",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.instagram_reels.settings.eyebrow.label",
      "default": "Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.instagram_reels.settings.heading.label",
      "default": "As Seen on Instagram"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "t:sections.instagram_reels.settings.handle.label",
      "default": "enso.future",
      "info": "t:sections.instagram_reels.settings.handle.info"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.instagram_reels.settings.cta_label.label",
      "default": "Follow @enso.future"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.instagram_reels.settings.cta_link.label",
      "info": "t:sections.instagram_reels.settings.cta_link.info"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "t:sections.instagram_reels.blocks.reel.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "t:sections.instagram_reels.blocks.reel.settings.thumbnail.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.instagram_reels.blocks.reel.settings.video.label",
          "info": "t:sections.instagram_reels.blocks.reel.settings.video.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.instagram_reels.blocks.reel.settings.link.label"
