{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text
-%}

<instagram-reels class="instagram-reels {{ scheme_class }} section-padding">
  <div class="container">
    <div class="instagram-reels__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="instagram-reels__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <a
          href="{{ section.settings.cta_link | default: settings.social_instagram_link | default: '#' }}"
          class="instagram-reels__cta"
          target="_blank"
          rel="noopener"
        >
          {%- render 'icon-instagram' -%}
          {{ section.settings.cta_label }} ›
        </a>
      {%- endif -%}
    </div>

    <div class="instagram-reels__track">
    <div class="instagram-reels__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_video = false
          if block.settings.video and block.settings.video.sources.size > 0
            assign has_video = true
          endif
        -%}
        <a href="{{ block.settings.link | default: '#' }}"
           class="reel"
           data-igp="{{ forloop.index0 }}"
           data-ig-link="{{ block.settings.link | escape }}"
           {%- for source in block.settings.video.sources -%}
             {%- if source.format == 'mp4' -%}data-ig-video="{{ source.url }}"{%- endif -%}
           {%- endfor -%}
           aria-label="Open Instagram reel"
           {{ block.shopify_attributes }}>
          <div class="reel__media">
            {%- if block.settings.thumbnail -%}
              <img
                src="{{ block.settings.thumbnail | image_url: width: 500 }}"
                alt="{{ block.settings.thumbnail.alt | escape }}"
                width="{{ block.settings.thumbnail.width }}"
                height="{{ block.settings.thumbnail.height }}"
                loading="lazy"
                class="reel__poster"
              >
            {%- else -%}
              <img
                src="https://cdn.shopify.com/s/files/1/0773/3218/5401/files/Screenshot_2026-09-21_111535-removebg-preview.png?v=1789971478"
                alt=""
                loading="lazy"
                class="reel__poster"
              >
            {%- endif -%}

            {%- if has_video -%}
              <template data-video-template>
                <video class="reel__video" muted loop playsinline preload="none">
                  {%- for source in block.settings.video.sources -%}
                    {%- if source.format == 'mp4' -%}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endif -%}
                  {%- endfor -%}
                </video>
              </template>
            {%- endif -%}

            <span class="reel__play">{%- render 'icon-play' -%}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
    <div class="igr-nav">
      <button class="igr-nav__btn" data-igr-prev aria-label="Previous posts">&#x2039;</button>
      <button class="igr-nav__btn" data-igr-next aria-label="Next posts">&#x203a;</button>
    </div>
    </div>
  </div>

  <div class="igv" id="igv-{{ section.id }}" hidden role="dialog" aria-modal="true" aria-label="Instagram reel">
    <div class="igv__backdrop"></div>
    <div class="igv__card">
      <div class="igv__top">
        <div class="igv__profile">
          <svg class="igv__ig-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="6" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
          </svg>
          <span class="igv__handle">{{ section.settings.cta_label | default: '@enso.future' | remove: ' ›' }}</span>
        </div>
        <a class="igv__view-link" href="#" target="_blank" rel="noopener" data-ig-href>View on Instagram ›</a>
      </div>
      <div class="igv__media">
        <video class="igv__video" muted playsinline preload="none" loop></video>
      </div>
      <button class="igv__prev" data-ig-prev aria-label="Previous reel">
        <svg viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="igv__next" data-ig-next aria-label="Next reel">
        <svg viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    <button class="igv__close" data-ig-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
</instagram-reels>

{% stylesheet %}
  .instagram-reels__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    margin-bottom: 32px;
  }

  .instagram-reels__heading {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size: 36px;
    line-height: 1.15;
    margin: 0 0 8px;
  }

  .instagram-reels__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    text-decoration: none;
  }

  .instagram-reels__cta:hover {
    text-decoration: underline;
  }

  .instagram-reels__cta .icon-instagram {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .instagram-reels__track {
    max-width: 1040px;
    margin: 0 auto;
  }

  .instagram-reels__grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 20px;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
  }

  .instagram-reels__grid::-webkit-scrollbar {
    display: none;
  }

  .instagram-reels__grid.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .igr-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

  .igr-nav__btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);
    background: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease;
    font-family: inherit;
    padding: 0;
  }

  .igr-nav__btn:hover {
    border-color: rgba(0, 0, 0, 0.7);
  }

  .reel {
    flex: 0 0 calc((100% - 40px) / 3);
    scroll-snap-align: start;
  }

  .reel__media {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-background-raised);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.3s var(--ease-out);
  }

  .reel:hover .reel__media {
    box-shadow: var(--shadow-md);
  }

  .reel__poster,
  .reel__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .reel:hover .reel__poster {
    transform: scale(1.06);
  }

  .reel__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: auto;
  }

  .reel__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(10, 10, 10, 0.45) 0%, rgba(10, 10, 10, 0) 35%);
    pointer-events: none;
  }

  .reel__video {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .reel__media.is-ready .reel__video {
    opacity: 1;
  }

  .reel__play {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    width: 26px;
    height: 26px;
    color: #F5F1E6;
    transition: opacity 0.2s ease;
  }

  .reel__media.is-ready .reel__play {
    opacity: 0;
  }

  @media screen and (max-width: 749px) {
    .instagram-reels__heading {
      font-size: 28px;
    }

    .instagram-reels__track {
      max-width: none;
      margin: 0;
    }

    .instagram-reels__grid {
      margin: 0 -16px;
      padding: 0 16px;
    }

    .reel {
      flex: 0 0 62%;
      scroll-snap-align: center;
    }

    .igr-nav {
      display: none;
    }
  }

  /* ── Lightbox ── */
  .igv {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .igv[hidden] {
    display: none;
  }

  .igv__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.88);
    cursor: pointer;
  }

  .igv__card {
    position: relative;
    z-index: 1;
    width: min(360px, 90vw);
    border-radius: 18px;
    overflow: hidden;
    background: #0a0a0a;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
  }

  .igv__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: rgba(10, 10, 10, 0.9);
  }

  .igv__profile {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .igv__ig-icon {
    width: 22px;
    height: 22px;
    color: #fff;
    flex-shrink: 0;
  }

  .igv__handle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    color: #fff;
  }

  .igv__view-link {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    color: var(--palette-sand, #c8943a);
    text-decoration: none;
    white-space: nowrap;
  }

  .igv__view-link:hover {
    text-decoration: underline;
  }

  .igv__media {
    aspect-ratio: 9 / 16;
    background: #000;
    position: relative;
  }

  .igv__video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .igv__prev,
  .igv__next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: background 0.2s ease;
  }

  .igv__prev:hover,
  .igv__next:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .igv__prev { left: 8px; }
  .igv__next { right: 8px; }

  .igv__prev svg,
  .igv__next svg {
    width: 20px;
    height: 20px;
  }

  .igv__close {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9001;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: background 0.2s ease;
  }

  .igv__close:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .igv__close svg {
    width: 20px;
    height: 20px;
  }
{% endstylesheet %}

{% javascript %}
  class InstagramReels extends HTMLElement {
    #reels = [];
    #currentIndex = 0;
    #modal = null;
    #modalVideo = null;
    #modalHref = null;

    connectedCallback() {
      this.#reels = [...this.querySelectorAll('a[data-igp]')];
      this.#modal = this.querySelector('.igv');
      if (!this.#modal) return;

      this.#modalVideo = this.#modal.querySelector('.igv__video');
      this.#modalHref = this.#modal.querySelector('[data-ig-href]');

      for (const reel of this.#reels) {
        reel.addEventListener('click', (e) => {
          e.preventDefault();
          this.#open(parseInt(reel.dataset.igp, 10));
        });
      }

      this.#initGridNav();
      this.#initDrag();

      this.#modal.querySelector('[data-ig-close]').addEventListener('click', () => this.#close());
      this.#modal.querySelector('.igv__backdrop').addEventListener('click', () => this.#close());

      this.#modal.querySelector('[data-ig-prev]').addEventListener('click', () => {
        this.#open((this.#currentIndex - 1 + this.#reels.length) % this.#reels.length);
      });
      this.#modal.querySelector('[data-ig-next]').addEventListener('click', () => {
        this.#open((this.#currentIndex + 1) % this.#reels.length);
      });

      document.addEventListener('keydown', (e) => {
        if (this.#modal.hidden) return;
        if (e.key === 'Escape') this.#close();
        if (e.key === 'ArrowLeft') this.#open((this.#currentIndex - 1 + this.#reels.length) % this.#reels.length);
        if (e.key === 'ArrowRight') this.#open((this.#currentIndex + 1) % this.#reels.length);
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              this.#loadPreview(entry.target.querySelector('.reel__media'));
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '200px' }
        );
        for (const reel of this.#reels) observer.observe(reel);
      }
    }

    #initGridNav() {
      const grid = this.querySelector('.instagram-reels__grid');
      const prev = this.querySelector('[data-igr-prev]');
      const next = this.querySelector('[data-igr-next]');
      if (!grid || !prev || !next) return;
      prev.addEventListener('click', () => grid.scrollBy({ left: -grid.clientWidth, behavior: 'smooth' }));
      next.addEventListener('click', () => grid.scrollBy({ left: grid.clientWidth, behavior: 'smooth' }));
    }

    #initDrag() {
      const grid = this.querySelector('.instagram-reels__grid');
      if (!grid) return;
      let dragging = false;
      let startX = 0;
      let scrollStart = 0;

      grid.addEventListener('mousedown', (e) => {
        dragging = true;
        startX = e.pageX;
        scrollStart = grid.scrollLeft;
        grid.classList.add('is-dragging');
        e.preventDefault();
      });

      window.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        grid.scrollLeft = scrollStart - (e.pageX - startX);
      });

      const stopDrag = () => {
        if (!dragging) return;
        dragging = false;
        grid.classList.remove('is-dragging');
      };
      window.addEventListener('mouseup', stopDrag);
      window.addEventListener('mouseleave', stopDrag);
    }

    #open(index) {
      const reel = this.#reels[index];
      if (!reel) return;
      this.#currentIndex = index;

      const videoSrc = reel.dataset.igVideo || '';
      const igLink = reel.dataset.igLink || '#';

      if (this.#modalHref) this.#modalHref.href = igLink;

      if (this.#modalVideo) {
        this.#modalVideo.pause();
        this.#modalVideo.src = videoSrc;
        if (videoSrc) {
          this.#modalVideo.load();
          this.#modalVideo.play().catch(() => {});
        }
      }

      this.#modal.hidden = false;
      document.body.style.overflow = 'hidden';
      this.#modal.querySelector('[data-ig-close]').focus();
    }

    #close() {
      if (this.#modalVideo) {
        this.#modalVideo.pause();
        this.#modalVideo.src = '';
      }
      this.#modal.hidden = true;
      document.body.style.overflow = '';
    }

    #loadPreview(media) {
      if (!media) return;
      const template = media.querySelector('[data-video-template]');
      if (!template) return;
      const video = template.content.firstElementChild.cloneNode(true);
      video.addEventListener('canplay', () => media.classList.add('is-ready'), { once: true });
      media.append(video);
      video.play().catch(() => {});
    }
  }

  if (!customElements.get('instagram-reels')) {
    customElements.define('instagram-reels', InstagramReels);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.instagram_reels.name",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.instagram_reels.settings.eyebrow.label",
      "default": "Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.instagram_reels.settings.heading.label",
      "default": "As Seen on Instagram"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.instagram_reels.settings.cta_label.label",
      "default": "Follow @enso.future"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.instagram_reels.settings.cta_link.label",
      "info": "t:sections.instagram_reels.settings.cta_link.info"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "t:sections.instagram_reels.blocks.reel.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "t:sections.instagram_reels.blocks.reel.settings.thumbnail.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.instagram_reels.blocks.reel.settings.video.label",
          "info": "t:sections.instagram_reels.blocks.reel.settings.video.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.instagram_reels.blocks.reel.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.instagram_reels.presets.name",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
