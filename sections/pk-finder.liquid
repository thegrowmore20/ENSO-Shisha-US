{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
{%- liquid
  if section.settings.device_frame != blank
    assign df_src = section.settings.device_frame | image_url: width: 600
  else
    assign df_src = 'closed-start.jpg' | file_url
  endif
-%}
<section class="pk-heat" id="heat">
  <h2>Find your heat</h2>
  <p class="pk-heat__lead">Three taps and the dial turns to where your tobacco smokes best.</p>
  <div class="hf2">
    <div class="mac">
      <div class="dev">
        <img src="{{ df_src }}" alt="ENSŌ Diamond, front" loading="lazy">
        <div class="lv" role="img" aria-label="The dial set to your heat"></div>
      </div>
    </div>
    <div class="hf__q">
      <div class="hf__g">
        <b>Your tobacco</b>
        <div class="hf__opts">
          <button type="button" data-hf="leaf" data-v="virginia" aria-pressed="true">Virginia<small>Blonde leaf</small></button>
          <button type="button" data-hf="leaf" data-v="dark" aria-pressed="false">Burley<small>Dark leaf, heavier</small></button>
          <button type="button" data-hf="leaf" data-v="mix" aria-pressed="false">A mix<small>Virginia and dark</small></button>
        </div>
      </div>
      <div class="hf__g">
        <b>How you like it</b>
        <div class="hf__opts">
          <button type="button" data-hf="str" data-v="soft" aria-pressed="true">Lighter<small>Smooth and long</small></button>
          <button type="button" data-hf="str" data-v="strong" aria-pressed="false">Stronger<small>More body</small></button>
        </div>
      </div>
      <dl class="hf2__out" aria-live="polite">
        <div><dt>Pre-heat</dt><dd class="hf2__pre"></dd></div>
        <div><dt>Session heat</dt><dd class="hf2__t"></dd></div>
        <div class="hf2__meshc"><dt>Mesh</dt><dd><img class="hf2__mimg" src="" alt=""><span><span class="hf2__m"></span><small class="hf2__msub"></small></span></dd></div>
        <div><dt>Profile to try</dt><dd class="hf2__prof"></dd></div>
      </dl>
      <p class="hf2__note">A starting point. Turn the dial by taste: the harder you draw, the more heat you need.</p>
    </div>
  </div>
</section>

{% stylesheet %}
.pk-heat {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
}
.pk-heat h2 {
  font-size: 40px;
  line-height: 46px;
  font-family: var(--font-accent);
  font-weight: var(--font-weight-heavy);
  letter-spacing: -0.02em;
  margin: 0 0 8px;
}
.pk-heat__lead {
  margin: 0 0 28px;
  font-size: 17px;
  color: rgb(0 0 0 / .72);
}
@media screen and (max-width: 767px) {
  .pk-heat { padding: 0 16px; }
  .pk-heat h2 { font-size: 30px; line-height: 36px; }
}
.hf2__out {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.hf2__out > div {
  background: #f8f7f4;
  border-radius: 8px;
  padding: 14px 16px;
}
.hf2__out dt {
  font-size: 11px;
  font-weight: var(--font-weight-semibold);
  letter-spacing: .08em;
  text-transform: uppercase;
  color: rgb(0 0 0 / .45);
  margin-bottom: 6px;
}
.hf2__out dd {
  margin: 0;
  font-size: 15px;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}
.hf2__meshc dd {
  display: flex;
  align-items: center;
  gap: 10px;
}
.hf2__mimg {
  width: 40px;
  height: 40px;
  object-fit: contain;
  flex-shrink: 0;
  border-radius: 4px;
  background: #ede9e2;
}
.hf2__m {
  display: block;
  font-size: 14px;
  font-weight: var(--font-weight-semibold);
}
.hf2__msub {
  display: block;
  font-size: 12px;
  font-weight: var(--font-weight-regular);
  color: rgb(0 0 0 / .55);
  line-height: 1.3;
}
@media screen and (max-width: 767px) {
  .hf2__out {
    grid-template-columns: 1fr 1fr;
  }
}
{% endstylesheet %}

{% javascript %}
(function(){
  var BASE={virginia:252,dark:270,mix:262},PROF={virginia:'Phoenix',dark:'Wraith',mix:'Default'};
  var MESH={
    soft:['Basket mesh','Loose, airy pack. Long, smooth session.','{{ section.settings.mesh_basket | image_url: width: 80 }}'],
    strong:['Flat screen','Denser pack. Fuller, faster session.','{{ section.settings.mesh_screen | image_url: width: 80 }}']
  };
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  function calc(st){
    var t=BASE[st.leaf]+(st.str==='strong'?5:-5),pre='7 minutes at 275 °C (Default)',prof=PROF[st.leaf];
    if(st.leaf==='dark'&&st.str==='strong'){pre='7 minutes at 290 °C';prof='Oracle'}
    else if(st.leaf==='dark'){pre='7 minutes at 280 °C'}
    return{t:Math.round(t/5)*5,pre:pre,prof:prof};
  }
  function initHf(f){
    if(f.dataset.hfReady)return;
    f.dataset.hfReady='1';
    var lv=f.querySelector('.lv');
    if(lv&&!lv.querySelector('.lv__s')){
      lv.innerHTML='<div class="lv__s on"><div class="lv__bat"><svg viewBox="0 0 10 14"><path d="M6 0 0 8h4l-1 6 7-9H6l1-5z"/></svg>100%</div><div class="t-huge" data-k="t">275<sup>°</sup></div><div class="t-cap">Session heat</div></div>';
    }
    var tEl=lv?lv.querySelector('[data-k="t"]'):null,st={leaf:'virginia',str:'soft',fl:'fruit'},cur=275,anim;
    function go(){
      var r=calc(st);
      var tOut=f.querySelector('.hf2__t'),pOut=f.querySelector('.hf2__pre'),prOut=f.querySelector('.hf2__prof');
      var mImg=f.querySelector('.hf2__mimg'),mName=f.querySelector('.hf2__m'),mSub=f.querySelector('.hf2__msub');
      var mesh=MESH[st.str];
      if(tOut)tOut.textContent=r.t+' °C';
      if(pOut)pOut.textContent=r.pre;
      if(prOut)prOut.textContent=r.prof;
      if(mImg&&mesh[2]){mImg.src=mesh[2];mImg.alt=mesh[0]}
      if(mName)mName.textContent=mesh[0];
      if(mSub)mSub.textContent=mesh[1];
      if(!tEl)return;
      clearInterval(anim);if(lv)lv.classList.add('press');setTimeout(function(){if(lv)lv.classList.remove('press')},250);
      if(reduce){cur=r.t;tEl.innerHTML=cur+'<sup>°</sup>';return}
      anim=setInterval(function(){cur+=cur<r.t?1:-1;tEl.innerHTML=cur+'<sup>°</sup>';if(cur===r.t)clearInterval(anim)},20);
    }
    [].forEach.call(f.querySelectorAll('[data-hf]'),function(b){
      b.addEventListener('click',function(){
        st[b.dataset.hf]=b.dataset.v;
        [].forEach.call(f.querySelectorAll('[data-hf="'+b.dataset.hf+'"]'),function(x){x.setAttribute('aria-pressed',x===b)});
        go();
      });
    });
    go();
  }
  function init(){[].forEach.call(document.querySelectorAll('.hf2'),initHf)}
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init)}else{init()}
})();
{% endjavascript %}

{% schema %}
{
  "name": "PK: Find your heat",
  "presets": [{ "name": "PK: Find your heat" }],
  "settings": [
    { "type": "image_picker", "id": "device_frame", "label": "Device frame image" },
    { "type": "image_picker", "id": "mesh_basket", "label": "Mesh image — Basket" },
    { "type": "image_picker", "id": "mesh_screen", "label": "Mesh image — Flat screen" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top padding (mobile)", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom padding (mobile)", "default": 40 }
  ]
}
{% endschema %}
