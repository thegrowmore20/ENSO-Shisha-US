{% stylesheet %}

.dg-check {
  padding: 80px 0;
}

.dg-check__head {
  margin-bottom: 32px;
}

.dg-check__head h2 {
  font-size: var(--font-size-h2);
  font-weight: var(--font-weight-heavy);
  font-family: var(--font-heading);
  margin: 0 0 8px;
  line-height: 1.1;
  letter-spacing: -.02em;
}

.dg-check__head p {
  font-size: 15px;
  color: rgb(0 0 0 / .66);
  margin: 0;
}

.dg-check__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.dg-check__grid article {
  padding: 0;
}

.dg-check__grid article img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 16px;
  margin-bottom: 16px;
  display: block;
}

.dg-check__placeholder {
  width: 100%;
  aspect-ratio: 4 / 3;
  display: block;
  border-radius: 16px;
  margin-bottom: 16px;
}

.dg-check__grid article h3 {
  font-size: 18px;
  font-weight: var(--font-weight-bold);
  font-family: var(--font-heading);
  margin: 0 0 10px;
  line-height: 1.3;
}

.dg-check__grid article ul {
  list-style: disc;
  padding-left: 18px;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.dg-check__grid article li {
  font-size: 14px;
  line-height: 1.5;
  color: rgb(0 0 0 / .72);
}

@media screen and (max-width: 989px) {
  .dg-check { padding: 40px 0; }
  .dg-check__grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}

{% endstylesheet %}

{% style %}
  #shopify-section-{{ section.id }} .dg-check {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .dg-check {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section class="dg-check" id="DgCheck-{{ section.id }}">
  <div class="container">
    <div class="dg-check__head">
      <h2>{{ section.settings.heading | default: 'Before the first session' | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="dg-check__grid">
        {%- for block in section.blocks -%}
          <article {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{- block.settings.image | image_url: width: 800 | image_tag:
                alt: block.settings.image.alt | default: block.settings.heading,
                loading: 'lazy',
                widths: '400,600,800',
                sizes: '(max-width: 989px) 100vw, 33vw'
              -}}
            {%- else -%}
              <svg class="dg-check__placeholder" viewBox="0 0 4 3" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="4" height="3" fill="#f0ede8"/>
                <path d="M1.6 1.5 L2 0.9 L2.4 1.5 M1.75 1.5 L2.25 1.5 M2 1.5 L2 2.1" stroke="#c8b89a" stroke-width="0.08" stroke-linecap="round"/>
              </svg>
            {%- endif -%}
            <h3>{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.bullets != blank -%}
              {%- assign lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
              <ul>
                {%- for line in lines -%}
                  {%- assign trimmed = line | strip -%}
                  {%- if trimmed != blank -%}
                    <li>{{ trimmed }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.diamond_guide_checklist.name",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_guide_checklist.settings.heading.label",
      "default": "Before the first session"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.diamond_guide_checklist.settings.subheading.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "t:sections.diamond_guide_checklist.blocks.article.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.diamond_guide_checklist.blocks.article.settings.image.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.diamond_guide_checklist.blocks.article.settings.heading.label",
          "default": "Article heading"
        },
        {
          "type": "textarea",
          "id": "bullets",
          "label": "t:sections.diamond_guide_checklist.blocks.article.settings.bullets.label",
          "info": "t:sections.diamond_guide_checklist.blocks.article.settings.bullets.info"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.diamond_guide_checklist.presets.name"
    }
  ]
}
{% endschema %}
