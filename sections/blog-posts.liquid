{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
  assign featured_blog = section.settings.blog
-%}

{% style %}
 .section-padding-{{ section.id }} {
      display: block;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      max-width: 100%;
    }

    @media screen and (min-width: 750px) {
      .section-padding-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
{% endstyle %}

<section class="blog-posts {{ scheme_class }} section-padding-{{ section.id }}">
  <div class="container">
    <div class="blog-posts__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h-section">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: featured_blog.url | default: '#' }}" class="btn btn--outline blog-posts__cta">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    {%- if featured_blog -%}
      <div class="grid grid--3 blog-posts__grid">
        {%- for article in featured_blog.articles limit: section.settings.posts_limit -%}
          {%- render 'card-article', article: article -%}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="body-text text-muted">{{ 'sections.blog_posts.onboarding' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .blog-posts__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .blog-posts__cta {
    flex-shrink: 0;
  }

  .blog-posts__grid {
    row-gap: var(--space-6);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.blog_posts.settings.color_scheme.label",
      "default": "scheme-paper"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog_posts.settings.blog.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.blog_posts.settings.eyebrow.label",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.blog_posts.settings.heading.label",
      "default": "From the Journal"
    },
    {
      "type": "range",
      "id": "posts_limit",
      "label": "t:sections.blog_posts.settings.posts_limit.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.blog_posts.settings.cta_label.label",
      "default": "Read More"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.blog_posts.settings.cta_link.label"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog_posts.presets.name"
    }
  ]
}
{% endschema %}
