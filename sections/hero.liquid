{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
-%}

<section class="hero {{ scheme_class }} section-padding">
  <div class="container hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="h-display">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="body-text text-muted hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="hero__actions">
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_link | default: '#' }}" class="btn btn--primary">
            {{ section.settings.cta_primary_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a href="{{ section.settings.cta_secondary_link | default: '#' }}" class="btn btn--outline">
            {{ section.settings.cta_secondary_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="hero__media">
      {%- if section.settings.image -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
          class="hero__image"
        >
      {%- else -%}
        <div class="media-placeholder">
          {%- render 'icon-enso', class: 'media-placeholder__mark' -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  @media screen and (max-width: 989px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .hero__text {
    margin-top: var(--space-5);
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-7);
    flex-wrap: wrap;
  }

  .hero__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.hero.settings.color_scheme.label",
      "default": "scheme-paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.settings.eyebrow.label",
      "default": "The all-in-one · 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.settings.heading.label",
      "default": "No charcoal. No ash. No open flame."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.hero.settings.text.label",
      "default": "<p>For people who value the hookah ritual but reject the burden of charcoal — ENSO is the fully electronic hookah system that delivers a precise, portable and cleaner session.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "t:sections.hero.settings.cta_primary_label.label",
      "default": "Order ENSO 2026"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "t:sections.hero.settings.cta_primary_link.label"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "t:sections.hero.settings.cta_secondary_label.label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "t:sections.hero.settings.cta_secondary_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.presets.name"
    }
  ]
}
{% endschema %}
