{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text
  assign current_variant = product.selected_or_first_available_variant

  assign has_buy_buttons_block = false
  for block in section.blocks
    if block.type == 'buy_buttons'
      assign has_buy_buttons_block = true
    endif
  endfor
-%}

{{ 'main-product.css' | asset_url | stylesheet_tag }}

<div
  class="product-main {{ scheme_class }} product-main--width-{{ section.settings.width }} {% if section.settings.enable_sticky_info %}product-main--sticky{% endif %}{% if section.settings.accordion_position == 'below_media' %} product-main--acc-below{% endif %}"
  style="
    --product-media-width: {{ section.settings.media_width }}%;
    --product-padding-top: {{ section.settings.padding_top_mobile }}px;
    --product-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    --product-padding-top-desktop: {{ section.settings.padding_top }}px;
    --product-padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
  "
  id="ProductMain-{{ section.id }}"
>
  <div class="product-main__inner {% if section.settings.width == 'page' %}container{% endif %}" id="ProductMainInner-{{ section.id }}">
    {%- if section.settings.accordion_position == 'below_media' -%}
      <div class="product-main__left-col">
        <div class="product-main__media">
          {%- render 'product-media-gallery', product: product, section: section -%}
        </div>
        <div class="product-main__accordions">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'accordion' -%}
                {%- if block.settings.heading != blank and block.settings.content != blank -%}
                  <details class="accordion" name="product-accordion-{{ section.id }}" {% if block.settings.default_open %}open{% endif %} {{ block.shopify_attributes }}>
                    <summary class="accordion__heading">
                      {{ block.settings.heading }}
                      <svg class="accordion__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                    </summary>
                    <div class="accordion__content body-text text-muted">{{ block.settings.content }}</div>
                  </details>
                {%- endif -%}
              {%- when 'collapsible_content' -%}
                {%- if block.settings.heading != blank or block.settings.content != blank -%}
                  <details class="accordion" name="product-accordion-{{ section.id }}" {% if block.settings.collapse_open %}open{% endif %} {{ block.shopify_attributes }}>
                    <summary class="accordion__heading">
                      {{ block.settings.heading }}
                      <svg class="accordion__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                    </summary>
                    <div class="accordion__content body-text text-muted">{{ block.settings.content }}</div>
                  </details>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div><!-- /product-main__left-col -->
    {%- else -%}
      <div class="product-main__media">
        {%- render 'product-media-gallery', product: product, section: section -%}
      </div>
    {%- endif -%}

    <product-info
      class="product-main__content{% if section.settings.show_info_border %} product-main__content--bordered{% endif %}"
      id="ProductInfo-{{ section.id }}"
      data-section-id="{{ section.id }}"
    >
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'accordion', 'collapsible_content' -%}
              {%- comment -%} Rendered in product-main__accordions below the gallery {%- endcomment -%}

            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <p class="eyebrow product-vendor product-block" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
              {%- endif -%}

            {%- when 'type' -%}
              {%- if product.type != blank -%}
                <p class="eyebrow product-main__type product-block" {{ block.shopify_attributes }}>{{ product.type }}</p>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product-main__title product-block" {{ block.shopify_attributes }}>
                {{ product.title }}
              </h1>

              {% style %}
                .product-main__title {
                  font-size: {{ block.settings.heading_size }}px
                }
                @media (max-width: 749px) {
                 .product-main__title {
                    font-size: 28px;
                  } 
                }
              {% endstyle %}

            {%- when 'price' -%}
              <div class="product-price product-block" data-price-wrapper {{ block.shopify_attributes }}>
                {%- render 'price', product: product, variant: current_variant, show_unit_price: block.settings.show_unit_price, show_savings_badge: true -%}
              </div>
              {%- comment -%} Pre-rendered price per variant — swapped client-side, no fetch needed {%- endcomment -%}
              <template data-price-templates>
                {%- for variant in product.variants -%}
                  <div data-variant-price-id="{{ variant.id }}">
                    {%- render 'price', product: product, variant: variant, show_unit_price: block.settings.show_unit_price, show_savings_badge: true -%}
                  </div>
                {%- endfor -%}
              </template>

            {%- when 'stock_badge' -%}
              <div class="product-stock-badge product-block" data-stock-badge {{ block.shopify_attributes }}>
                {%- if current_variant.available -%}
                  <p class="product-stock-badge__text">
                    <i class="product-stock-badge__dot product-stock-badge__dot--in" aria-hidden="true"></i>
                    {{ block.settings.in_stock_text | default: 'In stock · Ships now' }}
                  </p>
                {%- else -%}
                  <p class="product-stock-badge__text">
                    <i class="product-stock-badge__dot" aria-hidden="true"></i>
                    {{ block.settings.out_of_stock_text | default: 'Out of stock' }}
                  </p>
                {%- endif -%}
              </div>
              <template data-stock-badge-templates>
                {%- for variant in product.variants -%}
                  <div data-variant-stock-id="{{ variant.id }}">
                    {%- if variant.available -%}
                      <p class="product-stock-badge__text">
                        <i class="product-stock-badge__dot product-stock-badge__dot--in" aria-hidden="true"></i>
                        {{ block.settings.in_stock_text | default: 'In stock · Ships now' }}
                      </p>
                    {%- else -%}
                      <p class="product-stock-badge__text">
                        <i class="product-stock-badge__dot" aria-hidden="true"></i>
                        {{ block.settings.out_of_stock_text | default: 'Out of stock' }}
                      </p>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </template>

            {%- when 'compat_badge' -%}
              {%- assign _compat = product.metafields.custom.compatiblity_with | metafield_tag | strip_html | strip -%}
              {%- if _compat != blank -%}
                <div class="product-chips product-block" {{ block.shopify_attributes }}>
                  <span class="product-chip product-chip--compat">{{ _compat }}</span>
                </div>
              {%- endif -%}

            {%- when 'tags' -%}
              {%- if product.tags.size > 0 -%}
                <div class="product-chips product-block" {{ block.shopify_attributes }}>
                  {%- for tag in product.tags -%}
                    <span class="product-chip">{{ tag }}</span>
                  {%- endfor -%}
                </div>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                {%- if block.settings.style == 'card' -%}
                  <div class="variant-card-picker product-block" {{ block.shopify_attributes }}>
                    {%- for option in product.options_with_values -%}
                      {%- assign opt_idx = forloop.index0 -%}
                      <div class="variant-card-picker__group" data-option-index="{{ opt_idx }}" data-option-name="{{ option.name | escape | downcase }}" role="radiogroup" aria-label="{{ option.name | escape }}">
                        <span data-selected-value hidden>{{ option.selected_value }}</span>
                        {%- for value in option.values -%}
                          {%- assign card_variant = nil -%}
                          {%- for v in product.variants -%}
                            {%- if v.options[opt_idx] == value and card_variant == nil -%}
                              {%- assign card_variant = v -%}
                            {%- endif -%}
                          {%- endfor -%}
                          <button
                            type="button"
                            class="pill variant-card{% if option.selected_value == value %} is-selected{% endif %}"
                            role="radio"
                            aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                            data-option-value="{{ value | escape }}"
                          >
                            <span class="variant-card__left">
                              <b class="variant-card__name">{{ value }}</b>
                              {%- if card_variant != nil and card_variant.metafields.custom.availability_text != blank -%}
                                <small class="variant-card__avail">{{ card_variant.metafields.custom.availability_text }}</small>
                              {%- endif -%}
                            </span>
                            {%- if card_variant != nil -%}
                              <em class="variant-card__price">{{ card_variant.price | money }}</em>
                            {%- endif -%}
                          </button>
                        {%- endfor -%}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="variant-picker product-block" {{ block.shopify_attributes }}>
                    {%- for option in product.options_with_values -%}
                      <div class="variant-picker__option" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name | escape | downcase }}">
                        <span class="variant-picker__label">
                          {{ option.name }}: <strong data-selected-value>{{ option.selected_value }}</strong>
                        </span>
                        <div class="variant-picker__pills" role="radiogroup" aria-label="{{ option.name | escape }}">
                          {%- for value in option.values -%}
                            <button
                              type="button"
                              class="pill{% if option.selected_value == value %} is-selected{% endif %}"
                              role="radio"
                              aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                              data-option-value="{{ value | escape }}"
                            >
                              {{ value }}
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- comment -%} Used only for combination matching / availability / featured media — never for price display {%- endcomment -%}
                <script type="application/json" data-product-variants>
                  {{ product.variants | json }}
                </script>
              {%- endunless -%}

            {%- when 'variant_note' -%}
              {%- assign first_note = current_variant.metafields.custom.note_text -%}
              {%- if first_note == blank -%}{%- assign first_note = block.settings.default_text | default: '' -%}{%- endif -%}
              <p class="product-variant-note product-block" data-variant-note {% if first_note == blank %}hidden{% endif %} {{ block.shopify_attributes }}>
                {{- first_note -}}
              </p>
              <template data-variant-note-templates>
                {%- for variant in product.variants -%}
                  <span data-variant-note-id="{{ variant.id }}">{{ variant.metafields.custom.note_text }}</span>
                {%- endfor -%}
              </template>

            {%- when 'trust_strip' -%}
              <ul class="product-trust product-block" {{ block.shopify_attributes }}>
                <li class="product-trust__item">
                  <svg class="product-trust__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <div><b>{{ block.settings.item_1_heading | default: '30 days to decide' }}</b><span>{{ block.settings.item_1_body | default: 'From delivery' }}</span></div>
                </li>
                <li class="product-trust__item">
                  <svg class="product-trust__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 4.5 6v5.2c0 4.6 3.2 8.4 7.5 9.8 4.3-1.4 7.5-5.2 7.5-9.8V6L12 3Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
                  <div><b>{{ block.settings.item_2_heading | default: 'Real people answer' }}</b><span>{{ block.settings.item_2_body | default: 'Email support, in English' }}</span></div>
                </li>
                <li class="product-trust__item">
                  <svg class="product-trust__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16v11H4zM8 7V5h8v2" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M4 12h16" stroke="currentColor" stroke-width="1.75"/></svg>
                  <div><b>{{ block.settings.item_3_heading | default: 'EU prices include VAT' }}</b><span>{{ block.settings.item_3_body | default: 'US prices before sales tax' }}</span></div>
                </li>
              </ul>

            {%- when 'specs_inline' -%}
              {%- if product.metafields.custom.specifications != blank -%}
                <div class="product-facts product-block" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <b class="product-inbox__heading">{{ block.settings.heading }}</b>
                  {%- endif -%}
                  {{ product.metafields.custom.specifications | metafield_tag }}
                </div>
              {%- endif -%}

            {%- when 'witb_inline' -%}
              {%- if product.metafields.custom.what_s_in_the_box != blank -%}
                <div class="product-inbox product-block" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <b class="product-inbox__heading">{{ block.settings.heading }}</b>
                  {%- endif -%}
                  <div class="product-inbox__content">{{ product.metafields.custom.what_s_in_the_box | metafield_tag }}</div>
                </div>
              {%- endif -%}

            {%- when 'quantity' -%}
              {%- comment -%}
                When a buy_buttons block is also present, the quantity
                selector renders inside it instead (next to Add to cart) —
                see the 'buy_buttons' case below. This avoids a duplicate.
              {%- endcomment -%}
              {%- unless has_buy_buttons_block -%}
                <div class="product-quantity product-block" {{ block.shopify_attributes }}>
                  {%- render 'quantity-selector', section_id: section.id -%}
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              {% assign form_id = 'ProductForm-' | append: section.id %}
              {%- form 'product', product, id: form_id, class: 'product-form' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

                <div class="product-form__buy-buttons product-block" id="ProductBuyButtons-{{ section.id }}" {{ block.shopify_attributes }}>
                  {%- if product.selling_plan_groups.size > 0 -%}
                    <div class="product-form__selling-plan">
                      <label for="SellingPlan-{{ section.id }}">{{ 'products.product.purchase_option' | t }}</label>
                      <select name="selling_plan" id="SellingPlan-{{ section.id }}" class="select">
                        <option value="">{{ 'products.product.one_time_purchase' | t }}</option>
                        {%- for group in product.selling_plan_groups -%}
                          {%- for plan in group.selling_plans -%}
                            <option value="{{ plan.id }}">{{ plan.name }}</option>
                          {%- endfor -%}
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- endif -%}

                  <div class="product-form__cart-row{% unless block.settings.show_quantity %} product-form__cart-row--no-qty{% endunless %}">
                    {%- if block.settings.show_quantity -%}
                      {%- render 'quantity-selector', section_id: section.id -%}
                    {%- endif -%}

                    <button
                      type="submit"
                      name="add"
                      class="btn btn--primary product-form__submit{% unless block.settings.show_quantity %} btn--full{% endunless %}"
                      data-add-to-cart
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      {% render 'icon-add-to-cart' %}
                      <span
                        data-add-to-cart-text
                        data-label-available="{{ 'products.product.add_to_cart' | t }}"
                        data-label-sold-out="{{ 'products.product.join_waitlist' | t }}"
                      >
                        {%- if current_variant.available -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- else -%}
                          {{ 'products.product.join_waitlist' | t }}
                        {%- endif -%}
                      </span>
                      <span class="btn__spinner" data-add-to-cart-spinner hidden></span>
                    </button>
                  </div>

                  <p class="product-form__error caption" data-add-to-cart-error hidden></p>

                  {%- if block.settings.show_dynamic_checkout and product.available -%}
                    <div class="product-form__payment-button" data-dynamic-checkout>
                      {{ form | payment_button }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endform -%}

            {%- when 'trust_badges' -%}
              <ul class="pp__trust product-block" {{ block.shopify_attributes }}>
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></svg>
                  {{ block.settings.item_1 | default: 'Ships from our EU warehouse, tracking by email' }}
                </li>
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 3-6.2M4 4v4h4"/></svg>
                  {{ block.settings.item_2 | default: '14 days to return an unopened item' }}
                </li>
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6"/></svg>
                  {{ block.settings.item_3 | default: 'Questions? support@ensoshisha.eu, a person answers' }}
                </li>
              </ul>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product-main__description body-text text-muted product-block" {{ block.shopify_attributes }}>
                  {%- if block.settings.truncate -%}
                    {{ product.description | strip_html | truncatewords: block.settings.truncate_length }}
                  {%- else -%}
                    {{ product.description }}
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.content != blank -%}
                <div
                  class="product-main__text product-block product-main__text--{{ block.settings.alignment }} {% if block.settings.text_size == 'small' %}caption{% else %}body-text{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.show_icon -%}
                    <span class="product-main__text-icon" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                    </span>
                  {%- endif -%}
                  <div>{{ block.settings.content }}</div>
                </div>
              {%- endif -%}

            {%- when 'delivery_dates' -%}
              <div class="product-delivery-dates product-block">
                {% render 'product-delivery-dates' %}
              </div>

            {%- when 'accordion' -%}
              {%- comment -%} Handled in product-main__accordions {%- endcomment -%}

            {%- when 'custom_liquid' -%}
              <div class="product-custom-liquid product-block" {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>

            {%- when 'icon_text_block' -%}
              <div class="icon-text-block product-block inline-mobile-columns-{{ block.settings.inline_mobile_columns }} icon-text-block--{{ block.settings.layout }} {{ block.settings.icon_text_class }}" {{ block.shopify_attributes }}>
                
                {% for i in (1..6) %}
                  {% capture icon_key %}icon_{{ i }}{% endcapture %}
                  {% capture text_key %}text_{{ i }}{% endcapture %}
                  {% assign icon = block.settings[icon_key] %}
                  {% assign text = block.settings[text_key] %}
                  
                  {%- liquid
                    assign lazyload = 'lazy'
                    if forloop.index == 1
                    assign lazyload = 'eager'
                    endif
                  -%}
                    
                  {% if icon != blank or text != blank %}
                    <div data-icon="icon_{{ i }}" class="icon-text-item">
                      {% if icon %}
                        {% assign icon_alt = icon.alt | default: 'trust icon' %}
                        <div class="icon-wrapper icon-wrapper-{{ block.id }}" {% if block.settings.icon_bg_color != blank %}style="background-color: {{ block.settings.icon_bg_color }};"{% endif %}>
                          <img
                            src="{{ icon | image_url: width: 100 }}"
                            alt="{{ icon_alt }}" 
                            width="100" height="{{ icon.height | default: 80 }}"
                            loading="{{ lazyload }}"
                          >
                            <style>
                              .icon-wrapper-{{ block.id }} img {
                                width: {{ block.settings.icon_size }}px;
                              }
                              @media (max-width: 520px) {
                               .icon-wrapper-{{ block.id }} img {
                                  width: {{ block.settings.icon_size | times: 0.75 }}px;
                                } 
                              }
                            </style>
                        </div>
                      {% endif %}
                        
                      {% if text != blank %}
                        <div class="icon-text" style="font-size: {{ block.settings.text_size }}px; color: {{ block.settings.text_color }};">
                          {{ text | replace: '<p>', '' | replace: '</p>', '' }}
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>  

            {%- when 'rating' -%}
              {%- if block.settings.show_empty_rating or product.metafields.loox.avg_rating != blank -%}
                <div class="product-rating product-block" {{ block.shopify_attributes }}>
                  {%- render 'star-rating', rating: product.metafields.loox.avg_rating, review_count: product.metafields.loox.num_reviews -%}
                </div>
              {%- endif -%}

            {%- when 'rich_text_block' -%}
              {%- if block.settings.heading != blank or block.settings.content != blank or block.settings.button_text != blank -%}
                <div
                  class="product-block product-rich-text product-rich-text--{{ block.settings.text_alignment | default: 'text-left' }}{% if block.settings.custom_class != blank %} {{ block.settings.custom_class }}{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if block.settings.background_color != blank or block.settings.text_color != blank %}
                    style="
                      {% if block.settings.background_color != blank %}background-color: {{ block.settings.background_color }};{% endif %}
                      {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                    "
                  {% endif %}
                >
                  {%- if block.settings.icon != blank -%}
                    <span class="product-rich-text__icon" style="width: {{ block.settings.icon_width | default: 24 }}px;" aria-hidden="true">
                      {%- render 'icon-section', icon: block.settings.icon -%}
                    </span>
                  {%- endif -%}
                  <div class="product-rich-text__body">
                    {%- if block.settings.heading != blank -%}
                      <div class="product-rich-text__heading" {% if block.settings.heading_color != blank %}style="color: {{ block.settings.heading_color }};"{% endif %}>
                        {{ block.settings.heading }}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.content != blank -%}
                      <div class="product-rich-text__content body-text text-muted">
                        {{ block.settings.content }}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.button_text != blank -%}
                      <a
                        href="{{ block.settings.button_url }}"
                        class="btn {% if block.settings.button_style == 'outline' %}btn--outline{% else %}btn--primary{% endif %}"
                        {% if block.settings.button_background_color != blank or block.settings.button_text_color != blank %}
                          style="
                            {% if block.settings.button_background_color != blank %}background-color: {{ block.settings.button_background_color }};{% endif %}
                            {% if block.settings.button_text_color != blank %}color: {{ block.settings.button_text_color }};{% endif %}
                          "
                        {% endif %}
                      >
                        {{ block.settings.button_text }}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

            {%- when 'payment_installments' -%}
              <div class="product-payment-installments product-block" {{ block.shopify_attributes }}>
                {%- form 'product', product -%}
                  {{ current_variant | payment_terms }}
                {%- endform -%}
              </div>

            {%- when 'quantity_selector' -%}
              {%- unless has_buy_buttons_block -%}
                <div class="product-quantity-selector product-block" {{ block.shopify_attributes }}>
                  {%- render 'quantity-selector', section_id: section.id -%}
                </div>
              {%- endunless -%}

            {%- when 'share_button' -%}
              <div class="product-block product-share" {{ block.shopify_attributes }}>
                <button type="button" class="product-share__button" onclick="ProductShare(this)">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/><line x1="15.4" y1="6.5" x2="8.6" y2="10.5"/></svg>
                  <span data-share-label>{{ 'products.product.share' | t }}</span>
                </button>
              </div>
              <script>
                function ProductShare(btn) {
                  var url = {{ shop.url | append: product.url | json }};
                  var title = {{ product.title | json }};
                  if (navigator.share) {
                    navigator.share({ title: title, url: url }).catch(function () {});
                  } else if (navigator.clipboard) {
                    navigator.clipboard.writeText(url).then(function () {
                      var label = btn.querySelector('[data-share-label]');
                      var original = label.textContent;
                      label.textContent = {{ 'products.product.link_copied' | json }};
                      setTimeout(function () { label.textContent = original; }, 2000);
                    });
                  }
                }
              </script>

            {%- when 'collapsible_content' -%}
              {%- comment -%} Handled in product-main__accordions {%- endcomment -%}

            {%- when 'addons' -%}
              <div class="product-addons product-block">
                {% render 'product-addons' %}
              </div>

            {%- when '@app' -%}
              <div class="product-app-block product-block">
                {%- render block -%}
              </div>

          {%- endcase -%}
        {%- endfor -%}
    </product-info>

    {%- unless section.settings.accordion_position == 'below_media' -%}
    <div class="product-main__accordions">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'accordion' -%}
            {%- if block.settings.heading != blank and block.settings.content != blank -%}
              <details class="accordion" name="product-accordion-{{ section.id }}" {% if block.settings.default_open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="accordion__heading">
                  {{ block.settings.heading }}
                  <svg class="accordion__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </summary>
                <div class="accordion__content body-text text-muted">
                  {{ block.settings.content }}
                </div>
              </details>
            {%- endif -%}

          {%- when 'collapsible_content' -%}
            {%- if block.settings.heading != blank or block.settings.content != blank -%}
              <details class="accordion" name="product-accordion-{{ section.id }}" {% if block.settings.collapse_open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="accordion__heading">
                  {{ block.settings.heading }}
                  <svg class="accordion__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </summary>
                <div class="accordion__content body-text text-muted">
                  {{ block.settings.content }}
                </div>
              </details>
            {%- endif -%}

        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- endunless -%}

  </div>
</div>

{%- comment -%}
  Only rendered when the section actually has a buy_buttons block — templates
  like the pre-order page use a custom deposit/payment flow instead of a
  normal cart purchase, so a floating "Add to cart" bar there would offer an
  action the page itself doesn't support.
{%- endcomment -%}
{%- if has_buy_buttons_block -%}
  {%- assign sticky_watch_id = 'ProductBuyButtons-' | append: section.id -%}
  {%- render 'sticky-add-to-cart', product: product, section: section, watch_target_id: sticky_watch_id -%}
{%- endif -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% style %}
  .product-main {
    padding-top: var(--product-padding-top);
    padding-bottom: var(--product-padding-bottom);
  }

  @media screen and (min-width: 750px) {
    .product-main {
      padding-top: var(--product-padding-top-desktop);
      padding-bottom: var(--product-padding-bottom-desktop);
    }
  }

  .product-main__inner {
    display: grid;
    grid-template-columns: var(--product-media-width, 50%) 1fr;
    grid-template-areas:
      "media content"
      "media accordions";
    column-gap: var(--space-8);
    row-gap: 0;
    align-items: start;
  }

  .product-main__media      { grid-area: media; min-width: 0; }
  .product-main__content    { grid-area: content; }
  .product-main__accordions { grid-area: accordions; min-width: 0; }

  @media screen and (max-width: 989px) {
    .product-main__inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "media"
        "content"
        "accordions";
      gap: var(--space-4);
    }
  }

  /* Accordions below media (product.custom-enso template).
     A left-col flex wrapper stacks media + accordions; the grid is
     a plain 2-column layout so row heights can never shift. */
  .product-main--acc-below .product-main__inner {
    grid-template-columns: var(--product-media-width, 50%) 1fr;
    grid-template-areas: "left content";
    grid-template-rows: auto;
    row-gap: 0;
  }
  .product-main--acc-below .product-main__left-col {
    grid-area: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-self: start;
  }
  .product-main--acc-below .product-main__left-col .product-main__media {
    width: 100%;
  }
  .product-main--acc-below .product-main__content {
    grid-area: content;
  }

  @media screen and (min-width: 990px) {
    .product-main--sticky .product-main__media {
      position: sticky;
      top: var(--space-6);
      align-self: start;
    }
  }

  .product-main__content {
    /* padding-inline: var(--page-margin-mobile); */
  }

  @media screen and (min-width: 750px) {
    .product-main__content {
      /* padding-inline: var(--page-margin); */
    }
  }

  /* Mobile: product info rendered as a rounded card */
  @media screen and (max-width: 989px) {
    .product-main__content {
      background: var(--color-background-raised, rgba(0,0,0,0.03));
      border-radius: var(--radius-xl);
      padding: var(--space-5);
    }
  }

  /* Close the accordion list with a bottom border on the last item */
  .product-main__accordions .accordion:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  /* ---------- Media gallery ---------- */
  .product-gallery { display: block; }

  .media-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    background: rgba(0, 0, 0, 0.05);
    border-radius: var(--radius-xl);
  }
  .media-placeholder__mark { width: 30%; height: auto; opacity: 0.4; }

  .product-gallery__image,
  .product-gallery__video,
  .product-gallery__model {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .product-gallery--thumbnails_bottom .product-gallery__thumbs {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
    overflow-x: auto;
  }

  .product-gallery--thumbnails_left {
    display: flex;
    flex-direction: row-reverse;
    gap: var(--space-4);
  }
  .product-gallery--thumbnails_left .product-gallery__main { flex: 1; min-width: 0; }

  .product-gallery__main {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    /* Let the page scroll vertically as usual; the gallery's own JS
       (pointer events) handles horizontal swipe/drag itself. */
    touch-action: pan-y;
  }
  .product-gallery__main .custom-wishlist-button {
    position: absolute;
    right: 10px;
    top: 10px;
    z-index: 2;
  }

  /*
    Slides sit side by side in a flex row; changing slides (via swipe, drag,
    or a thumbnail click) just moves this row with translateX — .is-dragging
    drops the transition so a finger/pointer drag tracks 1:1 with no lag,
    turned back on for the settle/snap once the drag ends.
  */
  .product-gallery__track {
    display: flex;
    transition: transform 0.35s var(--ease-out);
  }
  .product-gallery__track.is-dragging {
    transition: none;
  }

  .product-gallery__item {
    flex: 0 0 100%;
    min-width: 0;
  }

  .product-gallery--thumbnails_left .product-gallery__thumbs-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    max-height: 600px;
  }

  .product-gallery--thumbnails_left .product-gallery__thumbs {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    overflow-y: auto;
    min-height: 0;
    scrollbar-width: none;
  }
  .product-gallery--thumbnails_left .product-gallery__thumbs::-webkit-scrollbar {
    display: none;
  }

  /* Only shown by JS once the thumbnail column actually overflows its
     max-height (see product-form.js) — scrolls the column by roughly one
     thumbnail at a time instead of relying on the hidden scrollbar. A bare
     chevron, no chip/border/shadow behind it — just an icon sitting in the
     open space past the last thumbnail. */
  .product-gallery__thumbs-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 50%;
    background: rgb(255, 255, 255);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: var(--color-text);
    opacity: 0.8;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }
  .product-gallery__thumbs-arrow:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.5);
  }
  .product-gallery__thumbs-arrow .icon-chevron {
    width: 14px;
    height: 14px;
  }
  /* Desktop: column of thumbnails, arrows point up/down. */
  .product-gallery__thumbs-arrow--prev .icon-chevron {
    transform: rotate(180deg);
  }
  .product-gallery__thumbs-arrow[hidden] {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .product-gallery--thumbnails_left {
      /* DOM order is [main, thumbs-wrap]; plain column keeps that order
         (image on top, thumbnail row below) — column-reverse was flipping
         it, putting the thumbnail row above the image on mobile. */
      flex-direction: column;
    }
    /* Row of thumbnails flanked by arrows, mirroring the desktop column —
       same overflow-arrow pattern, rotated. min-width: 0 on every level is
       load-bearing here: without it the row's intrinsic content width (not
       its scrollable width) forces this flex item, its ancestors, and
       ultimately the page itself wider than the viewport instead of
       scrolling in place. */
    .product-gallery--thumbnails_left .product-gallery__thumbs-wrap {
      flex-direction: row;
      gap: 0;
      max-height: none;
      min-width: 0;
      width: 100%;
      position: relative;
    }
    .product-gallery--thumbnails_left .product-gallery__thumbs {
      flex-direction: row;
      gap: var(--space-1);
      overflow-x: auto;
      overflow-y: visible;
      flex: 1;
      min-width: 0;
    }
    /* Arrows float over the thumbnail row instead of reserving their own
       flex column — keeps the row (and its thumbnails) spanning the full
       width instead of leaving a blank gap where an arrow used to sit. */
    .product-gallery--thumbnails_left .product-gallery__thumbs-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
    }
    .product-gallery--thumbnails_left .product-gallery__thumbs-arrow--prev {
      left: 0;
    }
    .product-gallery--thumbnails_left .product-gallery__thumbs-arrow--next {
      right: 0;
    }
    .product-gallery__thumbs-arrow--prev .icon-chevron {
      transform: rotate(90deg);
    }
    .product-gallery__thumbs-arrow--next .icon-chevron {
      transform: rotate(-90deg);
    }
  }

  .product-gallery__thumb {
    position: relative;
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 2px solid transparent;
    opacity: 0.6;
    padding: 0;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }
  .product-gallery__thumb.is-active,
  .product-gallery__thumb:hover {
    opacity: 1;
    border-color: var(--color-accent);
  }
  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-gallery__thumb-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.35);
    color: #fff;
  }

  /* no_thumbnails layout reuses the global .carousel__track scaffolding */
  .product-gallery__scroller .carousel__track > * {
    flex: 0 0 90%;
  }
  @media screen and (min-width: 750px) {
    .product-gallery__scroller .carousel__track > * {
      flex: 0 0 100%;
    }
  }

  /* ---------- Content blocks ---------- */
  .product-main__type { opacity: 0.7; }
  .product-main__text.caption { font-size: 13px; }

  .product-main__title {
    margin: 0;
    line-height: 1.21;
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    letter-spacing: -0.025em;
  }

  .product-main__description {
    margin-top: var(--space-5);
  }

  /* ---------- Price ---------- */
  .price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .price__current { color: var(--color-text); font-size: 28px; font-family: var(--font-accent); font-weight: var(--font-weight-bold); }
  /* .price--on-sale .price__current--sale { color: #c0392b; } */
  .price__compare-at { opacity: 0.6; }
  .price__sold-out { opacity: 0.6; }
  .price__unit { display: block; width: 100%; opacity: 0.7; }

  /* ---------- Variant picker ---------- */
  .variant-picker { margin-top: var(--space-5); display: flex; flex-direction: column; gap: var(--space-4); }
  .variant-picker__label { font-size: 14px; }
  .variant-picker__pills { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }

  .pill {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
    font-size: 14px;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }
  .pill:hover { border-color: var(--color-accent); }
  .pill.is-selected { border-color: var(--color-accent); border-width: 2px; }
  .pill.is-unavailable { opacity: 0.35; text-decoration: line-through; cursor: not-allowed; }

  /* ---------- Quantity ---------- */
  .quantity {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    margin-top: var(--space-5);
    width: fit-content;
  }
  .quantity__button {
    width: 40px;
    background: transparent;
    font-size: 18px;
    cursor: pointer;
  }
  .quantity__input {
    width: 48px;
    border: none;
    text-align: center;
    background: transparent;
    -moz-appearance: textfield;
  }
  .quantity__input::-webkit-outer-spin-button,
  .quantity__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .quantity {
    height: 44px;
  }
  @media screen and (max-width: 749px) {
    .quantity {
      height: 40px;
    }
  }

  /* ---------- Savings badge ---------- */
  .price__savings {
    display: inline-flex;
    align-items: center;
    align-self: center;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background-color: var(--badge-sale-bg);
    color: var(--badge-sale-text);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
  }
  @media screen and (max-width: 749px) {
    .price__savings {
      font-size: 10px;
    }
  }

  /* ---------- Buy buttons ---------- */
  .product-form__buy-buttons { margin-top: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-3); }
  .product-form__selling-plan { display: flex; flex-direction: column; gap: var(--space-2); }

  /* Quantity + Add to cart on one row; dynamic checkout stays its own full-width row below */
  .product-form__cart-row {
    display: flex;
    align-items: stretch;
    gap: var(--space-3);
  }
  .product-form__cart-row .quantity {
    margin-top: 0;
    flex-shrink: 0;
  }
  .product-form__cart-row .product-form__submit {
    flex: 1;
  }

  .product-form__cart-row .product-form__submit svg {
    width: 20px;
    height: 20px;
  }

  .product-form__submit { position: relative; }
  .product-form__submit[data-loading] span:first-child { visibility: hidden; }
  .btn__spinner {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: product-spin 0.6s linear infinite;
  }
  @keyframes product-spin { to { transform: rotate(360deg); } }
  .product-form__error { color: #c0392b; margin: 0; }

  /* ---------- Text block ---------- */
  .product-main__text {
    margin-top: var(--space-4);
    display: flex;
    gap: var(--space-2);
  }
  .product-main__text--center { justify-content: center; text-align: center; }
  .product-main__text--right { justify-content: flex-end; text-align: right; }

  /* ---------- Accordion ---------- */
  .accordion {
    margin-top: 0;
    border-top: 1px solid var(--color-border);
    padding: var(--space-4) 0;
  }
  .accordion__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-family: var(--font-heading);
    list-style: none;
    font-weight: 600;
  }
  .accordion__heading::-webkit-details-marker { display: none; }
  .accordion__icon { display: none; }
  .accordion__heading::after {
    content: "+";
    font: 400 22px/1 var(--font-body, sans-serif);
    flex-shrink: 0;
    color: var(--color-text);
  }
  .accordion[open] > .accordion__heading::after { content: "−"; }
  .accordion__content {
    margin-top: var(--space-3);
    display: flow-root;
  }
  .product-main__content .accordion__content h1,
  .product-main__content .accordion__content h2 {
    font-size: 20px;
    margin-bottom: 8px;
    color: var(--color-text);
  }
  .product-main__content .accordion__content h3,
  .product-main__content .accordion__content h4,
  .product-main__content .accordion__content h5,
  .product-main__content .accordion__content h6 {
    font-size: 18px;
    margin-bottom: 8px;
    color: var(--color-text);
  }
  .product-main__content .accordion__content img,
  .product-main__content .accordion__content video {
    max-width: 100%;
  }

  /* ---------- Rich text block ---------- */
  .product-rich-text {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: var(--space-4);
    background-color: var(--color-background-raised);
    border-radius: var(--radius-lg);
  }
  .product-rich-text + .product-rich-text {
    margin-top: var(--space-3);
  }
  .product-rich-text--text-center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .product-rich-text__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    box-sizing: content-box;
    padding: 8px;
    border-radius: 50%;
    background-color: var(--color-accent-soft, rgba(200, 148, 58, 0.12));
    color: var(--color-accent);
  }
  .product-rich-text__icon svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .product-rich-text__heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
  }
  .product-rich-text__content {
    margin-top: var(--space-1);
    font-size: 14px;
  }
  .product-rich-text .btn {
    margin-top: var(--space-3);
  }

  /* ---------- Share button ---------- */
  .product-share {
    margin-top: var(--space-4);
  }
  .product-share__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 14px;
    color: var(--color-text-muted);
  }
  .product-share__button:hover {
    color: var(--color-text);
  }
{% endstyle %}

{% style %}

  /* ---------- Stock badge ---------- */
  .product-stock-badge { margin-top: 0; }
  .product-stock-badge__text {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: rgb(0 0 0 / .72);
    margin: 0;
  }
  .product-stock-badge__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(0 0 0 / .3);
    box-shadow: none;
    flex: none;
  }
  .product-stock-badge__dot--in {
    background: #16a34a;
    box-shadow: 0 0 0 3px rgb(22 163 74 / .2);
  }

  /* ---------- Tags / chips ---------- */
  .product-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .product-chip {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 13px;
    color: var(--color-text);
  }
  .product-chip--compat {
    background: var(--palette-mist, #f5f5f4);
    border-color: transparent;
    font-weight: var(--font-weight-bold);
  }

  /* ---------- Trust badges ---------- */
  .pp__trust {
    list-style: none;
    padding: 0;
    margin: 20px 0 8px;
    display: grid;
    gap: 10px;
    font-size: 14px;
    color: rgb(0 0 0 / .75);
  }
  .pp__trust li {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .pp__trust svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7px;
    flex: none;
  }

  /* ---------- Card variant picker ---------- */
  .variant-card-picker { margin-top: var(--space-5); }
  .variant-card-picker__group { display: flex; flex-direction: column; gap: 8px; }
  .variant-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1.5px solid var(--color-border);
    border-radius: 10px;
    padding: 12px 14px;
    background: var(--color-background);
    cursor: pointer;
    text-align: left;
    width: 100%;
    transition: border-color 0.15s ease;
  }
  .variant-card.is-selected { border-color: var(--color-text); }
  .variant-card:hover:not(.is-selected) { border-color: var(--color-accent); }
  .variant-card.is-unavailable { opacity: 0.4; cursor: not-allowed; text-decoration: none; }
  .variant-card__left { display: flex; flex-direction: column; gap: 2px; }
  .variant-card__name { font-size: 15px; font-weight: 600; }
  .variant-card__avail { font-size: 13px; color: var(--color-text-muted); font-weight: 400; }
  .variant-card__price {
    font-style: normal;
    font-family: var(--font-accent);
    font-weight: 800;
    font-size: 17px;
    flex: none;
    color: var(--color-text);
  }

  /* ---------- Variant note ---------- */
  .product-variant-note {
    font-size: 13px;
    color: rgb(0 0 0 / .65);
    line-height: 1.55;
    margin: 0;
  }

  /* ---------- Trust strip ---------- */
  .product-trust {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: 16px;
  }
  .product-trust__item {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 13px;
    line-height: 1.4;
  }
  .product-trust__item b { color: var(--color-text); display: block; font-weight: 600; }
  .product-trust__item span { display: block; color: rgb(0 0 0 / .6); }
  .product-trust__icon { width: 20px; height: 20px; color: var(--color-text); flex: none; margin-bottom: 2px; }

  /* ---------- Specs inline (2-col bullets) ---------- */
  .product-facts {
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }
  .product-facts ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 20px;
  }
  .product-facts li {
    font-size: 14px;
    line-height: 1.55;
    color: rgb(0 0 0 / .78);
    padding-left: 14px;
    position: relative;
  }
  .product-facts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-text);
  }

  /* ---------- Specifications ---------- */
  .product-facts {
    border-top: 1px solid var(--color-border);
    padding-top: 16px;
  }

  /* ---------- In the box ---------- */
  .product-inbox {
    border-top: 1px solid var(--color-border);
    padding-top: 16px;
  }
  .product-inbox__heading {
    display: block;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 4px;
    font-size: 14px;
  }
  .product-inbox__content {
    font-size: 14px;
    line-height: 1.55;
    color: rgb(0 0 0 / .72);
  }
  .product-inbox__content p { margin: 0; }
  .product-inbox__content a { color: inherit; text-decoration: none; }
  .product-inbox__content ul { list-style: disc; padding-left: 18px; margin: 4px 0 0; }
  .product-inbox__content li { padding-left: 2px; }

  @media screen and (max-width: 749px) {
    .product-facts ul { grid-template-columns: 1fr; }
  }

  /* Bordered product info card */
  .product-main__content--bordered {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 28px 24px;
  }
  @media screen and (max-width: 989px) {
    .product-main__content--bordered {
      padding: var(--space-5);
    }
  }

{% endstyle %}

{% javascript %}
  document.addEventListener('variant:change', function (e) {
    var variant = e.detail && e.detail.variant;
    if (!variant) return;

    var badge = document.querySelector('[data-stock-badge]');
    var badgeTpl = document.querySelector('[data-stock-badge-templates]');
    if (badge && badgeTpl) {
      var bItem = badgeTpl.content.querySelector('[data-variant-stock-id="' + variant.id + '"]');
      if (bItem) badge.innerHTML = bItem.innerHTML;
    }

    var note = document.querySelector('[data-variant-note]');
    var noteTpl = document.querySelector('[data-variant-note-templates]');
    if (note && noteTpl) {
      var nItem = noteTpl.content.querySelector('[data-variant-note-id="' + variant.id + '"]');
      var text = nItem ? nItem.textContent.trim() : '';
      note.textContent = text;
      note.hidden = !text;
    }
  });

  if (!('HTMLDetailsElement' in window) || !('name' in HTMLDetailsElement.prototype)) {
    document.addEventListener('toggle', function (event) {
      var details = event.target;
      if (!(details instanceof HTMLDetailsElement) || !details.open) return;
      var name = details.getAttribute('name');
      if (!name) return;
      document.querySelectorAll('details[name="' + name + '"]').forEach(function (other) {
        if (other !== details) other.open = false;
      });
    }, true);
  }
{% endjavascript %}

