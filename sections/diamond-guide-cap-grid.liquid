{% stylesheet %}

.dg-cap__inner {
  padding: 96px 0;
  border-top: 1px solid var(--color-border);
}

.dg-cap__head {
  max-width: 62ch;
  margin-bottom: 40px;
}

.dg-cap__head .eyebrow {
  margin: 0 0 10px;
  font-size: 13px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.dg-cap__head h2 {
  font-family: var(--font-accent);
  font-weight: 800;
  font-size: 44px;
  line-height: 50px;
  letter-spacing: -.025em;
  margin: 0 0 16px;
  text-wrap: balance;
}

.dg-cap__sub {
  font-size: 15px;
  color: rgb(0 0 0 / .72);
  margin: 0;
}

.dg-cap__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.dg-cap__grid figure {
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.dg-cap__grid figure img {
  width: 100%;
  aspect-ratio: 4 / 5;
  max-height: 520px;
  object-fit: cover;
  border-radius: 22px;
  border: 1px solid var(--color-border);
  background: #f5f5f4;
  display: block;
}

.dg-cap__placeholder {
  width: 100%;
  aspect-ratio: 4 / 5;
  display: block;
  border-radius: 22px;
  border: 1px solid var(--color-border);
  background: #f5f5f4;
}

.dg-cap__grid figcaption {
  display: grid;
  gap: 4px;
  order: -1;
}

.dg-cap__grid figcaption b {
  display: block;
  font-size: 18px;
  font-weight: var(--font-weight-semibold);
  line-height: 24px;
}

.dg-cap__grid figcaption span {
  display: block;
  font-size: 15px;
  color: rgb(0 0 0 / .72);
  line-height: 23px;
}

@media screen and (max-width: 991px) {
  .dg-cap { padding: 64px 0; }
  .dg-cap__head h2 {
    font-size: 30px;
    line-height: 36px;
  }
  .dg-cap__grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }
}

{% endstylesheet %}

{% style %}
  #shopify-section-{{ section.id }} .dg-cap__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    #shopify-section-{{ section.id }} .dg-cap__inner {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section class="dg-cap" id="{{ section.settings.section_id | default: section.id }}">
  <div class="container">
    <div class="dg-cap__inner">
    <div class="dg-cap__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading | default: 'Open, load, close' | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="dg-cap__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="dg-cap__grid">
        {%- for block in section.blocks -%}
          <figure {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{- block.settings.image | image_url: width: 800 | image_tag:
                alt: block.settings.image.alt | default: block.settings.label,
                loading: 'lazy',
                widths: '400,600,800',
                sizes: '(max-width: 991px) 100vw, 33vw'
              -}}
            {%- else -%}
              <svg class="dg-cap__placeholder" viewBox="0 0 4 5" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="4" height="5" fill="#f0ede8"/>
                <path d="M1.6 2.5 L2 1.9 L2.4 2.5 M1.75 2.5 L2.25 2.5 M2 2.5 L2 3.1" stroke="#c8b89a" stroke-width="0.08" stroke-linecap="round"/>
              </svg>
            {%- endif -%}
            <figcaption>
              <b>{{ block.settings.label | escape }}</b>
              {%- if block.settings.caption != blank -%}
                <span>{{ block.settings.caption | escape }}</span>
              {%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.diamond_guide_cap_grid.name",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "t:sections.diamond_guide_cap_grid.settings.section_id.label",
      "info": "t:sections.diamond_guide_cap_grid.settings.section_id.info"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.diamond_guide_cap_grid.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_guide_cap_grid.settings.heading.label",
      "default": "Open, load, close"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.diamond_guide_cap_grid.settings.subheading.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0
    }
  ],
  "blocks": [
    {
      "type": "figure",
      "name": "t:sections.diamond_guide_cap_grid.blocks.figure.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.diamond_guide_cap_grid.blocks.figure.settings.image.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.diamond_guide_cap_grid.blocks.figure.settings.label.label",
          "default": "Step"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.diamond_guide_cap_grid.blocks.figure.settings.caption.label"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.diamond_guide_cap_grid.presets.name"
    }
  ]
}
{% endschema %}
