{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme

  assign height_desktop_custom_css = section.settings.height_desktop_custom | append: 'px'
  assign height_tablet_custom_css = section.settings.height_tablet_custom | append: 'px'
  assign height_mobile_custom_css = section.settings.height_mobile_custom | append: 'px'

  assign content_width_desktop_css = 'none'
  if section.settings.content_width_desktop > 0
    assign content_width_desktop_css = section.settings.content_width_desktop | append: 'px'
  endif

  assign content_width_tablet_css = 'none'
  if section.settings.content_width_tablet > 0
    assign content_width_tablet_css = section.settings.content_width_tablet | append: 'px'
  endif

  assign content_width_mobile_css = 'none'
  if section.settings.content_width_mobile > 0
    assign content_width_mobile_css = section.settings.content_width_mobile | append: 'px'
  endif
-%}

<section
  class="split {{ scheme_class }} split--width-{{ section.settings.width }} {% if section.settings.width == 'page' %}container{% endif %} split--height-mobile-{{ section.settings.height_mobile }} split--height-tablet-{{ section.settings.height_tablet }} split--height-desktop-{{ section.settings.height_desktop }} split--align-{{ section.settings.content_alignment }}"
  style="
    --split-margin-top: {{ section.settings.margin_top }}px;
    --split-margin-bottom: {{ section.settings.margin_bottom }}px;
    --split-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --split-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --split-overlay-color: {{ section.settings.overlay_color }};
    --split-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --split-gap: {{ section.settings.image_gap }}px;
    --split-height-desktop-custom: {{ height_desktop_custom_css }};
    --split-height-tablet-custom: {{ height_tablet_custom_css }};
    --split-height-mobile-custom: {{ height_mobile_custom_css }};
    --split-content-width-desktop: {{ content_width_desktop_css }};
    --split-content-width-tablet: {{ content_width_tablet_css }};
    --split-content-width-mobile: {{ content_width_mobile_css }};
  "
>
  <div class="split__inner">
    <div class="split__row split__row--count-{{ section.blocks.size }} container">
      {%- for block in section.blocks limit: 3 -%}
        {%- liquid
          assign has_image = false
          if block.settings.image != blank or block.settings.image_mobile != blank
            assign has_image = true
          endif

          assign heading_style = ''
          if block.settings.heading_color != blank
            assign heading_style = 'color: ' | append: block.settings.heading_color | append: ';'
          endif
        -%}
        <div class="split__item" {{ block.shopify_attributes }}>
          <div class="split__media">
            {%- if block.settings.image_mobile != blank -%}
              <img
                class="split__image split__image--mobile"
                src="{{ block.settings.image_mobile | image_url: width: 800 }}"
                alt="{{ block.settings.image_mobile.alt | default: block.settings.heading | escape }}"
                width="{{ block.settings.image_mobile.width }}"
                height="{{ block.settings.image_mobile.height }}"
                loading="eager"
                fetchpriority="high"
              >
            {%- endif -%}

            {%- if block.settings.image != blank -%}
              <img
                class="split__image split__image--desktop"
                src="{{ block.settings.image | image_url: width: 1200 }}"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="eager"
                fetchpriority="high"
              >
            {%- elsif block.settings.image_mobile == blank -%}
              <div class="split__placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'split__placeholder-svg' }}
              </div>
            {%- endif -%}

            {%- if has_image and section.settings.overlay_opacity > 0 -%}
              <div class="split__overlay"></div>
            {%- endif -%}
          </div>

          {%- if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button != blank -%}
            <div class="split__content container">
              <div class="split__content-inner">
                {%- if block.settings.heading != blank -%}
                  <h2 class="split__heading"{% if heading_style != blank %} style="{{ heading_style }}"{% endif %}>
                    {{ block.settings.heading }}
                  </h2>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <div class="split__subheading"{% if heading_style != blank %} style="{{ heading_style }}"{% endif %}>
                    <p>{{ block.settings.subheading }}</p>
                  </div>
                {%- endif -%}
                {%- if block.settings.button != blank -%}
                  <a class="btn btn--primary" href="{{ block.settings.button_url }}">
                    {{ block.settings.button }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- if request.design_mode -%}
          <p class="body-text text-muted">{{ 'sections.split_showcase.onboarding' | t }}</p>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .split {
    position: relative;
    margin-top: var(--split-margin-top);
    margin-bottom: calc(var(--split-margin-bottom) + var(--space-4));
  }

  .split__inner {
    position: relative;
    width: 100%;
  }

  .split--width-page .split__inner {
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .split__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--split-gap);
  }

  @media screen and (min-width: 768px) {
    .split__row {
      grid-template-columns: 1fr 1fr;
    }

    .split__row--count-3 {
      grid-template-columns: 2.2fr 1.4fr 1fr;
      align-items: stretch;
    }

    .split__row--count-3 .split__item,
    .split__row--count-3 .split__media {
      height: 100%;
    }

    .split__row--count-3 .split__image {
      position: absolute;
      inset: 0;
      height: 100%;
    }

    /* Secondary + accessory columns read smaller and quieter than the main column */
    .split__row--count-3 .split__item:nth-child(2) .split__heading {
      font-size: calc(var(--split-heading-size-desktop) * 0.72);
    }

    .split__row--count-3 .split__item:nth-child(3) .split__heading {
      font-size: calc(var(--split-heading-size-desktop) * 0.58);
    }

    .split__row--count-3 .split__item:nth-child(2) .split__subheading,
    .split__row--count-3 .split__item:nth-child(3) .split__subheading {
      font-size: 0.85em;
    }

    .split__row--count-3 .split__item:nth-child(3) .split__content {
      padding: var(--space-4);
    }
  }

  @media screen and (max-width: 767px) {
    .split__row--count-3 .split__item:nth-child(2) .split__heading,
    .split__row--count-3 .split__item:nth-child(3) .split__heading {
      font-size: calc(var(--split-heading-size-mobile) * 0.8);
    }
  }

  .split__item {
    position: relative;
  }

  .split__media {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .split--width-page .split__media {
    border-radius: 8px;
  }

  .split__row--count-3 .split__media {
    border-radius: 10px;
  }

  .split__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .split__image--mobile {
    display: none;
  }

  @media screen and (max-width: 767px) {
    .split__image--mobile {
      display: block;
    }
    .split__image--mobile ~ .split__image--desktop {
      display: none;
    }
  }

  /* Fixed height variants: image and placeholder fill the box.
     Each viewport tier (mobile / tablet / desktop) carries its own class
     on the section at all times — only the media query below decides
     which tier's rules are actually in effect at a given width. */
  @media screen and (max-width: 749px) {
    .split--height-mobile-small .split__media,
    .split--height-mobile-small .split__placeholder {
      min-height: 220px;
    }
    .split--height-mobile-medium .split__media,
    .split--height-mobile-medium .split__placeholder {
      min-height: 300px;
    }
    .split--height-mobile-large .split__media,
    .split--height-mobile-large .split__placeholder {
      min-height: 380px;
    }
    .split--height-mobile-auto .split__placeholder {
      min-height: 200px;
    }
    .split--height-mobile-custom .split__media,
    .split--height-mobile-custom .split__placeholder {
      min-height: var(--split-height-mobile-custom);
    }
    .split--height-mobile-small .split__image,
    .split--height-mobile-medium .split__image,
    .split--height-mobile-large .split__image,
    .split--height-mobile-custom .split__image {
      position: absolute;
      inset: 0;
      height: 100%;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .split--height-tablet-small .split__media,
    .split--height-tablet-small .split__placeholder {
      min-height: 260px;
    }
    .split--height-tablet-medium .split__media,
    .split--height-tablet-medium .split__placeholder {
      min-height: 340px;
    }
    .split--height-tablet-large .split__media,
    .split--height-tablet-large .split__placeholder {
      min-height: 420px;
    }
    .split--height-tablet-auto .split__placeholder {
      min-height: 260px;
    }
    .split--height-tablet-custom .split__media,
    .split--height-tablet-custom .split__placeholder {
      min-height: var(--split-height-tablet-custom);
    }
    .split--height-tablet-small .split__image,
    .split--height-tablet-medium .split__image,
    .split--height-tablet-large .split__image,
    .split--height-tablet-custom .split__image {
      position: absolute;
      inset: 0;
      height: 100%;
    }
  }

  @media screen and (min-width: 990px) {
    .split--height-desktop-small .split__media,
    .split--height-desktop-small .split__placeholder {
      min-height: 300px;
    }
    .split--height-desktop-medium .split__media,
    .split--height-desktop-medium .split__placeholder {
      min-height: 380px;
    }
    .split--height-desktop-large .split__media,
    .split--height-desktop-large .split__placeholder {
      min-height: 460px;
    }
    .split--height-desktop-auto .split__placeholder {
      min-height: 320px;
    }
    .split--height-desktop-custom .split__media,
    .split--height-desktop-custom .split__placeholder {
      min-height: var(--split-height-desktop-custom);
    }
    .split--height-desktop-small .split__image,
    .split--height-desktop-medium .split__image,
    .split--height-desktop-large .split__image,
    .split--height-desktop-custom .split__image {
      position: absolute;
      inset: 0;
      height: 100%;
    }
  }

  .split__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: rgba(0, 0, 0, 0.05);
  }

  .split__placeholder-svg {
    width: 40%;
    height: auto;
    opacity: 0.4;
  }

  .split__overlay {
    position: absolute;
    inset: 0;
    background: var(--split-overlay-color);
    opacity: var(--split-overlay-opacity);
    pointer-events: none;
  }

  .split__row--count-3 .split__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 55%);
    pointer-events: none;
  }

  .split__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--page-margin-mobile);
  }

  .split__row--count-3 .split__content {
    justify-content: flex-end;
    padding: var(--space-5) var(--space-4);
  }

  .split--align-center .split__content {
    align-items: center;
    text-align: center;
  }

  .split--align-left .split__content {
    align-items: flex-start;
    text-align: left;
  }

  .split__content-inner {
    max-width: var(--split-content-width-mobile);
  }

  .split__heading {
    margin: 0;
    font-size: var(--split-heading-size-mobile);
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .split__content-inner {
      max-width: var(--split-content-width-tablet);
    }
  }

  @media screen and (min-width: 768px) {
    .split__heading {
      font-size: var(--split-heading-size-desktop);
    }
    .split__content {
      padding: var(--page-margin);
    }
  }

  @media screen and (min-width: 990px) {
    .split__content-inner {
      max-width: var(--split-content-width-desktop);
    }
  }
  .split__content-inner {
      text-align: left;
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      padding: 40px 20px 20px;
  }

  .split__heading {
      margin: 0;
  }

  .split__subheading {
      max-width: 400px;
  }

  .split__inner {
      padding: 50px 0px;
      background: #fff;
  }

  .split__row.split__row--count-3.container {
      max-width: 1640px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Split showcase",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-paper"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "page", "label": "Page width" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Gap between images",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Image height (desktop)",
      "options": [
        { "value": "auto", "label": "Auto (based on image)" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "height_desktop_custom",
      "label": "Custom height (desktop)",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 500,
      "visible_if": "{{ section.settings.height_desktop == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height_tablet",
      "label": "Image height (tablet)",
      "options": [
        { "value": "auto", "label": "Auto (based on image)" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "height_tablet_custom",
      "label": "Custom height (tablet)",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 500,
      "visible_if": "{{ section.settings.height_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Image height (mobile)",
      "options": [
        { "value": "auto", "label": "Auto (based on image)" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "height_mobile_custom",
      "label": "Custom height (mobile)",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 500,
      "visible_if": "{{ section.settings.height_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_width_desktop",
      "label": "Content width (desktop)",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 600,
      "info": "0 = no limit"
    },
    {
      "type": "range",
      "id": "content_width_tablet",
      "label": "Content width (tablet)",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 500,
      "info": "0 = no limit"
    },
    {
      "type": "range",
      "id": "content_width_mobile",
      "label": "Content width (mobile)",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 0,
      "info": "0 = no limit"
    },
    {
      "type": "header",
      "content": "Heading size"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 3,
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image (below 768px)",
          "info": "Optional. If empty, the desktop image is used on mobile too."
        },
        {
          "type": "header",
          "content": "Heading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color"
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "label": "Text"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split showcase",
      "blocks": [
        { "type": "column", "settings": { "heading": "Add a heading" } },
        { "type": "column", "settings": { "heading": "Add a heading" } }
      ]
    }
  ]
}
{% endschema %}