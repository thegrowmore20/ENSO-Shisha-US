{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text
  assign faqs = product.metafields.custom.faqs.value
-%}

{%- if faqs != blank -%}
<section class="faq-section {{ scheme_class }} section-padding">

  <div class="container faq-section__inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="faq-section__header">

        {%- if section.settings.eyebrow != blank -%}
          <p class="faq-section__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="faq-section__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

      </div>
    {%- endif -%}


    <div class="faq-section__body">

      {%- for faq in faqs -%}

        {%- if faq.question == blank -%}
          {%- continue -%}
        {%- endif -%}

        <details class="faq-item" data-accordion>

          <summary class="faq-item__trigger">

            <span class="faq-item__question">
              {{ faq.question }}
            </span>

            <span class="faq-item__icon">
              {%- render 'icon-chevron' -%}
            </span>

          </summary>

          <div class="faq-item__panel">

            <div class="faq-item__answer">
              {{ faq.answer | metafield_tag }}
            </div>

          </div>

        </details>

      {%- endfor -%}

    </div>

  </div>

</section>
{%- endif -%}


{% stylesheet %}

/* Layout */

.faq-section {
  padding-bottom: 40px !important;
}

.faq-section__inner {
  max-width: 1280px;
  margin-inline: auto;
}


/* Header */

.faq-section__header {
  text-align: left;
  margin-bottom: 24px;
}

.faq-section__eyebrow {
  display: none;
}

.faq-section__heading {
  font-weight: 600;
  margin: 0;
  text-align: center;
}


/* FAQ List */

.faq-section__body {
  opacity: 1;
}

.faq-item {
  border-top: 1px solid rgb(0 0 0 / .1);
  border-radius: 0;
  background: none;
}

.faq-item:last-child {
  border-bottom: 1px solid rgb(0 0 0 / .1);
}


/* Question */

.faq-item__trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 26px 0;
  cursor: pointer;
  list-style: none;
  user-select: none;
}

.faq-item__trigger::-webkit-details-marker {
  display: none;
}

.faq-item__question {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.4;
  flex: 1;
}


/* Icon */

.faq-item__icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: auto;
  border-radius: 0;
  background: none;
  color: inherit;
  transition: none;
}

.faq-item__icon svg {
  display: none;
}

.faq-item__icon::after {
  content: "+";
  font: 400 26px/1 Inter, sans-serif;
}

details[open] .faq-item__icon {
  transform: none;
}

details[open] .faq-item__icon::after {
  content: "−";
}


/* Answer */

.faq-item__panel {
  overflow: hidden;
}

.faq-item__answer {
  padding: 0 0 28px;
  max-width: 80ch;
  color: rgb(0 0 0 / .72);
  font-size: .9375rem;
  line-height: 1.7;
}

.faq-item__answer p {
  margin: 0 0 12px;
}

.faq-item__answer p:last-child {
  margin-bottom: 0;
}

@media screen and (max-width: 749px) {

  .faq-section__inner {
    max-width: 100%;
  }

  .faq-section__header {
    margin-bottom: 24px;
  }

  .faq-item__icon {
    width: auto;
    height: auto;
  }

}


{% endstylesheet %}

{% schema %} { "name": "Product FAQs", "tag": "section", "enabled_on": { "templates": ["product"] }, "settings": [ {
   "type": "color",
   "id": "color_background",
   "label": "t:sections.all.background_color.label",
   "default": "{{ settings.color_palette.background }}"
 },
 {
   "type": "color",
   "id": "color_text",
   "label": "t:sections.all.text_color.label",
   "default": "{{ settings.color_palette.foreground }}"
 }, { "type": "text", "id": "eyebrow", "label": "t:sections.faq.settings.eyebrow.label", "default": "Questions" }, { "type": "text", "id": "heading", "label": "t:sections.faq.settings.heading.label", "default": "Before You Order" } ], "presets": [ { "name": "Product FAQs" } ] } {% endschema %}
