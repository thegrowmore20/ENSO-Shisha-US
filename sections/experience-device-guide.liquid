{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{%- comment -%}No top-level variable assignments needed; all data comes from blocks.{%- endcomment -%}

<div class="xi-wrap" data-xi id="XiSection-{{ section.id }}">

  <!-- Page header -->
  <section class="xi-head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="xi-eyebrow eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1>{{ section.settings.heading | default: 'Guides for your ENSŌ' }}</h1>
    {%- if section.settings.description != blank -%}
      <p class="xi-desc">{{ section.settings.description }}</p>
    {%- endif -%}
  </section>

  <!-- Search bar -->
  <div class="xi-search">
    <div class="xs">
      <div class="xs__box">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          id="XiSearch-{{ section.id }}"
          type="search"
          placeholder="{{ 'sections.experience_device_guide.search_placeholder' | t }}"
          autocomplete="off"
          aria-label="{{ 'sections.experience_device_guide.search_placeholder' | t }}"
          data-xi-search-input
        >
      </div>
      <div id="XiResults-{{ section.id }}" class="xs__res" hidden data-xi-search-results></div>
    </div>
  </div>

  <!-- Guides by device -->
  {%- assign devh = section.settings.devh_label | default: 'Guides by device' -%}
  <h2 class="xi-devh">{{ devh }}</h2>

  {%- if section.blocks.size > 0 -%}
    <ul class="xh-list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b         = block.settings
          assign b_img     = b.image
          assign b_head    = b.heading    | default: 'ENSŌ Device'
          assign b_desc    = b.description
          assign b_app     = b.app_url    | default: '#'
          assign b_id      = b.device_id  | default: forloop.index
          assign is_diamond = false
          if b.device_type == 'diamond'
            assign is_diamond = true
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <details class="xh" id="{{ b_id }}" data-xi-acc>
            <summary>
              {%- if b_img != blank -%}
                <div class="xh__img">
                  {{- b_img | image_url: width: 600 | image_tag:
                        alt: b_head,
                        loading: 'lazy',
                        widths: '300, 600',
                        sizes: '(min-width: 991px) 260px, 50vw' -}}
                </div>
              {%- else -%}
                <div class="xh__img xh__img--empty"></div>
              {%- endif -%}
              <div class="xh__txt">
                <h2>{{ b_head }}</h2>
                {%- if b_desc != blank -%}<p>{{ b_desc }}</p>{%- endif -%}
              </div>
              <span class="xh__open" aria-hidden="true">
                <span class="o">{{ 'sections.experience_device_guide.show_guides' | t }}</span>
                <span class="c">{{ 'sections.experience_device_guide.hide_guides' | t }}</span>
              </span>
            </summary>

            <div class="xh__body-wrap">
              <div class="xh__body">

                <!-- In-app strip -->
                <div class="xh__app">
                  <p class="xh__apph">{{ 'sections.experience_device_guide.in_app' | t }}</p>
                  <div class="xh__appg">
                    {%- if b.app_reg_url != blank -%}
                      <a href="{{ b.app_reg_url }}" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/><polyline points="9 11 12 14 22 4"/></svg>
                        <b>{{ 'sections.experience_device_guide.warranty_registration' | t }}</b>
                      </a>
                    {%- endif -%}
                    {%- if b.app_updates_url != blank -%}
                      <a href="{{ b.app_updates_url }}" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-.49-4.49"/></svg>
                        <b>{{ 'sections.experience_device_guide.software_updates' | t }}</b>
                      </a>
                    {%- endif -%}
                    {%- if b.app_fix_url != blank -%}
                      <a href="{{ b.app_fix_url }}" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                        <b>{{ 'sections.experience_device_guide.troubleshooting' | t }}</b>
                      </a>
                    {%- endif -%}
                    {%- if b.app_recipes_url != blank -%}
                      <a href="{{ b.app_recipes_url }}" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        <b>{{ 'sections.experience_device_guide.recipes' | t }}</b>
                      </a>
                    {%- endif -%}
                  </div>
                  <a class="xh__appall" href="{{ b_app }}" target="_blank" rel="noopener noreferrer">{{ 'sections.experience_device_guide.open_app' | t }}</a>
                </div>

                <!-- Guide grid -->
                <ul class="xh__grid" role="list">
                  <!-- Guide 1: Quick start (both devices) -->
                  {%- if b.url_1 != blank -%}
                    <li>
                      <a href="{{ b.url_1 }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                        <b>{{ 'sections.experience_device_guide.quick_start' | t }}</b>
                        {%- if is_diamond -%}
                          <span>{{ 'sections.experience_device_guide.diamond_qs_desc' | t }}</span>
                        {%- else -%}
                          <span>{{ 'sections.experience_device_guide.enso_qs_desc' | t }}</span>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endif -%}
                  <!-- Guide 2: Full manual (both devices) -->
                  {%- if b.url_2 != blank -%}
                    <li>
                      <a href="{{ b.url_2 }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                        <b>{{ 'sections.experience_device_guide.full_manual' | t }}</b>
                        {%- if is_diamond -%}
                          <span>{{ 'sections.experience_device_guide.diamond_manual_desc' | t }}</span>
                        {%- else -%}
                          <span>{{ 'sections.experience_device_guide.enso_manual_desc' | t }}</span>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endif -%}
                  <!-- Guide 3: Pack cup (Diamond) / Troubleshooting (ENSŌ) -->
                  {%- if b.url_3 != blank -%}
                    <li>
                      <a href="{{ b.url_3 }}">
                        {%- if is_diamond -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                          <b>{{ 'sections.experience_device_guide.pack_cup' | t }}</b>
                          <span>{{ 'sections.experience_device_guide.diamond_pack_desc' | t }}</span>
                        {%- else -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                          <b>{{ 'sections.experience_device_guide.troubleshooting' | t }}</b>
                          <span>{{ 'sections.experience_device_guide.enso_trbl_desc' | t }}</span>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endif -%}
                  <!-- Guide 4: Cleaning (Diamond) / Flavour (ENSŌ) -->
                  {%- if b.url_4 != blank -%}
                    <li>
                      <a href="{{ b.url_4 }}">
                        {%- if is_diamond -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
                          <b>{{ 'sections.experience_device_guide.cleaning' | t }}</b>
                          <span>{{ 'sections.experience_device_guide.diamond_clean_desc' | t }}</span>
                        {%- else -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                          <b>{{ 'sections.experience_device_guide.flavour_guide' | t }}</b>
                          <span>{{ 'sections.experience_device_guide.enso_flav_desc' | t }}</span>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endif -%}
                  <!-- Guide 5: Troubleshooting (Diamond) / Video (ENSŌ) -->
                  {%- if b.url_5 != blank -%}
                    <li>
                      <a href="{{ b.url_5 }}">
                        {%- if is_diamond -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                          <b>{{ 'sections.experience_device_guide.troubleshooting' | t }}</b>
                          <span>{{ 'sections.experience_device_guide.diamond_trbl_desc' | t }}</span>
                        {%- else -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><polygon points="8 21 16 21 12 17"/></svg>
                          <b>{{ 'sections.experience_device_guide.video_guides' | t }}</b>
                          <span>{{ 'sections.experience_device_guide.enso_vid_desc' | t }}</span>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endif -%}
                  <!-- Guide 6: Firmware (Diamond) / Accessories (ENSŌ) -->
                  {%- if b.url_6 != blank -%}
                    <li>
                      <a href="{{ b.url_6 }}">
                        {%- if is_diamond -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-.49-4.49"/></svg>
                          <b>{{ 'sections.experience_device_guide.software_updates' | t }}</b>
                          <span>{{ 'sections.experience_device_guide.diamond_firm_desc' | t }}</span>
                        {%- else -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                          <b>{{ 'sections.experience_device_guide.accessories' | t }}</b>
                          <span>{{ 'sections.experience_device_guide.enso_acc_desc' | t }}</span>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endif -%}
                </ul>

              </div>
            </div>
          </details>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

</div>

{% stylesheet %}
  /* ── Wrapper (max-width 1200px matches handoff .wrap) ── */
  .xi-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Page header ── */
  .xi-head {
    padding: 72px 0 28px;
    max-width: 720px;
  }
  .xi-eyebrow {
    color: var(--palette-sand, #c8943a);
    text-transform: uppercase;
    letter-spacing: .08em;
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    margin: 0 0 12px;
  }
  .xi-head h1 {
    font-family: var(--font-accent);
    font-size: 48px;
    line-height: 52px;
    font-weight: var(--font-weight-heavy);
    margin: 0 0 14px;
    color: var(--color-text);
  }
  .xi-desc {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(0,0,0,.72);
    margin: 0;
  }

  /* ── Search ── */
  .xi-search { margin: 0 0 48px; }
  .xs { position: relative; max-width: 640px; }
  .xs__box {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 56px;
    border: 1.5px solid rgb(0 0 0 / .1);
    border-radius: 999px;
    padding: 0 22px;
    background: #fff;
    transition: border-color .2s;
  }
  .xs__box:focus-within { border-color: #000; }
  .xs__box svg { flex: none; opacity: .55; }
  .xs__box input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 16px;
    font-family: var(--font-body);
    color: var(--color-text);
  }
  .xs__box input::placeholder { color: rgba(0,0,0,.45); }
  .xs__res {
    position: absolute;
    top: calc(100% + 8px);
    left: 0; right: 0;
    background: #fff;
    border: 1px solid rgb(0 0 0 / .1);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0,0,0,.1);
    z-index: 100;
  }
  .xs__res a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 18px;
    text-decoration: none;
    color: var(--color-text);
    border-bottom: 1px solid rgb(0 0 0 / .08);
  }
  .xs__res a:last-child { border-bottom: none; }
  .xs__res a:hover, .xs__res a:focus-visible { background: #f5f5f4; }
  .xs__res small { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: rgba(0,0,0,.5); }
  .xs__res b { font-size: 14px; font-weight: var(--font-weight-semibold); }
  .xs__res span { font-size: 13px; color: rgba(0,0,0,.6); }
  .xs__none { padding: 14px 18px; font-size: 14px; color: rgba(0,0,0,.5); margin: 0; }

  /* ── "Guides by device" heading ── */
  .xi-devh {
    margin: 0 0 16px;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  /* ── Accordion list ── */
  .xh-list {
    list-style: none;
    margin: 0;
    padding: 0 0 96px;
    display: grid;
    gap: 20px;
  }
  .xh-list > li { display: contents; }

  /* ── Accordion card ── */
  .xh {
    border: 1px solid rgb(0 0 0 / .1);
    border-radius: 28px;
    overflow: hidden;
    background: #fff;
  }

  .xh summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
    padding: 20px 32px 20px 20px;
  }
  .xh summary::-webkit-details-marker { display: none; }
  .xh summary:focus-visible { outline: 2px solid var(--color-focus); outline-offset: -2px; }

  .xh__img {
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    aspect-ratio: 4/3;
  }
  .xh__img img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .xh__img--empty { background: #f5f5f4; }

  .xh__txt h2 {
    font-family: var(--font-accent);
    font-size: 32px;
    line-height: 38px;
    font-weight: var(--font-weight-heavy);
    margin: 0 0 6px;
    color: var(--color-text);
  }
  .xh__txt p {
    color: rgba(0,0,0,.72);
    margin: 0;
    font-size: 15px;
    line-height: 24px;
    max-width: 48ch;
  }

  .xh__open {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1.5px solid rgb(0 0 0 / .1);
    border-radius: 999px;
    padding: 12px 20px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text);
  }
  .xh__open::after {
    content: "+";
    font-family: var(--font-accent);
    font-weight: 800;
    font-size: 18px;
    line-height: 1;
  }
  .xh[open] .xh__open::after { content: "−"; }
  .xh[open] .xh__open .o { display: none; }
  .xh:not([open]) .xh__open .c { display: none; }

  /* ── Smooth body animation ── */
  .xh__body-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .35s ease;
  }
  .xh[open] .xh__body-wrap { grid-template-rows: 1fr; }
  .xh__body-wrap > .xh__body { overflow: hidden; }
  .xh__body { padding: 8px 32px 32px; }

  /* ── In-app strip ── */
  .xh__app {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    background: #f5f3ef;
    border-radius: 20px;
    padding: 14px 16px;
    margin: 0 0 18px;
  }
  .xh__app--bottom { margin: 18px 0 0; }
  .xh__apph {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--palette-sand, #c8943a);
    flex: none;
  }
  .xh__appg {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1;
  }
  .xh__appg a {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 8px 14px 8px 11px;
    text-decoration: none;
    color: #000;
    transition: border-color .2s;
  }
  .xh__appg a:hover, .xh__appg a:focus-visible { border-color: #000; }
  .xh__appg a svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--palette-sand, #c8943a);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .xh__appg b { font-size: 14px; line-height: 18px; }
  .xh__appall {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    line-height: 18px;
    color: #000;
    text-decoration: none;
  }

  /* ── Guide grid ── */
  .xh__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .xh__grid a {
    display: block;
    border-radius: 18px;
    background: #f5f5f4;
    padding: 20px 22px;
    text-decoration: none;
    color: #000;
    transition: background .2s;
  }
  .xh__grid a:hover { background: #ecebe8; }
  .xh__grid a svg {
    display: block;
    stroke: var(--palette-sand, #c8943a);
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-bottom: 12px;
  }
  .xh__grid b {
    display: block;
    font-family: var(--font-accent);
    font-weight: 800;
    font-size: 18px;
    line-height: 24px;
    letter-spacing: -.02em;
    margin-bottom: 4px;
  }
  .xh__grid span {
    display: block;
    color: rgba(0,0,0,.66);
    font-size: 14px;
    line-height: 21px;
  }

  /* ── Responsive (matches handoff 991px breakpoint) ── */
  @media screen and (max-width: 991px) {
    .xi-wrap { padding: 0 16px; }
    .xi-head { padding: 40px 0 24px; }
    .xi-head h1 { font-size: 34px; line-height: 38px; }

    .xh summary {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      padding: 14px 14px 20px;
    }
    .xh__img { aspect-ratio: 16/10; }
    .xh__txt h2 { font-size: 26px; line-height: 30px; }
    .xh__open { justify-self: start; }
    .xh__body { padding: 4px 14px 20px; }
    .xh__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .xh__grid a { padding: 16px 14px; }
    .xh__grid b { font-size: 16px; line-height: 21px; }
    .xh__grid span { font-size: 13px; line-height: 19px; }

    .xh-list { padding-bottom: 56px; }
  }

  /* ── Small mobile (760px) ── */
  @media screen and (max-width: 760px) {
    .xs__box { height: 52px; }
    .xh__app { display: grid; grid-template-columns: 1fr; gap: 10px; padding: 14px; }
    .xh__appg { display: grid; grid-template-columns: 1fr; gap: 6px; }
    .xh__appg a { border-radius: 14px; padding: 12px 14px; justify-content: flex-start; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    /* ── Accordion (smooth + exclusive + hash routing) ── */
    var sections = document.querySelectorAll('[data-xi]');
    sections.forEach(function (wrap) {
      var accs = wrap.querySelectorAll('[data-xi-acc]');

      accs.forEach(function (det) {
        var sum = det.querySelector('summary');
        sum.addEventListener('click', function (e) {
          e.preventDefault();
          var wasOpen = det.hasAttribute('open');
          accs.forEach(function (d) { d.removeAttribute('open'); });
          if (!wasOpen) det.setAttribute('open', '');
        });
      });

      function openId(id) {
        accs.forEach(function (d) {
          if (d.id === id) { d.setAttribute('open', ''); }
          else { d.removeAttribute('open'); }
        });
      }

      var h = (location.hash || '').slice(1);
      if (h === 'diamond' || h === 'enso') openId(h);

      window.addEventListener('hashchange', function () {
        var k = location.hash.slice(1);
        if (k === 'diamond' || k === 'enso') openId(k);
      });
    });

    /* ── Search ── */
    document.querySelectorAll('[data-xi]').forEach(function (wrap) {
      var input = wrap.querySelector('[data-xi-search-input]');
      var res   = wrap.querySelector('[data-xi-search-results]');
      if (!input || !res) return;

      var idx = [];
      wrap.querySelectorAll('.xh__grid a').forEach(function (a) {
        var d = a.closest('[data-xi-acc]');
        var k = (d && d.id === 'diamond') ? 'Diamond guide' : 'ENSŌ 2026 guide';
        idx.push({
          k: k,
          t: (a.querySelector('b') || a).textContent,
          s: ((a.querySelector('span') || {}).textContent || ''),
          u: a.getAttribute('href')
        });
      });

      function esc(x) {
        return String(x).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }

      function run() {
        var v = input.value.trim().toLowerCase();
        if (!v) { res.hidden = true; res.innerHTML = ''; return; }
        var ws = v.split(/\s+/);
        var hits = idx.map(function (x) {
          var t = (x.t + ' ' + x.s + ' ' + x.k).toLowerCase();
          if (!ws.every(function (w) { return t.indexOf(w) >= 0; })) return null;
          var sc = ws.reduce(function (a, w) {
            return a + (x.t.toLowerCase().indexOf(w) >= 0 ? 2 : 1);
          }, 0);
          return { x: x, sc: sc };
        }).filter(Boolean).sort(function (a, b) { return b.sc - a.sc; }).slice(0, 8);

        res.hidden = false;
        res.innerHTML = hits.length
          ? hits.map(function (h) {
              return '<a href="' + esc(h.x.u) + '">'
                + '<small>' + esc(h.x.k) + '</small>'
                + '<b>' + esc(h.x.t) + '</b>'
                + (h.x.s ? '<span>' + esc(h.x.s.slice(0, 140)) + (h.x.s.length > 140 ? '…' : '') + '</span>' : '')
                + '</a>';
            }).join('')
          : '<p class="xs__none">No matches found.</p>';
      }

      input.addEventListener('input', run);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { input.value = ''; run(); }
      });
    });

    /* ── Animated search placeholder ── */
    document.querySelectorAll('[data-xi-search-input]').forEach(function (q) {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var Q = [
        'Will Diamond fit my hookah?',
        'How long does the battery last?',
        'What temperature should I use?',
        'How do I clean the chamber?',
        'What is the warranty?',
        'How do I update the firmware?',
        'How much tobacco goes in the cup?',
        'Can I take it on a plane?'
      ];
      var base = q.getAttribute('placeholder');
      var i = 0, c = 0, del = false, t = null, stopped = false;

      function tick() {
        if (stopped) return;
        var w = Q[i];
        if (!del) {
          c++;
          q.placeholder = w.slice(0, c);
          if (c === w.length) { del = true; t = setTimeout(tick, 1600); return; }
          t = setTimeout(tick, 55);
        } else {
          c--;
          q.placeholder = c ? w.slice(0, c) : ' ';
          if (c === 0) { del = false; i = (i + 1) % Q.length; t = setTimeout(tick, 350); return; }
          t = setTimeout(tick, 25);
        }
      }

      q.addEventListener('focus', function () { stopped = true; clearTimeout(t); q.placeholder = base; });
      q.addEventListener('blur', function () { stopped = false; tick(); });
      tick();
    });
  })();
{% endjavascript %}

