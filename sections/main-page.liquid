{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{%- if section.settings.show_title or section.settings.show_content -%}
  <div class="page {{ scheme_class }}">
    <div class="container page__inner">
      {%- if section.settings.show_title -%}
        <h1 class="h-section text-center">{{ page.title }}</h1>
      {%- endif -%}
      {%- if section.settings.show_content and page.content != blank -%}
        <div class="body-text page__content">{{ page.content }}</div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .page__inner {
    max-width: 1000px;
    margin-inline: auto;
  }

  .page__content {
    margin-top: var(--space-6);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:sections.main-page.settings.show_title.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "t:sections.main-page.settings.show_content.label",
      "default": true
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.padding_desktop_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.padding_mobile_heading"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
