{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
-%}

<div class="page {{ scheme_class }} section-padding">
  <div class="container page__inner">
    <h1 class="h-section text-center">{{ page.title }}</h1>
    <div class="body-text page__content">{{ page.content }}</div>
  </div>
</div>

{% stylesheet %}
  .page__inner {
    max-width: 720px;
    margin-inline: auto;
  }

  .page__content {
    margin-top: var(--space-6);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.header.settings.color_scheme.label",
      "default": "scheme-paper"
    }
  ]
}
{% endschema %}
