{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
  assign current_year = 'now' | date: '%Y'
-%}

<footer class="site-footer {{ scheme_class }}">
  <div class="container section-padding">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="{{ routes.root_url }}" class="wordmark site-footer__logo">
          {%- render 'icon-enso', class: 'site-footer__mark' -%}
          <span>ENSŌ</span>
        </a>
        <p class="body-text text-muted site-footer__tagline">{{ 'sections.footer.tagline' | t }}</p>

        <div class="site-footer__social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="site-footer__social-link" target="_blank" rel="noopener" aria-label="Instagram">
              {%- render 'icon-instagram' -%}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="site-footer__columns">
        {%- for block in section.blocks -%}
          <div class="site-footer__column" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="eyebrow site-footer__column-title">{{ block.settings.heading }}</p>
                {%- endif -%}
                <ul class="site-footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="caption site-footer__link">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>

              {%- when 'policies' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="eyebrow site-footer__column-title">{{ block.settings.heading }}</p>
                {%- endif -%}
                <ul class="site-footer__links">
                  {%- for policy in shop.policies -%}
                    {%- if policy != blank -%}
                      <li><a href="{{ policy.url }}" class="caption site-footer__link">{{ policy.title }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="eyebrow site-footer__column-title">{{ block.settings.heading }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="body-text text-muted site-footer__text">{{ block.settings.text }}</div>
                {%- endif -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="site-footer__newsletter">
        <p class="eyebrow">{{ 'sections.newsletter.heading' | t }}</p>
        {%- form 'customer', id: 'FooterNewsletterForm' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__newsletter-field">
            <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'sections.newsletter.placeholder' | t }}</label>
            <input
              type="email"
              id="FooterNewsletterEmail"
              name="contact[email]"
              class="search-input"
              placeholder="{{ 'sections.newsletter.placeholder' | t }}"
              required
            >
            <button type="submit" class="btn btn--primary">{{ 'sections.newsletter.submit' | t }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="caption">{{ 'sections.newsletter.success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="caption">{{ 'sections.newsletter.error' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <hr class="hairline site-footer__divider">

    <div class="site-footer__bottom">
      <p class="caption">{{ 'sections.footer.copyright' | t: year: current_year }}</p>
      <p class="caption">
        {{ 'sections.footer.sign_off' | t }} ·
        <a href="mailto:{{ 'sections.footer.support' | t }}" class="footer-micro">{{ 'sections.footer.support' | t }}</a>
      </p>
      <p class="caption">{{ 'sections.footer.age_gate' | t }}</p>
    </div>
  </div>
</footer>

{% style %}
  {% if section.settings.footer_bg_image != blank %}
  footer.site-footer {
    background-image: url('{{ section.settings.footer_bg_image | image_url: width: 1920 }}');
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
  }
  footer.site-footer:before {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 1;
  } 
  {% endif %}
  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr 2fr 1.5fr;
    gap: var(--space-8);
    margin-bottom: var(--space-6);
  }

  @media screen and (max-width: 989px) {
    .site-footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 20px;
  }

  .site-footer__mark {
    width: 26px;
    height: 26px;
  }

  .site-footer__tagline {
    margin-top: var(--space-4);
    max-width: 32ch;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .site-footer__social-link {
    display: flex;
    width: 20px;
    height: 20px;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .site-footer__social-link:hover {
    color: var(--color-accent);
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-6);
  }

  .site-footer__column-title {
    margin-bottom: var(--space-4);
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__link {
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .site-footer__link:hover {
    color: var(--color-accent);
  }

  .site-footer__newsletter-field {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .site-footer__newsletter-field .search-input {
    flex: 1;
  }

  @media screen and (max-width: 589px) {
    .site-footer__newsletter-field {
      flex-direction: column;
    }
  }

  .site-footer__divider {
    margin-block: var(--space-6);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.footer.settings.color_scheme.label",
      "default": "scheme-graphite"
    },
    {
      "type": "image_picker",
      "id": "footer_bg_image",
      "label": "Background Image"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.settings.heading.label",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.settings.menu.label",
          "default": "footer"
        }
      ]
    },
    {
      "type": "policies",
      "name": "t:sections.footer.blocks.policies.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.policies.settings.heading.label",
          "default": "Policies"
        },
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.policies.paragraph"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label",
          "default": "Support"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.text.settings.text.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop", "menu": "footer" } },
      {
        "type": "text",
        "settings": {
          "heading": "Support",
          "text": "<p><a href=\"/pages/faq\">FAQ</a><br><a href=\"/pages/support\">Support</a><br><a href=\"/blogs/news\">Blog</a></p>"
        }
      },
      { "type": "policies", "settings": { "heading": "Policies" } }
    ]
  }
}
{% endschema %}
