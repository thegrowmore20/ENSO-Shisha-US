{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text, accent: section.settings.color_accent
  assign current_year = 'now' | date: '%Y'

  assign policy_links = linklists.policies.links
  if policy_links == blank
    assign policy_links = shop.policies
  endif
-%}

<div class="site-footer {{ scheme_class }}">
  <div class="container site-footer__container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="{{ routes.root_url }}" class="site-footer__logo" aria-label="{{ shop.name }}">
          {%- render 'site-logo', inverted: true, lazy: true -%}
        </a>
        <p class="body-text site-footer__tagline">{{ 'sections.footer.tagline' | t }}</p>

        {%- if section.settings.show_newsletter -%}
          {%- form 'customer', class: 'footer-signup', id: 'FooterSignup' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="footer-signup__label" for="FooterSignupEmail">{{ 'sections.footer.newsletter.label' | t }}</label>
            {%- if form.posted_successfully? -%}
              <p class="footer-signup__message" role="status" tabindex="-1" autofocus>
                {{ 'sections.footer.newsletter.success' | t }}
              </p>
            {%- else -%}
              <span class="footer-signup__row">
                <input
                  id="FooterSignupEmail"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ 'sections.footer.newsletter.placeholder' | t }}"
                  autocomplete="email"
                  autocapitalize="off"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="FooterSignupError"
                  {% endif %}
                >
                <button type="submit">{{ 'sections.footer.newsletter.button' | t }}</button>
              </span>
              {%- if form.errors -%}
                <p class="footer-signup__message" id="FooterSignupError" role="alert">
                  {{ 'sections.footer.newsletter.error' | t }}
                </p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <div class="site-footer__brand-social">
            {%- render 'social-icons' -%}
          </div>
        {%- endif -%}
      </div>

      <div class="site-footer__columns">
        {%- for block in section.blocks -%}
          <div class="site-footer__column{% if block.type == 'contact' %} site-footer__column--contact{% endif %}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="eyebrow site-footer__column-title">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <ul class="site-footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="caption site-footer__link">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>

                {%- if block.settings.menu_1 != blank -%}
                  {%- if block.settings.heading_1 != blank -%}
                    <h2 class="eyebrow site-footer__column-title site-footer__column-title--second">{{ block.settings.heading_1 }}</h2>
                  {%- endif -%}
                  <ul class="site-footer__links">
                    {%- for link in block.settings.menu_1.links -%}
                      <li><a href="{{ link.url }}" class="caption site-footer__link">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'policies' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="eyebrow site-footer__column-title">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <ul class="site-footer__links">
                  {%- for policy in shop.policies -%}
                    {%- if policy != blank -%}
                      <li><a href="{{ policy.url }}" class="caption site-footer__link">{{ policy.title }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="eyebrow site-footer__column-title">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="body-text site-footer__text">{{ block.settings.text }}</div>
                {%- endif -%}

              {%- when 'contact' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="eyebrow site-footer__column-title">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- render 'contact-info',
                  contact_link: block.settings.contact_link_text,
                  contact_url: block.settings.contact_url,
                  open_new_contact: block.settings.open_new_contact,
                  whatsapp_number: block.settings.whatsapp_number,
                  whatsapp_url: block.settings.whatsapp_url,
                  open_new_whatsapp: block.settings.open_new_whatsapp,
                  phone_number: block.settings.phone_number,
                  call_url: block.settings.call_url,
                  open_new_call: block.settings.open_new_call,
                  email_address: block.settings.email_address,
                  email_url: block.settings.email_url,
                  open_new_email: block.settings.open_new_email,
                  location: block.settings.location,
                  address_url: block.settings.address_url,
                  open_new_address: block.settings.open_new_address
                -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.show_payment -%}
      <ul class="site-footer__payment" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <hr class="hairline site-footer__divider">

    <div class="site-footer__bottom">
      {%- if policy_links != blank -%}
        <nav class="site-footer__policies" aria-label="{{ 'sections.footer.policies_label' | t }}">
          <ul role="list">
            {%- for link in policy_links -%}
              <li><a href="{{ link.url }}" class="caption footer-micro">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
      <p class="caption site-footer__copyright">
        &copy; {{ current_year }} <a href="{{ routes.root_url }}" class="site-footer__shop-link">{{ shop.name }}</a>
      </p>
    </div>
  </div>
</div>

{% stylesheet %}
  .site-footer {
    padding-top: 40px;
  }

  .site-footer__container {
    padding-top: var(--space-8);
    padding-bottom: var(--space-3);
  }

  /* ---------- Top: brand column + link columns ---------- */
  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 20px;
  }

  .site-footer__column--contact {
    grid-column: 1 / -1;
  }

  @media screen and (min-width: 990px) {
    .site-footer__top {
      grid-template-columns: minmax(260px, 1.2fr) minmax(0, 2fr);
      gap: var(--space-7);
    }

    .site-footer__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .site-footer__column--contact {
      grid-column: auto;
    }
  }

  .site-footer__logo {
    display: inline-flex;
  }

  .site-footer__logo .site-logo__image {
    width: 132px;
  }

  .site-footer__logo .site-logo__text {
    font-size: 20px;
  }

  .site-footer__tagline {
    margin-top: var(--space-4);
    max-width: 32ch;
  }

  /* ---------- Newsletter sign-up ---------- */
  .footer-signup {
    margin: 36px 0 var(--space-5);
  }

  @media screen and (min-width: 990px) {
    .footer-signup {
      max-width: 360px;
    }
  }

  .footer-signup__label {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-subheading);
    font-weight: var(--font-weight-semibold);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--palette-sand);
  }

  .footer-signup__row {
    display: flex;
    height: 44px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-text) 4%, transparent);
  }

  .footer-signup__row:focus-within {
    border-color: color-mix(in srgb, var(--color-text) 60%, transparent);
  }

  .footer-signup__row input {
    flex: 1;
    min-width: 0;
    padding: 0 var(--space-4);
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text);
    font-size: 14px;
  }

  .footer-signup__row input::placeholder {
    color: color-mix(in srgb, var(--color-text) 50%, transparent);
  }

  .footer-signup__row button {
    flex: none;
    margin: 4px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    background-color: var(--color-text);
    color: var(--color-background);
    font-weight: var(--font-weight-bold);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: opacity 0.15s ease;
  }

  .footer-signup__row button:hover {
    opacity: 0.88;
  }

  .footer-signup__row button:focus-visible {
    outline: 2px solid var(--palette-sand);
    outline-offset: 2px;
  }

  .footer-signup__message {
    margin-top: var(--space-2);
    font-size: 13px;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }

  .site-footer__brand-social {
    margin-top: var(--space-5);
  }

  /* ---------- Link columns ---------- */
  .site-footer__column .eyebrow.site-footer__column-title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-subheading);
    font-weight: var(--font-weight-medium);
    font-size: 18px;
    line-height: 1.4;
    color: var(--color-accent);
  }

  .site-footer__column-title--second {
    margin-top: var(--space-6);
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__link {
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .site-footer__link:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer__text {
    color: var(--color-text-muted);
  }

  /* contact-info.liquid's own markup (snippets/contact-info.liquid) */
  .contact-info-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .contact-info-wrapper .contact-link {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .contact-info-wrapper .contact-link:hover {
    color: var(--color-accent);
  }

  .contact-info-wrapper .contact-link:hover .contact-info-item {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The contact icons have no size of their own and hardcode a white fill
     or stroke instead of currentColor, so both are set here. */
  .contact-info-wrapper svg {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-top: 5px;
    transition: transform 0.2s ease;
  }

  .contact-info-wrapper .contact-link:hover svg {
    transform: scale(1.1);
  }

  .contact-info-wrapper .contact-link:hover svg .st0 {
    fill: var(--color-accent);
  }

  .contact-info-wrapper .contact-link:hover svg path {
    stroke: var(--color-accent);
  }

  /* ---------- Payment icons ---------- */
  .site-footer__payment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .site-footer__payment-icon {
    display: block;
    width: auto;
    height: 20px;
  }

  /* ---------- Bottom bar ---------- */
  .site-footer__divider {
    margin-block: var(--space-4);
    border-top-color: color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    text-align: center;
    font-size: 12px;
  }

  .site-footer__bottom .caption {
    font-size: inherit;
  }

  /* Mobile: policies first, copyright second. Desktop: reversed. */
  .site-footer__policies {
    order: 1;
  }

  .site-footer__copyright {
    order: 2;
  }

  @media screen and (min-width: 750px) {
    .site-footer__bottom {
      font-size: 14px;
    }

    .site-footer__policies {
      order: 2;
    }

    .site-footer__copyright {
      order: 1;
    }
  }

  .site-footer__policies ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1) var(--space-4);
  }

  .site-footer__copyright,
  .site-footer__policies a {
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }

  .site-footer__policies a,
  .site-footer__shop-link {
    transition: color 0.2s ease;
  }

  .site-footer__policies a:hover,
  .site-footer__shop-link:hover {
    color: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.footer.settings.logo_paragraph"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.footer.settings.show_newsletter.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.footer.settings.show_social.label",
      "info": "t:sections.footer.settings.show_social.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "t:sections.footer.settings.show_payment.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.ink }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.white }}"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "t:sections.footer.settings.color_accent.label",
      "info": "t:sections.footer.settings.color_accent.info",
      "default": "{{ settings.color_palette.gold }}"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.settings.heading.label",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.settings.menu.label",
          "default": "footer"
        },
        {
          "type": "header",
          "content": "t:sections.footer.blocks.menu.settings.headers.second_menu"
        },
        {
          "type": "text",
          "id": "heading_1",
          "label": "t:sections.footer.blocks.menu.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu_1",
          "label": "t:sections.footer.blocks.menu.settings.menu.label"
        }
      ]
    },
    {
      "type": "policies",
      "name": "t:sections.footer.blocks.policies.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.policies.settings.heading.label",
          "default": "Policies"
        },
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.policies.paragraph"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label",
          "default": "Support"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "contact",
      "name": "t:sections.footer.blocks.contact.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label",
          "default": "Contact"
        },
        {
          "type": "text",
          "id": "contact_link_text",
          "label": "t:sections.footer.blocks.contact.settings.contact_link_text.label",
          "default": "Get In Touch"
        },
        {
          "type": "url",
          "id": "contact_url",
          "label": "t:sections.footer.blocks.contact.settings.link.label"
        },
        {
          "type": "checkbox",
          "id": "open_new_contact",
          "label": "t:sections.footer.blocks.contact.settings.open_new.label",
          "default": false
        },
        {
          "type": "header",
          "content": "t:sections.footer.blocks.contact.settings.headers.whatsapp"
        },
        {
          "type": "text",
          "id": "whatsapp_number",
          "label": "t:sections.footer.blocks.contact.settings.whatsapp_number.label"
        },
        {
          "type": "url",
          "id": "whatsapp_url",
          "label": "t:sections.footer.blocks.contact.settings.link.label"
        },
        {
          "type": "checkbox",
          "id": "open_new_whatsapp",
          "label": "t:sections.footer.blocks.contact.settings.open_new.label",
          "default": false
        },
        {
          "type": "header",
          "content": "t:sections.footer.blocks.contact.settings.headers.phone"
        },
        {
          "type": "text",
          "id": "phone_number",
          "label": "t:sections.footer.blocks.contact.settings.phone_number.label"
        },
        {
          "type": "url",
          "id": "call_url",
          "label": "t:sections.footer.blocks.contact.settings.link.label"
        },
        {
          "type": "checkbox",
          "id": "open_new_call",
          "label": "t:sections.footer.blocks.contact.settings.open_new.label",
          "default": false
        },
        {
          "type": "header",
          "content": "t:sections.footer.blocks.contact.settings.headers.email"
        },
        {
          "type": "text",
          "id": "email_address",
          "label": "t:sections.footer.blocks.contact.settings.email_address.label"
        },
        {
          "type": "url",
          "id": "email_url",
          "label": "t:sections.footer.blocks.contact.settings.link.label"
        },
        {
          "type": "checkbox",
          "id": "open_new_email",
          "label": "t:sections.footer.blocks.contact.settings.open_new.label",
          "default": false
        },
        {
          "type": "header",
          "content": "t:sections.footer.blocks.contact.settings.headers.location"
        },
        {
          "type": "text",
          "id": "location",
          "label": "t:sections.footer.blocks.contact.settings.location.label"
        },
        {
          "type": "url",
          "id": "address_url",
          "label": "t:sections.footer.blocks.contact.settings.link.label"
        },
        {
          "type": "checkbox",
          "id": "open_new_address",
          "label": "t:sections.footer.blocks.contact.settings.open_new.label",
          "default": false
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop", "menu": "footer" } },
      { "type": "menu", "settings": { "heading": "Quick Links", "menu": "footer" } },
      { "type": "contact", "settings": { "heading": "Contact" } }
    ]
  }
}
{% endschema %}
