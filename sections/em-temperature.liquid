{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
{{ 'em-manual.css' | asset_url | stylesheet_tag }}
<div class="em-wrap">
  <section class="em-ch em-ch-section" id="temperature" style="scroll-margin-top:180px">
    <p class="em-ch__num">04 · Use</p>
    <h2>Temperature and modes</h2>
    <p class="em-ch__lead">180–330 °C on the thermodial, in 5° steps. Start low and step up.</p>
    <div class="em-parts em-parts--t">
      {%- if section.settings.img_dial != blank -%}
        {{- section.settings.img_dial | image_url: width: 800 | image_tag:
            loading: 'lazy',
            alt: 'The thermodial, 180 to 330 °C',
            widths: '400, 600, 800',
            sizes: '(max-width: 760px) 100vw, 40vw' -}}
      {%- else -%}
        <img src="{{ 'temp-dial-ink.webp' | file_url }}" alt="The thermodial, 180 to 330 °C" loading="lazy">
      {%- endif -%}
      <div>
        <ol>
          <li><b>Scale.</b> The range is 180°–330°C — each gradation step on the dial equals 5°C.</li>
          <li><b>Turn.</b> Turn the Thermodial: clockwise = higher, counter-clockwise = lower. Start low (180°), heat 5–8 min, then step up 15–30° at a time, allowing 30–60 seconds per change.</li>
          <li><b>Read.</b> The LED shows your setting — the higher the temperature, the closer the LED strips sit to the middle.</li>
        </ol>
        <p>The 2026 edition reads about 10–15°C cooler than earlier models at the same displayed number — the temperature sensing was made more conservative. If 255°C used to be your setting, try 265–270°C, and move in small steps from there.</p>
      </div>
    </div>

    <h3>Three modes</h3>
    <div class="em-temps">
      <div>
        <b>Default</b>
        <span>Orange light. ENSŌ regulates the temperature, with a 70 °C+ boost during the 5-minute pre-heat.</span>
      </div>
      <div>
        <b>G-Mode</b>
        <span>Press the thermodial 3×, the light turns green. Linear power for frequent draws, no extra heat in the pre-heat.</span>
      </div>
      <div>
        <b>Blue-Mode</b>
        <span>Press 5×, the light turns blue and the dial locks. The set temperature stays, turning the dial does nothing.</span>
      </div>
    </div>
    <div class="em-figs">
      {%- if section.settings.img_turn != blank -%}
        {{- section.settings.img_turn | image_url: width: 560 | image_tag: loading: 'lazy', alt: 'Turning the thermodial' -}}
      {%- else -%}
        <img src="{{ 'dial-turn-ink.webp' | file_url }}" alt="Turning the thermodial" loading="lazy">
      {%- endif -%}
      {%- if section.settings.img_led != blank -%}
        {{- section.settings.img_led | image_url: width: 560 | image_tag: loading: 'lazy', alt: 'The LED strips move to the middle as the temperature rises' -}}
      {%- else -%}
        <img src="{{ 'led-temp-ink.webp' | file_url }}" alt="The LED strips move to the middle as the temperature rises" loading="lazy">
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "EM: Temperature",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "img_dial",
      "label": "Thermodial diagram"
    },
    {
      "type": "image_picker",
      "id": "img_turn",
      "label": "Dial turning"
    },
    {
      "type": "image_picker",
      "id": "img_led",
      "label": "LED temperature indicator"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#faf8f4"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "EM: Temperature"
    }
  ]
}
{% endschema %}
