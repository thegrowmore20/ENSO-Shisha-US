{% stylesheet %}

.d-bowl {
  padding: var(--d-bowl-padding-top-mobile, 40px) 0 var(--d-bowl-padding-bottom-mobile, 40px);
}

/* Card */
.d-bowl__card {
  position: relative;
  border-radius: 28px;
  overflow: hidden;
  background: #0f0d0b;
  color: #fff;
  aspect-ratio: 19 / 10;
  display: flex;
  align-items: center;
}

/* Background image */
.d-bowl__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50% 72%;
}

/* Left-to-right gradient overlay */
.d-bowl__card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgb(7 8 10 / .92) 0%, rgb(7 8 10 / .55) 45%, rgb(7 8 10 / 0) 75%);
  pointer-events: none;
}

/* Text block */
.d-bowl__body {
  position: relative;
  z-index: 1;
  padding: 64px 56px;
  max-width: 52ch;
}

.d-bowl__heading {
  color: #fff;
  font-size: 44px;
  line-height: 48px;
  letter-spacing: -.025em;
  font-weight: var(--font-weight-heavy);
  margin: 0;
}

.d-bowl__text {
  color: rgb(255 255 255 / .85);
  font-size: var(--font-size-body);
  line-height: 1.6;
  margin: 14px 0 26px;
}

/* Buttons */
.d-bowl__btns {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.d-bowl__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  padding: 0 28px;
  border-radius: 999px;
  font-family: var(--font-heading);
  font-weight: var(--font-weight-bold);
  font-size: 14px;
  letter-spacing: .08em;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  border: 0;
  transition: background .2s, color .2s;
  white-space: nowrap;
}

.d-bowl__btn--light {
  background: #fff;
  color: #000;
}
.d-bowl__btn--light:hover { background: #f2f2f2; }

.d-bowl__btn--ghost {
  background: transparent;
  color: #fff;
  border: 1px solid rgb(255 255 255 / .6);
}
.d-bowl__btn--ghost:hover { background: rgb(255 255 255 / .1); }

/* Mobile ≤ 989px */
@media screen and (max-width: 991px) {
  .d-bowl {
    padding: var(--d-bowl-padding-top-mobile, 24px) 0 var(--d-bowl-padding-bottom-mobile, 24px);
  }

  .d-bowl__card {
    aspect-ratio: auto;
    display: block;
    min-height: 0;
  }

  /* Stack image above text */
  .d-bowl__card::after {
    background: linear-gradient(180deg, rgb(7 8 10 / 0) 0%, rgb(7 8 10 / 0) 42%, rgb(7 8 10 / .72) 64%, rgb(7 8 10 / .9) 100%);
  }

  .d-bowl__img {
    position: relative;
    inset: auto;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-position: 50% 18%;
    display: block;
  }

  /* On mobile show mobile image via picture/source; hide desktop img */
  .d-bowl__picture source { display: none; }

  .d-bowl__body {
    padding: 24px 20px 28px;
    max-width: none;
  }

  .d-bowl__heading {
    font-size: 30px;
    line-height: 36px;
  }

  .d-bowl__text {
    margin: 10px 0 18px;
  }
}

{% endstylesheet %}

{%- liquid
  assign pt_desktop = section.settings.padding_top | default: 40
  assign pb_desktop = section.settings.padding_bottom | default: 40
  assign pt_mobile  = section.settings.padding_top_mobile | default: 24
  assign pb_mobile  = section.settings.padding_bottom_mobile | default: 24
-%}

<style>
  #shopify-section-{{ section.id }} .d-bowl {
    padding-top: {{ pt_mobile }}px;
    padding-bottom: {{ pb_mobile }}px;
  }
  @media screen and (min-width: 992px) {
    #shopify-section-{{ section.id }} .d-bowl {
      padding-top: {{ pt_desktop }}px;
      padding-bottom: {{ pb_desktop }}px;
    }
  }
</style>

<section class="d-bowl" id="bowl-{{ section.id }}" aria-labelledby="DBowlHead-{{ section.id }}">
  <div class="container">
    <div class="d-bowl__card">

      {%- if section.settings.image != blank -%}
        {%- if section.settings.image_mobile != blank -%}
          <picture>
            <source
              media="(max-width: 991px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 800 }} 800w,
                      {{ section.settings.image_mobile | image_url: width: 400 }} 400w"
              sizes="100vw"
            >
            {{- section.settings.image | image_url: width: 1600 | image_tag:
              class: 'd-bowl__img',
              alt: section.settings.image.alt | default: section.settings.heading,
              loading: 'lazy',
              widths: '800,1200,1600',
              sizes: '(max-width: 991px) 100vw, 90vw'
            -}}
          </picture>
        {%- else -%}
          {{- section.settings.image | image_url: width: 1600 | image_tag:
            class: 'd-bowl__img',
            alt: section.settings.image.alt | default: section.settings.heading,
            loading: 'lazy',
            widths: '800,1200,1600',
            sizes: '(max-width: 991px) 100vw, 90vw'
          -}}
        {%- endif -%}
      {%- else -%}
        <span class="d-bowl__img" aria-hidden="true" style="background:#1a1a18;display:block;">
          <svg style="position:absolute;inset:0;margin:auto;width:64px;height:64px;opacity:.25" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
        </span>
      {%- endif -%}

      <div class="d-bowl__body">
        {%- if section.settings.heading != blank -%}
          <h2 class="d-bowl__heading" id="DBowlHead-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="d-bowl__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        <div class="d-bowl__btns">
          {%- if section.settings.cta1_label != blank and section.settings.cta1_link != blank -%}
            <a href="{{ section.settings.cta1_link }}" class="d-bowl__btn d-bowl__btn--light">
              {{- section.settings.cta1_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank and section.settings.cta2_link != blank -%}
            <a href="{{ section.settings.cta2_link }}" class="d-bowl__btn d-bowl__btn--ghost">
              {{- section.settings.cta2_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.diamond_bowl.name",
  "tag": "div",
  "enabled_on": { "templates": ["product", "page"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.diamond_bowl.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.diamond_bowl.settings.image_mobile.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_bowl.settings.heading.label",
      "default": "Design your perfect bowl"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.diamond_bowl.settings.text.label",
      "default": "How to pack for the flavour you want: grams, mesh, temperature and time, one blend at a time."
    },
    {
      "type": "header",
      "content": "t:sections.diamond_bowl.settings.cta1_header.content"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "t:sections.diamond_bowl.settings.cta1_label.label",
      "default": "Open the guide"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "t:sections.diamond_bowl.settings.cta1_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.diamond_bowl.settings.cta2_header.content"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "t:sections.diamond_bowl.settings.cta2_label.label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "t:sections.diamond_bowl.settings.cta2_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:sections.diamond_bowl.presets.name",
      "settings": {
        "heading": "Design your perfect bowl",
        "text": "How to pack for the flavour you want: grams, mesh, temperature and time, one blend at a time.",
        "cta1_label": "Open the guide",
        "cta2_label": "Shop"
      }
    }
  ]
}
{% endschema %}
