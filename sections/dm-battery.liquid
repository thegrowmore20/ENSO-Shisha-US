{%- liquid
  if section.settings.device_frame != blank
    assign df_src = section.settings.device_frame | image_url: width: 600
  else
    assign df_src = 'dm-closed-start.jpg' | file_url
  endif
-%}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
<div class="wrap">
  <section class="ch" id="battery"><p class="ch__num">03 · Start</p><h2>Battery</h2><p class="ch__lead">One removable battery runs Diamond. A spare keeps a long evening going: one in Diamond, one charging.</p><div class="temps"><div><b>About 90 min</b><span>Per charge, pre-heat not included</span></div><div><b>About 1.5 h</b><span>From empty to full with a 30 W USB-C charger</span></div></div><h3>When it runs low</h3><div class="temps"><div class=""><b>10 %</b><span>First sound: time to plan</span></div><div class=""><b>4–6 %</b><span>Second sound, and heating stops</span></div><div class="red"><b>2–3 %</b><span>Diamond switches off</span></div></div><h3>Swap it mid-session</h3><div class="slider tslider" style="--n:{{ section.blocks.size }}"><div class="slides">
    {%- for block in section.blocks -%}
      {%- if block.settings.ui_image != blank -%}
        <figure class="slide ts" {{ block.shopify_attributes }}><figcaption class="ts__tx"><span class="st__n">{{ forloop.index }}</span><b>{{ block.settings.step_title }}</b>{{ block.settings.step_body }}</figcaption><div class="ts__pic ts__pic--mac"><div class="dev"><img src="{{ df_src }}" alt=""><img class="lvimg" src="{{ block.settings.ui_image | image_url: width: 600 }}" alt="{{ block.settings.ui_image.alt | default: '' }}"></div></div></figure>
      {%- else -%}
        <figure class="slide ts" {{ block.shopify_attributes }}><figcaption class="ts__tx"><span class="st__n">{{ forloop.index }}</span><b>{{ block.settings.step_title }}</b>{{ block.settings.step_body }}</figcaption><div class="ts__pic ts__pic--img">
          {%- if block.settings.image != blank -%}
            {{- block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: '' -}}
          {%- else -%}
            <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto"><rect width="400" height="300" rx="16" fill="#f0ede8"/><path d="M160 100a40 40 0 1 1 80 0 40 40 0 0 1-80 0zm-40 80 60-60 40 40 40-40 60 60H120z" fill="#c8b89a"/></svg>
          {%- endif -%}
        </div></figure>
      {%- endif -%}
    {%- endfor -%}
  </div><button class="nav prev" aria-label="Previous">‹</button><button class="nav next" aria-label="Next">›</button></div></section>
</div>

{% schema %}
{
  "name": "DM: Battery",
  "settings": [
    {
      "type": "header",
      "content": "Device frame"
    },
    {
      "type": "image_picker",
      "id": "device_frame",
      "label": "Diamond device frame image"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "battery_step",
      "name": "Battery Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step photo"
        },
        {
          "type": "image_picker",
          "id": "ui_image",
          "label": "Screen UI image",
          "info": "Set this instead of the photo for the device screen overlay slide"
        },
        {
          "type": "text",
          "id": "step_title",
          "label": "Step title"
        },
        {
          "type": "richtext",
          "id": "step_body",
          "label": "Step description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DM: Battery"
    }
  ]
}
{% endschema %}
