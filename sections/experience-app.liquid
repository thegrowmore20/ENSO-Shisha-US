{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{%- liquid
  assign cta_url  = section.settings.cta_url   | default: '#'
  assign cta_lbl  = section.settings.cta_label | default: 'Open the ENSŌ app'
-%}

<div class="xapp-wrap">
  <section class="xapp" id="app" aria-labelledby="XappH-{{ section.id }}">

    <div class="xapp__txt">
      {%- if section.settings.eyebrow != blank -%}
        <p class="xapp__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 id="XappH-{{ section.id }}">{{ section.settings.heading | default: 'Register, update, fix and create' }}</h2>
      {%- if section.settings.description != blank -%}
        <p>{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="xapp__grid">
        {%- for block in section.blocks -%}
          {%- assign icon = block.settings.icon -%}
          <a class="xapp__go" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
            {%- case icon -%}
              {%- when 'warranty' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/><polyline points="9 11 12 14 22 4"/></svg>
              {%- when 'updates' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-.49-4.49"/></svg>
              {%- when 'troubleshooting' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              {%- when 'recipes' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              {%- when 'quickstart' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 8 12 12 14 14"/></svg>
            {%- endcase -%}
            <b>{{ block.settings.heading }}</b>
            {%- if block.settings.description != blank -%}
              <span>{{ block.settings.description }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="xapp__foot">
      <a class="btn btn--primary" href="{{ cta_url }}">{{ cta_lbl }}</a>
      {%- if section.settings.cta_note != blank -%}
        <small>{{ section.settings.cta_note }}</small>
      {%- endif -%}
    </div>

  </section>
</div>

{% stylesheet %}
  .xapp-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .xapp {
    background: #f5f3ef;
    border-radius: 28px;
    padding: 36px;
    display: grid;
    gap: 28px;
  }
  .xapp__txt { max-width: 680px; }
  .xapp__eyebrow {
    color: var(--palette-sand, #c8943a);
    text-transform: uppercase;
    letter-spacing: .08em;
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    margin: 0 0 4px;
  }
  .xapp__txt h2 {
    font-family: var(--font-accent);
    font-size: 32px;
    line-height: 1.1;
    font-weight: var(--font-weight-heavy);
    margin: 4px 0 10px;
    color: var(--color-text);
  }
  .xapp__txt > p { font-size: 15px; line-height: 1.65; color: rgba(0,0,0,.72); margin: 0; max-width: 62ch; }
  .xapp__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .xapp__go {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: #fff;
    border-radius: 20px;
    padding: 22px 20px 24px;
    text-decoration: none;
    color: #000;
    border: 1px solid transparent;
    transition: border-color .2s;
  }
  .xapp__go:hover, .xapp__go:focus-visible { border-color: #000; }
  .xapp__go svg {
    fill: none;
    stroke: var(--palette-sand, #c8943a);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-bottom: 8px;
  }
  .xapp__go b    { font-size: 17px; line-height: 1.3; font-weight: var(--font-weight-semibold); }
  .xapp__go span { font-size: 14px; line-height: 1.55; color: rgba(0,0,0,.6); }
  .xapp__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .xapp__foot small { font-size: 13px; color: rgba(0,0,0,.6); }

  @media screen and (max-width: 991px) {
    .xapp-wrap { padding: 0 16px; }
    .xapp { padding: 24px 16px; gap: 20px; border-radius: 20px; }
    .xapp__txt h2 { font-size: 28px; }
    .xapp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .xapp__go { padding: 18px 14px 20px; border-radius: 16px; }
    .xapp__go b  { font-size: 15px; }
    .xapp__go span { font-size: 13px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.experience_app.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.experience_app.settings.eyebrow.label",
      "default": "The ENSŌ app"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.experience_app.settings.heading.label",
      "default": "Register, update, fix and create"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.experience_app.settings.description.label",
      "default": "Quick start, the manual, troubleshooting, software updates, warranty registration and the blend maker, for the device you own. Add it to your home screen and it is one tap away."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:sections.experience_app.settings.cta_url.label"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.experience_app.settings.cta_label.label",
      "default": "Open the ENSŌ app"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "t:sections.experience_app.settings.cta_note.label",
      "default": "For ENSŌ 2026 and ENSŌ Diamond, made for the phone"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.padding_desktop_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.padding_mobile_heading"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.experience_app.blocks.feature.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.experience_app.blocks.feature.settings.icon.label",
          "options": [
            { "value": "warranty",       "label": "Warranty" },
            { "value": "updates",        "label": "Software updates" },
            { "value": "troubleshooting","label": "Troubleshooting" },
            { "value": "recipes",        "label": "Recipes" },
            { "value": "quickstart",     "label": "Quick start" }
          ],
          "default": "warranty"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.experience_app.blocks.feature.settings.heading.label",
          "default": "Warranty registration"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:sections.experience_app.blocks.feature.settings.description.label",
          "default": "Two minutes, once. Two years on the device, one on the battery"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:sections.experience_app.blocks.feature.settings.url.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.experience_app.presets.name",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "warranty",
            "heading": "Warranty registration",
            "description": "Two minutes, once. Two years on the device, one on the battery"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "updates",
            "heading": "Software updates",
            "description": "ENSŌ Diamond: hear when new software is out"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "troubleshooting",
            "heading": "Troubleshooting",
            "description": "Step-by-step fixes, with support one tap away"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "recipes",
            "heading": "Recipes",
            "description": "On electric heat every tobacco smokes differently than on coal. Find what works, save it"
          }
        }
      ]
    }
  ]
}
{% endschema %}
