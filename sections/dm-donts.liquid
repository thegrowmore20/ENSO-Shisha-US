{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
<div class="wrap">
  <section class="ch" id="donts">
    <p class="ch__num">14 · Care</p>
    <h2>Keep it safe</h2>
    <p class="ch__lead">Diamond is easy to live with. Water on the battery or its contacts is the one thing it really does not like.</p>
    <div class="safe">
      {%- for block in section.blocks -%}
        {%- if block.type == 'safe_row' -%}
          <div class="safe__row" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <div class="safe__pair">
              <figure class="safe__no">
                {%- if block.settings.dont_image != blank -%}
                  {{- block.settings.dont_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.dont_image.alt | default: '', width: block.settings.dont_image.width, height: block.settings.dont_image.height -}}
                {%- else -%}
                  <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto"><rect width="400" height="300" rx="16" fill="#f0ede8"/><path d="M160 100a40 40 0 1 1 80 0 40 40 0 0 1-80 0zm-40 80 60-60 40 40 40-40 60 60H120z" fill="#c8b89a"/></svg>
                {%- endif -%}
                <figcaption><i>✕</i><b>Don't</b><span>{{ block.settings.dont_caption }}</span></figcaption>
              </figure>
              <figure class="safe__ok">
                {%- if block.settings.ok_image != blank -%}
                  {{- block.settings.ok_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.ok_image.alt | default: '', width: block.settings.ok_image.width, height: block.settings.ok_image.height -}}
                {%- else -%}
                  <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto"><rect width="400" height="300" rx="16" fill="#f0ede8"/><path d="M160 100a40 40 0 1 1 80 0 40 40 0 0 1-80 0zm-40 80 60-60 40 40 40-40 60 60H120z" fill="#c8b89a"/></svg>
                {%- endif -%}
                <figcaption><i>✓</i><b>Do</b><span>{{ block.settings.ok_caption }}</span></figcaption>
              </figure>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="note note--dont"><b>If water gets in</b><ul><li>Do not switch Diamond on. Let it cool down and dry out completely.</li><li>Water on the contacts or inside the body is not covered by the warranty.</li></ul></div>
  </section>
</div>

{% schema %}
{
  "name": "DM: Keep it Safe",
  "blocks": [
    {
      "type": "safe_row",
      "name": "Don't / Do row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Row heading",
          "default": "Row title"
        },
        {
          "type": "header",
          "content": "Don't (left card)"
        },
        {
          "type": "image_picker",
          "id": "dont_image",
          "label": "Don't image"
        },
        {
          "type": "text",
          "id": "dont_caption",
          "label": "Don't caption",
          "default": "Avoid this"
        },
        {
          "type": "header",
          "content": "Do (right card)"
        },
        {
          "type": "image_picker",
          "id": "ok_image",
          "label": "Do image"
        },
        {
          "type": "text",
          "id": "ok_caption",
          "label": "Do caption",
          "default": "Do this instead"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#faf8f4"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DM: Keep it Safe"
    }
  ]
}
{% endschema %}
