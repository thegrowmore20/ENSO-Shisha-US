{%- doc -%}
  Before and after you buy — 3-column card grid.
  Each block: icon, heading, body, link (makes it a <a>), popup_body (opens modal), button symbol.
  If popup_body is set and no link, clicking the card opens a shared modal.
{%- enddoc -%}

{% style %}
  #section-help-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #section-help-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section id="section-help-{{ section.id }}" class="help-cards-section">
  <div class="help-cards__container">

    {%- if section.settings.heading != blank -%}
      <h2 class="help-cards__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="help-cards__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          if block.settings.button_symbol == 'arrow'
            assign btn_char = '›'
          else
            assign btn_char = '+'
          endif
          assign has_link = false
          assign has_popup = false
          if block.settings.link != blank
            assign has_link = true
          elsif block.settings.popup_body != blank
            assign has_popup = true
          endif
        -%}

        {%- if has_link -%}
          <a class="help-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {%- elsif has_popup -%}
          <div class="help-card help-card--popup"
               tabindex="0"
               role="button"
               data-popup-id="{{ block.id }}"
               data-popup-title="{{ block.settings.heading | escape }}"
               {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="help-card" {{ block.shopify_attributes }}>
        {%- endif -%}

          <div class="help-card__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'book' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 6.5C10.5 5.3 8.3 4.7 5 4.7v13.6c3.3 0 5.5.6 7 1.8 1.5-1.2 3.7-1.8 7-1.8V4.7c-3.3 0-5.5.6-7 1.8z"/>
                  <path d="M12 6.5v13.6"/>
                </svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 5h16v11H9l-5 4z"/>
                  <path d="M8 9h8M8 12h5"/>
                </svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>
                  <path d="M9 12l2 2 4-4"/>
                </svg>
              {%- when 'star' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/>
                </svg>
              {%- when 'box' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8l-9-5-9 5v8l9 5 9-5z"/>
                  <path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12"/>
                </svg>
              {%- when 'building' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-5 9 5v10H3z"/>
                  <path d="M3 9l9 5 9-5M12 14v5"/>
                </svg>
            {%- endcase -%}
          </div>

          {%- if block.settings.heading != blank -%}
            <h3 class="help-card__heading">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.body != blank -%}
            <p class="help-card__body">{{ block.settings.body }}</p>
          {%- endif -%}

          <span class="help-card__btn" aria-hidden="true">{{ btn_char }}</span>

        {%- if has_link -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}

        {%- if has_popup -%}
          <template id="help-content-{{ block.id }}">
            {{ block.settings.popup_body }}
          </template>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>

  <!-- Shared popup modal -->
  <div class="help-modal" id="help-modal-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Help" hidden>
    <div class="help-modal__box">
      <div class="help-modal__head">
        <h3 class="help-modal__title"></h3>
        <button class="help-modal__close" data-help-close aria-label="Close">&#215;</button>
      </div>
      <div class="help-modal__body"></div>
    </div>
  </div>
</section>

{% stylesheet %}
  .help-cards__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .help-cards__heading {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    font-size: 42px;
    line-height: 46px;
    letter-spacing: -0.025em;
    margin: 0 0 40px;
  }

  .help-cards__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  /* Card */
  .help-card {
    position: relative;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 24px;
    padding: 36px 32px 80px;
    background: #fff;
    transition: box-shadow 0.3s ease;
    text-decoration: none;
    color: var(--color-text);
    display: block;
  }

  .help-card--popup {
    cursor: pointer;
  }

  .help-card:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  }

  .help-card:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* Icon */
  .help-card__icon {
    width: 44px;
    height: 44px;
    margin-bottom: 18px;
  }

  .help-card__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Heading */
  .help-card__heading {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    font-size: 26px;
    line-height: 32px;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    color: var(--color-text);
  }

  /* Body — muted gray matching handoff */
  .help-card__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 25px;
    color: rgba(0, 0, 0, 0.72);
  }

  /* Arrow / plus button */
  .help-card__btn {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #f5f5f4;
    display: grid;
    place-items: center;
    font: 400 22px/1 var(--font-accent);
    color: var(--color-text);
  }

  /* ── Modal ── */
  .help-modal {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .help-modal[hidden] {
    display: none;
  }

  .help-modal__box {
    background: #fff;
    border-radius: 24px;
    width: min(760px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    color: #000;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.25);
  }

  .help-modal__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 28px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .help-modal__title {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    font-size: 26px;
    line-height: 32px;
    letter-spacing: -0.02em;
    margin: 0;
    color: #000;
  }

  .help-modal__close {
    border: none;
    background: none;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    color: #000;
    padding: 4px 8px;
    border-radius: 4px;
    transition: background 0.2s ease;
  }

  .help-modal__close:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  .help-modal__close:focus-visible {
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  .help-modal__body {
    padding: 24px 28px 32px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 26px;
    color: #000;
  }

  .help-modal__body h4 {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    font-size: 17px;
    line-height: 24px;
    margin: 18px 0 4px;
    color: #000;
  }

  .help-modal__body h4:first-child {
    margin-top: 0;
  }

  .help-modal__body p {
    margin: 0 0 12px;
    color: rgba(0, 0, 0, 0.78);
  }

  .help-modal__body a {
    color: #000;
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.5);
  }

  .help-modal__body a:hover {
    border-bottom-color: #000;
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .help-cards__container {
      padding: 0 16px;
    }

    .help-cards__heading {
      font-size: 28px;
      line-height: 34px;
      margin-bottom: 24px;
    }

    .help-cards__grid {
      grid-template-columns: 1fr;
    }

    .help-card {
      padding: 28px 24px 72px;
    }

    .help-modal {
      padding: 12px;
      align-items: flex-end;
    }

    .help-modal__box {
      max-height: 85vh;
      border-radius: 20px 20px 12px 12px;
    }

    .help-modal__head {
      padding: 16px 20px;
    }

    .help-modal__title {
      font-size: 22px;
      line-height: 28px;
    }

    .help-modal__body {
      padding: 16px 20px 24px;
      font-size: 15px;
      line-height: 24px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.help-cards-section').forEach(function (section) {
    const modal = section.querySelector('.help-modal');
    if (!modal) return;

    const titleEl = modal.querySelector('.help-modal__title');
    const bodyEl = modal.querySelector('.help-modal__body');
    let lastCard = null;

    function openModal(card) {
      const id = card.dataset.popupId;
      const title = card.dataset.popupTitle || '';
      const tpl = document.getElementById('help-content-' + id);
      if (!tpl) return;

      titleEl.textContent = title;
      bodyEl.innerHTML = '';
      bodyEl.appendChild(tpl.content.cloneNode(true));
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      modal.querySelector('[data-help-close]').focus();
      lastCard = card;
    }

    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
      if (lastCard) lastCard.focus();
    }

    for (const card of section.querySelectorAll('[data-popup-id]')) {
      card.addEventListener('click', function () { openModal(card); });
      card.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(card); }
      });
    }

    modal.querySelector('[data-help-close]').addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.help_cards.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.help_cards.settings.heading.label",
      "default": "Before and after you buy"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — desktop",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — desktop",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:sections.help_cards.blocks.card.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.help_cards.blocks.card.settings.icon.label",
          "options": [
            { "value": "book",   "label": "t:sections.help_cards.blocks.card.settings.icon.options.book" },
            { "value": "chat",   "label": "t:sections.help_cards.blocks.card.settings.icon.options.chat" },
            { "value": "shield", "label": "t:sections.help_cards.blocks.card.settings.icon.options.shield" },
            { "value": "star",   "label": "t:sections.help_cards.blocks.card.settings.icon.options.star" },
            { "value": "box",      "label": "t:sections.help_cards.blocks.card.settings.icon.options.box" },
            { "value": "building", "label": "t:sections.help_cards.blocks.card.settings.icon.options.building" }
          ],
          "default": "book"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.help_cards.blocks.card.settings.heading.label",
          "default": "Card heading"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "t:sections.help_cards.blocks.card.settings.body.label"
        },
        {
          "type": "header",
          "content": "Card action"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.help_cards.blocks.card.settings.link.label",
          "info": "t:sections.help_cards.blocks.card.settings.link.info"
        },
        {
          "type": "richtext",
          "id": "popup_body",
          "label": "t:sections.help_cards.blocks.card.settings.popup_body.label",
          "info": "t:sections.help_cards.blocks.card.settings.popup_body.info"
        },
        {
          "type": "select",
          "id": "button_symbol",
          "label": "t:sections.help_cards.blocks.card.settings.button_symbol.label",
          "options": [
            { "value": "arrow", "label": "t:sections.help_cards.blocks.card.settings.button_symbol.options.arrow" },
            { "value": "plus",  "label": "t:sections.help_cards.blocks.card.settings.button_symbol.options.plus" }
          ],
          "default": "plus"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.help_cards.presets.name",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "book",
            "heading": "Guides and how-tos",
            "body": "The first session step by step, packing the cup, temperatures, cleaning and firmware, in ENSŌ Experience.",
            "link": "/pages/experience",
            "button_symbol": "arrow"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "chat",
            "heading": "Support",
            "body": "A person answers at support@ensoshisha.eu. Guides, firmware and the manual live in ENSŌ Experience.",
            "button_symbol": "plus"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "shield",
            "heading": "Warranty and returns",
            "body": "Two years on the device, one year on the battery. 14 days to return an unopened box, 30 days an opened one.",
            "button_symbol": "plus"
          }
        }
      ]
    }
  ]
}
{% endschema %}
