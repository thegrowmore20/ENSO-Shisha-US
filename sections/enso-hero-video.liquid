{%- liquid
  assign heading = section.settings.heading
  assign subline = section.settings.subline
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
-%}

{% stylesheet %}
.shopify-section .video-hero-slider {
  min-height: 0;
  overflow: visible;
}

.enso-hero {
  position: relative;
  overflow: hidden;
  width: 100vw;
  margin-left: calc(50% - 50vw);
}

.enso-hero__video {
  width: 100%;
  height: min(84vh, 920px);
  object-fit: cover;
  display: block;
  opacity: .94;
}

.enso-hero__placeholder-svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.enso-hero::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60%;
  background: linear-gradient(180deg, rgb(0 0 0 / 0), rgb(0 0 0 / .6));
  pointer-events: none;
}

.enso-hero__copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: 56px;
  z-index: 1;
}

.enso-hero__copy-inner {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
}

.enso-hero__text {
  flex: 1 1 auto;
  min-width: 0;
}

.enso-hero__heading {
  font-family: var(--font-heading);
  font-weight: var(--font-weight-semibold);
  font-size: 52px;
  line-height: 56px;
  max-width: 16ch;
  color: #fff;
  text-shadow: 0 2px 24px rgb(0 0 0 / .35);
  margin: 0;
  letter-spacing: -.01em;
}

.enso-hero__subline {
  color: rgb(255 255 255 / .85);
  font-size: 15px;
  line-height: 22px;
  margin: 10px 0 0;
}

.enso-hero__cta {
  flex: 0 0 auto;
  display: inline-block;
  background: #fff;
  color: #000;
  border-radius: 999px;
  padding: 20px 40px;
  font-family: var(--font-body);
  font-weight: var(--font-weight-bold);
  font-size: 15px;
  line-height: 1;
  letter-spacing: .1em;
  text-transform: uppercase;
  text-decoration: none;
  white-space: nowrap;
  transition: opacity .2s;
}

.enso-hero__cta:hover {
  opacity: .85;
}

@media screen and (max-width: 749px) {
  .enso-hero__video {
    height: min(64vh, 560px);
  }

  .enso-hero__copy {
    padding-bottom: 28px;
  }

  .enso-hero__copy-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .enso-hero__heading {
    font-size: 28px;
    line-height: 34px;
  }

  .enso-hero__subline {
    font-size: 12.5px;
    white-space: nowrap;
  }
}
{% endstylesheet %}

<div class="video-hero-slider">
  <div class="enso-hero">
    {%- if section.settings.video != blank -%}
      <video
        class="enso-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="none"
      >
        {%- for source in section.settings.video.sources -%}
          {%- if source.format == 'mp4' -%}
            <source src="{{ source.url }}" type="video/mp4">
          {%- endif -%}
        {%- endfor -%}
      </video>
    {%- else -%}
      <div class="enso-hero__video enso-hero__video--placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'enso-hero__placeholder-svg' }}
      </div>
    {%- endif -%}

    <div class="enso-hero__copy">
      <div class="container">
        <div class="enso-hero__copy-inner">
          <div class="enso-hero__text">
            {%- if heading != blank -%}
              <h2 class="enso-hero__heading">{{ heading }}</h2>
            {%- endif -%}
            {%- if subline != blank -%}
              <p class="enso-hero__subline">{{ subline }}</p>
            {%- endif -%}
          </div>

          {%- if cta_label != blank and cta_link != blank -%}
            <a href="{{ cta_link }}" class="enso-hero__cta">{{ cta_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.enso_hero_video.name",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.enso_hero_video.settings.video.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.enso_hero_video.settings.heading.label",
      "default": "An all-in-one portable hookah"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "t:sections.enso_hero_video.settings.subline.label",
      "default": "Your ritual. Without charcoal. Open system, full control."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.enso_hero_video.settings.cta_label.label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.enso_hero_video.settings.cta_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.enso_hero_video.presets.name"
    }
  ]
}
{% endschema %}
