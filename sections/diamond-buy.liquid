{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_compare = false
  if product.compare_at_price > product.price
    assign has_compare = true
  endif
  assign gallery_layout = section.settings.gallery_layout | default: 'thumbnails_bottom'
-%}

{% style %}
  #section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 992px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% stylesheet %}

/* ── Section wrapper ── */
.d-buy {}

/* ── Two-column grid ── */
.d-buy__cols {
  display: grid;
  grid-template-columns: minmax(0, 680px) minmax(380px, 520px);
  justify-content: center;
  gap: 48px;
  align-items: start;
}
@media screen and (max-width: 1199px) {
  .d-buy__cols {
    grid-template-columns: minmax(0, 1fr) minmax(340px, 400px);
    gap: 40px;
  }
}
@media screen and (max-width: 991px) {
  .d-buy__cols {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}

/* ── Left column: gallery + specs stacked ── */
.d-buy__left {
  display: flex;
  flex-direction: column;
  gap: 28px;
  min-width: 0;
}

/* ── Gallery area ── */
.d-buy__gallery {
  min-width: 0;
}

/* ── Gallery — identical to main-product.liquid so the custom element works ── */
.product-gallery { display: block; }

.media-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1 / 1;
  background: rgba(0,0,0,.05);
  border-radius: var(--radius-xl);
}
.media-placeholder__mark { width: 30%; height: auto; opacity: .4; }

.product-gallery__image,
.product-gallery__video,
.product-gallery__model {
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

.product-gallery--thumbnails_bottom .product-gallery__thumbs {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.product-gallery--thumbnails_bottom .product-gallery__thumbs::-webkit-scrollbar { display: none; }

.product-gallery--thumbnails_left {
  display: flex;
  flex-direction: row-reverse;
  gap: var(--space-4);
}
.product-gallery--thumbnails_left .product-gallery__main { flex: 1; min-width: 0; }

.product-gallery__main {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-xl);
  border: 1px solid var(--color-border);
  margin-bottom: 16px;
  touch-action: pan-y;
}

.product-gallery__track {
  display: flex;
  transition: transform 0.35s var(--ease-out);
}
.product-gallery__track.is-dragging { transition: none; }

.product-gallery__item { flex: 0 0 100%; min-width: 0; }

.product-gallery--thumbnails_left .product-gallery__thumbs-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  max-height: 600px;
}
.product-gallery--thumbnails_left .product-gallery__thumbs {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  overflow-y: auto;
  min-height: 0;
  scrollbar-width: none;
}
.product-gallery--thumbnails_left .product-gallery__thumbs::-webkit-scrollbar { display: none; }

.product-gallery__thumbs-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  padding: 0;
  border-radius: 50%;
  background: rgb(255,255,255);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  border: 1px solid rgba(255,255,255,.5);
  color: var(--color-text);
  opacity: .8;
  transition: opacity .2s ease, background-color .2s ease;
}
.product-gallery__thumbs-arrow:hover { opacity: 1; background: rgba(255,255,255,.5); }
.product-gallery__thumbs-arrow .icon-chevron { width: 14px; height: 14px; }
.product-gallery__thumbs-arrow--prev .icon-chevron { transform: rotate(180deg); }
.product-gallery__thumbs-arrow[hidden] { display: none; }

@media screen and (max-width: 991px) {
  .product-gallery--thumbnails_left { flex-direction: column; }
  .product-gallery--thumbnails_left .product-gallery__thumbs-wrap {
    flex-direction: row;
    gap: 0;
    max-height: none;
    min-width: 0;
    width: 100%;
    position: relative;
  }
  .product-gallery--thumbnails_left .product-gallery__thumbs {
    flex-direction: row;
    gap: var(--space-1);
    overflow-x: auto;
    overflow-y: visible;
    flex: 1;
    min-width: 0;
  }
  .product-gallery--thumbnails_left .product-gallery__thumbs-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }
  .product-gallery--thumbnails_left .product-gallery__thumbs-arrow--prev { left: 0; }
  .product-gallery--thumbnails_left .product-gallery__thumbs-arrow--next { right: 0; }
  .product-gallery__thumbs-arrow--prev .icon-chevron { transform: rotate(90deg); }
  .product-gallery__thumbs-arrow--next .icon-chevron { transform: rotate(-90deg); }
}

.product-gallery__thumb {
  position: relative;
  flex: 0 0 72px;
  width: 72px;
  height: 72px;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 2px solid transparent;
  opacity: .6;
  padding: 0;
  transition: opacity .2s ease, border-color .2s ease;
}
.product-gallery__thumb.is-active,
.product-gallery__thumb:hover {
  opacity: 1;
  border-color: var(--color-accent);
}
.product-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
.product-gallery__thumb-icon {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,.35);
  color: #fff;
}
.product-gallery__scroller .carousel__track > * { flex: 0 0 90%; }
@media screen and (min-width: 750px) {
  .product-gallery__scroller .carousel__track > * { flex: 0 0 100%; }
}

/* ── Specs area ── */
.d-buy__specs {
  min-width: 0;
}

/* ── Spec accordions ── */
.d-spec {
  border-top: 1px solid var(--color-border);
}
.d-spec:last-child {
  border-bottom: 1px solid var(--color-border);
}
.d-spec > summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
  cursor: pointer;
  list-style: none;
  font-weight: 700;
  font-size: 16px;
  user-select: none;
}
.d-spec > summary::-webkit-details-marker { display: none; }
.d-spec > summary::after {
  content: '+';
  font: 400 22px/1 var(--font-body, sans-serif);
  flex-shrink: 0;
  transition: transform .25s ease;
}
.d-spec[open] > summary::after { content: '−'; }

.d-spec__body {
  overflow: hidden;
}
.d-spec__body-inner {
  padding-bottom: 20px;
}
.d-spec__body p {
  font-size: 15px;
  color: rgb(0 0 0 / .65);
  margin: 0;
  line-height: 1.6;
}
.d-spec__dl {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 6px 16px;
  margin: 0;
  font-size: 15px;
  line-height: 1.47;
}
.d-spec__dl dt {
  font-weight: 600;
  color: var(--color-text);
  white-space: nowrap;
}
.d-spec__dl dd {
  margin: 0;
  color: rgb(0 0 0 / .65);
}
.d-spec__dl dd a,
.d-spec__dl dt a {
  color: inherit;
  text-decoration: none;
}

/* Richtext list inside spec body — matches dl style */
.d-spec__body-inner ul,
.d-spec__body-inner ol {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 6px;
}
.d-spec__body-inner li {
  font-size: 15px;
  line-height: 1.47;
  color: rgb(0 0 0 / .65);
}
.d-spec__body-inner li strong {
  font-weight: 600;
  color: var(--color-text);
}

/* Dimensions: dl + image side by side */
.d-spec__dim-grid {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 16px;
  align-items: start;
}
.d-spec__dims img {
  width: 220px;
  height: auto;
  display: block;
}
@media screen and (max-width: 599px) {
  .d-spec__dims img { width: 160px; }
}

/* ── Buy card ── */
.d-buy__card {
  position: sticky;
  top: calc(var(--announcement-bar-height, 0px) + var(--site-header-height, 72px) + 20px);
  align-self: start;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  padding: 28px 28px 24px;
}
@media screen and (max-width: 1199px) {
  .d-buy__card { padding: 20px 20px 18px; }
}
@media screen and (max-width: 991px) {
  .d-buy__card {
    position: static;
    margin-top: 0;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 8px;
  }
}

/* Eyebrow — mirrors handoff .buy .eyebrow, inherits uppercase/spacing from base .eyebrow */
.d-buy .eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: rgb(0 0 0 / .75);
  margin-bottom: 10px;
  font-family: var(--font-body);
}
.d-buy .eyebrow i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #16a34a;
  flex-shrink: 0;
  font-style: normal;
  display: block;
}

/* Title */
.d-buy__title {
  font-family: var(--font-heading);
  font-weight: var(--font-weight-bold);
  font-size: 28px;
  line-height: 34px;
  letter-spacing: -.02em;
  margin: 0 0 6px;
}

/* Chips */
.d-buy__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}
.d-buy__chips .product-chip {
  border: 1px solid var(--color-border);
  border-radius: 999px;
  padding: 4px 12px;
  font-size: 13px;
  color: var(--color-text);
}

/* Sub */
.d-buy__sub {
  color: rgb(0 0 0 / .6);
  font-size: 15px;
  margin: 6px 0 18px;
}

/* Price */
.d-buy__price {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}
.d-buy__price strong {
  font-family: var(--font-accent);
  font-weight: 800;
  font-size: 32px;
  line-height: 1;
  letter-spacing: -.025em;
}
.d-buy__was {
  font-family: var(--font-accent);
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -.02em;
  color: rgb(0 0 0 / .35);
  text-decoration: line-through;
}
.d-buy__price-note {
  flex-basis: 100%;
  font-size: 13px;
  color: rgb(0 0 0 / .5);
  line-height: 1.5;
  margin-top: 2px;
}

/* Price note — block between price and button */
.d-buy__price-note-block {
  font-size: 14px;
  line-height: 1.6;
  color: rgb(0 0 0 / .6);
  margin: -6px 0 18px;
}

/* CTA pill */
.d-buy__form { margin-bottom: 18px; }
.d-buy__pill {
  display: block;
  width: 100%;
  background: var(--color-accent-button-background);
  color: var(--color-accent-button-label);
  border: none;
  border-radius: 999px;
  padding: 20px 40px;
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 15px;
  letter-spacing: .1em;
  text-transform: uppercase;
  cursor: pointer;
  transition: opacity .2s;
  line-height: 1;
}
.d-buy__pill:hover { opacity: .88; }
.d-buy__pill:disabled { opacity: .45; cursor: not-allowed; }
.d-buy__pill[aria-pressed="true"] {
  background: transparent;
  color: var(--color-accent-button-background);
  border: 1.5px solid var(--color-accent-button-background);
}
.d-buy__pill[aria-pressed="true"]:hover {
  background: var(--color-accent-button-background);
  color: var(--color-accent-button-label);
  opacity: 1;
}
.d-buy__pill.is-loading {
  opacity: .8;
  pointer-events: none;
  position: relative;
  color: transparent !important;
}
.d-buy__pill.is-loading::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20px;
  height: 20px;
  margin-top: -10px;
  margin-left: -10px;
  border: 2px solid rgba(255, 255, 255, .35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: d-btn-spin .65s linear infinite;
}
/* Gold spinner when in outline/added state */
.d-buy__pill[aria-pressed="true"].is-loading::after {
  border-color: rgba(200, 148, 58, .3);
  border-top-color: var(--color-accent-button-background);
}
@keyframes d-btn-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* Trust */
.d-trust {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.d-trust li {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  font-size: 13px;
  line-height: 1.46;
  color: rgb(0 0 0 / .65);
}
.d-trust li b {
  display: block;
  font-weight: 600;
  color: var(--color-text);
  font-size: 12px;
}
.d-trust svg {
  width: 20px;
  height: 20px;
  color: var(--color-text);
  flex-shrink: 0;
}
@media screen and (max-width: 479px) {
  .d-trust { grid-template-columns: 1fr; gap: 10px; }
}

/* Facts */
.d-facts {
  list-style: none;
  margin: 22px 0 0;
  padding: 18px 0 0;
  border-top: 1px solid var(--color-border);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 16px;
}
.d-facts li {
  font-size: 14px;
  line-height: 1.5;
  color: rgb(0 0 0 / .72);
  padding-left: 16px;
  position: relative;
}
.d-facts li::before {
  content: '';
  position: absolute;
  left: 2px;
  top: 8px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #000;
}
@media screen and (max-width: 479px) {
  .d-facts { grid-template-columns: 1fr; }
}

/* In the box */
.d-inbox {
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--color-border);
  font-size: 14px;
  line-height: 1.6;
  color: rgb(0 0 0 / .72);
}
.d-inbox b {
  display: block;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 4px;
}
.d-inbox a {
  color: var(--color-text);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 2px;
  white-space: nowrap;
}

/* Contact */
.d-contact {
  font-size: 13px;
  color: rgb(0 0 0 / .5);
  margin: 12px 0 0;
}
.d-contact a {
  color: var(--color-text);
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* ── Sticky bar: base layout ── */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  top: var(--site-header-height, 72px);
  z-index: 29;
  background: rgb(255 255 255 / .94);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--color-border);
  transform: translateY(-110%);
  transition: transform .35s cubic-bezier(.2, .8, .2, 1);
}
.bar.is-on { transform: none; }

.bar .wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 48px;
  padding: 0 var(--page-margin, 20px);
  gap: 16px;
  max-width: var(--page-width, 1440px);
  margin: 0 auto;
}

.bar b {
  font-family: var(--font-accent);
  font-weight: 800;
  font-size: 16px;
  letter-spacing: -.025em;
}

.bar .cta {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
}

.bar .cta > span {
  font-family: var(--font-accent);
  font-weight: 800;
  font-size: 16px;
  letter-spacing: -.025em;
}

.bar .cta s {
  font-size: 15px;
  font-weight: 500;
  color: rgb(0 0 0 / .45);
  text-decoration: line-through;
}

.bar .pill--sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--color-accent-button-background);
  color: var(--color-accent-button-label);
  border-radius: 999px;
  padding: 12px 22px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  text-decoration: none;
  white-space: nowrap;
}

/* Suppress the generic sticky-atc when the custom bar is active */
body:has(.bar.is-on) .sticky-atc { display: none !important; }
/* When header slides away, bar moves to viewport top (no gap) */
body:has(.site-header--hidden) .bar { top: 0; }

/* Desktop label */
.bar__sub { font: 500 14px var(--font-body, Montserrat, sans-serif); letter-spacing: 0; color: rgb(0 0 0 / .45); margin-left: 8px; }
.bar__sub::before { content: "· "; }

/* Mobile: bar slides up from bottom */
@media screen and (max-width: 991px) {
  .bar {
    top: auto;
    bottom: 0;
    transform: translateY(110%);
    border-bottom: 0;
    border-top: 1px solid var(--color-border);
    height: auto;
    padding: 10px 0 calc(10px + env(safe-area-inset-bottom, 0px));
  }
  .bar .wrap { height: auto; }
  .bar .cta s { display: none; }
}

/* Mobile: keep name + Pre-order on ONE line, price + struck-out on ONE line */
@media (max-width:767px) {
  .bar b { display:inline-flex; flex-direction:row; align-items:baseline; font-size:15px; }
  .bar__sub { font-size:12.5px; margin-left:6px; }
  .bar .cta > span { display:inline-flex !important; flex-direction:row !important; align-items:baseline; gap:6px; }
}

{% endstylesheet %}

<div id="section-{{ section.id }}">

<div class="bar" id="bar"><div class="wrap">
  <b>ENSŌ Diamond<small class="bar__sub">Pre-order</small></b>
  <div class="cta">
    <span>{{ product.price | money }}<s>{{ product.compare_at_price | money }}</s></span>
    <a class="pill pill--sm" href="/cart">Reserve for $120</a>
  </div>
</div></div>

{%- assign sticky_watch_id = 'DBuyCard-' | append: section.id -%}
{%- render 'sticky-add-to-cart',
  product: product,
  section: section,
  watch_target_id: sticky_watch_id,
  cta_label: section.settings.cta_label
-%}

<diamond-buy
  class="d-buy"
  id="buy"
  data-section-id="{{ section.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-cart-type="{{ settings.cart_type }}"
>
  <div class="container">
    <div class="d-buy__cols">

      {%- comment -%} ── LEFT COLUMN: gallery + specs ── {%- endcomment -%}
      <div class="d-buy__left">

      <div class="d-buy__gallery">
        {%- render 'product-media-gallery', product: product, section: section -%}
      </div>

      {%- comment -%} ── SPECS ── {%- endcomment -%}
      <div class="d-buy__specs">

        {%- liquid
          assign mf_dims    = product.metafields.custom.spec_dimensions.value
          assign mf_heat    = product.metafields.custom.spec_heating.value
          assign mf_batt    = product.metafields.custom.spec_battery.value
          assign mf_ctrl    = product.metafields.custom.spec_controls.value
          assign mf_mat     = product.metafields.custom.spec_materials.value
          assign mf_compat  = product.metafields.custom.spec_compatibility.value
        -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'spec' -%}
          {%- assign _bi = forloop.index0 -%}
          <details class="d-spec" data-accordion data-accordion-group="specs" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.title | escape }}</summary>
            <div class="d-spec__body">
              {%- liquid
                assign dims_img_src = 'https://cdn.shopify.com/s/files/1/0773/3218/5401/files/dim-image.webp'
                if block.settings.image != blank
                  assign dims_img_src = block.settings.image | image_url: width: 240
                endif
              -%}
              {%- if _bi == 0 and mf_dims != blank -%}
                <div class="d-spec__body-inner">
                  <div class="d-spec__dim-grid">
                    <div>{{ product.metafields.custom.spec_dimensions | metafield_tag }}</div>
                    <div class="d-spec__dims"><img src="{{ dims_img_src }}" alt="ENSŌ Diamond dimensions" loading="lazy" width="220"></div>
                  </div>
                </div>
              {%- elsif _bi == 1 and mf_heat != blank -%}
                <div class="d-spec__body-inner">{{ product.metafields.custom.spec_heating | metafield_tag }}</div>
              {%- elsif _bi == 2 and mf_batt != blank -%}
                <div class="d-spec__body-inner">{{ product.metafields.custom.spec_battery | metafield_tag }}</div>
              {%- elsif _bi == 3 and mf_ctrl != blank -%}
                <div class="d-spec__body-inner">{{ product.metafields.custom.spec_controls | metafield_tag }}</div>
              {%- elsif _bi == 4 and mf_mat != blank -%}
                <div class="d-spec__body-inner">{{ product.metafields.custom.spec_materials | metafield_tag }}</div>
              {%- elsif _bi == 5 and mf_compat != blank -%}
                <div class="d-spec__body-inner">{{ product.metafields.custom.spec_compatibility | metafield_tag }}</div>
              {%- elsif block.settings.content != blank -%}
                {%- if _bi == 0 -%}
                  <div class="d-spec__body-inner">
                    <div class="d-spec__dim-grid">
                      <div>{{ block.settings.content }}</div>
                      <div class="d-spec__dims"><img src="{{ dims_img_src }}" alt="ENSŌ Diamond dimensions" loading="lazy" width="220"></div>
                    </div>
                  </div>
