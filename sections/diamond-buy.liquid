{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_compare = false
  if product.compare_at_price > product.price
    assign has_compare = true
  endif
  assign gallery_layout = section.settings.gallery_layout | default: 'thumbnails_bottom'
-%}

{% stylesheet %}

/* ── Sticky bar ── */
.d-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: #fff;
  border-bottom: 1px solid var(--color-border);
  transform: translateY(-100%);
  transition: transform .25s ease;
}
.d-bar.is-on {
  transform: translateY(0);
}
.d-bar__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-top: 12px;
  padding-bottom: 12px;
}
.d-bar__name {
  font-size: 15px;
  font-weight: 600;
  white-space: nowrap;
}
.d-bar__cta {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
}
.d-bar__price {
  font-size: 15px;
  font-weight: 700;
}
.d-bar__price s {
  font-weight: 400;
  opacity: .55;
  margin-left: 4px;
}
.d-bar__pill {
  background: #000;
  color: #fff;
  border: none;
  border-radius: 999px;
  padding: 10px 24px;
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 13px;
  letter-spacing: .08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: opacity .2s;
}
.d-bar__pill:hover { opacity: .82; }

/* ── Section wrapper ── */
.d-buy {
  padding-top: 64px;
  padding-bottom: 40px;
}
@media screen and (max-width: 989px) {
  .d-buy { padding-top: 32px; padding-bottom: 24px; }
}

/* ── Two-column grid ── */
.d-buy__cols {
  display: grid;
  grid-template-columns: 1fr 440px;
  gap: 56px;
  align-items: start;
}
@media screen and (max-width: 1199px) {
  .d-buy__cols { grid-template-columns: 1fr 380px; gap: 40px; }
}
@media screen and (max-width: 989px) {
  .d-buy__cols { grid-template-columns: 1fr; gap: 0; }
}

/* ── Left column ── */
.d-buy__left { min-width: 0; }

/* ── Gallery ── */
.product-gallery { display: block; }

.media-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1 / 1;
  background: rgba(0,0,0,.05);
  border-radius: var(--radius-xl);
}
.media-placeholder__mark { width: 30%; height: auto; opacity: .4; }

.product-gallery__image,
.product-gallery__video,
.product-gallery__model {
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

.product-gallery__main {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-xl);
  border: 1px solid var(--color-border);
  margin-bottom: 16px;
  touch-action: pan-y;
}

.product-gallery__track {
  display: flex;
  transition: transform 0.35s var(--ease-out);
}
.product-gallery__track.is-dragging { transition: none; }

.product-gallery__item {
  flex: 0 0 100%;
  min-width: 0;
}

.product-gallery--thumbnails_bottom .product-gallery__thumbs {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
  overflow-x: auto;
  scrollbar-width: none;
}
.product-gallery--thumbnails_bottom .product-gallery__thumbs::-webkit-scrollbar { display: none; }

.product-gallery--thumbnails_left {
  display: flex;
  flex-direction: row-reverse;
  gap: var(--space-4);
}
.product-gallery--thumbnails_left .product-gallery__main { flex: 1; min-width: 0; }
.product-gallery--thumbnails_left .product-gallery__thumbs-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  max-height: 600px;
}
.product-gallery--thumbnails_left .product-gallery__thumbs {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  overflow-y: auto;
  min-height: 0;
  scrollbar-width: none;
}
.product-gallery--thumbnails_left .product-gallery__thumbs::-webkit-scrollbar { display: none; }

@media screen and (max-width: 749px) {
  .product-gallery--thumbnails_left { flex-direction: column; }
  .product-gallery--thumbnails_left .product-gallery__thumbs-wrap {
    flex-direction: row;
    gap: 0;
    max-height: none;
    min-width: 0;
    width: 100%;
  }
  .product-gallery--thumbnails_left .product-gallery__thumbs {
    flex-direction: row;
    gap: var(--space-1);
    overflow-x: auto;
    overflow-y: visible;
    flex: 1;
    min-width: 0;
  }
}

.product-gallery__thumbs-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  padding: 0;
  border-radius: 50%;
  background: #fff;
  border: 1px solid rgba(255,255,255,.5);
  color: var(--color-text);
  opacity: .8;
  transition: opacity .2s;
}
.product-gallery__thumbs-arrow:hover { opacity: 1; }
.product-gallery__thumbs-arrow[hidden] { display: none; }
.product-gallery__thumbs-arrow--prev .icon-chevron { transform: rotate(180deg); }

@media screen and (max-width: 749px) {
  .product-gallery--thumbnails_left .product-gallery__thumbs-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
  }
  .product-gallery--thumbnails_left .product-gallery__thumbs-arrow--prev { left: 0; }
  .product-gallery--thumbnails_left .product-gallery__thumbs-arrow--next { right: 0; }
  .product-gallery__thumbs-arrow--prev .icon-chevron { transform: rotate(90deg); }
  .product-gallery__thumbs-arrow--next .icon-chevron { transform: rotate(-90deg); }
}

.product-gallery__thumb {
  position: relative;
  flex: 0 0 72px;
  width: 72px;
  height: 72px;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 2px solid transparent;
  opacity: .6;
  padding: 0;
  transition: opacity .2s, border-color .2s;
}
.product-gallery__thumb.is-active,
.product-gallery__thumb:hover {
  opacity: 1;
  border-color: var(--color-accent);
}
.product-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
.product-gallery__thumb-icon {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,.35);
  color: #fff;
}

/* ── Spec accordions ── */
.d-specs {
  margin-top: var(--space-5);
}
.d-spec {
  border-top: 1px solid var(--color-border);
}
.d-spec:last-child {
  border-bottom: 1px solid var(--color-border);
}
.d-spec > summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
  cursor: pointer;
  list-style: none;
  font-weight: 600;
  font-size: 15px;
  user-select: none;
}
.d-spec > summary::-webkit-details-marker { display: none; }
.d-spec > summary::after {
  content: '+';
  font: 400 22px/1 Inter, sans-serif;
  flex-shrink: 0;
}
.d-spec[open] > summary::after { content: '−'; }

.d-spec__body {
  padding-bottom: 20px;
}
.d-spec__dl {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 6px 16px;
  margin: 0;
  font-size: 14px;
}
.d-spec__dl dt {
  font-weight: 600;
  color: var(--color-text);
  white-space: nowrap;
}
.d-spec__dl dd {
  margin: 0;
  color: rgb(0 0 0 / .65);
}

.d-spec__dims {
  position: relative;
  margin-top: 16px;
  max-width: 200px;
}
.d-spec__dims img {
  width: 100%;
  height: auto;
  display: block;
}
.d-spec__dim-label {
  position: absolute;
  font-size: 12px;
  font-weight: 600;
  color: var(--color-text);
}

/* ── Buy card ── */
.d-buy__card {
  position: sticky;
  top: calc(var(--announcement-bar-height, 0px) + 88px);
  align-self: start;
}
@media screen and (max-width: 989px) {
  .d-buy__card {
    position: static;
    margin-top: 32px;
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
  }
}

.d-buy__eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-subheading);
  font-weight: 500;
  font-size: 11px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 10px;
}
.d-buy__eyebrow i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
  flex-shrink: 0;
  font-style: normal;
  display: block;
}

.d-buy__title {
  font-family: var(--font-heading);
  font-weight: var(--font-weight-bold);
  font-size: 36px;
  line-height: 1.1;
  letter-spacing: -.02em;
  margin: 0 0 8px;
}
@media screen and (max-width: 749px) {
  .d-buy__title { font-size: 28px; }
}

.d-buy__sub {
  color: rgb(0 0 0 / .6);
  font-size: 15px;
  margin: 0 0 20px;
}

/* Price */
.d-buy__price {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 4px;
}
.d-buy__price strong {
  font-family: var(--font-accent);
  font-weight: var(--font-weight-bold);
  font-size: 32px;
  line-height: 1;
}
.d-buy__was {
  font-size: 18px;
  color: rgb(0 0 0 / .45);
  font-weight: 400;
  text-decoration: line-through;
}
.d-buy__price-note {
  display: block;
  width: 100%;
  font-size: 13px;
  color: rgb(0 0 0 / .55);
  margin-bottom: 20px;
  line-height: 1.5;
}

/* CTA pill */
.d-buy__form { margin: 20px 0; }
.d-buy__pill {
  display: block;
  width: 100%;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 999px;
  padding: 20px 40px;
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 15px;
  letter-spacing: .1em;
  text-transform: uppercase;
  cursor: pointer;
  transition: opacity .2s;
  line-height: 1;
}
.d-buy__pill:hover { opacity: .85; }
.d-buy__pill:disabled { opacity: .45; cursor: not-allowed; }
.d-buy__pill.is-loading { opacity: .7; pointer-events: none; position: relative; }
.d-buy__pill.is-loading::after {
  content: '';
  position: absolute;
  right: 20px;
  top: 50%;
  margin-top: -8px;
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255,255,255,.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: btn-spin .7s linear infinite;
}
@keyframes btn-spin { to { transform: rotate(360deg); } }

/* Trust */
.d-trust {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  padding: 16px 0;
  margin-bottom: 20px;
}
.d-trust li {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  font-size: 12px;
  line-height: 1.4;
  color: rgb(0 0 0 / .65);
}
.d-trust li b {
  display: block;
  font-weight: 600;
  color: var(--color-text);
  font-size: 12px;
}
.d-trust svg {
  width: 20px;
  height: 20px;
  color: var(--color-text);
  flex-shrink: 0;
}
@media screen and (max-width: 479px) {
  .d-trust { grid-template-columns: 1fr; gap: 10px; }
}

/* Facts */
.d-facts {
  list-style: none;
  margin: 0 0 20px;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 16px;
}
.d-facts li {
  font-size: 14px;
  line-height: 1.5;
  color: rgb(0 0 0 / .72);
  padding-left: 14px;
  position: relative;
}
.d-facts li::before {
  content: '•';
  position: absolute;
  left: 0;
  color: var(--color-text);
}
@media screen and (max-width: 479px) {
  .d-facts { grid-template-columns: 1fr; }
}

/* In the box */
.d-inbox {
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  padding: 14px 16px;
  font-size: 14px;
  line-height: 1.6;
  color: rgb(0 0 0 / .72);
  margin-bottom: 16px;
}
.d-inbox b {
  display: block;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 4px;
}
.d-inbox a {
  color: var(--color-text);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 2px;
  white-space: nowrap;
}

/* Contact */
.d-contact {
  font-size: 13px;
  color: rgb(0 0 0 / .55);
  margin: 0;
}
.d-contact a {
  color: var(--color-text);
  text-decoration: underline;
  text-underline-offset: 2px;
}

{% endstylesheet %}

{%- comment -%} Sticky bar {%- endcomment -%}
<div class="d-bar" id="DBar-{{ section.id }}" aria-hidden="true">
  <div class="container d-bar__inner">
    <b class="d-bar__name">ENSŌ Diamond · Pre-order</b>
    <div class="d-bar__cta">
      <span class="d-bar__price">
        {{ current_variant.price | money }}
        {%- if has_compare -%}<s>{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
      </span>
      <button type="button" class="d-bar__pill" data-d-bar-atc>{{ section.settings.cta_label | default: 'Pre-order' }}</button>
    </div>
  </div>
</div>

<diamond-buy
  class="d-buy"
  id="buy"
  data-section-id="{{ section.id }}"
  data-variant-id="{{ current_variant.id }}"
>
  <div class="container">
    <div class="d-buy__cols">

      {%- comment -%} ── LEFT: gallery + specs ── {%- endcomment -%}
      <div class="d-buy__left">

        {%- comment -%} Gallery via shared snippet {%- endcomment -%}
        <div class="d-buy__gallery">
          {%- render 'product-media-gallery', product: product, section: section -%}
        </div>

        {%- comment -%} Spec accordions {%- endcomment -%}
        <div class="d-specs">

          <details class="d-spec">
            <summary>Product dimensions</summary>
            <div class="d-spec__body">
              <dl class="d-spec__dl">
                <dt>Height</dt><dd>18 cm with the cap on</dd>
                <dt>Width</dt><dd>10 cm at the band</dd>
                <dt>Weight</dt><dd>About 1 kg with the battery</dd>
                <dt>Fits</dt><dd>Stem tops that take a standard bowl, with one of the two adapters</dd>
              </dl>
              <div class="d-spec__dims">
                <img src="{{ 'diamond-dim-silhouette.webp' | file_url }}" alt="ENSŌ Diamond silhouette showing 18 cm height and 10 cm width" loading="lazy" width="200">
              </div>
            </div>
          </details>

          <details class="d-spec">
            <summary>Heating</summary>
            <div class="d-spec__body d-spec__body--text">
              <dl class="d-spec__dl">
                <dt>Session temperature</dt><dd>180–320 °C, one-degree steps</dd>
                <dt>Pre-heat</dt><dd>0–15 minutes, default 7 minutes at 275 °C</dd>
                <dt>Element</dt><dd>Below and around the ceramic cup</dd>
                <dt>Profiles</dt><dd>Default, Phoenix, Wraith, Oracle</dd>
              </dl>
            </div>
          </details>

          <details class="d-spec">
            <summary>Battery and charging</summary>
            <div class="d-spec__body">
              <dl class="d-spec__dl">
                <dt>Runtime</dt><dd>About 90 minutes, pre-heat not included</dd>
                <dt>Charging</dt><dd>USB-C, about 1.5 hours with a 30 W supply, inside Diamond or on its own</dd>
                <dt>Charge while in use</dt><dd>Yes, over USB-C: plug in and keep smoking</dd>
                <dt>Firmware</dt><dd>Updates over USB-C from a page on ensoshisha.eu (coming)</dd>
              </dl>
            </div>
          </details>

          <details class="d-spec">
            <summary>Controls</summary>
            <div class="d-spec__body">
              <dl class="d-spec__dl">
                <dt>Dial</dt><dd>Turn to move, click to choose. Hold three seconds to switch on</dd>
                <dt>Screen</dt><dd>Round display, colour themes, brightness</dd>
                <dt>Feedback</dt><dd>Sound and haptics, adjustable or off</dd>
                <dt>App</dt><dd>None needed. No account, no phone</dd>
              </dl>
            </div>
          </details>

          <details class="d-spec">
            <summary>Materials</summary>
            <div class="d-spec__body">
              <dl class="d-spec__dl">
                <dt>Body</dt><dd>Soft-touch graphite body, copper stripe, vegan leather band</dd>
                <dt>Band</dt><dd>Vegan leather with the ENSŌ mark</dd>
                <dt>Cup and chamber</dt><dd>Glazed ceramic cup, stainless steel mesh and air path</dd>
                <dt>Cap</dt><dd>Three parts: the heat-holding shell, the air plate you turn to set the draw, and the silicone insert that holds them. No electronics</dd>
              </dl>
            </div>
          </details>

          <details class="d-spec">
            <summary>Compatibility</summary>
            <div class="d-spec__body">
              <p style="font-size:14px;color:rgb(0 0 0/.65);margin:0;line-height:1.6;">Most traditional stems, with one of the two silicone adapters in the box. Your stem, base and hose stay as they are. Not sure about yours? Send us a photo of the stem top.</p>
            </div>
          </details>

        </div>{%- comment -%} /d-specs {%- endcomment -%}
      </div>{%- comment -%} /d-buy__left {%- endcomment -%}

      {%- comment -%} ── RIGHT: buy card ── {%- endcomment -%}
      <aside class="d-buy__card" id="DBuyCard-{{ section.id }}">

        <div class="d-buy__eyebrow"><i aria-hidden="true"></i>Pre-order</div>

        <h1 class="d-buy__title">{{ product.title }}</h1>

        {%- if section.settings.subline != blank -%}
          <p class="d-buy__sub">{{ section.settings.subline }}</p>
        {%- endif -%}

        <div class="d-buy__price">
          <strong>{{ current_variant.price | money }}</strong>
          {%- if has_compare -%}
            <s class="d-buy__was">{{ current_variant.compare_at_price | money }}</s>
          {%- endif -%}
          {%- if section.settings.price_note != blank -%}
            <span class="d-buy__price-note">{{ section.settings.price_note }}</span>
          {%- endif -%}
        </div>

        <form
          action="/cart/add"
          method="post"
          id="DiamondForm-{{ section.id }}"
          class="d-buy__form"
          novalidate
        >
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button
            type="submit"
            class="d-buy__pill"
            id="DiamondBtn-{{ section.id }}"
            {%- unless current_variant.available -%}disabled{%- endunless -%}
          >
            {%- if current_variant.available -%}
              {{ section.settings.cta_label | default: 'Pre-order' }}
            {%- else -%}
              Sold out
            {%- endif -%}
          </button>
        </form>

        <ul class="d-trust" aria-label="Purchase trust">
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span><b>30 days to decide</b>From delivery</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3 4.5 6v5.2c0 4.6 3.2 8.4 7.5 9.8 4.3-1.4 7.5-5.2 7.5-9.8V6L12 3Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            </svg>
            <span><b>Real people answer</b>Email support, in English</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16v11H4zM8 7V5h8v2" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M4 12h16" stroke="currentColor" stroke-width="1.75"/>
            </svg>
            <span><b>EU prices include VAT</b>US prices before sales tax</span>
          </li>
        </ul>

        <ul class="d-facts">
          <li>About seven minutes to the first draw</li>
          <li>About 90 minutes per battery</li>
          <li>Fits most traditional stems</li>
          <li>Two-year warranty, one year on the battery</li>
          <li>Ships from our warehouse in Hungary</li>
        </ul>

        {%- if section.settings.inbox_text != blank -%}
          <div class="d-inbox">
            <b>In the box</b>
            <span>{{ section.settings.inbox_text }} <a href="#package">See it laid out</a></span>
          </div>
        {%- endif -%}

        {%- if section.settings.contact_email != blank -%}
          <p class="d-contact">Questions before you order: <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></p>
        {%- endif -%}

      </aside>
    </div>
  </div>
</diamond-buy>

{% javascript %}
(function () {
  if (customElements.get('diamond-buy')) return;

  class DiamondBuy extends HTMLElement {
    connectedCallback() {
      const sectionId = this.dataset.sectionId;
      const bar       = document.getElementById('DBar-' + sectionId);
      const card      = document.getElementById('DBuyCard-' + sectionId);
      const form      = document.getElementById('DiamondForm-' + sectionId);
      const btn       = document.getElementById('DiamondBtn-' + sectionId);
      const barBtn    = bar && bar.querySelector('[data-d-bar-atc]');

      /* ── Sticky bar: show when buy card scrolls above header ── */
      if (bar && card) {
        const hdrH = () => {
          const h = document.querySelector('.site-header, header');
          return h ? h.getBoundingClientRect().height : 72;
        };
        const check = () => {
          const r = card.getBoundingClientRect();
          const on = r.bottom < hdrH();
          bar.classList.toggle('is-on', on);
          bar.setAttribute('aria-hidden', String(!on));
        };
        addEventListener('scroll', check, { passive: true });
        addEventListener('resize', check);
        check();
      }

      /* ── Bar button → submit main form ── */
      if (barBtn && form) {
        barBtn.addEventListener('click', () => form.requestSubmit());
      }

      /* ── AJAX ATC ── */
      if (!form || !btn) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (btn.disabled || btn.classList.contains('is-loading')) return;

        btn.classList.add('is-loading');
        if (barBtn) barBtn.disabled = true;

        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'Accept': 'application/javascript'
            },
            body: new FormData(form)
          });

          if (!res.ok) throw new Error('cart/add failed');

          const item = await res.json();

          document.dispatchEvent(new CustomEvent('cart:add', { detail: { item } }));
          document.dispatchEvent(new CustomEvent('cart:updated'));

          /* Open cart drawer if present */
          const drawer = document.querySelector('cart-drawer');
          if (drawer && typeof drawer.open === 'function') {
            drawer.open(btn);
          }

        } catch (err) {
          console.error('[diamond-buy] ATC error:', err);
        } finally {
          btn.classList.remove('is-loading');
          if (barBtn) barBtn.disabled = false;
        }
      });
    }
  }

  customElements.define('diamond-buy', DiamondBuy);
})();
{% endjavascript %}

