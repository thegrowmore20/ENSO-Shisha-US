{% javascript %}
(function () {
  if (customElements.get('diamond-buy')) return;

  class DiamondBuy extends HTMLElement {
    #lineKey = null;

    connectedCallback() {
      const sectionId  = this.dataset.sectionId;
      const form       = document.getElementById('DiamondForm-' + sectionId);
      const btn        = document.getElementById('DiamondBtn-' + sectionId);
      const stickyForm = document.getElementById('StickyProductForm-' + sectionId);
      const stickyBtn  = stickyForm && stickyForm.querySelector('[data-add-to-cart]');
      const ctaLabel   = btn ? btn.dataset.label : '';

      /* ── Helpers ── */
      const updateCount = (cart) => {
        if (typeof updateCartItemCounts === 'function') {
          updateCartItemCounts(cart.item_count);
        } else {
          document.querySelectorAll('.cart-count').forEach((el) => {
            el.textContent = cart.item_count;
            el.hidden = cart.item_count === 0;
          });
        }
      };

      const setAdded = (key) => {
        this.#lineKey = key;
        [btn, stickyBtn].forEach((b) => {
          if (!b) return;
          b.setAttribute('aria-pressed', 'true');
          b.textContent = 'Added to cart';
        });
      };

      const setDefault = () => {
        this.#lineKey = null;
        [btn, stickyBtn].forEach((b) => {
          if (!b) return;
          b.removeAttribute('aria-pressed');
          b.textContent = ctaLabel;
        });
      };

      const setBusy = (busy) => {
        [btn, stickyBtn].forEach((b) => {
          if (!b) return;
          b.classList.toggle('is-loading', busy);
          if (b === stickyBtn) b.disabled = busy;
        });
      };

      /* ── Bar: slide in when buy card leaves viewport ── */
      const bar = document.getElementById('bar');
      const buyCard = document.getElementById('DBuyCard-' + sectionId);
      if (bar && buyCard) {
        new IntersectionObserver(([entry]) => {
          bar.classList.toggle('is-on', !entry.isIntersecting);
        }, { threshold: 0 }).observe(buyCard);
      }

      /* ── Sticky form → route through main AJAX handler ── */
      if (stickyForm && form) {
        stickyForm.addEventListener('submit', (e) => {
          e.preventDefault();
          form.requestSubmit();
        });
      }

      if (!form || !btn) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (btn.classList.contains('is-loading')) return;

        /* ── Already in cart → remove ── */
        if (btn.getAttribute('aria-pressed') === 'true' && this.#lineKey) {
          setBusy(true);
          try {
            await fetch('/cart/change.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: this.#lineKey, quantity: 0 })
            });
            setDefault();
            const cart = await (await fetch('/cart.js')).json();
            updateCount(cart);
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart } }));
            if (typeof updateCartDrawer === 'function') await updateCartDrawer();
          } catch (err) {
            console.error('[diamond-buy] remove error:', err);
          } finally {
            setBusy(false);
          }
          return;
        }

        /* ── Add to cart ── */
        setBusy(true);
        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/javascript' },
            body: new FormData(form)
          });
          if (!res.ok) throw new Error('cart/add failed');
          const item = await res.json();

          setAdded(item.key);

          if (typeof window.__showProductToast === 'function') {
            window.__showProductToast(item.product_title || item.title || '');
          }

          const cart = await (await fetch('/cart.js')).json();
          updateCount(cart);
          document.dispatchEvent(new CustomEvent('cart:add', { detail: { item } }));

          if (this.dataset.cartType === 'drawer') {
            if (typeof updateCartDrawer === 'function') await updateCartDrawer();
            if (typeof openCartDrawer === 'function') openCartDrawer();
          }

        } catch (err) {
          console.error('[diamond-buy] ATC error:', err);
        } finally {
          setBusy(false);
        }
      });
    }
  }

  customElements.define('diamond-buy', DiamondBuy);
})();
{% endjavascript %}

