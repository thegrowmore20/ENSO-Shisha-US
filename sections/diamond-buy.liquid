{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_compare = false
  if product.compare_at_price > product.price
    assign has_compare = true
  endif
  assign gallery_layout = section.settings.gallery_layout | default: 'thumbnails_bottom'
-%}

{% style %}
  #section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 992px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% stylesheet %}

/* ── Section wrapper ── */
.d-buy {}

/* ── Two-column grid ── */
.d-buy__cols {
  display: grid;
  grid-template-columns: minmax(0, 680px) minmax(380px, 520px);
  justify-content: center;
  gap: 48px;
  align-items: start;
}
@media screen and (max-width: 1199px) {
  .d-buy__cols {
    grid-template-columns: minmax(0, 1fr) minmax(340px, 400px);
    gap: 40px;
  }
}
@media screen and (max-width: 991px) {
  .d-buy__cols {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}

/* ── Left column: gallery + specs stacked ── */
.d-buy__left {
  display: flex;
  flex-direction: column;
  gap: 28px;
  min-width: 0;
}

/* ── Gallery area ── */
.d-buy__gallery {
  min-width: 0;
}

/* ── Gallery — identical to main-product.liquid so the custom element works ── */
.product-gallery { display: block; }

.media-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1 / 1;
  background: rgba(0,0,0,.05);
  border-radius: var(--radius-xl);
}
.media-placeholder__mark { width: 30%; height: auto; opacity: .4; }

.product-gallery__image,
.product-gallery__video,
.product-gallery__model {
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

.product-gallery--thumbnails_bottom .product-gallery__thumbs {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
  overflow-x: auto;
}

.product-gallery--thumbnails_left {
  display: flex;
  flex-direction: row-reverse;
  gap: var(--space-4);
}
.product-gallery--thumbnails_left .product-gallery__main { flex: 1; min-width: 0; }

.product-gallery__main {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-xl);
  border: 1px solid var(--color-border);
  margin-bottom: 16px;
  touch-action: pan-y;
}

.product-gallery__track {
  display: flex;
  transition: transform 0.35s var(--ease-out);
}
.product-gallery__track.is-dragging { transition: none; }

.product-gallery__item { flex: 0 0 100%; min-width: 0; }

.product-gallery--thumbnails_left .product-gallery__thumbs-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  max-height: 600px;
}
.product-gallery--thumbnails_left .product-gallery__thumbs {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  overflow-y: auto;
  min-height: 0;
  scrollbar-width: none;
}
.product-gallery--thumbnails_left .product-gallery__thumbs::-webkit-scrollbar { display: none; }

.product-gallery__thumbs-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  padding: 0;
  border-radius: 50%;
  background: rgb(255,255,255);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  border: 1px solid rgba(255,255,255,.5);
  color: var(--color-text);
  opacity: .8;
  transition: opacity .2s ease, background-color .2s ease;
}
.product-gallery__thumbs-arrow:hover { opacity: 1; background: rgba(255,255,255,.5); }
.product-gallery__thumbs-arrow .icon-chevron { width: 14px; height: 14px; }
.product-gallery__thumbs-arrow--prev .icon-chevron { transform: rotate(180deg); }
.product-gallery__thumbs-arrow[hidden] { display: none; }

@media screen and (max-width: 991px) {
  .product-gallery--thumbnails_left { flex-direction: column; }
  .product-gallery--thumbnails_left .product-gallery__thumbs-wrap {
    flex-direction: row;
    gap: 0;
    max-height: none;
    min-width: 0;
    width: 100%;
    position: relative;
  }
  .product-gallery--thumbnails_left .product-gallery__thumbs {
    flex-direction: row;
    gap: var(--space-1);
    overflow-x: auto;
    overflow-y: visible;
    flex: 1;
    min-width: 0;
  }
  .product-gallery--thumbnails_left .product-gallery__thumbs-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }
  .product-gallery--thumbnails_left .product-gallery__thumbs-arrow--prev { left: 0; }
  .product-gallery--thumbnails_left .product-gallery__thumbs-arrow--next { right: 0; }
  .product-gallery__thumbs-arrow--prev .icon-chevron { transform: rotate(90deg); }
  .product-gallery__thumbs-arrow--next .icon-chevron { transform: rotate(-90deg); }
}

.product-gallery__thumb {
  position: relative;
  flex: 0 0 72px;
  width: 72px;
  height: 72px;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 2px solid transparent;
  opacity: .6;
  padding: 0;
  transition: opacity .2s ease, border-color .2s ease;
}
.product-gallery__thumb.is-active,
.product-gallery__thumb:hover {
  opacity: 1;
  border-color: var(--color-accent);
}
.product-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
.product-gallery__thumb-icon {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,.35);
  color: #fff;
}
.product-gallery__scroller .carousel__track > * { flex: 0 0 90%; }
@media screen and (min-width: 750px) {
  .product-gallery__scroller .carousel__track > * { flex: 0 0 100%; }
}

/* ── Specs area ── */
.d-buy__specs {
  min-width: 0;
}

/* ── Spec accordions ── */
.d-spec {
  border-top: 1px solid var(--color-border);
}
.d-spec:last-child {
  border-bottom: 1px solid var(--color-border);
}
.d-spec > summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
  cursor: pointer;
  list-style: none;
  font-weight: 700;
  font-size: 16px;
  user-select: none;
}
.d-spec > summary::-webkit-details-marker { display: none; }
.d-spec > summary::after {
  content: '+';
  font: 400 22px/1 var(--font-body, sans-serif);
  flex-shrink: 0;
  transition: transform .25s ease;
}
.d-spec[open] > summary::after { content: '−'; }

.d-spec__body {
  overflow: hidden;
}
.d-spec__body-inner {
  padding-bottom: 20px;
}
.d-spec__body p {
  font-size: 15px;
  color: rgb(0 0 0 / .65);
  margin: 0;
  line-height: 1.6;
}
.d-spec__dl {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 6px 16px;
  margin: 0;
  font-size: 15px;
  line-height: 1.47;
}
.d-spec__dl dt {
  font-weight: 600;
  color: var(--color-text);
  white-space: nowrap;
}
.d-spec__dl dd {
  margin: 0;
  color: rgb(0 0 0 / .65);
}
.d-spec__dl dd a,
.d-spec__dl dt a {
  color: inherit;
  text-decoration: none;
}

/* Dimensions: dl + image side by side */
.d-spec__dim-grid {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 16px;
  align-items: start;
}
.d-spec__dims img {
  width: 120px;
  height: auto;
  display: block;
}

/* ── Buy card ── */
.d-buy__card {
  position: sticky;
  top: calc(var(--announcement-bar-height, 0px) + var(--site-header-height, 72px) + 20px);
  align-self: start;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  padding: 28px 28px 24px;
}
@media screen and (max-width: 1199px) {
  .d-buy__card { padding: 20px 20px 18px; }
}
@media screen and (max-width: 991px) {
  .d-buy__card {
    position: static;
    margin-top: 0;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 8px;
  }
}

/* Eyebrow */
.d-buy__eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 400;
  color: rgb(0 0 0 / .75);
  margin-bottom: 10px;
}
.d-buy__eyebrow i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #16a34a;
  flex-shrink: 0;
  font-style: normal;
  display: block;
}

/* Title */
.d-buy__title {
  font-family: var(--font-heading);
  font-weight: var(--font-weight-bold);
  font-size: 28px;
  line-height: 34px;
  letter-spacing: -.02em;
  margin: 0 0 6px;
}

/* Sub */
.d-buy__sub {
  color: rgb(0 0 0 / .6);
  font-size: 15px;
  margin: 6px 0 18px;
}

/* Price */
.d-buy__price {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}
.d-buy__price strong {
  font-family: var(--font-accent);
  font-weight: 800;
  font-size: 32px;
  line-height: 1;
  letter-spacing: -.025em;
}
.d-buy__was {
  font-family: var(--font-accent);
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -.02em;
  color: rgb(0 0 0 / .35);
  text-decoration: line-through;
}
.d-buy__price-note {
  flex-basis: 100%;
  font-size: 13px;
  color: rgb(0 0 0 / .5);
  line-height: 1.5;
  margin-top: 2px;
}

/* CTA pill */
.d-buy__form { margin-bottom: 18px; }
.d-buy__pill {
  display: block;
  width: 100%;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 999px;
  padding: 20px 40px;
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 15px;
  letter-spacing: .1em;
  text-transform: uppercase;
  cursor: pointer;
  transition: opacity .2s;
  line-height: 1;
}
.d-buy__pill:hover { opacity: .85; }
.d-buy__pill:disabled { opacity: .45; cursor: not-allowed; }
.d-buy__pill.is-loading { opacity: .7; pointer-events: none; position: relative; color: transparent; }
.d-buy__pill.is-loading::after {
  content: '';
  position: absolute;
  inset: 0;
  margin: auto;
  width: 18px;
  height: 18px;
  border: 2px solid rgba(255,255,255,.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: d-btn-spin .7s linear infinite;
}
@keyframes d-btn-spin { to { transform: rotate(360deg); } }

/* Trust */
.d-trust {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.d-trust li {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  font-size: 13px;
  line-height: 1.46;
  color: rgb(0 0 0 / .65);
}
.d-trust li b {
  display: block;
  font-weight: 600;
  color: var(--color-text);
  font-size: 12px;
}
.d-trust svg {
  width: 20px;
  height: 20px;
  color: var(--color-text);
  flex-shrink: 0;
}
@media screen and (max-width: 479px) {
  .d-trust { grid-template-columns: 1fr; gap: 10px; }
}

/* Facts */
.d-facts {
  list-style: none;
  margin: 22px 0 0;
  padding: 18px 0 0;
  border-top: 1px solid var(--color-border);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 16px;
}
.d-facts li {
  font-size: 14px;
  line-height: 1.5;
  color: rgb(0 0 0 / .72);
  padding-left: 16px;
  position: relative;
}
.d-facts li::before {
  content: '';
  position: absolute;
  left: 2px;
  top: 8px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #000;
}
@media screen and (max-width: 479px) {
  .d-facts { grid-template-columns: 1fr; }
}

/* In the box */
.d-inbox {
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--color-border);
  font-size: 14px;
  line-height: 1.6;
  color: rgb(0 0 0 / .72);
}
.d-inbox b {
  display: block;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 4px;
}
.d-inbox a {
  color: var(--color-text);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 2px;
  white-space: nowrap;
}

/* Contact */
.d-contact {
  font-size: 13px;
  color: rgb(0 0 0 / .5);
  margin: 12px 0 0;
}
.d-contact a {
  color: var(--color-text);
  text-decoration: underline;
  text-underline-offset: 2px;
}

{% endstylesheet %}

<div id="section-{{ section.id }}">

{%- assign sticky_watch_id = 'DBuyCard-' | append: section.id -%}
{%- render 'sticky-add-to-cart',
  product: product,
  section: section,
  watch_target_id: sticky_watch_id,
  cta_label: section.settings.cta_label
-%}

<diamond-buy
  class="d-buy"
  id="buy"
  data-section-id="{{ section.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-cart-type="{{ settings.cart_type }}"
>
  <div class="container">
    <div class="d-buy__cols">

      {%- comment -%} ── LEFT COLUMN: gallery + specs ── {%- endcomment -%}
      <div class="d-buy__left">

      <div class="d-buy__gallery">
        {%- render 'product-media-gallery', product: product, section: section -%}
      </div>

      {%- comment -%} ── SPECS ── {%- endcomment -%}
      <div class="d-buy__specs">

        {%- liquid
          assign mf_dims    = product.metafields.custom.spec_dimensions.value
          assign mf_heat    = product.metafields.custom.spec_heating.value
          assign mf_batt    = product.metafields.custom.spec_battery.value
          assign mf_ctrl    = product.metafields.custom.spec_controls.value
          assign mf_mat     = product.metafields.custom.spec_materials.value
          assign mf_compat  = product.metafields.custom.spec_compatibility.value
        -%}

        <details class="d-spec" data-accordion>
          <summary>Product dimensions</summary>
          <div class="d-spec__body">
            {%- if mf_dims != blank -%}
              <div class="d-spec__body-inner">{{ product.metafields.custom.spec_dimensions | metafield_tag }}</div>
            {%- else -%}
            <div class="d-spec__body-inner">
              <div class="d-spec__dim-grid">
                <dl class="d-spec__dl">
                  <dt>Height</dt><dd>18 cm with the cap on</dd>
                  <dt>Width</dt><dd>10 cm at the band</dd>
                  <dt>Weight</dt><dd>About 1 kg with the battery</dd>
                  <dt>Fits</dt><dd>Stem tops that take a standard bowl</dd>
                </dl>
                <div class="d-spec__dims">
                  <img src="https://cdn.shopify.com/s/files/1/0773/3218/5401/files/dim-silhouette.webp?v=1791784230" alt="ENSŌ Diamond silhouette dimensions" loading="lazy" width="120">
                </div>
              </div>
            </div>
            {%- endif -%}
          </div>
        </details>

        <details class="d-spec" data-accordion>
          <summary>Heating</summary>
          <div class="d-spec__body">
            {%- if mf_heat != blank -%}
              <div class="d-spec__body-inner">{{ product.metafields.custom.spec_heating | metafield_tag }}</div>
            {%- else -%}
            <div class="d-spec__body-inner">
              <dl class="d-spec__dl">
                <dt>Session temperature</dt><dd>180–320 °C, one-degree steps</dd>
                <dt>Pre-heat</dt><dd>0–15 minutes, default 7 minutes at 275 °C</dd>
                <dt>Element</dt><dd>Below and around the ceramic cup</dd>
                <dt>Profiles</dt><dd>Default, Phoenix, Wraith, Oracle</dd>
              </dl>
            </div>
            {%- endif -%}
          </div>
        </details>

        <details class="d-spec" data-accordion>
          <summary>Battery and charging</summary>
          <div class="d-spec__body">
            {%- if mf_batt != blank -%}
              <div class="d-spec__body-inner">{{ product.metafields.custom.spec_battery | metafield_tag }}</div>
            {%- else -%}
            <div class="d-spec__body-inner">
              <dl class="d-spec__dl">
                <dt>Runtime</dt><dd>About 90 minutes, pre-heat not included</dd>
                <dt>Charging</dt><dd>USB-C, about 1.5 hours with a 30 W supply</dd>
                <dt>Charge while in use</dt><dd>Yes, over USB-C</dd>
                <dt>Firmware</dt><dd>Updates over USB-C</dd>
              </dl>
            </div>
            {%- endif -%}
          </div>
        </details>

        <details class="d-spec" data-accordion>
          <summary>Controls</summary>
          <div class="d-spec__body">
            {%- if mf_ctrl != blank -%}
              <div class="d-spec__body-inner">{{ product.metafields.custom.spec_controls | metafield_tag }}</div>
            {%- else -%}
            <div class="d-spec__body-inner">
              <dl class="d-spec__dl">
                <dt>Dial</dt><dd>Turn to move, click to choose</dd>
                <dt>Screen</dt><dd>Round display, colour themes, brightness</dd>
                <dt>Feedback</dt><dd>Sound and haptics, adjustable or off</dd>
                <dt>App</dt><dd>None needed — no account, no phone</dd>
              </dl>
            </div>
            {%- endif -%}
          </div>
        </details>

        <details class="d-spec" data-accordion>
          <summary>Materials</summary>
          <div class="d-spec__body">
            {%- if mf_mat != blank -%}
              <div class="d-spec__body-inner">{{ product.metafields.custom.spec_materials | metafield_tag }}</div>
            {%- else -%}
            <div class="d-spec__body-inner">
              <dl class="d-spec__dl">
                <dt>Body</dt><dd>Soft-touch graphite, copper stripe, vegan leather band</dd>
                <dt>Cup and chamber</dt><dd>Glazed ceramic cup, stainless steel mesh and air path</dd>
                <dt>Cap</dt><dd>Heat-holding shell, air plate, silicone insert</dd>
              </dl>
            </div>
            {%- endif -%}
          </div>
        </details>

        <details class="d-spec" data-accordion>
          <summary>Compatibility</summary>
          <div class="d-spec__body">
            {%- if mf_compat != blank -%}
              <div class="d-spec__body-inner">{{ product.metafields.custom.spec_compatibility | metafield_tag }}</div>
            {%- else -%}
            <div class="d-spec__body-inner">
              <p>Most traditional stems, with one of the two silicone adapters in the box. Not sure about yours? Send us a photo of the stem top.</p>
            </div>
            {%- endif -%}
          </div>
        </details>

      </div>{%- comment -%} /d-buy__specs {%- endcomment -%}

      </div>{%- comment -%} /d-buy__left {%- endcomment -%}

      {%- comment -%} ── BUY CARD ── {%- endcomment -%}
      <aside class="d-buy__card" id="DBuyCard-{{ section.id }}">

        <div class="d-buy__eyebrow"><i aria-hidden="true"></i>Pre-order open</div>

        <h1 class="d-buy__title">{{ product.title }}</h1>

        {%- if section.settings.subline != blank -%}
          <p class="d-buy__sub">{{ section.settings.subline }}</p>
        {%- endif -%}

        <div class="d-buy__price">
          <strong>{{ current_variant.price | money }}</strong>
          {%- if has_compare -%}
            <span class="d-buy__was">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
          {%- if section.settings.price_note != blank -%}
            <span class="d-buy__price-note">{{ section.settings.price_note }}</span>
          {%- endif -%}
        </div>

        <form
          action="/cart/add"
          method="post"
          id="DiamondForm-{{ section.id }}"
          class="d-buy__form"
          novalidate
        >
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button
            type="submit"
            class="d-buy__pill"
            id="DiamondBtn-{{ section.id }}"
            {%- unless current_variant.available -%}disabled{%- endunless -%}
          >
            {%- if current_variant.available -%}
              {{ section.settings.cta_label | default: 'Pre-order' }}
            {%- else -%}
              Sold out
            {%- endif -%}
          </button>
        </form>

        <ul class="d-trust" aria-label="Purchase trust">
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span><b>30 days to decide</b>From delivery</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3 4.5 6v5.2c0 4.6 3.2 8.4 7.5 9.8 4.3-1.4 7.5-5.2 7.5-9.8V6L12 3Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            </svg>
            <span><b>Real people answer</b>Email support, in English</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16v11H4zM8 7V5h8v2" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M4 12h16" stroke="currentColor" stroke-width="1.75"/>
            </svg>
            <span><b>EU prices include VAT</b>US prices before sales tax</span>
          </li>
        </ul>

        <ul class="d-facts">
          <li>About seven minutes to the first draw</li>
          <li>About 90 minutes per battery</li>
          <li>Fits most traditional stems</li>
          <li>Two-year warranty, one year on the battery</li>
          <li>Ships from our warehouse in Hungary</li>
        </ul>

        {%- if section.settings.inbox_text != blank -%}
          <div class="d-inbox">
            <b>In the box</b>
            <span>{{ section.settings.inbox_text }} <a href="#package">See it laid out</a></span>
          </div>
        {%- endif -%}

        {%- if section.settings.contact_email != blank -%}
          <p class="d-contact">Questions before you order: <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></p>
        {%- endif -%}

      </aside>
    </div>
  </div>
</diamond-buy>

</div>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% javascript %}
(function () {
  if (customElements.get('diamond-buy')) return;

  class DiamondBuy extends HTMLElement {
    connectedCallback() {
      const sectionId  = this.dataset.sectionId;
      const form       = document.getElementById('DiamondForm-' + sectionId);
      const btn        = document.getElementById('DiamondBtn-' + sectionId);
      const stickyForm = document.getElementById('StickyProductForm-' + sectionId);
      const stickyBtn  = stickyForm && stickyForm.querySelector('[data-add-to-cart]');

      /* ── Sticky form → route through main AJAX handler ── */
      if (stickyForm && form) {
        stickyForm.addEventListener('submit', (e) => {
          e.preventDefault();
          form.requestSubmit();
        });
      }

      /* ── AJAX ATC ── */
      if (!form || !btn) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (btn.disabled || btn.classList.contains('is-loading')) return;

        btn.classList.add('is-loading');
        if (stickyBtn) { stickyBtn.disabled = true; stickyBtn.classList.add('is-loading'); }

        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/javascript' },
            body: new FormData(form)
          });

          if (!res.ok) throw new Error('cart/add failed');
          const item = await res.json();

          // Show toast notification (exposed by product-popup.liquid)
          if (typeof window.__showProductToast === 'function') {
            window.__showProductToast(item.product_title || item.title || '');
          }

          // Update header cart count bubble
          const cartRes = await fetch('/cart.js');
          const cart = await cartRes.json();
          if (typeof updateCartItemCounts === 'function') {
            updateCartItemCounts(cart.item_count);
          } else {
            document.querySelectorAll('.cart-count').forEach(function (el) {
              el.textContent = cart.item_count;
              el.hidden = cart.item_count === 0;
            });
          }

          document.dispatchEvent(new CustomEvent('cart:add', { detail: { item } }));

          // Open cart drawer only when enabled in theme settings
          if (this.dataset.cartType === 'drawer') {
            if (typeof updateCartDrawer === 'function') await updateCartDrawer();
            if (typeof openCartDrawer === 'function') openCartDrawer();
          }

        } catch (err) {
          console.error('[diamond-buy] ATC error:', err);
        } finally {
          btn.classList.remove('is-loading');
          if (stickyBtn) { stickyBtn.disabled = false; stickyBtn.classList.remove('is-loading'); }
        }
      });
    }
  }

  customElements.define('diamond-buy', DiamondBuy);
})();
{% endjavascript %}

