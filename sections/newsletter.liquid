{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
-%}

<section class="newsletter {{ scheme_class }} section-padding">
  <div class="container newsletter__inner text-center">
    <hr class="divider-amber" style="margin-inline: auto;">
    {%- if section.settings.heading != blank -%}
      <h2 class="h-product">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="body-text text-muted newsletter__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'NewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__field">
        <label class="visually-hidden" for="NewsletterEmail">{{ 'sections.newsletter.placeholder' | t }}</label>
        <input
          type="email"
          id="NewsletterEmail"
          name="contact[email]"
          class="search-input"
          placeholder="{{ 'sections.newsletter.placeholder' | t }}"
          required
        >
        <button type="submit" class="btn btn--primary">{{ 'sections.newsletter.submit' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="caption">{{ 'sections.newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="caption">{{ 'sections.newsletter.error' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .newsletter__inner {
    max-width: 560px;
    margin-inline: auto;
  }

  .newsletter__text {
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .newsletter__field {
    display: flex;
    gap: var(--space-2);
  }

  .newsletter__field .search-input {
    flex: 1;
  }

  @media screen and (max-width: 589px) {
    .newsletter__field {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.newsletter.settings.color_scheme.label",
      "default": "scheme-paper"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "Your Ritual. Without Charcoal."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.newsletter.settings.text.label",
      "default": "Refined for 2026. Join the list for release updates."
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name"
    }
  ]
}
{% endschema %}
