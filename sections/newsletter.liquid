{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text
-%}

<section class="newsletter {{ scheme_class }} section-padding">
  <div class="container newsletter__inner text-center">
    <span class="newsletter__icon" aria-hidden="true">{%- render 'icon-newsletter' -%}</span>
    {%- if section.settings.heading != blank -%}
      <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="newsletter__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'NewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__field">
        <label class="visually-hidden" for="NewsletterEmail">{{ 'sections.newsletter.placeholder' | t }}</label>
        <input
          type="email"
          id="NewsletterEmail"
          name="contact[email]"
          class="newsletter__input"
          placeholder="{{ 'sections.newsletter.placeholder' | t }}"
          required
        >
        <button type="submit" class="newsletter__submit">{{ 'sections.newsletter.submit' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="caption newsletter__message">{{ 'sections.newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="caption newsletter__message newsletter__message--error">{{ 'sections.newsletter.error' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .newsletter__inner {
    max-width: 460px;
    margin-inline: auto;
  }

  .newsletter__icon {
    display: inline-flex;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .newsletter__icon svg {
    width: 32px;
    height: 32px;
  }

  .newsletter__heading {
    margin: 0;
    font-weight: 700;
  }

  .newsletter__text {
    margin: var(--space-2) 0 var(--space-6);
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .newsletter__field {
    display: flex;
    gap: var(--space-3);
  }

  .newsletter__input {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-sm);
    border: none;
    background-color: rgba(0, 0, 0, 0.05);
    color: var(--color-text);
    font-size: 15px;
  }

  .newsletter__input::placeholder {
    color: var(--color-text-muted);
  }

  .newsletter__input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .newsletter__submit {
    flex-shrink: 0;
    height: 48px;
    padding: 0 var(--space-6);
    border-radius: var(--radius-pill);
    background-color: #000;
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .newsletter__submit:hover {
    opacity: 0.85;
  }

  .newsletter__message {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .newsletter__message--error {
    color: #c0392b;
  }

  @media screen and (max-width: 589px) {
    .newsletter__field {
      flex-direction: column;
    }

    .newsletter__submit {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "Your Ritual. Without Charcoal."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.newsletter.settings.text.label",
      "default": "Refined for 2026. Join the list for release updates."
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name"
    }
  ]
}
{% endschema %}
