      "id": "product_image",
      "label": "t:sections.diamond_guide_switch_on.settings.product_image.label"
    },
    {
      "type": "range",
      "id": "scroll_height",
      "label": "t:sections.diamond_guide_switch_on.settings.scroll_height.label",
      "min": 200, "max": 800, "step": 20, "unit": "vh", "default": 580
    },
    {
      "type": "header",
      "content": "t:sections.diamond_guide_switch_on.settings.screens_header.content"
    },
    {
      "type": "image_picker",
      "id": "screen_start",
      "label": "t:sections.diamond_guide_switch_on.settings.screen_start.label"
    },
    {
      "type": "image_picker",
      "id": "screen_timer",
      "label": "t:sections.diamond_guide_switch_on.settings.screen_timer.label"
    },
    {
      "type": "image_picker",
      "id": "screen_preheat",
      "label": "t:sections.diamond_guide_switch_on.settings.screen_preheat.label"
    },
    {
      "type": "image_picker",
