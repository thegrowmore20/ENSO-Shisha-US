{% stylesheet %}

.dg-rail {
  max-width: var(--page-width);
  margin: 0 auto;
}

.dg-rail__head {
  display: grid;
  grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  gap: 24px;
  align-items: end;
  padding: 0 var(--page-margin);
  margin-bottom: 32px;
}

.dg-rail__head h2 {
  font-size: 44px;
  line-height: 50px;
  font-weight: var(--font-weight-heavy);
  font-family: var(--font-heading);
  margin: 0;
  letter-spacing: -.02em;
}

.dg-rail__head p {
  font-size: 15px;
  line-height: 1.6;
  color: rgb(0 0 0 / .72);
  margin: 0;
}

.dg-rail__track {
  display: flex;
  gap: 20px;
  padding: 0 var(--page-margin) 8px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.dg-rail__track::-webkit-scrollbar { display: none; }

.dg-rail__card {
  flex: 0 0 min(560px, 78vw);
  border: 1px solid var(--color-border);
  border-radius: 12px;
  overflow: hidden;
  background: #fff;
  display: flex;
  flex-direction: column;
  scroll-snap-align: start;
}

.dg-rail__card img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  background: #fff;
  display: block;
}

.dg-rail__card-placeholder {
  width: 100%;
  aspect-ratio: 4 / 5;
  display: block;
}

.dg-rail__body {
  padding: 22px 24px 26px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.dg-rail__n {
  font-size: 13px;
  font-weight: var(--font-weight-bold);
  letter-spacing: .06em;
  color: rgb(0 0 0 / .4);
}

.dg-rail__body h3 {
  font-size: 26px;
  line-height: 32px;
  font-weight: 800;
  font-family: var(--font-accent);
  letter-spacing: -.025em;
  margin: 0;
}

.dg-rail__body p {
  font-size: 15px;
  line-height: 24px;
  color: rgb(0 0 0 / .72);
  margin: 0;
}

.dg-rail__warn {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  margin-top: 4px;
  padding: 12px 14px;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  font-size: 14px;
  line-height: 22px;
}

.dg-rail__warn svg {
  flex: 0 0 20px;
  width: 20px;
  height: 20px;
  margin-top: 1px;
}

.dg-rail__dots {
  display: flex;
  gap: 10px;
  padding: 16px var(--page-margin) 0;
}

.dg-rail__dots i {
  display: block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgb(0 0 0 / .18);
  font-style: normal;
  transition: background .3s;
}

.dg-rail__dots i.is-on {
  background: #000;
}

@media screen and (max-width: 989px) {
  .dg-rail__head {
    grid-template-columns: 1fr;
    padding-left: var(--page-margin);
    padding-right: var(--page-margin);
  }
  .dg-rail__head h2 {
    font-size: 30px;
    line-height: 36px;
  }
}

{% endstylesheet %}

{% style %}
  #shopify-section-{{ section.id }} .dg-rail {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .dg-rail {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
  #shopify-section-{{ section.id }} .dg-rail__head {
    padding-top: 0;
  }
{% endstyle %}

<section class="dg-rail" id="{{ section.settings.section_id | default: '' }}" aria-labelledby="DgRailHead-{{ section.id }}">
  <div class="dg-rail__head">
    <h2 id="DgRailHead-{{ section.id }}">{{ section.settings.heading | default: 'Charge the battery first' | escape }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="dg-rail__track" data-dg-rail-track>
      {%- for block in section.blocks -%}
        <article class="dg-rail__card" role="listitem" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{- block.settings.image | image_url: width: 600 | image_tag:
              alt: block.settings.image.alt | default: block.settings.heading,
              loading: 'lazy',
              widths: '400,600',
              sizes: 'min(560px, 78vw)'
            -}}
          {%- else -%}
            <svg class="dg-rail__card-placeholder" viewBox="0 0 4 5" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="4" height="5" fill="#f0ede8"/>
              <path d="M1.6 2.5 L2 1.9 L2.4 2.5 M1.75 2.5 L2.25 2.5 M2 2.5 L2 3.1" stroke="#c8b89a" stroke-width="0.08" stroke-linecap="round"/>
            </svg>
          {%- endif -%}
          <div class="dg-rail__body">
            <span class="dg-rail__n" aria-hidden="true">{{ forloop.index }}</span>
            <h3>{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.body != blank -%}
              <p>{{ block.settings.body | escape }}</p>
            {%- endif -%}
            {%- if block.settings.warning != blank -%}
              <div class="dg-rail__warn" role="note">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 3 2.5 20h19L12 3Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                  <path d="M12 9v5M12 17h.01" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                </svg>
                <span>{{ block.settings.warning | escape }}</span>
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

  {%- endif -%}
</section>

{% javascript %}
(function() {
  document.querySelectorAll('[data-dg-rail-track]').forEach(function(track) {
    var dots = track.closest('.dg-rail')
      ? track.closest('.dg-rail').querySelector('[data-dg-rail-dots]')
      : null;
    if (!dots) return;
    var dotEls = Array.from(dots.querySelectorAll('i'));
    var cards = Array.from(track.querySelectorAll('.dg-rail__card'));
    if (!cards.length) return;
    track.addEventListener('scroll', function() {
      var scrollLeft = track.scrollLeft;
      var cardWidth = cards[0].offsetWidth + 20;
      var idx = Math.round(scrollLeft / cardWidth);
      idx = Math.max(0, Math.min(idx, dotEls.length - 1));
      dotEls.forEach(function(d, i) { d.classList.toggle('is-on', i === idx); });
    }, { passive: true });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.diamond_guide_charge_rail.name",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "t:sections.diamond_guide_charge_rail.settings.section_id.label",
      "info": "t:sections.diamond_guide_charge_rail.settings.section_id.info",
      "default": "quick-start"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_guide_charge_rail.settings.heading.label",
      "default": "Charge the battery first"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.diamond_guide_charge_rail.settings.subheading.label",
      "default": "Two things before the first session."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:sections.diamond_guide_charge_rail.blocks.card.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.diamond_guide_charge_rail.blocks.card.settings.image.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.diamond_guide_charge_rail.blocks.card.settings.heading.label",
          "default": "Step heading"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "t:sections.diamond_guide_charge_rail.blocks.card.settings.body.label"
        },
        {
          "type": "textarea",
          "id": "warning",
          "label": "t:sections.diamond_guide_charge_rail.blocks.card.settings.warning.label"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.diamond_guide_charge_rail.presets.name"
    }
  ]
}
{% endschema %}
