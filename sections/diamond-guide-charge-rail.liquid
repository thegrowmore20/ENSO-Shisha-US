{% stylesheet %}

.dg-rail {
  padding: 80px 0;
}

.dg-rail__head {
  margin-bottom: 28px;
}

.dg-rail__head h2 {
  font-size: var(--font-size-h2);
  font-weight: var(--font-weight-heavy);
  font-family: var(--font-heading);
  margin: 0 0 6px;
  line-height: 1.1;
}

.dg-rail__head p {
  font-size: 15px;
  color: rgb(0 0 0 / .66);
  margin: 0;
}

.dg-rail__track {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 4px;
}
.dg-rail__track::-webkit-scrollbar { display: none; }

.dg-rail__card {
  flex: none;
  width: min(400px, 86vw);
  border-radius: 20px;
  overflow: hidden;
  background: var(--color-background);
  box-shadow: var(--shadow-md);
  scroll-snap-align: start;
}

.dg-rail__card img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  display: block;
}

.dg-rail__card-placeholder {
  width: 100%;
  aspect-ratio: 4 / 3;
  display: block;
}

.dg-rail__body {
  padding: 24px;
}

.dg-rail__n {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-text);
  color: var(--color-background);
  font-size: 13px;
  font-weight: var(--font-weight-bold);
  margin-bottom: 10px;
  font-family: var(--font-accent);
}

.dg-rail__body h3 {
  font-size: 18px;
  font-weight: var(--font-weight-bold);
  font-family: var(--font-heading);
  margin: 0 0 8px;
}

.dg-rail__body p {
  font-size: 14px;
  line-height: 1.6;
  color: rgb(0 0 0 / .66);
  margin: 0;
}

.dg-rail__warn {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  margin-top: 12px;
  padding: 10px 12px;
  background: rgb(0 0 0 / .04);
  border-radius: 8px;
  font-size: 13px;
  line-height: 1.5;
}

.dg-rail__warn svg {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  margin-top: 1px;
}

.dg-rail__dots {
  display: flex;
  justify-content: center;
  gap: 6px;
  margin-top: 16px;
}

.dg-rail__dots i {
  display: block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgb(0 0 0 / .2);
  font-style: normal;
  transition: background .2s;
}

.dg-rail__dots i.is-on {
  background: var(--color-text);
}

@media screen and (max-width: 989px) {
  .dg-rail { padding: 40px 0; }
}

{% endstylesheet %}

{% style %}
  #shopify-section-{{ section.id }} .dg-rail {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .dg-rail {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section class="dg-rail" id="{{ section.settings.section_id | default: '' }}" aria-labelledby="DgRailHead-{{ section.id }}">
  <div class="container">
    <div class="dg-rail__head">
      <h2 id="DgRailHead-{{ section.id }}">{{ section.settings.heading | default: 'Charge the battery first' | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="dg-rail__track" data-dg-rail-track>
        {%- for block in section.blocks -%}
          <article class="dg-rail__card" role="listitem" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{- block.settings.image | image_url: width: 800 | image_tag:
                alt: block.settings.image.alt | default: block.settings.heading,
                loading: 'lazy',
                widths: '400,600,800',
                sizes: 'min(400px, 86vw)'
              -}}
            {%- else -%}
              <svg class="dg-rail__card-placeholder" viewBox="0 0 4 3" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="4" height="3" fill="#f0ede8"/>
                <path d="M1.6 1.5 L2 0.9 L2.4 1.5 M1.75 1.5 L2.25 1.5 M2 1.5 L2 2.1" stroke="#c8b89a" stroke-width="0.08" stroke-linecap="round"/>
              </svg>
            {%- endif -%}
            <div class="dg-rail__body">
              <span class="dg-rail__n" aria-hidden="true">{{ forloop.index }}</span>
              <h3>{{ block.settings.heading | escape }}</h3>
              {%- if block.settings.body != blank -%}
                <p>{{ block.settings.body | escape }}</p>
              {%- endif -%}
              {%- if block.settings.warning != blank -%}
                <div class="dg-rail__warn" role="note">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3 2.5 20h19L12 3Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                    <path d="M12 9v5M12 17h.01" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                  </svg>
                  <span>{{ block.settings.warning | escape }}</span>
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="dg-rail__dots" aria-hidden="true" data-dg-rail-dots>
          {%- for block in section.blocks -%}
            <i{% if forloop.first %} class="is-on"{% endif %}></i>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% javascript %}
(function() {
  document.querySelectorAll('[data-dg-rail-track]').forEach(function(track) {
    var dots = track.closest('.dg-rail')
      ? track.closest('.dg-rail').querySelector('[data-dg-rail-dots]')
      : null;
    if (!dots) return;
    var dotEls = Array.from(dots.querySelectorAll('i'));
    var cards = Array.from(track.querySelectorAll('.dg-rail__card'));
    if (!cards.length) return;
    track.addEventListener('scroll', function() {
      var scrollLeft = track.scrollLeft;
      var cardWidth = cards[0].offsetWidth + 20;
      var idx = Math.round(scrollLeft / cardWidth);
      idx = Math.max(0, Math.min(idx, dotEls.length - 1));
      dotEls.forEach(function(d, i) { d.classList.toggle('is-on', i === idx); });
    }, { passive: true });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.diamond_guide_charge_rail.name",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "t:sections.diamond_guide_charge_rail.settings.section_id.label",
      "info": "t:sections.diamond_guide_charge_rail.settings.section_id.info",
      "default": "quick-start"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_guide_charge_rail.settings.heading.label",
      "default": "Charge the battery first"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.diamond_guide_charge_rail.settings.subheading.label",
      "default": "Two things before the first session."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:sections.diamond_guide_charge_rail.blocks.card.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.diamond_guide_charge_rail.blocks.card.settings.image.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.diamond_guide_charge_rail.blocks.card.settings.heading.label",
          "default": "Step heading"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "t:sections.diamond_guide_charge_rail.blocks.card.settings.body.label"
        },
        {
          "type": "textarea",
          "id": "warning",
          "label": "t:sections.diamond_guide_charge_rail.blocks.card.settings.warning.label"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.diamond_guide_charge_rail.presets.name"
    }
  ]
}
{% endschema %}
