{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
<div class="wrap">
  <section class="ch" id="warranty"><p class="ch__num">16 · Help</p><h2>Warranty and support</h2><p class="ch__lead">Two years on Diamond, one year on the battery.</p><p>Write to <a href="mailto:support@ensoshisha.com">support@ensoshisha.com</a> with your order number and a short description or a photo. <a href="/pages/warranty">Read the warranty terms →</a></p></section>
</div>

{% schema %}
{
  "name": "DM: Warranty",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#faf8f4"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "DM: Warranty"
    }
  ]
}
{% endschema %}
