{% javascript %}
(function () {
  /* ── resolve IDs from the globally set section ID ── */
  const sid = window.__witbSectionId;
  if (!sid) return;

  const modal      = document.getElementById(sid + '-Modal');
  const openBoxBtn = document.getElementById(sid + '-OpenBox');
  if (!modal) return;

  let lastModalFocus = null;

  function openModal() {
    lastModalFocus = document.activeElement;
    modal.hidden = false;
    requestAnimationFrame(() => modal.classList.add('is-on'));
    document.body.style.overflow = 'hidden';
    modal.querySelector('.d-witb-modal__close').focus();
    if (openBoxBtn) openBoxBtn.setAttribute('aria-expanded', 'true');
  }

  function closeModal() {
    modal.classList.remove('is-on');
    modal.addEventListener('transitionend', () => {
      modal.hidden = true;
    }, { once: true });
    document.body.style.overflow = '';
    if (openBoxBtn) openBoxBtn.setAttribute('aria-expanded', 'false');
    if (lastModalFocus && lastModalFocus.focus) lastModalFocus.focus();
  }

  if (openBoxBtn) openBoxBtn.addEventListener('click', openModal);
  modal.querySelector('.d-witb-modal__close').addEventListener('click', closeModal);
  modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

  /* Clicking an acc item in the modal list opens the acc sheet */
  modal.querySelectorAll('.d-witb-modal__list li[data-handle]').forEach(li => {
    li.addEventListener('click', () => {
      const handle = li.dataset.handle;
      if (!handle) return;
      closeModal();
      if (typeof window.openAccSheet === 'function') window.openAccSheet(handle, li);
    });
  });

  /* Device tile → open BOXALL modal */
  document.querySelectorAll('.d-witb__tile[data-opens-modal]').forEach(btn => {
    btn.addEventListener('click', openModal);
  });

  /* Acc tiles → open acc sheet */
  document.querySelectorAll('.d-witb__tile[data-handle]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (typeof window.openAccSheet === 'function') window.openAccSheet(btn.dataset.handle, btn);
    });
  });

  /* Escape key closes modal */
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
})();
{% endjavascript %}

