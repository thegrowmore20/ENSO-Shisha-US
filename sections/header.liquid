{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text

  comment
    The drawer can carry more links than the desktop bar (Guides, Support,
    FAQ). When no separate mobile menu is picked it mirrors the main menu.
  endcomment
  assign mobile_menu = section.settings.menu
  if section.settings.mobile_menu.links.size > 0
    assign mobile_menu = section.settings.mobile_menu
  endif
-%}

<mobile-menu>
<header class="site-header {{ scheme_class }}" data-sticky="{{ section.settings.sticky }}">
  <div class="site-header__bar">
    <div class="container site-header__inner">
      <button
        type="button"
        class="site-header__menu-btn"
        data-menu-trigger
        aria-label="{{ 'header.menu' | t }}"
        aria-expanded="false"
        aria-controls="SiteHeaderPanel"
      >
        {%- render 'icon-menu' -%}
      </button>

      <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }}">
        {%- render 'site-logo' -%}
      </a>

      <nav class="site-header__nav" aria-label="{{ 'header.menu' | t }}">
        <ul>
          {%- for link in section.settings.menu.links -%}
            {%- liquid
              assign has_children = false
              if link.links.size > 0
                assign has_children = true
              endif

              assign mega_block = nil
              for block in section.blocks
                if block.type == 'mega_menu'
                  assign target = block.settings.mega_target_item | strip | downcase
                  assign this_title = link.title | strip | downcase
                  if target != blank and target == this_title
                    assign mega_block = block
                  endif
                endif
              endfor

              assign show_toggle = false
              if has_children or mega_block
                assign show_toggle = true
              endif
            -%}
            <li
              class="site-header__nav-item{% if mega_block %} site-header__nav-item--mega{% endif %}"
              data-nav-item
            >
              <a href="{{ link.url }}" class="caption site-header__nav-link"{% if link.active %} aria-current="page"{% endif %}>
                {{ link.title }}
              </a>

              {%- if show_toggle -%}
                <button
                  type="button"
                  class="site-header__nav-caret"
                  aria-expanded="false"
                  aria-label="{{ 'header.toggle_menu' | t }}: {{ link.title }}"
                  data-dropdown-toggle
                ></button>
              {%- endif -%}

              {%- if mega_block -%}
                {%- render 'mega-menu', link: link, block: mega_block -%}
              {%- elsif has_children -%}
                {%- render 'nav-dropdown', link: link -%}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="site-header__actions">
        <a href="{{ routes.search_url }}" class="site-header__icon-btn" aria-label="{{ 'header.search' | t }}">
          {%- render 'icon-search' -%}
        </a>
        {%- if section.settings.experience_link != blank -%}
          <a
            href="{{ section.settings.experience_link }}"
            class="site-header__icon-btn"
            aria-label="{{ section.settings.experience_label | escape }}"
            title="{{ section.settings.experience_label | escape }}"
          >
            {%- render 'icon-book' -%}
          </a>
        {%- endif -%}
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="site-header__icon-btn" aria-label="{{ 'header.account' | t }}">
            {%- render 'icon-account' -%}
          </a>
        {%- endif -%}
        <a
          href="{{ routes.cart_url }}"
          class="site-header__icon-btn site-header__cart"
          aria-label="{{ 'header.cart' | t }}: {{ 'accessibility.cart_count' | t: count: cart.item_count }}"
        >
          {%- render 'icon-cart' -%}
          <span class="site-header__cart-count cart-count"{% if cart.item_count == 0 %} hidden{% endif %}>
            {{- cart.item_count -}}
          </span>
        </a>
      </div>
    </div>
  </div>

  <div class="site-header__panel" id="SiteHeaderPanel" data-menu-panel>
    <div class="site-header__panel-inner {{ scheme_class }}">
      <div class="menu-drawer-header">
        <a href="{{ routes.root_url }}" class="site-header__panel-logo" aria-label="{{ shop.name }}">
          {%- render 'site-logo', lazy: true -%}
        </a>
        <button type="button" class="site-header__panel-close" data-menu-close aria-label="{{ 'accessibility.close' | t }}">
          {%- render 'icon-close' -%}
        </button>
      </div>

      {%- comment -%}
        Nested items use native <details>/<summary>, as in the handoff: no
        script, and more than one group can be open at a time. Mega-menu
        content (product cards) is desktop-only; the drawer lists the same
        children as plain links.
      {%- endcomment -%}
      <ul class="site-header__panel-links">
        {%- for link in mobile_menu.links -%}
          <li class="site-header__panel-item">
            {%- if link.links.size > 0 -%}
              <details class="site-header__panel-details">
                <summary class="site-header__panel-summary">
                  <span class="h-catalog">{{ link.title }}</span>
                  <span class="site-header__panel-chevron" aria-hidden="true"></span>
                </summary>
                <ul class="site-header__panel-sublist">
                  {%- for child in link.links -%}
                    <li>
                      {%- if child.links.size > 0 -%}
                        <details class="site-header__panel-details site-header__panel-details--nested">
                          <summary class="site-header__panel-summary">
                            <span class="caption">{{ child.title }}</span>
                            <span class="site-header__panel-chevron" aria-hidden="true"></span>
                          </summary>
                          <ul class="site-header__panel-sublist site-header__panel-sublist--nested">
                            {%- for grandchild in child.links -%}
                              <li><a href="{{ grandchild.url }}" class="caption">{{ grandchild.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        </details>
                      {%- else -%}
                        <a href="{{ child.url }}" class="caption">{{ child.title }}</a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="site-header__panel-summary">
                <span class="h-catalog">{{ link.title }}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="site-header__panel-social">
        {%- render 'social-icons' -%}
      </div>
    </div>
  </div>
</header>
</mobile-menu>

<script src="{{ 'site-header.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  /* ---------- Bar ---------- */
  .site-header {
    --logo-width-current: var(--logo-width-mobile);
    transition: transform 0.2s ease;
  }

  @media screen and (min-width: 990px) {
    .site-header {
      --logo-width-current: var(--logo-width);
    }
  }

  .site-header--hidden {
    transform: translateY(-100%);
  }

  .site-header--no-transition {
    transition: none;
  }

  .site-header[data-sticky="always"],
  .site-header[data-sticky="scroll_up"] {
    position: fixed;
    top: var(--announcement-bar-height, 0px);
    left: 0;
    right: 0;
    z-index: 41;
    background-color: var(--color-background);
    color: var(--color-text);
    box-shadow: 0 8px 24px rgba(149, 157, 165, 0.2);
  }

  body:has(.site-header[data-sticky="always"]),
  body:has(.site-header[data-sticky="scroll_up"]) {
    padding-top: var(--site-header-height);
  }

  .site-header__bar {
    position: relative;
    z-index: 40;
    padding-block: var(--space-4);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-3);
  }

  @media screen and (min-width: 990px) {
    .site-header__bar {
      padding-block: 0;
    }

    .site-header__inner {
      justify-content: space-between;
      gap: var(--space-5);
    }
  }

  /* ---------- Logo ---------- */
  .site-header__logo {
    display: flex;
    flex: none;
    align-items: center;
    margin: 0 auto 0 var(--space-1);
  }

  .site-header__logo .site-logo__image {
    width: var(--logo-width-current);
  }

  .site-header__panel-logo .site-logo__image {
    width: var(--logo-width);
  }

  .site-header__logo .site-logo__text {
    font-size: 24px;
  }

  @media screen and (min-width: 990px) {
    .site-header__logo {
      margin: 0;
    }
  }

  /* ---------- Desktop navigation ---------- */
  .site-header__nav {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .site-header__nav {
      display: flex;
      flex: 1 1 auto;
      justify-content: center;
      min-width: 0;
    }
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-6);
    white-space: nowrap;
  }

  /* Nav item: link + caret sit side by side; the item is the positioning
     context its dropdown anchors against (a mega panel spans the header). */
  .site-header__nav-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding-block: 27px;
  }

  .site-header__nav-item .site-header__nav-link {
    font-size: 18px;
    font-weight: var(--font-weight-regular);
    color: inherit;
  }

  .site-header__nav-item.site-header__nav-item--mega {
    position: static;
  }

  .site-header__nav-caret {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    padding: 0;
    color: inherit;
  }

  .site-header__nav-caret::after {
    content: '';
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }

  .site-header__nav-item.is-open .site-header__nav-caret::after,
  .site-header__nav-item:hover .site-header__nav-caret::after,
  .site-header__nav-item:focus-within .site-header__nav-caret::after {
    transform: rotate(225deg);
  }

  /* ---------- Menu button and action icons ---------- */
  .site-header__menu-btn {
    position: relative;
    display: flex;
    flex: none;
    padding: 0;
  }

  .site-header__menu-btn svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (min-width: 990px) {
    .site-header__menu-btn {
      display: none;
    }
  }

  .site-header__actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
  }

  @media screen and (min-width: 990px) {
    .site-header__actions {
      margin-left: 0;
    }
  }

  .site-header__icon-btn {
    position: relative;
    display: flex;
    width: 20px;
    height: 20px;
    color: inherit;
  }

  .site-header__icon-btn svg {
    width: 20px;
    height: 20px;
  }

  /* 44px touch target without changing the 20px icon or the 16px gap. */
  .site-header__icon-btn::before,
  .site-header__menu-btn::before {
    content: '';
    position: absolute;
    inset: -12px;
  }

  .site-header__cart-count {
    position: absolute;
    top: -6px;
    right: -10px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    color: var(--color-accent-button-label);
    font-family: var(--font-accent);
    font-weight: var(--font-weight-bold);
    font-size: 11px;
    line-height: 18px;
    text-align: center;
  }

  .site-header__cart-count[hidden] {
    display: none;
  }

  /* ---------- Mobile drawer ---------- */
  .site-header__panel {
    position: fixed;
    inset: 0;
    z-index: 50;
    visibility: hidden;
    opacity: 0;
    background-color: rgba(10, 10, 10, 0.4);
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .site-header__panel[data-open="true"] {
    visibility: visible;
    opacity: 1;
  }

  .site-header__panel-inner {
    width: min(360px, 86vw);
    height: 100%;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    transform: translateX(-100%);
    transition: transform 0.25s ease;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .site-header__panel[data-open="true"] .site-header__panel-inner {
    transform: translateX(0);
  }

  .menu-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-header__panel-logo {
    display: flex;
    align-items: center;
  }

  .site-header__panel-close {
    width: 20px;
    height: 20px;
    padding: 0;
  }

  .site-header__panel-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-header__panel-details {
    border: none;
  }

  .site-header__panel-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2);
    list-style: none;
    cursor: pointer;
  }

  .site-header__panel-summary .h-catalog {
    letter-spacing: 0;
    font-weight: var(--font-weight-medium);
    font-size: 20px;
  }

  .site-header__panel-summary::-webkit-details-marker {
    display: none;
  }

  .site-header__panel-chevron {
    display: inline-block;
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }

  .site-header__panel-details[open] > .site-header__panel-summary .site-header__panel-chevron {
    transform: rotate(225deg);
  }

  .site-header__panel-sublist {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-left: var(--space-4);
  }

  .site-header__panel-sublist--nested {
    padding-left: var(--space-3);
  }

  .site-header__panel-details--nested {
    margin-top: 0;
  }

  .site-header__panel-sublist a.caption {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-text-muted);
  }

  .site-header__panel-social {
    margin-top: auto;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .site-header__panel-social .social-icons {
    gap: var(--space-5);
  }

  /*
    Transparent state. When the first section of the page is the full-bleed
    video hero, the header overlays it: no background, light text, inverted
    logo. It turns solid once scrolled (.is-scrolled, set in global.js) or
    while a mega panel is open (.site-header--mega-open, set in
    site-header.js). The selector below is mirrored by isHeroOverlay() in
    global.js: keep the two in sync.
  */
  body:has(#MainContent > .shopify-section:first-child .video-hero-slider) {
    padding-top: 0;
  }

  body:has(#MainContent > .shopify-section:first-child .video-hero-slider) .site-header {
    position: fixed;
    top: var(--announcement-bar-height, 0px);
    left: 0;
    right: 0;
    z-index: 40;
    transition: top 0.2s ease, transform 0.2s ease;
  }

  body:has(#MainContent > .shopify-section:first-child .video-hero-slider) .site-header__bar {
    position: static;
  }

  body:has(#MainContent > .shopify-section:first-child .video-hero-slider) .site-header:not(.is-scrolled):not(.site-header--mega-open) {
    background-color: transparent;
    color: var(--palette-linen);
    box-shadow: none;
  }

  /* No inverse logo uploaded: invert the default one. */
  body:has(#MainContent > .shopify-section:first-child .video-hero-slider) .site-header:not(.is-scrolled):not(.site-header--mega-open) .site-header__logo .site-logo:not(.site-logo--has-inverse) .site-logo__default {
    filter: invert(1);
  }

  /* Inverse logo uploaded: swap the two images. */
  body:has(#MainContent > .shopify-section:first-child .video-hero-slider) .site-header:not(.is-scrolled):not(.site-header--mega-open) .site-header__logo .site-logo--has-inverse .site-logo__default {
    display: none;
  }

  body:has(#MainContent > .shopify-section:first-child .video-hero-slider) .site-header:not(.is-scrolled):not(.site-header--mega-open) .site-header__logo .site-logo--has-inverse .site-logo__inverse {
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.header.settings.logo_paragraph"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.headers.menus"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "t:sections.header.settings.mobile_menu.label",
      "info": "t:sections.header.settings.mobile_menu.info"
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "t:sections.header.settings.sticky.label",
      "options": [
        {
          "value": "always",
          "label": "t:sections.header.settings.sticky.options.always"
        },
        {
          "value": "scroll_up",
          "label": "t:sections.header.settings.sticky.options.scroll_up"
        },
        {
          "value": "none",
          "label": "t:sections.header.settings.sticky.options.none"
        }
      ],
      "default": "scroll_up"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.headers.icons"
    },
    {
      "type": "url",
      "id": "experience_link",
      "label": "t:sections.header.settings.experience_link.label",
      "info": "t:sections.header.settings.experience_link.info"
    },
    {
      "type": "text",
      "id": "experience_label",
      "label": "t:sections.header.settings.experience_label.label",
      "default": "ENSŌ Experience"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:sections.header.settings.show_account.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.foreground }}"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "t:sections.header.blocks.mega_menu.name",
      "settings": [
        {
          "type": "text",
          "id": "mega_target_item",
          "label": "t:sections.header.blocks.mega_menu.settings.mega_target_item.label",
          "info": "t:sections.header.blocks.mega_menu.settings.mega_target_item.info"
        },
        {
          "type": "checkbox",
          "id": "show_products",
          "label": "t:sections.header.blocks.mega_menu.settings.show_products.label",
          "info": "t:sections.header.blocks.mega_menu.settings.show_products.info",
          "default": false
        },
        {
          "type": "range",
          "id": "max_products",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 4,
          "label": "t:sections.header.blocks.mega_menu.settings.max_products.label"
        },
        {
          "type": "text",
          "id": "view_all_text",
          "label": "t:sections.header.blocks.mega_menu.settings.view_all_text.label",
          "info": "t:sections.header.blocks.mega_menu.settings.view_all_text.info"
        },
        {
          "type": "url",
          "id": "view_all_link",
          "label": "t:sections.header.blocks.mega_menu.settings.view_all_link.label",
          "info": "t:sections.header.blocks.mega_menu.settings.view_all_link.info"
        },
        {
          "type": "header",
          "content": "t:sections.header.blocks.mega_menu.settings.headers.promo"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.header.blocks.mega_menu.settings.image.label"
        },
        {
          "type": "text",
          "id": "image_heading",
          "label": "t:sections.header.blocks.mega_menu.settings.image_heading.label"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "t:sections.header.blocks.mega_menu.settings.image_url.label",
          "info": "t:sections.header.blocks.mega_menu.settings.image_url.info"
        }
      ]
    }
  ]
}
{% endschema %}
