{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
-%}

<section class="faq {{ scheme_class }} section-padding">
  <div class="container faq__inner">
    <div class="faq__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h-section">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion-item" {{ block.shopify_attributes }}>
          <summary class="accordion-item__trigger">
            <span>{{ block.settings.question }}</span>
            {%- render 'icon-chevron' -%}
          </summary>
          <div class="accordion-item__panel">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .faq__inner {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-8);
  }

  @media screen and (max-width: 749px) {
    .faq__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  .faq__list {
    border-top: 1px solid var(--color-border);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.faq.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.faq.settings.color_scheme.label",
      "default": "scheme-paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.faq.settings.eyebrow.label",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.faq.settings.heading.label",
      "default": "Before You Order"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.blocks.question.settings.question.label",
          "default": "Does ENSO use charcoal?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.blocks.question.settings.answer.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.presets.name",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Does ENSO use charcoal?",
            "answer": "<p>No. ENSO is fully electronic — controlled heat from 180 to 330°C, no charcoal, no ash, no open flame.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Am I locked into proprietary pods?",
            "answer": "<p>No. ENSO is an open system — bring your own molasses, always.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>ENSO ships globally from our warehouses · approximately 2 weeks delivery.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
