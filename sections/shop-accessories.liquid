{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
  assign col_desktop = section.settings.columns | plus: 0
  assign col_mobile = section.settings.columns_mobile | plus: 0
  assign gap = section.settings.card_gap
  assign is_carousel = false
  if section.settings.layout == 'carousel'
    assign is_carousel = true
  endif
  assign section_collection = section.settings.collection
-%}


{% render 'carousel-styles',
  section_id: section.id,
  columns_desktop: section.settings.columns,
  columns_mobile: section.settings.columns_mobile,
  gap: section.settings.card_gap,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  padding_top_mobile: section.settings.padding_top_mobile,
  padding_bottom_mobile: section.settings.padding_bottom_mobile
%}

{% comment %} {% style %}
  #Shop-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  #Shop-{{ section.id }} .carousel__track {
    gap: {{ gap }}px;
  }
  #Shop-{{ section.id }} .carousel__track > * {
    flex: 0 0 calc((100% - ({{ gap }}px * {{ col_mobile | minus: 1 }})) / {{ col_mobile }});
  }

  @media screen and (min-width: 750px) {
    #Shop-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    #Shop-{{ section.id }} .carousel__track > * {
      flex: 0 0 calc((100% - ({{ gap }}px * {{ col_desktop | minus: 1 }})) / {{ col_desktop }});
    }
  }
{% endstyle %} {% endcomment %}

<carousel-slider
  id="Carousel-{{ section.id }}"
  class="shop-accessories {{ scheme_class }} section-padding"
  {% unless is_carousel %}data-static="true"{% endunless %}
>
  <div class="container">
    <div class="carousel__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h-section">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      <div class="carousel__actions">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: section_collection.url | default: '#' }}" class="btn btn--outline">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}

        
      </div>
    </div>

    {%- if section_collection != blank -%}
      <div class="carousel__wrapper">
        <div
          class="carousel__track {% unless is_carousel %}carousel__track--grid{% endunless %}"
          {% if is_carousel %}data-carousel-track tabindex="0"{% endif %}
          role="group"
          aria-label="{{ section.settings.heading | escape }}"
        >
          {%- for product in section_collection.products limit: section.settings.products_limit -%}
            {%- render 'card-product', product: product, section: section -%}
          {%- endfor -%}
        </div>
        {%- if is_carousel -%}
          <div class="carousel__controls">
            <button type="button" class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
              {%- render 'icon-chevron' -%}
            </button>
            <button type="button" class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="{{ 'accessibility.next_slide' | t }}">
              {%- render 'icon-chevron' -%}
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="body-text text-muted">{{ 'sections.shop_accessories.onboarding' | t }}</p>
    {%- endif -%}
  </div>
</carousel-slider>

{% comment %} {% stylesheet %}
  .shop-accessories { display: block; }

  .shop-accessories .carousel__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .shop-accessories .carousel__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .shop-accessories .carousel__controls {
    display: flex;
    gap: 0.5rem;
  }

  .shop-accessories .carousel__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .shop-accessories .carousel__arrow:hover:not(:disabled) { border-color: rgba(0, 0, 0, 0.4); }
  .shop-accessories .carousel__arrow:disabled { opacity: 0.3; cursor: not-allowed; }
  .shop-accessories .carousel--static .carousel__controls { display: none; }

  /* THE FIX: make the track an actual scrollable flex container */
  .shop-accessories .carousel__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 0.25rem;
  }
  .shop-accessories .carousel__track::-webkit-scrollbar { display: none; }

  /* THE FIX: consume the columns variable to size each card */
  .shop-accessories .carousel__track > * {
    flex: 0 0 auto;
    width: calc((100% - (var(--carousel-columns-desktop, 3) - 1) * 1.5rem) / var(--carousel-columns-desktop, 3));
    scroll-snap-align: start;
  }

  @media screen and (max-width: 989px) {
    .shop-accessories .carousel__track { gap: 1rem; }
    .shop-accessories .carousel__track > * { width: calc((100% - 1rem) / 2); }
  }

  @media screen and (max-width: 749px) {
    .shop-accessories .carousel__track > * { width: 80%; }
  }
{% endstylesheet %} {% endcomment %}

{% schema %}
{
  "name": "Shop accessories",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-paper"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Accessories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Accessories"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel (scrollable row)" },
        { "value": "grid", "label": "Simple grid (wraps into rows)" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Cards per row — desktop",
      "options": [
        { "value": "2", "label": "2 cards" },
        { "value": "3", "label": "3 cards" },
        { "value": "4", "label": "4 cards" },
        { "value": "5", "label": "5 cards" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Cards per row — mobile",
      "options": [
        { "value": "1", "label": "1 card" },
        { "value": "2", "label": "2 cards" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between cards",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "enable_quickadd",
      "label": "Enable quick add"
    },
    {
      "type": "select",
      "id": "quickadd_design",
      "label": "Quickadd Design",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "View All Accessories"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    { "name": "Shop accessories" }
  ]
}
{% endschema %}
