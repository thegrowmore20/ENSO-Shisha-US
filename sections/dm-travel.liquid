{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
<div class="wrap">
  <section class="ch" id="travel"><p class="ch__num">13 · Care</p><h2>Travel and flights</h2><p class="ch__lead">The battery is well under the 100 Wh carry-on limit. Its rating is printed on the battery label.</p><div class="temps"><div><b>56 Wh</b><span>15,150 mAh · 3.7 V · 56.055 Wh, on the label</span></div><div><b>Cabin bag</b><span>The battery travels with you, never in checked luggage</span></div><div><b>Either bag</b><span>Diamond itself, without the battery, can go in checked luggage</span></div></div><div class="note note--tip"><b>Before you fly</b><ul><li>Take the battery out and pack it in your cabin bag.</li><li>Airlines set their own rules: check yours before you travel.</li></ul></div></section>
</div>

{% schema %}
{
  "name": "DM: Travel",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DM: Travel"
    }
  ]
}
{% endschema %}
