{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
{{ 'em-manual.css' | asset_url | stylesheet_tag }}
<div class="em-wrap">
  <section class="em-hero">
    <div>
      <p class="em-eyebrow">ENSŌ Experience · ENSŌ 2026</p>
      <h1>{{ section.settings.heading | default: 'ENSŌ 2026 Edition manual' }}</h1>
      <p>{{ section.settings.subheading | default: 'From the first charge to a clean session, and what to do when something is off. Read it in order the first time, then search or jump to what you need.' }}</p>
      <div class="em-app">
        {%- if section.settings.cta1_label != blank -%}
          <a href="{{ section.settings.cta1_url }}">{{ section.settings.cta1_label }}</a>
        {%- else -%}
          <a href="/pages/enso-app#register">Register your warranty</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_label }}</a>
        {%- else -%}
          <a href="/pages/enso-app#fix">Troubleshoot in the app</a>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.product_image != blank -%}
      {{- section.settings.product_image | image_url: width: 800 | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          alt: 'ENSŌ 2026 Edition',
          widths: '400, 600, 800',
          sizes: '(max-width: 991px) 100vw, 45vw' -}}
    {%- else -%}
      <img src="{{ 'enso-front.webp' | file_url }}" alt="ENSŌ 2026 Edition" loading="eager" fetchpriority="high">
    {%- endif -%}
  </section>
  <div class="em-note em-note--dont" style="margin-top:32px;margin-bottom:8px">
    <b>Before you start: keep your warranty intact</b>
    <ul>
      <li><b>Let the chamber cool before water comes near it.</b> Ceramic reacts badly to sudden temperature changes, and cold water poured into a hot chamber can crack it. Let the unit cool to room temperature first. Cracks caused by thermal shock are not covered.</li>
      <li><b>Keep the battery compartment and contacts dry.</b> Moisture on the battery pins or inside the compartment can cause a short circuit and permanently damage the device. We recommend cleaning with the battery in place, so no water can get into the compartment, and making sure everything is completely dry before the battery goes back in. Liquid damage is not covered.</li>
    </ul>
  </div>
  <!-- Sentinel: when this leaves the viewport top, the finder bar is stuck -->
  <div id="em-finder-sentinel" aria-hidden="true" style="height:0;pointer-events:none;visibility:hidden"></div>
</div>

{% schema %}
{
  "name": "EM: Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ENSŌ 2026 Edition manual"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "From the first charge to a clean session, and what to do when something is off. Read it in order the first time, then search or jump to what you need."
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "header",
      "content": "CTA links"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "CTA 1 label",
      "default": "Register your warranty"
    },
    {
      "type": "url",
      "id": "cta1_url",
      "label": "CTA 1 URL"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "CTA 2 label",
      "default": "Troubleshoot in the app"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "CTA 2 URL"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "EM: Hero"
    }
  ]
}
{% endschema %}
