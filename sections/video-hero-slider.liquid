{%- liquid
  assign autoplay_interval = section.settings.autoplay_interval
  assign video_quality = section.settings.video_quality | default: '720'
  assign scheme_class = 'color-surface'
  assign full_vp = section.settings.full_viewport_height
  assign poster_loading = section.settings.poster_loading | default: 'eager'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text
  assign total_blocks = section.blocks.size
-%}

{% if full_vp or section.settings.section_margin_bottom > 0 %}
  {% style %}
    {% if section.settings.section_margin_bottom > 0 %}
      #shopify-section-{{ section.id }} {
        margin-bottom: {{ section.settings.section_margin_bottom }}px;
      }
    {% endif %}

    {% if full_vp %}
      /* Full-viewport-height mode — matches handoff video_hero_slider_p6YT3f */
      #shopify-section-{{ section.id }} .video-hero-slider {
        background: #fff;
      }
      #shopify-section-{{ section.id }} .video-hero-slider__slide,
      #shopify-section-{{ section.id }} .video-hero-slider__media {
        position: relative;
        height: 100svh;
        min-height: 0;
        max-height: none;
        background: #fff;
      }
      #shopify-section-{{ section.id }} .video-hero-slider__media video,
      #shopify-section-{{ section.id }} .video-hero-slider__poster {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: #fff;
      }
      #shopify-section-{{ section.id }} .video-hero-slider__scrim {
        display: none;
      }
      #shopify-section-{{ section.id }} .video-hero-slider__content {
        position: absolute;
        inset: auto 0 0;
        height: auto;
        min-height: 0;
        padding: 0 0 40px;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: flex-end;
        text-align: center;
        max-width: none;
      }
      #shopify-section-{{ section.id }} .video-hero-slider__cta {
        position: absolute;
        left: 50%;
        bottom: 40px;
        transform: translateX(-50%);
        margin: 0;
      }
    {% endif %}
  {% endstyle %}
{% endif %}

<video-hero-slider
  class="video-hero-slider {{ scheme_class }}"
  role="region"
  aria-roledescription="{{ 'accessibility.carousel' | t | default: 'Carousel' }}"
  data-autoplay="{{ autoplay_interval }}"
  data-quality="{{ video_quality }}"
>
  {%- for block in section.blocks -%}
    {%- liquid
      assign has_upload = false
      if block.settings.video and block.settings.video.sources.size > 0
        assign has_upload = true
      endif
      assign has_external = false
      if block.settings.video_url and block.settings.video_url.id != blank
        assign has_external = true
      endif
      assign slide_num = forloop.index
    -%}
    <div
      class="video-hero-slider__slide{% if forloop.first %} is-active{% endif %}"
      role="group"
      aria-roledescription="{{ 'accessibility.slide' | t | default: 'Slide' }}"
      aria-label="{{ 'accessibility.slide_position' | t: index: slide_num, total: total_blocks }}"
      data-slide
      data-index="{{ forloop.index0 }}"
      {{ block.shopify_attributes }}
    >
      <div class="video-hero-slider__media">
        {%- if block.settings.thumbnail -%}
          <img
            class="video-hero-slider__poster"
            src="{{ block.settings.thumbnail | image_url: width: 1920 }}"
            alt="{{ block.settings.thumbnail.alt | default: block.settings.heading | escape }}"
            width="{{ block.settings.thumbnail.width }}"
            height="{{ block.settings.thumbnail.height }}"
            loading="{% if forloop.first and poster_loading == 'eager' %}eager{% else %}lazy{% endif %}"
            {% if forloop.first and poster_loading == 'eager' %}fetchpriority="high"{% endif %}
          >
        {%- endif -%}

        <div class="video-hero-slider__video-slot" data-video-slot></div>

        {%- if has_upload -%}
          {%- liquid
            assign sources_json = '['
            assign mp4_first = true
            for source in block.settings.video.sources
              if source.format == 'mp4'
                unless mp4_first
                  assign sources_json = sources_json | append: ','
                endunless
                assign sources_json = sources_json | append: '{"url":"' | append: source.url | append: '","height":' | append: source.height | append: '}'
                assign mp4_first = false
              endif
            endfor
            assign sources_json = sources_json | append: ']'
          -%}
          <template data-video-template data-video-kind="upload" data-sources="{{ sources_json | escape }}"></template>
        {%- elsif has_external -%}
          <template data-video-template data-video-kind="{{ block.settings.video_url.type }}" data-video-id="{{ block.settings.video_url.id }}"></template>
        {%- endif -%}
      </div>

      <div class="video-hero-slider__scrim"></div>

      <div class="container video-hero-slider__content">
        {%- if block.settings.eyebrow != blank -%}
          <p class="eyebrow video-hero-slider__eyebrow">{{ block.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          {%- if forloop.first -%}
            <h1 class="h1 video-hero-slider__heading">{{ block.settings.heading }}</h1>
          {%- else -%}
            <h2 class="h1 video-hero-slider__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="body-text video-hero-slider__text">{{ block.settings.text }}</div>
        {%- endif -%}
        {%- if block.settings.cta_label != blank and block.settings.cta_link != blank -%}
          <a href="{{ block.settings.cta_link }}" class="btn btn--accent video-hero-slider__cta">
            {{ block.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <button type="button" class="video-hero-slider__arrow video-hero-slider__arrow--prev" data-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
      {%- render 'icon-chevron' -%}
    </button>
    <button type="button" class="video-hero-slider__arrow video-hero-slider__arrow--next" data-next aria-label="{{ 'accessibility.next_slide' | t }}">
      {%- render 'icon-chevron' -%}
    </button>

    <div class="video-hero-slider__dots" aria-hidden="true">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="video-hero-slider__dot{% if forloop.first %} is-active{% endif %}"
          data-dot
          data-index="{{ forloop.index0 }}"
          tabindex="-1"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</video-hero-slider>

{% stylesheet %}
  .video-hero-slider {
    position: relative;
    display: block;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
  }

  .video-hero-slider__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease;
  }

  .video-hero-slider__slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .video-hero-slider__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--palette-graphite);
  }

  .video-hero-slider__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 7s var(--ease-out);
  }

  .video-hero-slider__slide.is-active .video-hero-slider__poster {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .video-hero-slider__poster {
      transition: none;
      transform: none;
    }
  }

  .video-hero-slider__video-slot {
    position: absolute;
    inset: 0;
  }

  .video-hero-slider__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .video-hero-slider__slide.is-ready .video-hero-slider__video {
    opacity: 1;
  }

  .video-hero-slider__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.18) 45%,
      rgba(0, 0, 0, 0.0) 70%
    );
  }

  .video-hero-slider__content {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 120px;
    padding-bottom: var(--space-8);
    color: var(--palette-ivory);
  }

  .video-hero-slider__content > * {
    max-width: 600px;
  }

  .video-hero-slider__eyebrow {
    color: var(--palette-sand);
  }

  .video-hero-slider__heading {
    max-width: 20ch;
    font-weight: var(--font-weight-medium);
    color: var(--palette-ivory);
  }

  .video-hero-slider__text {
    margin-top: var(--space-3);
    max-width: 46ch;
    color: color-mix(in srgb, var(--palette-ivory) 82%, transparent);
  }

  .video-hero-slider__cta {
    margin-top: var(--space-3);
    width: fit-content;
    box-shadow: var(--shadow-md);
  }

  /* ── Dots ── */
  .video-hero-slider__dots {
    position: absolute;
    z-index: 3;
    bottom: var(--space-6);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: var(--space-3);
  }

  @media screen and (min-width: 750px) {
    .video-hero-slider__dots {
      left: auto;
      right: var(--page-margin);
      transform: none;
    }
  }

  .video-hero-slider__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background-color: rgba(255, 255, 255, 0.4);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .video-hero-slider__dot.is-active {
    background-color: #ffffff;
    transform: scale(1.4);
  }

  /* ── Arrows ── */
  .video-hero-slider__arrow {
    display: none;
    position: absolute;
    z-index: 3;
    top: 50%;
    transform: translateY(-50%);
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background-color: rgba(10, 10, 10, 0.3);
    color: var(--palette-ivory);
  }

  @media screen and (min-width: 750px) {
    .video-hero-slider__arrow {
      display: flex;
    }

    .video-hero-slider__arrow--prev {
      left: 15px;
    }

    .video-hero-slider__arrow--next {
      right: 15px;
    }
  }

  @media screen and (min-width: 1541px) {
    .video-hero-slider__arrow--prev {
      left: calc(var(--page-margin) - 40px);
    }

    .video-hero-slider__arrow--next {
      right: calc(var(--page-margin) - 40px);
    }
  }

  .video-hero-slider__arrow .icon-chevron {
    width: 18px;
    height: 18px;
  }

  .video-hero-slider__arrow--prev .icon-chevron {
    transform: rotate(90deg);
  }

  .video-hero-slider__arrow--next .icon-chevron {
    transform: rotate(-90deg);
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('video-hero-slider')) {
    class VideoHeroSlider extends HTMLElement {
      #slides = [];
      #dots = [];
      #activeIndex = 0;
      #timer = null;
      #interval = 0;
      #inView = false;
      #touchStart = null;
      #reduceMotion = false;
      #quality = '720';

      connectedCallback() {
        this.#slides = [...this.querySelectorAll('[data-slide]')];
        this.#dots   = [...this.querySelectorAll('[data-dot]')];
        this.#interval = Number(this.dataset.autoplay || 0);
        this.#quality  = this.dataset.quality || '720';
        this.#reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!this.#slides.length) return;

        this.#loadSlide(0);

        this.querySelector('[data-prev]')?.addEventListener('click', () => this.#step(-1));
        this.querySelector('[data-next]')?.addEventListener('click', () => this.#step(1));

        for (const dot of this.#dots) {
          dot.addEventListener('click', () => this.#goTo(Number(dot.dataset.index)));
        }

        this.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') this.#step(-1);
          if (e.key === 'ArrowRight') this.#step(1);
        });

        this.addEventListener('touchstart', (e) => {
          this.#touchStart = e.touches[0];
        }, { passive: true });

        this.addEventListener('touchend', (e) => {
          if (!this.#touchStart) return;
          const dx = e.changedTouches[0].clientX - this.#touchStart.clientX;
          const dy = e.changedTouches[0].clientY - this.#touchStart.clientY;
          this.#touchStart = null;
          if (Math.abs(dx) < 40 || Math.abs(dy) > Math.abs(dx)) return;
          this.#step(dx < 0 ? 1 : -1);
        }, { passive: true });

        const observer = new IntersectionObserver(
          ([entry]) => {
            this.#inView = entry.isIntersecting;
            this.#syncPlayback();
          },
          { threshold: 0.3 }
        );
        observer.observe(this);

        document.addEventListener('visibilitychange', () => this.#syncPlayback());
      }

      #syncPlayback() {
        const active = this.#slides[this.#activeIndex];
        const video = active?.querySelector('video');
        const hidden = document.hidden || !this.#inView;
        if (video) hidden ? video.pause() : video.play().catch(() => {});
        if (hidden) this.#stopAutoplay(); else this.#startAutoplay();
      }

      #startAutoplay() {
        this.#stopAutoplay();
        if (this.#reduceMotion || !this.#interval || this.#slides.length < 2) return;
        this.#timer = window.setInterval(() => this.#step(1), this.#interval);
      }

      #stopAutoplay() {
        if (this.#timer) { window.clearInterval(this.#timer); this.#timer = null; }
      }

      #step(dir) {
        this.#goTo((this.#activeIndex + dir + this.#slides.length) % this.#slides.length);
      }

      #goTo(index) {
        if (index === this.#activeIndex || !this.#slides[index]) return;

        // Pause outgoing video
        this.#slides[this.#activeIndex].querySelector('video')?.pause();

        this.#slides[this.#activeIndex].classList.remove('is-active');
        this.#dots[this.#activeIndex]?.classList.remove('is-active');

        this.#activeIndex = index;
        this.#slides[this.#activeIndex].classList.add('is-active');
        this.#dots[this.#activeIndex]?.classList.add('is-active');

        this.#loadSlide(this.#activeIndex);
        this.#startAutoplay();
      }

      #pickSource(sourcesJson) {
        try {
          const sources = JSON.parse(sourcesJson || '[]');
          if (!sources.length) return null;
          const targetH = window.innerWidth <= 480 ? 480
            : this.#quality === '1080' ? 1080
            : this.#quality === '480' ? 480
            : 720;
          const sorted = [...sources].sort((a, b) => a.height - b.height);
          return (sorted.find(s => s.height >= targetH) || sorted[sorted.length - 1])?.url || null;
        } catch { return null; }
      }

      #loadSlide(index) {
        const slide = this.#slides[index];
        if (!slide || slide.dataset.loaded) return;
        slide.dataset.loaded = 'true';

        const template = slide.querySelector('[data-video-template]');
        const slot = slide.querySelector('[data-video-slot]');
        if (!template || !slot || this.#reduceMotion) return;

        const kind = template.dataset.videoKind;

        if (kind === 'upload') {
          const url = this.#pickSource(template.dataset.sources);
          if (!url) return;
          const video = document.createElement('video');
          video.className = 'video-hero-slider__video';
          video.muted = true; video.loop = true; video.playsInline = true; video.preload = 'none';
          const source = document.createElement('source');
          source.src = url; source.type = 'video/mp4';
          video.append(source);
          video.addEventListener('canplay', () => slide.classList.add('is-ready'), { once: true });
          slot.append(video);
          video.play().catch(() => {});
          return;
        }

        const videoId = template.dataset.videoId;
        if (!videoId) return;

        const iframe = document.createElement('iframe');
        iframe.setAttribute('allow', 'autoplay; encrypted-media');
        iframe.setAttribute('title', 'Background video');
        iframe.className = 'video-hero-slider__video';

        if (kind === 'vimeo') {
          iframe.src = 'https://player.vimeo.com/video/' + videoId + '?autoplay=1&muted=1&loop=1&background=1&controls=0';
        } else {
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=1&mute=1&loop=1&playlist=' + videoId + '&controls=0&playsinline=1&modestbranding=1&rel=0';
        }

        iframe.addEventListener('load', () => window.setTimeout(() => slide.classList.add('is-ready'), 300), { once: true });
        slot.append(iframe);
      }
    }

    customElements.define('video-hero-slider', VideoHeroSlider);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.video_hero_slider.name",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "checkbox",
      "id": "full_viewport_height",
      "label": "Full viewport height (100svh)",
      "info": "Use for the standalone full-screen video section. Hides scrim and centers CTA at bottom.",
      "default": false
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "poster_loading",
      "label": "Poster image loading",
      "info": "Eager (LCP) for the first above-fold hero only. Lazy for all below-fold video sections.",
      "options": [
        { "value": "eager", "label": "Eager (LCP)" },
        { "value": "lazy", "label": "Lazy (below fold)" }
      ],
      "default": "eager"
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "t:sections.video_hero_slider.settings.autoplay_interval.label",
      "info": "t:sections.video_hero_slider.settings.autoplay_interval.info",
      "min": 0,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 6000
    },
    {
      "type": "select",
      "id": "video_quality",
      "label": "t:sections.video_hero_slider.settings.video_quality.label",
      "info": "t:sections.video_hero_slider.settings.video_quality.info",
      "options": [
        { "value": "480", "label": "t:sections.video_hero_slider.settings.video_quality.options.sd" },
        { "value": "720", "label": "t:sections.video_hero_slider.settings.video_quality.options.hd" },
        { "value": "1080", "label": "t:sections.video_hero_slider.settings.video_quality.options.full_hd" }
      ],
      "default": "720"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.video_hero_slider.blocks.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "t:sections.video_hero_slider.blocks.slide.settings.thumbnail.label",
          "info": "t:sections.video_hero_slider.blocks.slide.settings.thumbnail.info"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.video_hero_slider.blocks.slide.settings.video.label"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "t:sections.video_hero_slider.blocks.slide.settings.video_url.label",
          "info": "t:sections.video_hero_slider.blocks.slide.settings.video_url.info",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "A Modern Twist on a Classic Ritual"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.video_hero_slider.name",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "A Modern Twist on a Classic Ritual",
            "cta_label": "Shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
