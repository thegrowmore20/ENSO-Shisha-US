{%- liquid
  assign img = section.settings.image
  assign heading = section.settings.heading
  assign body_text = section.settings.body_text
  assign pill_label = section.settings.pill_label
  assign link_url = section.settings.link_url

  case section.settings.card_height
    when 'small'
      assign card_min_height = '400px'
    when 'medium'
      assign card_min_height = '520px'
    when 'large'
      assign card_min_height = '640px'
    when 'custom'
      assign card_min_height = section.settings.card_height_custom | append: 'px'
    else
      assign card_min_height = '520px'
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  #shopify-section-{{ section.id }} .pack-blend__card {
    min-height: {{ card_min_height }};
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="pack-blend">
  <a class="pack-blend__card" href="{{ link_url | default: '#' }}">

    {%- if img != blank -%}
      <img
        class="pack-blend__image"
        src="{{ img | image_url: width: 2000 }}"
        srcset="
          {{ img | image_url: width: 750 }} 750w,
          {{ img | image_url: width: 1100 }} 1100w,
          {{ img | image_url: width: 1500 }} 1500w,
          {{ img | image_url: width: 2000 }} 2000w
        "
        sizes="(max-width: 749px) 100vw, 100vw"
        alt="{{ img.alt | default: heading | escape }}"
        width="{{ img.width }}"
        height="{{ img.height }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="pack-blend__placeholder">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'pack-blend__placeholder-svg' }}
      </div>
    {%- endif -%}

    <div class="pack-blend__overlay"></div>

    <div class="pack-blend__copy">
      {%- if heading != blank -%}
        <h2 class="pack-blend__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if body_text != blank -%}
        <p class="pack-blend__text">{{ body_text }}</p>
      {%- endif -%}
      {%- if pill_label != blank -%}
        <span class="pack-blend__pill">{{ pill_label }}</span>
      {%- endif -%}
    </div>

  </a>
</div>

{% stylesheet %}
  .pack-blend {
    width: 100%;
  }

  /* Full-bleed card — entire element is a link */
  .pack-blend__card {
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-radius: 0;
    text-decoration: none;
    width: 100%;
    /* min-height set via {% style %} above */
  }

  .pack-blend__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    transition: transform 0.5s ease;
  }

  .pack-blend__card:hover .pack-blend__image {
    transform: scale(1.03);
  }

  .pack-blend__placeholder {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pack-blend__placeholder-svg {
    width: 30%;
    opacity: 0.3;
  }

  /* Horizontal gradient — darker than enso-experience (.55 → .72) */
  .pack-blend__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgb(0 0 0 / .72) 0%, rgb(0 0 0 / .35) 45%, rgb(0 0 0 / 0) 70%);
  }

  /* Text block — bottom-left */
  .pack-blend__copy {
    position: relative;
    z-index: 2;
    padding: 64px 40px;
    max-width: 60ch;
  }

  .pack-blend__heading {
    margin: 0 0 12px;
    font-size: 40px;
    line-height: 1.1;
    color: #fff;
    font-weight: var(--font-weight-bold);
  }

  /* Body text: visible on desktop */
  .pack-blend__text {
    display: block;
    font-size: 15.5px;
    line-height: 23px;
    margin: 0 0 20px;
    color: rgb(255 255 255 / .88);
  }

  /* Pill button */
  .pack-blend__pill {
    display: inline-block;
    border: 1px solid rgb(255 255 255 / .6);
    color: rgb(255 255 255 / .9);
    border-radius: 999px;
    padding: 8px 18px;
    font-size: 13px;
    line-height: 1.4;
    white-space: nowrap;
    transition: border-color 0.2s, color 0.2s;
  }

  .pack-blend__card:hover .pack-blend__pill {
    border-color: #fff;
    color: #fff;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {
    /* Vertical gradient on mobile */
    .pack-blend__overlay {
      background: linear-gradient(0deg, rgb(0 0 0 / .82) 0%, rgb(0 0 0 / .45) 45%, rgb(0 0 0 / 0) 72%);
    }

    /* Shift image focus to show subject better */
    .pack-blend__image {
      object-position: 62% 50%;
    }

    .pack-blend__copy {
      padding: 28px 20px;
      max-width: none;
    }

    .pack-blend__heading {
      font-size: 28px;
    }

    .pack-blend__text {
      display: block;
      font-size: 15.5px;
      line-height: 23px;
      margin: 0 0 18px;
      color: rgb(255 255 255 / .88);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pack Your Blend",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pack your blend"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Blonde or dark leaf, one flavour or your own mix — the cup shapes the session. A few tips on how to pack it."
    },
    {
      "type": "text",
      "id": "pill_label",
      "label": "Pill button label",
      "default": "How to pack the cup"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Card link URL"
    },
    {
      "type": "header",
      "content": "Card height"
    },
    {
      "type": "select",
      "id": "card_height",
      "label": "Height preset",
      "options": [
        {
          "value": "small",
          "label": "Small — 400px"
        },
        {
          "value": "medium",
          "label": "Medium — 520px (handoff)"
        },
        {
          "value": "large",
          "label": "Large — 640px"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "card_height_custom",
      "label": "Custom height (px)",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 520,
      "info": "Only applies when Height preset is set to Custom"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Pack Your Blend"
    }
  ]
}
{% endschema %}
