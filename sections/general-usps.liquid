{%- doc -%}
  General USPs — row of icon + label tiles.
  HTML structure and CSS copied directly from the handoff HTML.
  Uses color-scheme-paper class exactly as in the handoff.

  @param section.blocks[] column blocks (icon_asset | image, heading)
{%- enddoc -%}

{% style %}
  #usps-{{ section.id }} {
    padding-top: 48px;
    padding-bottom: 48px;
  }

  @media screen and (max-width: 749px) {
    #usps-{{ section.id }} {
      padding-top: 36px;
      padding-bottom: 36px;
    }
  }
{% endstyle %}

<section id="usps-{{ section.id }}" class="usps color-scheme-paper">
  <div class="container">
    {%- if section.blocks.size > 0 -%}
      <div class="usps__row">
        {%- for block in section.blocks -%}
          <div class="usps__item" {{ block.shopify_attributes }}>
            <div class="usps__icon">
              {%- if block.settings.icon_asset != blank -%}
                <img
                  src="{{ block.settings.icon_asset | append: '.svg' | asset_url }}"
                  width="96"
                  height="126"
                  sizes="48px"
                  loading="lazy"
                  alt="{{ block.settings.heading | escape }}"
                >
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 192
                  | image_tag:
                    widths: '96, 168, 192',
                    sizes: '(min-width: 992px) 84px, 48px',
                    alt: block.settings.image.alt | default: block.settings.heading,
                    loading: 'lazy',
                    width: 96,
                    height: 126
                }}
              {%- endif -%}
            </div>
            <p class="usps__label">{{ block.settings.heading | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ── color-scheme-paper: copied from handoff block 1 CSS ── */
  .color-scheme-paper {
    --color-background: #faf6ec;
    --color-background-raised: #f2ede3;
    --color-text: #0a0a0a;
    --color-text-muted: #5a554b;
    --color-border: #e3ddcc;
    --color-accent: #c8943a;
    --color-accent-soft: #d4a758;
    background-color: var(--color-background);
    color: var(--color-text);
  }

  /* ── USP section overrides: background to cool grey, as per handoff design ── */
  .usps.color-scheme-paper {
    background-color: #f5f5f4;
    margin-bottom: 0;
  }

  /* ── Item layout and hover: from handoff ── */
  .usps__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }

  .usps__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.2s;
  }

  .usps__item:hover {
    transform: translateY(-3px);
  }

  /* ── Icon box: from handoff (base = mobile) ── */
  .usps__icon {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 18px;
    width: 88px;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  /* ── Icon image: from handoff ── */
  .usps__icon img {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  /* ── Label: from handoff ── */
  .usps__label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-text);
    margin: 10px 0 0;
  }

  /* ── Desktop (≥992px): from handoff ── */
  @media screen and (min-width: 992px) {
    .usps__row {
      display: flex;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 24px;
      max-width: 1120px;
      margin: 0 auto;
    }

    .usps__item {
      flex: 0 0 150px;
      max-width: 150px;
    }

    .usps__icon {
      width: 132px;
      height: 132px;
      padding: 20px;
      border-radius: 22px;
    }

    .usps__icon img {
      width: 84px;
      height: 84px;
    }

    .usps__label {
      font-size: 14px;
      margin-top: 14px;
    }
  }

  /* ── Mobile (≤991px): from handoff ── */
  @media screen and (max-width: 991px) {
    .usps__row {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px 10px;
    }

    .usps__item {
      width: auto;
      max-width: none;
      flex: none;
    }

    .usps__icon {
      width: 100%;
      max-width: 100px;
      height: auto;
      aspect-ratio: 1;
      padding: 16px;
    }

    .usps__icon img {
      width: 52px;
      height: 52px;
    }

    .usps__label {
      font-size: 12px;
      letter-spacing: 0.06em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "General USPs",
  "settings": [
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Icon",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon_asset",
          "label": "Built-in icon",
          "info": "Uses the SVG from the theme. Leave blank to use a custom image instead.",
          "options": [
            { "value": "", "label": "None — use custom image below" },
            { "value": "usp-no-fire", "label": "No fire" },
            { "value": "usp-heat", "label": "Heat control" },
            { "value": "usp-battery", "label": "Rechargeable" },
            { "value": "usp-snap", "label": "Snap on" },
            { "value": "usp-warranty", "label": "Warranty" },
            { "value": "usp-returns", "label": "Returns" }
          ],
          "default": ""
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image",
          "info": "Overrides the built-in icon above."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "General USPs",
      "blocks": [
        { "type": "column", "settings": { "icon_asset": "usp-no-fire",  "heading": "No fire" } },
        { "type": "column", "settings": { "icon_asset": "usp-heat",     "heading": "Heat control" } },
        { "type": "column", "settings": { "icon_asset": "usp-battery",  "heading": "Rechargeable" } },
        { "type": "column", "settings": { "icon_asset": "usp-snap",     "heading": "Snap on" } },
        { "type": "column", "settings": { "icon_asset": "usp-warranty", "heading": "2-year warranty" } },
        { "type": "column", "settings": { "icon_asset": "usp-returns",  "heading": "30-day returns" } }
      ]
    }
  ]
}
{% endschema %}
