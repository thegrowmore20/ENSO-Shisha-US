{%- doc -%}
  General USPs — simple row of icon + label cards.
  Icons can be one of the six built-in SVG assets (set `icon_asset` to the
  filename without extension, e.g. `usp-no-fire`) or a merchant-uploaded
  image via the image_picker (`image`). Asset icons take precedence.

  @param section.blocks[] column blocks (icon_asset | image, heading)
{%- enddoc -%}

{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text
-%}

{% style %}
  #usps-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    #usps-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section id="usps-{{ section.id }}" class="usps {{ scheme_class }}">
  <div class="container">
    {%- if section.blocks.size > 0 -%}
      <div class="usps__row">
        {%- for block in section.blocks -%}
          <div class="usps__item" {{ block.shopify_attributes }}>
            <div class="usps__icon">
              {%- if block.settings.icon_asset != blank -%}
                <img
                  src="{{ block.settings.icon_asset | append: '.svg' | asset_url }}"
                  alt="{{ block.settings.heading | escape }}"
                  width="44"
                  height="44"
                  loading="lazy"
                  class="usps__icon-image"
                >
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 96
                  | image_tag:
                    widths: '48, 96, 144',
                    sizes: '48px',
                    alt: block.settings.image.alt | default: block.settings.heading,
                    loading: 'lazy',
                    class: 'usps__icon-image'
                }}
              {%- endif -%}
            </div>

            {%- if block.settings.heading != blank -%}
              <p class="usps__label">{{ block.settings.heading | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .usps__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-6, 32px) var(--space-7, 40px);
  }

  .usps__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3, 12px);
    width: 90px;
  }

  .usps__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 108px;
    border: 1px solid var(--color-border, #ccc);
    border-radius: var(--radius-lg, 16px);
  }

  .usps__icon-image {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .usps__label {
    margin: 0;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  @media screen and (max-width: 589px) {
    .usps__row {
      gap: var(--space-5, 24px) var(--space-5, 24px);
    }

    .usps__icon {
      width: 68px;
      height: 88px;
    }

    .usps__icon-image {
      width: 34px;
      height: 34px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "General USPs",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Icon",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon_asset",
          "label": "Built-in icon",
          "info": "Uses the SVG from the theme. Leave blank to use a custom image instead.",
          "options": [
            { "value": "", "label": "None — use custom image below" },
            { "value": "usp-no-fire", "label": "No fire" },
            { "value": "usp-heat", "label": "Heat control" },
            { "value": "usp-battery", "label": "Rechargeable" },
            { "value": "usp-snap", "label": "Snap on" },
            { "value": "usp-warranty", "label": "Warranty" },
            { "value": "usp-returns", "label": "Returns" }
          ],
          "default": ""
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image",
          "info": "Overrides the built-in icon above."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "General USPs",
      "blocks": [
        { "type": "column", "settings": { "icon_asset": "usp-no-fire",  "heading": "No fire" } },
        { "type": "column", "settings": { "icon_asset": "usp-heat",     "heading": "Heat control" } },
        { "type": "column", "settings": { "icon_asset": "usp-battery",  "heading": "Rechargeable" } },
        { "type": "column", "settings": { "icon_asset": "usp-snap",     "heading": "Snap on" } },
        { "type": "column", "settings": { "icon_asset": "usp-warranty", "heading": "2-year warranty" } },
        { "type": "column", "settings": { "icon_asset": "usp-returns",  "heading": "30-day returns" } }
      ]
    }
  ]
}
{% endschema %}
