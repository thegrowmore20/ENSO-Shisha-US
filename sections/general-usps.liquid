{%- comment -%}
  General USPs — simple row of icon + label cards. No heading, no
  subheading, no trust badges — just icons and text, laid out in a flex row
  that wraps on narrow screens.
{%- endcomment -%}

{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text
-%}

{% style %}
  #usps-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    #usps-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section id="usps-{{ section.id }}" class="usps {{ scheme_class }}">
  <div class="container">
    {%- if section.blocks.size > 0 -%}
      <div class="usps__row">
        {%- for block in section.blocks -%}
          <div class="usps__item" {{ block.shopify_attributes }}>
            <div class="usps__icon">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 96
                  | image_tag:
                    widths: '48, 96, 144',
                    sizes: '48px',
                    alt: block.settings.image.alt | default: block.settings.heading,
                    loading: 'lazy',
                    class: 'usps__icon-image'
                }}
              {%- endif -%}
            </div>

            {%- if block.settings.heading != blank -%}
              <p class="usps__label">{{ block.settings.heading | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .usps__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-6, 32px) var(--space-7, 40px);
  }

  .usps__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3, 12px);
    width: 90px;
  }

  .usps__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 108px;
    border: 1px solid var(--color-border, #ccc);
    border-radius: var(--radius-lg, 16px);
  }

  .usps__icon-image {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .usps__label {
    margin: 0;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  @media screen and (max-width: 589px) {
    .usps__row {
      gap: var(--space-5, 24px) var(--space-5, 24px);
    }

    .usps__icon {
      width: 68px;
      height: 88px;
    }

    .usps__icon-image {
      width: 34px;
      height: 34px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "General USPs",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Icon",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "General USPs",
      "blocks": [
        { "type": "column", "settings": { "heading": "No Fire" } },
        { "type": "column", "settings": { "heading": "Heat Control" } },
        { "type": "column", "settings": { "heading": "Rechargeable" } },
        { "type": "column", "settings": { "heading": "Plug & Play" } },
        { "type": "column", "settings": { "heading": "Snap N' Go" } },
        { "type": "column", "settings": { "heading": "Sleek Design" } }
      ]
    }
  ]
}
{% endschema %}
