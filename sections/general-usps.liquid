{%- doc -%}
  General USPs — row of icon + label tiles.
  Icons can be one of the six built-in SVG assets (set `icon_asset` to the
  filename without extension, e.g. `usp-no-fire`) or a merchant-uploaded
  image via the image_picker (`image`). Asset icons take precedence.

  Layout matches the HTML handoff exactly:
  - Mobile: 3-column grid, square icon tiles
  - Desktop: flex row space-between, 132×132px tiles

  @param section.blocks[] column blocks (icon_asset | image, heading)
{%- enddoc -%}

{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text
-%}

{% style %}
  #usps-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    margin-bottom: 0;
  }

  @media screen and (min-width: 992px) {
    #usps-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{% endstyle %}

<section id="usps-{{ section.id }}" class="usps {{ scheme_class }}">
  <div class="container">
    {%- if section.blocks.size > 0 -%}
      <div class="usps__row">
        {%- for block in section.blocks -%}
          <div class="usps__item" {{ block.shopify_attributes }}>
            <div class="usps__icon">
              {%- if block.settings.icon_asset != blank -%}
                <img
                  src="{{ block.settings.icon_asset | append: '.svg' | asset_url }}"
                  alt="{{ block.settings.heading | escape }}"
                  width="52"
                  height="52"
                  loading="lazy"
                  class="usps__icon-image"
                >
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 168
                  | image_tag:
                    widths: '52, 84, 104, 168',
                    sizes: '(min-width: 992px) 84px, 52px',
                    alt: block.settings.image.alt | default: block.settings.heading,
                    loading: 'lazy',
                    class: 'usps__icon-image',
                    width: 52,
                    height: 52
                }}
              {%- endif -%}
            </div>

            {%- if block.settings.heading != blank -%}
              <p class="usps__label">{{ block.settings.heading | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ── Mobile-first (base) ── */
  .usps__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px 10px;
  }

  .usps__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.2s;
  }

  .usps__item:hover {
    transform: translateY(-3px);
  }

  .usps__icon {
    width: 100%;
    max-width: 100px;
    aspect-ratio: 1;
    padding: 16px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .usps__icon-image {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  .usps__label {
    margin: 10px 0 0;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* ── Desktop (≥992px) ── */
  @media screen and (min-width: 992px) {
    .usps__row {
      display: flex;
      justify-content: space-between;
      gap: 24px;
      max-width: 1120px;
      margin: 0 auto;
    }

    .usps__item {
      flex: 0 0 150px;
      max-width: 150px;
    }

    .usps__icon {
      width: 132px;
      max-width: none;
      height: 132px;
      aspect-ratio: auto;
      padding: 20px;
      border-radius: 22px;
    }

    .usps__icon-image {
      width: 84px;
      height: 84px;
    }

    .usps__label {
      font-size: 14px;
      letter-spacing: 0.08em;
      margin-top: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "General USPs",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Icon",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon_asset",
          "label": "Built-in icon",
          "info": "Uses the SVG from the theme. Leave blank to use a custom image instead.",
          "options": [
            { "value": "", "label": "None — use custom image below" },
            { "value": "usp-no-fire", "label": "No fire" },
            { "value": "usp-heat", "label": "Heat control" },
            { "value": "usp-battery", "label": "Rechargeable" },
            { "value": "usp-snap", "label": "Snap on" },
            { "value": "usp-warranty", "label": "Warranty" },
            { "value": "usp-returns", "label": "Returns" }
          ],
          "default": ""
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image",
          "info": "Overrides the built-in icon above."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "General USPs",
      "blocks": [
        { "type": "column", "settings": { "icon_asset": "usp-no-fire",  "heading": "No fire" } },
        { "type": "column", "settings": { "icon_asset": "usp-heat",     "heading": "Heat control" } },
        { "type": "column", "settings": { "icon_asset": "usp-battery",  "heading": "Rechargeable" } },
        { "type": "column", "settings": { "icon_asset": "usp-snap",     "heading": "Snap on" } },
        { "type": "column", "settings": { "icon_asset": "usp-warranty", "heading": "2-year warranty" } },
        { "type": "column", "settings": { "icon_asset": "usp-returns",  "heading": "30-day returns" } }
      ]
    }
  ]
}
{% endschema %}
