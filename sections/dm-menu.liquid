{%- liquid
  if section.settings.device_frame != blank
    assign df_src = section.settings.device_frame | image_url: width: 600
  else
    assign df_src = 'dm-closed-start.jpg' | file_url
  endif
-%}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
<div class="wrap">
  <section class="ch" id="menu"><p class="ch__num">09 · Every session</p><h2>Menu and settings</h2><p class="ch__lead">Open Menu from the start list, or with one click during a session. Turn to an item, click to open, turn to change, click to confirm. Nothing here stops a running session.</p><div class="slider tslider" style="--n:{{ section.blocks.size }}"><div class="slides">
    {%- for block in section.blocks -%}
      <figure class="slide ts" {{ block.shopify_attributes }}><figcaption class="ts__tx"><span class="st__n">{{ forloop.index }}</span><b>{{ block.settings.slide_title }}</b><p>{{ block.settings.slide_body }}</p></figcaption><div class="ts__pic ts__pic--mac"><div class="dev"><img src="{{ df_src }}" alt="">
        {%- if block.settings.image != blank -%}
          <img class="lvimg" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | default: '' }}">
        {%- else -%}
          <img class="lvimg" src="" alt="">
        {%- endif -%}
      </div></div></figure>
    {%- endfor -%}
  </div><button class="nav prev" aria-label="Previous">‹</button><button class="nav next" aria-label="Next">›</button></div></section>
</div>

{% schema %}
{
  "name": "DM: Menu",
  "settings": [
    {
      "type": "header",
      "content": "Device frame"
    },
    {
      "type": "image_picker",
      "id": "device_frame",
      "label": "Diamond device frame image"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "menu_slide",
      "name": "Menu Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Screen UI image"
        },
        {
          "type": "text",
          "id": "slide_title",
          "label": "Slide title"
        },
        {
          "type": "textarea",
          "id": "slide_body",
          "label": "Slide description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DM: Menu"
    }
  ]
}
{% endschema %}
