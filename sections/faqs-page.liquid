    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "select",
          "id": "tab",
          "label": "Tab",
          "options": [
            { "value": "diamond", "label": "ENSŌ Diamond" },
            { "value": "enso", "label": "ENSŌ 2026 Edition" },
            { "value": "orders", "label": "Orders, shipping and warranty" }
          ],
          "default": "diamond"
        },
        {
          "type": "text",
          "id": "anchor_id",
          "label": "Anchor ID",
          "info": "Used for deep-linking (e.g. q-battery-life). Leave blank to auto-generate."
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Write your question here"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Write your answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQs",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "question": "What is Diamond?",
            "answer": "<p>An electric heater that replaces charcoal on a traditional hookah. It sits where the bowl sits: pack the cup, set the temperature, start. No coals, no lighting, no waiting.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
