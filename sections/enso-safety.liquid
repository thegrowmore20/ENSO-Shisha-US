{%- doc -%}
  Safety and certification — 4-column icon card grid.
  Matches handoff section #shopify-section-enso-safety.
  Icons are inline SVGs selectable per block.
{%- enddoc -%}

{% style %}
  #section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    #section-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<div id="section-{{ section.id }}" class="enso-safety-section">
  <div class="enso-safety-section__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="enso-safety__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.lead != blank -%}
      <p class="enso-safety__lead">{{ section.settings.lead | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="enso-safety__grid">
        {%- for block in section.blocks -%}
          <article class="enso-safety__card" {{ block.shopify_attributes }}>
            <div class="enso-safety__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'no-flame' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3c3 4 6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 3-7 6-11z"/>
                    <path d="M4 4l16 16"/>
                  </svg>
                {%- when 'thermometer' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 14V5a2 2 0 0 1 4 0v9a4 4 0 1 1-4 0z"/>
                    <path d="M12 11v5"/>
                  </svg>
                {%- when 'battery' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="7" width="15" height="10" rx="2"/>
                    <path d="M18 10h2v4h-2M7 11v2M10 11v2"/>
                  </svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>
                    <path d="M8.5 12h7M12 8.5v7"/>
                  </svg>
              {%- endcase -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="enso-safety__card-heading">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="enso-safety__card-body">{{ block.settings.body | escape }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .enso-safety-section__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .enso-safety__heading {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    font-size: 42px;
    line-height: 46px;
    letter-spacing: -0.025em;
    margin: 0 0 8px;
  }

  .enso-safety__lead {
    color: rgb(0 0 0 / 0.6);
    margin: 0 0 32px;
    font-size: var(--font-size-body);
  }

  .enso-safety__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .enso-safety__card {
    border: 1px solid rgb(0 0 0 / 0.1);
    border-radius: 24px;
    padding: 32px;
  }

  .enso-safety__icon {
    margin-bottom: 18px;
  }

  .enso-safety__icon svg {
    width: 36px;
    height: 36px;
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  .enso-safety__card-heading {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    font-size: 22px;
    line-height: 28px;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }

  .enso-safety__card-body {
    color: rgb(0 0 0 / 0.72);
    font-size: 15px;
    line-height: 24px;
    margin: 0;
  }

  @media screen and (max-width: 991px) {
    .enso-safety-section__container {
      padding: 0 16px;
    }

    .enso-safety__heading {
      font-size: 32px;
      line-height: 36px;
    }

    .enso-safety__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .enso-safety__card {
      padding: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.enso_safety.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.enso_safety.settings.heading.label",
      "default": "Safety and certification"
    },
    {
      "type": "text",
      "id": "lead",
      "label": "t:sections.enso_safety.settings.lead.label",
      "default": "One standard for every ENSŌ device"
    },
    {
      "type": "header",
      "content": "t:sections.enso_safety.settings.padding_header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.enso_safety.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.enso_safety.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.enso_safety.settings.padding_top_mobile.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.enso_safety.settings.padding_bottom_mobile.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:sections.enso_safety.blocks.card.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.enso_safety.blocks.card.settings.icon.label",
          "options": [
            { "value": "no-flame",   "label": "t:sections.enso_safety.blocks.card.settings.icon.options.no_flame" },
            { "value": "thermometer","label": "t:sections.enso_safety.blocks.card.settings.icon.options.thermometer" },
            { "value": "battery",    "label": "t:sections.enso_safety.blocks.card.settings.icon.options.battery" },
            { "value": "shield",     "label": "t:sections.enso_safety.blocks.card.settings.icon.options.shield" }
          ],
          "default": "no-flame"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.enso_safety.blocks.card.settings.title.label",
          "default": "Card title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "t:sections.enso_safety.blocks.card.settings.body.label",
          "default": "Card body text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.enso_safety.presets.name",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "no-flame",
            "title": "No flame, no coals",
            "body": "ENSŌ heats electrically. No charcoal to light, no embers on the table, nothing burning in the room."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "thermometer",
            "title": "Heat held to the degree",
            "body": "Every ENSŌ holds the temperature you set for the whole session, so the tobacco warms instead of burning."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "battery",
            "title": "Protected batteries",
            "body": "Guarded against over-charge, over-discharge and over-temperature. Charging stops on its own when the battery is full."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "shield",
            "title": "Certified for the EU and the US",
            "body": "CE and RoHS in Europe, FCC in the US, UN 38.3 transport tests for the batteries. The declarations are in ENSŌ Experience, under Warranty."
          }
        }
      ]
    }
  ]
}
{% endschema %}
