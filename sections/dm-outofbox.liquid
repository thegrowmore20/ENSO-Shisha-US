{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
{%- liquid
  assign box_blocks = section.blocks | where: "type", "box_item"
  assign latch_blocks = section.blocks | where: "type", "latch_step"
-%}
<div class="wrap">
  <section class="ch" id="out-of-the-box"><p class="ch__num">01 · Start</p><h2>Out of the box</h2><p class="ch__lead">Everything for the first session is in the box, except the hookah, your tobacco and a USB-C wall charger. Here is what each part is and what it is for.</p><div class="boxgrid boxgrid--stack"><div class="box__img">
    {%- for block in box_blocks -%}
      {%- liquid
        assign tile_idx = forloop.index0
        assign box_cls = 'bx'
        if block.settings.size == 'hero'
          assign box_cls = 'bx bx--hero'
        elsif block.settings.size == 'small'
          assign box_cls = 'bx bx--s'
        endif
      -%}
      <figure class="{{ box_cls }}" data-tile="{{ tile_idx }}" tabindex="0" role="button" aria-label="{{ block.settings.label }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{- block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: block.settings.label -}}
        {%- else -%}
          <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto"><rect width="400" height="300" rx="16" fill="#f0ede8"/><path d="M160 100a40 40 0 1 1 80 0 40 40 0 0 1-80 0zm-40 80 60-60 40 40 40-40 60 60H120z" fill="#c8b89a"/></svg>
        {%- endif -%}
        {%- if block.settings.count != blank -%}<i class="bx__n">{{ block.settings.count }}</i>{%- endif -%}
        <figcaption class="bx__t">{{ block.settings.label }}</figcaption>
      </figure>
    {%- endfor -%}
    <p class="box__cap" aria-live="polite">Tap a part to see what it is</p></div>
    <ul class="boxlist">
      {%- for block in box_blocks -%}
        {%- if block.settings.list_title != blank -%}
          <li data-tile="{{ forloop.index0 }}">
            {%- if block.settings.count != blank -%}<em>{{ block.settings.count }}</em>{%- else -%}<em></em>{%- endif -%}
            <div><b>{{ block.settings.list_title }}</b>{{ block.settings.list_body }}</div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div><h3>Before you switch it on</h3><div class="slider tslider" style="--n:{{ latch_blocks.size }}"><div class="slides">
    {%- for block in latch_blocks -%}
      <figure class="slide ts" {{ block.shopify_attributes }}><figcaption class="ts__tx"><span class="st__n">{{ forloop.index }}</span><b>{{ block.settings.step_title }}</b>{{ block.settings.step_body }}</figcaption><div class="ts__pic ts__pic--img">
        {%- if block.settings.image != blank -%}
          {{- block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: '' -}}
          {%- if block.settings.marker_label != blank -%}
            <span class="mk mk--warn mk--l" style="left:{{ block.settings.marker_x }}%;top:{{ block.settings.marker_y }}%"><i></i><span>{{ block.settings.marker_label }}</span></span>
          {%- endif -%}
        {%- else -%}
          <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto"><rect width="400" height="300" rx="16" fill="#f0ede8"/><path d="M160 100a40 40 0 1 1 80 0 40 40 0 0 1-80 0zm-40 80 60-60 40 40 40-40 60 60H120z" fill="#c8b89a"/></svg>
        {%- endif -%}
      </div></figure>
    {%- endfor -%}
  </div><button class="nav prev" aria-label="Previous">‹</button><button class="nav next" aria-label="Next">›</button></div></section>
</div>

{% javascript %}
(function(){
  [].forEach.call(document.querySelectorAll('.box__img'),function(b){
    var cap=b.querySelector('.box__cap'),
        list=b.parentNode.querySelector('.boxlist'),
        tiles=[].slice.call(b.querySelectorAll('.bx[data-tile]')),
        rows=list?[].slice.call(list.querySelectorAll('li[data-tile]')):[];
    function pick(k,fromList){
      tiles.forEach(function(t){t.classList.toggle('on',t.dataset.tile===k);});
      var hit=rows.filter(function(r){return r.dataset.tile===k;});
      rows.forEach(function(r){r.classList.toggle('on',hit.indexOf(r)>-1);});
      var t=tiles.filter(function(x){return x.dataset.tile===k;})[0];
      if(cap&&t){
        var r=hit[0];
        cap.innerHTML='<b>'+t.getAttribute('aria-label')+'</b>'+(r?' '+r.querySelector('span').textContent:'');
        cap.classList.add('on');
      }
      if(!fromList&&hit[0]){
        var y=hit[0].getBoundingClientRect();
        if(y.top<b.getBoundingClientRect().bottom+8||y.bottom>innerHeight){
          scrollTo({top:scrollY+y.top-b.getBoundingClientRect().bottom-16,behavior:'smooth'});
        }
      }
    }
    tiles.forEach(function(t){
      t.addEventListener('click',function(){pick(t.dataset.tile);});
      t.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();pick(t.dataset.tile);}});
    });
    rows.forEach(function(r){r.addEventListener('click',function(){pick(r.dataset.tile,true);});});
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "DM: Out of Box",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "box_item",
      "name": "Box Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Item image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Image caption"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Display size",
          "options": [
            { "value": "regular", "label": "Regular" },
            { "value": "hero", "label": "Hero (large)" },
            { "value": "small", "label": "Small" }
          ],
          "default": "regular"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Count badge (e.g. ×2)",
          "info": "Leave blank for no badge"
        },
        {
          "type": "header",
          "content": "List entry"
        },
        {
          "type": "text",
          "id": "list_title",
          "label": "List item title",
          "info": "Leave blank to skip in list"
        },
        {
          "type": "richtext",
          "id": "list_body",
          "label": "List item description"
        }
      ]
    },
    {
      "type": "latch_step",
      "name": "Latch Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step image"
        },
        {
          "type": "text",
          "id": "step_title",
          "label": "Step title"
        },
        {
          "type": "richtext",
          "id": "step_body",
          "label": "Step description"
        },
        {
          "type": "header",
          "content": "Optional marker"
        },
        {
          "type": "text",
          "id": "marker_label",
          "label": "Marker label",
          "info": "Leave blank for no marker"
        },
        {
          "type": "range",
          "id": "marker_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Marker left position",
          "default": 79
        },
        {
          "type": "range",
          "id": "marker_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Marker top position",
          "default": 73
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DM: Out of Box"
    }
  ]
}
{% endschema %}
