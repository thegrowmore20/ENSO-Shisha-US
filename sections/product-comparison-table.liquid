
{{ 'comparison-table.css' | asset_url | stylesheet_tag }}
<div data-aplus-section-container>
	<div class="aplus-v2 desktop">
		<div class="premium-aplus premium-aplus-module-5 aplus-container-3 comparison-table enso-comparison">
			<div class="section-header section-content-spacing text-center">
				<h2 class="heading h2"> WHY ENSO WINS?</h2>
			</div>   
			<div id="comparison-table-container-6" data-comparison-name="comparison-table-container-6" class="a-section a-spacing-none table-container">  
			<div class="table-slider scroll-wrapper-bottom">
				<table class="a-bordered a-horizontal-stripes scroll-width">
					<tbody>
						
						<tr class="header-row">
							<td class="attribute empty"></td>
							
							<th class="aplus-data-column top-header active active-item">
								<div class="comparison-product-card">
									{% render 'card-product', card_product: product %}
								</div>
							</th>
							
							<th class="aplus-data-column top-header">
								<div class="relative overflow-hidden group/media">
									<a href="{{ url }}" tabindex="-1" data-instant aria-label="{{ card_product.title | default: 'Product' }}">
										<div
											class="product-card-media media rounded-block [--aspect-ratio:--product-card-image-aspect] md:pb-6"
										>
											<lqip-element class="image-loader h-full">
												<img src="https://cdn.shopify.com/s/files/1/0777/8339/files/71Bhm4vc2SL._SX679.webp?v=1777371233&width=450"
													widths="200, 360, 450" loading="lazy" width="" height="" alt="coal hookah image"
													class="product-card__image product-thumbnail-shade"/>
												</lqip-element>
											</div>
										</a>
									</div>
								</th>
								
								<th class="aplus-data-column top-header">
									<div class="relative overflow-hidden group/media">
										<a href="{{ url }}" tabindex="-1" data-instant aria-label="{{ card_product.title | default: 'Product' }}">
											<div
												class="product-card-media media rounded-block [--aspect-ratio:--product-card-image-aspect] md:pb-6"
											>
												<lqip-element class="image-loader h-full">
													<img src="https://cdn.shopify.com/s/files/1/0777/8339/files/51z90B1mVTL._AC_SY300_SX300_QL70_ML2.jpg?v=1775046681&width=450"
														widths="200, 360, 450" loading="lazy" width="" height="" alt="home vape"
														class="product-card__image product-thumbnail-shade"/>
													</lqip-element>
												</div>
											</a>
										</div>
									</th>
								</tr>
								
								{% for entry in selected_features %}{% endfor %}
								<tr class="first-content-row">
									<td class="attribute a-text-bold column-cell-1">
										<div class="comparison-metric-name " data-inline-content="" data-position="triggerRight">
											<span class="a-text-bold"> Category </span>
										</div>
									</td>
									
									{%- comment -%} Current product value {%- endcomment -%}
									<td class="aplus-data-column active active-item second-sticky-column">
										Electric hookah
									</td>
									<td class="aplus-data-column secondary-content-column">
										Coal hookah
									</td>
									<td class="aplus-data-column secondary-content-column">
										Home vape
									</td>
									
									
									{%- comment -%} Compared products values {%- endcomment -%}
									{% for cp in compare_products %}
										{% unless cp.id == product.id %}
											{% assign cp_compare_key = cp.metafields.custom.compare_key.value %}
											{% if cp_compare_key == blank %}
												{% assign cp_compare_key = cp.handle | replace: '-', '_' %}
											{% endif %}
											
											{% assign cp_value = entry[cp_compare_key] | metafield_tag %}
											<td class="aplus-data-column" style="min-width: 230px;">
												{% if cp_value != blank %}
													{{ cp_value.value | default: cp_value }}
												{% else %}
													—
												{% endif %}
											</td>
										{% endunless %}
									{% endfor %}									
								</tr>
								
								<tr>   
								<td class="attribute a-text-bold">
									<div class="comparison-metric-name " data-inline-content="" data-position="triggerRight">
										<span class="a-text-bold"> Heat style </span>
									</div>
								</td>
								<td class="aplus-data-column active active-item second-sticky-column">
									<span class="description">
										Clean electric
									</span>
								</td>      
								<td class="aplus-data-column secondary-content-column">
									<span class="description">
										Burning coal
									</span>
								</td>           
								<td class="aplus-data-column secondary-content-column">
									<span class="description">
										Dry heat
									</span>
								</td>      
							</tr> 
							
							<tr>   
							<td class="attribute a-text-bold">
								<div class="comparison-metric-name " data-inline-content="" data-position="triggerRight">
									<span class="a-text-bold"> What you use </span>
								</div>
							</td>
							<td class="aplus-data-column active active-item second-sticky-column">
								<span class="description">
									Molasses + dry herb
								</span>
							</td>      
							<td class="aplus-data-column secondary-content-column">
								<span class="description">
									Shisha molasses
								</span>
							</td>           
							<td class="aplus-data-column secondary-content-column">
								<span class="description">
									Dry herb
								</span>
							</td>      
							
						</tr> 
						
						<tr>   
						<td class="attribute a-text-bold">
							<div class="comparison-metric-name " data-inline-content="" data-position="triggerRight">
								<span class="a-text-bold"> Flavor quality </span>
							</div>
						</td>
						<td class="aplus-data-column active active-item second-sticky-column">
							<span class="description">
								Pure flavor
							</span>
						</td>      
						<td class="aplus-data-column secondary-content-column">
							<span class="description">
								Coal-tainted
							</span>
						</td>           
						<td class="aplus-data-column secondary-content-column">
							<span class="description">
								Herb taste
							</span>
						</td>      
						
					</tr>
					
					<tr>  
					<td class="attribute a-text-bold">
						<div class="comparison-metric-name " data-inline-content="" data-position="triggerRight">
							<span class="a-text-bold"> Cloud style </span> 
						</div>
					</td>
					<td class="aplus-data-column active active-item second-sticky-column">
						<span class="description">Big clouds</span>
					</td>
					<td class="aplus-data-column secondary-content-column">
						<span class="description">Heavy smoke</span>
					</td>      
					<td class="aplus-data-column secondary-content-column">
						<span class="description">Light vapor</span>
					</td> 
					
				</tr>
				
				
				<tr>  
				<td class="attribute a-text-bold">
					<div class="comparison-metric-name " data-inline-content="" data-position="triggerRight">
						<span class="a-text-bold">Session vibe</span>
					</div>
				</td>      
				<td class="aplus-data-column active active-item second-sticky-column">
					<span class="description">Party or solo ritual</span>
				</td>      
				<td class="aplus-data-column secondary-content-column">
					<span class="description">Old-school ritual</span>
				</td>      
				<td class="aplus-data-column secondary-content-column">
					<span class="description">Solo sessions</span>
				</td> 
			</tr> 
			
			<tr>   
			<td class="attribute a-text-bold">
				<div class="comparison-metric-name " data-inline-content="" data-position="triggerRight">
					<span class="a-text-bold">Session time</span>
				</div>
			</td>      
			<td class="aplus-data-column active active-item second-sticky-column">
				<span class="description">Long sessions</span>
			</td>      
			<td class="aplus-data-column secondary-content-column">
				<span class="description">Long sessions</span>
			</td>      
			<td class="aplus-data-column secondary-content-column">
				<span class="description">Short sessions</span>
			</td> 
			
		</tr>
		
		
		<tr>  
		<td class="attribute a-text-bold">
			<div class="comparison-metric-name " data-inline-content="" data-position="triggerRight">
				<span class="a-text-bold">Setup</span>
			</div>
		</td>      
		<td class="aplus-data-column active active-item second-sticky-column">
			<span class="description">Fast setup</span>
		</td>      
		<td class="aplus-data-column secondary-content-column">
			<span class="description">Messy prep</span>
		</td>      
		<td class="aplus-data-column secondary-content-column">
			<span class="description">Simple use</span>
		</td>
		
		
	</tr>  
	
	<tr>  
	<td class="attribute a-text-bold">
		<div class="comparison-metric-name " data-inline-content="" data-position="triggerRight">
			<span class="a-text-bold"> Portability </span>
		</div>
	</td>      
	<td class="aplus-data-column active active-item second-sticky-column">
		<span class="description">Cord-free</span>
	</td>      
	<td class="aplus-data-column secondary-content-column">
		<span class="description">Bulky setup</span>
	</td>      
	<td class="aplus-data-column secondary-content-column">
		<span class="description">Plug-in only</span>
	</td>
	
</tr>

<tr>  
<td class="attribute a-text-bold">
	<div class="comparison-metric-name " data-inline-content="" data-position="triggerRight">
		<span class="a-text-bold"> Best for </span>
	</div>
</td>      
<td class="aplus-data-column active active-item second-sticky-column">
	<span class="description">Modern hookah</span>
</td>      
<td class="aplus-data-column secondary-content-column">
	<span class="description">Traditional smokers</span>
</td>      
<td class="aplus-data-column secondary-content-column">
	<span class="description">Personal vaping</span>
</td>

</tr>

</tbody>
</table>
</div>
</div>
<div class="text-center">
	<strong>Pure flavor. Big clouds. Modern hookah sessions without coal, flame, or the mess</strong>
</div> 
</div>
</div>
</div>