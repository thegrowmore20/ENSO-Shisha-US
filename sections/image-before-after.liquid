{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme

  assign inner_modifier = ''
  assign header_align_class = ''
  case section.settings.text_position
    when 'left'
      assign inner_modifier = 'image-comparison-section__inner--split image-comparison-section__inner--left'
    when 'right'
      assign inner_modifier = 'image-comparison-section__inner--split image-comparison-section__inner--right'
    else
      assign header_align_class = 'image-comparison-section__header--center'
  endcase

  assign heading_tag = section.settings.heading_html_tag | default: 'p'

  assign before_img_alt = section.settings.before_image.alt | default: 'Before'
  assign after_img_alt = section.settings.after_image.alt | default: 'After'

  assign handle_rgb = section.settings.handle_color | color_to_rgb | remove: 'rgb(' | remove: ')'
  assign handle_brightness = section.settings.handle_color | color_brightness
  if handle_brightness > 128
    assign handle_foreground_rgb = '17, 17, 17'
  else
    assign handle_foreground_rgb = '255, 255, 255'
  endif

  case section.settings.width
    when 'narrow'
      assign content_max_width = '760px'
    when 'page_width'
      assign content_max_width = 'var(--page-width)'
    when 'full'
      assign content_max_width = '100%'
    else
      assign content_max_width = '1000px'
  endcase
-%}

{% style %}
  #ImageComparison-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #ImageComparison-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ImageComparison-{{ section.id }} .image-comparison-section__inner {
    max-width: {{ content_max_width }};
    margin-inline: auto;
  }

  #ImageComparison-{{ section.id }} .image-comparison-section__inner--split {
    display: grid;
    gap: var(--space-6) var(--space-8);
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    #ImageComparison-{{ section.id }} .image-comparison-section__inner--left {
      grid-template-columns: 1fr 2fr;
    }
    #ImageComparison-{{ section.id }} .image-comparison-section__inner--right {
      grid-template-columns: 2fr 1fr;
    }
    #ImageComparison-{{ section.id }} .image-comparison-section__inner--right .image-comparison-section__header {
      order: 2;
    }
  }

  #ImageComparison-{{ section.id }} .image-comparison-section__header--center {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  #ImageComparison-{{ section.id }} .image-comparison-section__heading {
    margin: var(--space-2) 0 0;
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1.15;
  }

  @media screen and (min-width: 750px) {
    #ImageComparison-{{ section.id }} .image-comparison-section__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
  }

  #ImageComparison-{{ section.id }} .image-comparison-section__content {
    margin-top: var(--space-3);
  }

  #ImageComparison-{{ section.id }} .image-comparison-section__body {
    margin-top: var(--space-6);
  }

  #ImageComparison-{{ section.id }} .image-comparison-section__inner--split .image-comparison-section__body {
    margin-top: 0;
  }

  #ImageComparison-{{ section.id }} .image-comparison {
    --image-comparison-progress: {{ section.settings.initial_position }}%;
    --image-comparison-handle-background: {{ handle_rgb }};
    --image-comparison-handle-foreground: {{ handle_foreground_rgb }};
    display: grid;
    justify-content: stretch;
    align-items: stretch;
    position: relative;
    overflow: hidden;
    min-height: 240px;
    cursor: grab;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }

  #ImageComparison-{{ section.id }} .image-comparison.is-dragging {
    cursor: grabbing;
  }

  @media not all and (min-width: 576px) {
    #ImageComparison-{{ section.id }} .image-comparison {
      margin-left: calc(var(--page-margin-mobile) * -1);
      margin-right: calc(var(--page-margin-mobile) * -1);
    }
  }

  @media (min-width: 576px) {
    #ImageComparison-{{ section.id }} .image-comparison {
      border-radius: var(--radius-lg);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }
  }

  #ImageComparison-{{ section.id }} .image-comparison__before {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #ImageComparison-{{ section.id }} .image-comparison__after {
    grid-area: 1 / 1;
    clip-path: inset(-1px -1px -1px var(--image-comparison-progress));
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateZ(0);
  }

  #ImageComparison-{{ section.id }} .image-comparison__handle {
    --width: 2rem;
    --height: 3rem;
    position: absolute;
    left: calc(var(--image-comparison-progress) - var(--width) / 2);
    top: calc(50% - var(--height) / 2);
    width: var(--width);
    height: var(--height);
    border-radius: 100rem;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgb(var(--image-comparison-handle-background));
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
    pointer-events: none;
  }

  @media not all and (min-width: 768px) {
    #ImageComparison-{{ section.id }} .image-comparison__handle {
      --width: 1.667rem;
      --height: 2.5rem;
    }
  }

  #ImageComparison-{{ section.id }} .image-comparison__handle::before {
    content: "";
    display: block;
    width: 12px;
    height: 16px;
    background-size: 100% 100%;
    background-image: linear-gradient(
      to right,
      rgb(var(--image-comparison-handle-foreground)) 0%,
      rgb(var(--image-comparison-handle-foreground)) 20%,
      transparent 20%,
      transparent 40%,
      rgb(var(--image-comparison-handle-foreground)) 40%,
      rgb(var(--image-comparison-handle-foreground)) 60%,
      transparent 60%,
      transparent 80%,
      rgb(var(--image-comparison-handle-foreground)) 80%,
      rgb(var(--image-comparison-handle-foreground)) 100%
    );
  }

  #ImageComparison-{{ section.id }} .image-comparison__bar {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    left: calc(var(--image-comparison-progress) - 2px);
    background: rgb(var(--image-comparison-handle-background));
    pointer-events: none;
  }

  #ImageComparison-{{ section.id }} .image-comparison:focus-visible {
    outline: 2px solid rgb(var(--image-comparison-handle-background));
    outline-offset: 4px;
  }
{% endstyle %}

<div class="image-comparison-section {{ scheme_class }} " id="ImageComparison-{{ section.id }}">
  <div class="container image-comparison-section__inner {{ inner_modifier }}">

    {%- if section.settings.subheading != blank or section.settings.heading != blank or section.settings.content != blank -%}
      <div class="image-comparison-section__header {{ header_align_class }}">
        {%- if section.settings.subheading != blank -%}
          <p class="eyebrow">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="image-comparison-section__heading">{{ section.settings.heading }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.content != blank -%}
          <div class="image-comparison-section__content body-text text-muted">{{ section.settings.content }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="image-comparison-section__body">
      <image-comparison
        class="image-comparison"
        tabindex="0"
        role="slider"
        aria-orientation="horizontal"
        aria-label="{{ 'Image before and after comparison' }}"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ section.settings.initial_position }}"
        data-initial-position="{{ section.settings.initial_position }}"
      >
        {%- if section.settings.before_image != blank -%}
          {{
            section.settings.before_image
            | image_url: width: 1920
            | image_tag: class: 'image-comparison__before', sizes: 'min(1024px, 100vw)', loading: 'lazy', alt: before_img_alt, width: section.settings.before_image.width, height: section.settings.before_image.height
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'image-comparison__before' }}
        {%- endif -%}

        {%- if section.settings.after_image != blank -%}
          {{
            section.settings.after_image
            | image_url: width: 1920
            | image_tag: class: 'image-comparison__after', sizes: 'min(1024px, 100vw)', loading: 'lazy', alt: after_img_alt, width: section.settings.after_image.width, height: section.settings.after_image.height
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'image-comparison__after' }}
        {%- endif -%}

        <div class="image-comparison__bar"></div>
        <div class="image-comparison__handle"></div>
      </image-comparison>
    </div>

  </div>
</div>

<script>
  if (!customElements.get('image-comparison')) {
    class ImageComparison extends HTMLElement {
      connectedCallback() {
        this.min = 0;
        this.max = 100;
        this.dragging = false;
        this._onMove = this.onPointerMove.bind(this);
        this._onUp = this.onPointerUp.bind(this);

        var initial = parseFloat(this.dataset.initialPosition);
        this.currentPosition = isNaN(initial) ? 50 : initial;

        this.addEventListener('pointerdown', this.onPointerDown.bind(this));
        this.addEventListener('keydown', this.onKeyDown.bind(this));
      }

      disconnectedCallback() {
        window.removeEventListener('pointermove', this._onMove);
        window.removeEventListener('pointerup', this._onUp);
      }

      onPointerDown(event) {
        this.dragging = true;
        this.classList.add('is-dragging');
        this.focus();
        this.setPositionFromEvent(event);
        window.addEventListener('pointermove', this._onMove);
        window.addEventListener('pointerup', this._onUp);
        event.preventDefault();
      }

      onPointerMove(event) {
        if (!this.dragging) return;
        this.setPositionFromEvent(event);
      }

      onPointerUp() {
        this.dragging = false;
        this.classList.remove('is-dragging');
        window.removeEventListener('pointermove', this._onMove);
        window.removeEventListener('pointerup', this._onUp);
      }

      onKeyDown(event) {
        var step = event.shiftKey ? 10 : 2;
        if (event.key === 'ArrowLeft') {
          this.setPosition(this.currentPosition - step);
          event.preventDefault();
        } else if (event.key === 'ArrowRight') {
          this.setPosition(this.currentPosition + step);
          event.preventDefault();
        } else if (event.key === 'Home') {
          this.setPosition(0);
          event.preventDefault();
        } else if (event.key === 'End') {
          this.setPosition(100);
          event.preventDefault();
        }
      }

      setPositionFromEvent(event) {
        var rect = this.getBoundingClientRect();
        var x = event.clientX - rect.left;
        this.setPosition((x / rect.width) * 100);
      }

      setPosition(pct) {
        pct = Math.max(this.min, Math.min(this.max, pct));
        this.currentPosition = pct;
        var rounded = Math.round(pct);
        this.style.setProperty('--image-comparison-progress', pct + '%');
        this.setAttribute('aria-valuenow', rounded);
        this.setAttribute('aria-valuetext', rounded + ' percent');
      }
    }

    customElements.define('image-comparison', ImageComparison);
  }
</script>

{% schema %}
{
  "name": "Image before/after",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-paper"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "header",
      "content": "Heading & content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the difference"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "left", "label": "Left of image" },
        { "value": "center", "label": "Above image, centered" },
        { "value": "right", "label": "Right of image" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_html_tag",
      "label": "Heading HTML tag",
      "info": "Controls semantic markup independently of visual size — useful for keeping one h1 per page.",
      "options": [
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" },
        { "value": "p", "label": "p" },
        { "value": "span", "label": "span" },
        { "value": "div", "label": "div" }
      ],
      "default": "p"
    },
    {
      "type": "header",
      "content": "Comparison slider"
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "Handle color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "initial_position",
      "label": "Starting position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Container width",
      "options": [
        { "value": "narrow", "label": "Narrow (760px)" },
        { "value": "page", "label": "Normal (1000px)" },
        { "value": "page_width", "label": "Page width" },
        { "value": "full", "label": "Full width (100%)" }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    { "name": "Image before/after" }
  ]
}
{% endschema %}
