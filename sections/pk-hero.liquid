<link rel="stylesheet" href="{{ 'diamond-manual.css' | asset_url }}">
<script src="{{ 'diamond-manual.js' | asset_url }}" defer></script>
<div class="wrap">
  <section class="pk-hero">
    {%- if section.settings.hero_image != blank -%}
      {{- section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_image.alt | default: 'How to pack the cup', width: section.settings.hero_image.width, height: section.settings.hero_image.height, style: 'object-position:100% 50%' -}}
    {%- endif -%}
    <div>
      <p class="eyebrow pk-eyebrow">ENSŌ Experience · Guide</p>
      <h1>How to pack the cup</h1>
      <p class="pk-intro">The same craft as a bowl on coal: choose the mesh, pack in light layers, find your heat. Diamond warms the cup from the sides and from below, so the pack shapes the flavour.</p>
      <div class="pk-facts">
        <span>10–15 g</span>
        <span>Basket or flat screen</span>
        <span>Default 7 min · 275 °C</span>
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
.pk-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 48px;
  align-items: center;
  padding: 64px 0 48px;
}
.pk-hero img {
  border-radius: 28px;
  aspect-ratio: 4/3;
  object-fit: cover;
  width: 100%;
}
.pk-hero h1 {
  font-size: 44px;
  line-height: 48px;
  font-family: var(--font-accent);
  font-weight: var(--font-weight-heavy);
  letter-spacing: -0.02em;
  margin: 0 0 14px;
}
.pk-intro {
  color: rgba(0, 0, 0, 0.72);
  margin: 0 0 16px;
  max-width: 52ch;
}
.pk-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 0;
}
.pk-facts span {
  background: transparent;
  border: 1px solid rgba(0, 0, 0, 0.2);
  border-radius: 999px;
  padding: 7px 14px;
  font-size: 13.5px;
  font-weight: 600;
  line-height: 1.2;
  color: #000;
}
.pk-sec {
  max-width: 1200px;
  margin: 0 auto;
  padding: 56px 40px 8px;
}
.pk-sec h2 {
  font-size: 36px;
  line-height: 42px;
  font-family: var(--font-accent);
  font-weight: var(--font-weight-heavy);
  letter-spacing: -0.02em;
  margin: 0 0 10px;
}
.pk-lead {
  font-size: 16px;
  line-height: 26px;
  color: rgb(0 0 0 / .74);
  max-width: 68ch;
  margin: 0 0 20px;
}
.pk-note {
  font-size: 15px;
  line-height: 23px;
  margin: 14px 0 0;
  color: rgb(0 0 0 / .72);
  padding-left: 14px;
  border-left: 3px solid #c8943a;
}
.pk-note b { font-weight: 700; }
.pk-eyebrow {
  color: #c8943a;
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 600;
  margin: 0 0 12px;
}
@media screen and (max-width: 990px) {
  .pk-hero {
    grid-template-columns: 1fr;
    gap: 20px;
    padding-top: 32px;
    padding-bottom: 32px;
  }
  .pk-hero h1 {
    font-size: 32px;
    line-height: 36px;
  }
}
@media screen and (max-width: 767px) {
  .pk-sec { padding: 40px 16px 4px; }
  .pk-sec h2 { font-size: 28px; line-height: 34px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "PK: Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    }
  ],
  "presets": [{ "name": "PK: Hero" }]
}
{% endschema %}
