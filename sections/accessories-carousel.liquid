{%- liquid
  assign coll = section.settings.collection
  assign product_list = section.settings.product_list
  assign heading = section.settings.heading
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link | default: coll.url | default: '/collections/all'
  assign limit = section.settings.products_limit
-%}
{%- render 'acc-atc-states' -%}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="acc-section" aria-label="{{ heading | escape }}">
  {%- if heading != blank -%}
    <div class="container">
      <div class="acc-section__head">
        <h2 class="acc-section__heading">{{ heading }}</h2>
      </div>
    </div>
  {%- endif -%}

  <div class="acc-wrap">
    <button class="acc-arrow acc-arrow--l" type="button" id="AccArrowPrev-{{ section.id }}" aria-label="{{ 'accessibility.previous_slide' | t }}">&#8249;</button>

    <div class="acc-track" id="AccTrack-{{ section.id }}" role="region" aria-label="{{ heading | escape }}">
      {%- if product_list.size > 0 -%}
        {%- for product in product_list limit: limit -%}
          {%- unless product.title contains 'Shipping Protection' -%}
            {%- render 'card-accessory', product: product -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- elsif coll != blank -%}
        {%- for product in coll.products limit: limit -%}
          {%- unless product.title contains 'Shipping Protection' -%}
            {%- render 'card-accessory', product: product -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="acc-card acc-card--placeholder">
            <div class="acc-card__img">{{ 'product-' | append: i | placeholder_svg_tag: 'acc-card__placeholder' }}</div>
            <h3 class="acc-card__title">Product name</h3>
            <p class="acc-card__desc">Product description goes here.</p>
            <div class="acc-card__foot">
              <div class="acc-card__price"><b>$0.00</b></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <button class="acc-arrow acc-arrow--r" type="button" id="AccArrowNext-{{ section.id }}" aria-label="{{ 'accessibility.next_slide' | t }}">&#8250;</button>
  </div>

  {%- if cta_label != blank -%}
    <div class="container">
      <div class="acc-section__viewall">
        <a class="btn btn--secondary acc-section__viewall-btn" href="{{ cta_link }}">{{ cta_label }}</a>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .acc-section__head {
    text-align: center;
    margin-bottom: 32px;
  }

  .acc-section__heading {
    font-size: 32px;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .acc-section__heading { font-size: 40px; }
  }

  /* Prevent scrollable track from bleeding into page horizontal scroll */
  .acc-section {
    overflow: hidden;
  }

  /* Carousel wrap — relative so arrows can position against it */
  .acc-wrap {
    position: relative;
    max-width: 1600px;
    margin: 0 auto;
    padding-top: 8px;
  }

  /* Arrow buttons */
  .acc-arrow {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: rgb(0 0 0 / .75);
    color: #fff;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
    display: grid;
    place-items: center;
    transition: background 0.2s;
  }

  .acc-arrow:hover { background: #000; }
  .acc-arrow--l { left: max(16px, calc(50% - 640px - 24px)); }
  .acc-arrow--r { right: max(16px, calc(50% - 640px - 24px)); }

  /* Scrollable track */
  .acc-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 0 0 8px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .acc-track::-webkit-scrollbar { display: none; }

  /* Cards */
  .acc-card {
    flex: 0 0 calc((100% - 60px) / 4);
    scroll-snap-align: start;
    border: 1px solid var(--color-border, rgb(0 0 0 / .12));
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: box-shadow 0.3s;
    min-width: 0;
  }

  .acc-card:hover { box-shadow: 0 12px 40px rgb(0 0 0 / .08); }

  /* Image block */
  .acc-card__img {
    position: relative;
    aspect-ratio: 1;
    border-radius: 12px;
    border: 1px solid var(--color-border, rgb(0 0 0 / .1));
    margin-bottom: 14px;
    background: #fff;
    overflow: hidden;
    display: block;
    text-decoration: none;
  }

  .acc-card__img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6%;
    transition: opacity 0.45s, transform 0.9s cubic-bezier(.2,.8,.2,1);
  }

  .acc-card__img img + img { opacity: 0; padding: 0; object-fit: cover; }
  .acc-card:hover .acc-card__img img + img { opacity: 1; }
  .acc-card:hover .acc-card__img img:first-child:last-child { transform: scale(1.04); }

  .acc-card__placeholder { width: 100%; height: 100%; opacity: 0.3; }

  /* Text */
  .acc-card__title {
    font-size: 16px;
    line-height: 22px;
    font-weight: var(--font-weight-semibold);
    margin: 0;
  }

  .acc-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .acc-card__title a:hover { text-decoration: underline; }

  .acc-card__desc {
    font-size: 13px;
    color: var(--color-text-muted, rgb(0 0 0 / .55));
    line-height: 19px;
    margin: 0;
  }

  /* Price + CTA row */
  .acc-card__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 6px;
  }

  .acc-card__price {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .acc-card__price b {
    font-family: var(--font-accent);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .acc-card__oos:not([hidden]) {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted, rgb(0 0 0 / .5));
  }

  .acc-card__form { margin: 0; }

  /* Icons hidden by default on desktop — only shown on mobile via the media query below */
  .acc-card__btn-icon { display: none; }

  /* .btn.btn--accent provides gold fill; keep only sizing overrides */
  .acc-card__btn { font-size: 12px; padding: 0 16px; min-width: 110px; }
  .acc-card__btn:not(.acc-card__btn--oos) .acc-card__btn-label { color: #fff; }

  .acc-card__btn--oos {
    background: transparent;
    color: var(--color-text-muted, rgb(0 0 0 / .45));
    border: 1.5px solid rgb(0 0 0 / .2);
    box-shadow: none;
    cursor: default;
    opacity: 0.7;
  }
  .acc-card__btn--oos .acc-card__btn-label {
    color: var(--color-text-muted, rgb(0 0 0 / .45));
  }

  /* REZ "Notify Me" button — match acc-card__btn sizing in the flex foot row */
  .acc-card .rez-button-wrapper { margin: 0; flex-shrink: 0; }
  .acc-card .rez-out-of-stock-collection-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    height: 44px !important;
    padding: 0 16px !important;
    min-width: 110px !important;
    width: auto !important;
    border-radius: var(--radius-pill) !important;
    font-family: var(--font-heading) !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    letter-spacing: 0.1em !important;
    text-transform: uppercase !important;
    box-sizing: border-box !important;
  }
  @media screen and (max-width: 749px) {
    .acc-card .rez-button-wrapper { flex-shrink: 0; }
    .acc-card .rez-out-of-stock-collection-btn {
      width: 40px !important;
      height: 40px !important;
      min-width: unset !important;
      padding: 0 !important;
      font-size: 0 !important;
    }
  }

  /* View all */
  .acc-section__viewall {
    display: flex;
    justify-content: center;
    margin-top: 28px;
    padding: 6px 0 8px;
  }

  /* uses .btn.btn--secondary from base.css — no overrides needed */

  /* Tablet (hide arrows, tighten layout) */
  @media screen and (max-width: 991px) {
    .acc-arrow { display: none; }
  }

  /* Mobile — peek carousel: current card centred, adjacent cards visible at edges */
  @media screen and (max-width: 749px) {
    .acc-wrap { overflow: hidden; }
    .acc-section { overflow: visible; }
    .acc-track {
      padding: 0 10vw 8px;
      gap: 12px;
    }
    .acc-card {
      flex: 0 0 80vw;
      scroll-snap-align: center;
    }

    /* Icon-only ATC button; icon states handled by acc-atc-states snippet */
    .acc-card__btn {
      width: 40px;
      height: 40px;
      padding: 0;
      flex-shrink: 0;
      min-width: unset;
    }
    .acc-card__btn-label { display: none; }
  }

{% endstylesheet %}

{% javascript %}
(function () {

  /* ── Open global popup from card data attributes ── */
  function openFromCard(card) {
    var d = card.dataset;
    var images = (d.popupImages || '').split(';').filter(Boolean).map(function (src) {
      return { src: src, alt: d.popupImgAlt || d.popupTitle || '' };
    });
    document.dispatchEvent(new CustomEvent('product:popup', {
      bubbles: true,
      detail: {
        title:     d.popupTitle     || '',
        fits:      d.popupCompat    || '',
        price:     d.popupPrice     || '',
        available: d.popupAvailable !== 'false',
        vid:       d.popupVariant   || '',
        url:       d.popupUrl       || '',
        images:    images,
        headline:  d.popupHeadline  || '',
        shortdesc: d.popupShortdesc || '',
        variants:  []
      }
    }));
  }

  /* ── Initialise each carousel instance ── */
  function initCarousel(trackEl) {
    var section = trackEl.closest('.shopify-section');
    var prevBtn = section && section.querySelector('.acc-arrow--l');
    var nextBtn = section && section.querySelector('.acc-arrow--r');

    var cardWidth = function () {
      var card = trackEl.querySelector('.acc-card');
      return card ? card.getBoundingClientRect().width + 20 : 0;
    };
    if (prevBtn) prevBtn.addEventListener('click', function () { trackEl.scrollBy({ left: -cardWidth(), behavior: 'smooth' }); });
    if (nextBtn) nextBtn.addEventListener('click', function () { trackEl.scrollBy({ left: cardWidth(), behavior: 'smooth' }); });

    /* click anywhere on card (except interactive controls) → global popup */
    trackEl.addEventListener('click', function (e) {
      /* Let buttons, form inputs, variant opts, and details links pass through */
      if (e.target.closest('button, input, select, a.acc-card__details, .acc-card__opt, .rez-button-wrapper')) return;
      var card = e.target.closest('.acc-card[data-popup-title]');
      if (!card) return;
      /* Also let the title link and image link navigate normally if popup isn't available */
      var imgLink   = e.target.closest('.acc-card__img');
      var titleLink = e.target.closest('.acc-card__title a');
      e.preventDefault();
      openFromCard(card);
    });

    /* variant option switching */
    trackEl.addEventListener('click', function (e) {
      var optBtn = e.target.closest('.acc-card__opt');
      if (!optBtn) return;
      var card = optBtn.closest('.acc-card');
      if (!card) return;

      var vid       = optBtn.dataset.vid;
      var money     = optBtn.dataset.money;
      var available = optBtn.dataset.available !== 'false';

      /* update active state */
      card.querySelectorAll('.acc-card__opt').forEach(function (b) {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
      });
      optBtn.classList.add('is-active');
      optBtn.setAttribute('aria-pressed', 'true');

      /* update hidden form input */
      var idInput = card.querySelector('input[name="id"]');
      if (idInput) idInput.value = vid;

      /* update price */
      var priceEl = card.querySelector('.acc-card__price b');
      if (priceEl && money) priceEl.textContent = money;

      /* update card-level data attrs used by global.js for button state sync */
      card.dataset.price     = optBtn.dataset.price;
      card.dataset.available = available;

      /* swap ATC ↔ Sold Out button */
      var form   = card.querySelector('.acc-card__form');
      var oosBtn = card.querySelector('.acc-card__btn--oos');
      var oosEl  = card.querySelector('.acc-card__oos');

      if (available) {
        if (form)   form.hidden   = false;
        if (oosBtn) oosBtn.hidden = true;
        if (oosEl)  oosEl.hidden  = true;

        /* Sync ATC button state with cart for the new variant */
        var atcBtn = form && form.querySelector('[type="submit"]');
        if (atcBtn) {
          var cache  = window.__cartItemsCache;
          var inCart = cache && cache.has(String(vid));
          if (inCart) {
            atcBtn.setAttribute('aria-pressed', 'true');
            atcBtn.setAttribute('data-in-cart-variant', vid);
            var lbl = atcBtn.querySelector('[data-quick-add-label]');
            if (lbl) lbl.textContent = 'Added To Cart';
          } else {
            atcBtn.removeAttribute('aria-pressed');
            atcBtn.removeAttribute('data-in-cart-variant');
            atcBtn.removeAttribute('data-product-title');
            var lbl = atcBtn.querySelector('[data-quick-add-label]');
            if (lbl) lbl.textContent = lbl.dataset.labelAvailable || 'Add To Cart';
          }
        }
      } else {
        if (form)   form.hidden   = true;
        if (oosBtn) oosBtn.hidden = false;
        if (oosEl)  oosEl.hidden  = false;
      }
    });

    /* ATC submit handled by global.js interceptor — no local handler needed */
  }

  function boot() {
    document.querySelectorAll('.acc-track').forEach(function (trackEl) {
      if (trackEl.dataset.accInit) return;
      trackEl.dataset.accInit = '1';
      initCarousel(trackEl);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

})();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.accessories_carousel.name",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.accessories_carousel.settings.collection.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.accessories_carousel.settings.heading.label",
      "default": "Accessories for ENSŌ"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "t:sections.accessories_carousel.settings.products_limit.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "t:sections.accessories_carousel.settings.product_list.label",
      "info": "t:sections.accessories_carousel.settings.product_list.info",
      "limit": 12
    },
    {
      "type": "header",
      "content": "t:sections.accessories_carousel.settings.header_cta.content"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.accessories_carousel.settings.cta_label.label",
      "default": "View all accessories"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.accessories_carousel.settings.cta_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:sections.accessories_carousel.presets.name"
    }
  ]
}
{% endschema %}
