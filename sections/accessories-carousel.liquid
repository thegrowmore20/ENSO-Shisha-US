{%- liquid
  assign coll = section.settings.collection
  assign heading = section.settings.heading
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link | default: coll.url | default: '/collections/all'
  assign limit = section.settings.products_limit
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="acc-section" aria-label="{{ heading | escape }}">
  {%- if heading != blank -%}
    <div class="container">
      <div class="acc-section__head">
        <h2 class="acc-section__heading">{{ heading }}</h2>
      </div>
    </div>
  {%- endif -%}

  <div class="acc-wrap">
    <button class="acc-arrow acc-arrow--l" type="button" id="AccArrowPrev-{{ section.id }}" aria-label="{{ 'accessibility.previous_slide' | t }}">&#8249;</button>

    <div class="acc-track" id="AccTrack-{{ section.id }}" role="region" aria-label="{{ heading | escape }}">
      {%- if coll != blank -%}
        {%- for product in coll.products limit: limit -%}
          {%- unless product.title contains 'Shipping Protection' -%}
            {%- render 'card-accessory', product: product -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- elsif request.design_mode -%}
        {%- for i in (1..4) -%}
          <article class="acc-card acc-card--placeholder">
            <div class="acc-card__img">{{ 'product-' | append: i | placeholder_svg_tag: 'acc-card__placeholder' }}</div>
            <h3 class="acc-card__title">Accessory {{ i }}</h3>
            <p class="acc-card__desc">Product description goes here.</p>
            <div class="acc-card__foot">
              <div class="acc-card__price"><b>€0.00</b></div>
              <span class="acc-card__btn">Add to cart</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <button class="acc-arrow acc-arrow--r" type="button" id="AccArrowNext-{{ section.id }}" aria-label="{{ 'accessibility.next_slide' | t }}">&#8250;</button>
  </div>

  {%- if cta_label != blank -%}
    <div class="container">
      <div class="acc-section__viewall">
        <a class="acc-section__viewall-btn" href="{{ cta_link }}">{{ cta_label }}</a>
      </div>
    </div>
  {%- endif -%}
</section>

<div class="acc-qv" id="AccQuickView-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t | default: 'Quick view' }}" hidden>
  <div class="acc-qv__backdrop"></div>
  <div class="acc-qv__box">
    <button class="acc-qv__close" type="button" aria-label="{{ 'accessibility.close' | t | default: 'Close' }}">&#215;</button>
    <div class="acc-qv__inner">

      <!-- Gallery slider -->
      <div class="acc-qv__gallery">
        <div class="acc-qv__gallery-track"></div>
        <button class="acc-qv__gprev" type="button" aria-label="{{ 'accessibility.previous_slide' | t }}">&#8249;</button>
        <button class="acc-qv__gnext" type="button" aria-label="{{ 'accessibility.next_slide' | t }}">&#8250;</button>
        <div class="acc-qv__dots" role="tablist"></div>
      </div>

      <!-- Body -->
      <div class="acc-qv__body">
        <p class="acc-qv__compat"></p>
        <h3 class="acc-qv__title"></h3>
        <div class="acc-qv__headline"></div>
        <div class="acc-qv__shortdesc"></div>

        <div class="acc-qv__foot">
          <div class="acc-qv__price-row">
            <span class="acc-qv__price"></span>
            <form class="acc-qv__form" action="/cart/add" method="post">
              <input type="hidden" name="id" value="">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="acc-qv__atc">{{ 'products.product.add_to_cart' | t }}</button>
            </form>
          </div>
          <a class="acc-qv__remind" href="">Remind me when in stock</a>
          <a class="acc-qv__details" href="">{{ 'products.product.view_full_details' | t | default: 'View full details' }} ›</a>
        </div>
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
  .acc-section__head {
    text-align: center;
    margin-bottom: 32px;
  }

  .acc-section__heading {
    font-size: 32px;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .acc-section__heading { font-size: 40px; }
  }

  /* Carousel wrap — relative so arrows can position against it */
  .acc-wrap {
    position: relative;
    max-width: 1600px;
    margin: 0 auto;
    padding-top: 8px;
  }

  /* Arrow buttons */
  .acc-arrow {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: rgb(0 0 0 / .75);
    color: #fff;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
    display: grid;
    place-items: center;
    transition: background 0.2s;
  }

  .acc-arrow:hover { background: #000; }
  .acc-arrow--l { left: calc(50% - 640px - 24px); }
  .acc-arrow--r { right: calc(50% - 640px - 24px); }

  /* Scrollable track */
  .acc-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 0 0 8px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .acc-track::-webkit-scrollbar { display: none; }

  /* Cards */
  .acc-card {
    flex: 0 0 calc((100% - 60px) / 4);
    scroll-snap-align: start;
    border: 1px solid var(--color-border, rgb(0 0 0 / .12));
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: box-shadow 0.3s;
    min-width: 0;
  }

  .acc-card:hover { box-shadow: 0 12px 40px rgb(0 0 0 / .08); }

  /* Image block */
  .acc-card__img {
    position: relative;
    aspect-ratio: 1;
    border-radius: 12px;
    border: 1px solid var(--color-border, rgb(0 0 0 / .1));
    margin-bottom: 14px;
    background: #fff;
    overflow: hidden;
    display: block;
    text-decoration: none;
  }

  .acc-card__img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6%;
    transition: opacity 0.45s, transform 0.9s cubic-bezier(.2,.8,.2,1);
  }

  .acc-card__img img + img { opacity: 0; padding: 0; object-fit: cover; }
  .acc-card:hover .acc-card__img img + img { opacity: 1; }
  .acc-card:hover .acc-card__img img:first-child:last-child { transform: scale(1.04); }

  .acc-card__placeholder { width: 100%; height: 100%; opacity: 0.3; }

  /* Text */
  .acc-card__title {
    font-size: 16px;
    line-height: 22px;
    font-weight: var(--font-weight-semibold);
    margin: 0;
  }

  .acc-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .acc-card__title a:hover { text-decoration: underline; }

  .acc-card__desc {
    font-size: 13px;
    color: var(--color-text-muted, rgb(0 0 0 / .55));
    line-height: 19px;
    margin: 0;
  }

  /* Price + CTA row */
  .acc-card__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 6px;
  }

  .acc-card__price {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .acc-card__price b {
    font-family: var(--font-accent);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .acc-card__oos {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted, rgb(0 0 0 / .5));
  }

  /* CTA buttons */
  /* Loading spinner inside the button */
  .acc-btn-spinner {
    display: block;
    width: 15px;
    height: 15px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #fff;
    border-radius: 50%;
    animation: accSpin 0.65s linear infinite;
    flex-shrink: 0;
  }

  @keyframes accSpin {
    to { transform: rotate(360deg); }
  }

  .acc-card__form { margin: 0; }

  .acc-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #000;
    color: #fff;
    border: 0;
    border-radius: 999px;
    padding: 10px 18px;
    font-size: 12px;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .acc-card__btn:hover { opacity: 0.8; }

  .acc-card__btn--remind {
    background: transparent;
    color: #000;
    border: 1.5px solid rgb(0 0 0 / .3);
  }

  .acc-card__btn--remind:hover {
    border-color: #000;
    opacity: 1;
  }

  /* View all */
  .acc-section__viewall {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  .acc-section__viewall-btn {
    display: inline-flex;
    align-items: center;
    padding: 16px 32px;
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: #000;
    border: 1px solid rgb(0 0 0 / .25);
    border-radius: 999px;
    transition: border-color 0.2s;
  }

  .acc-section__viewall-btn:hover { border-color: #000; }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .acc-track { padding: 0 16px 8px; }
    .acc-card { flex: 0 0 72vw; }
    .acc-arrow { display: none; }
  }

  /* ── Quick-view popup ── */
  .acc-qv {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .acc-qv[hidden] { display: none; }

  .acc-qv__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / .45);
    backdrop-filter: blur(2px);
  }

  .acc-qv__box {
    position: relative;
    background: #fff;
    border-radius: 24px;
    width: min(900px, 100%);
    max-height: 92vh;
    overflow-y: auto;
    padding: 32px;
    box-shadow: 0 24px 80px rgb(0 0 0 / .18);
    animation: accQvIn .22s ease;
  }

  @keyframes accQvIn {
    from { opacity: 0; transform: scale(.96); }
    to   { opacity: 1; transform: scale(1); }
  }

  .acc-qv__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: #e2e2e2;
    color: #000;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    z-index: 1;
    transition: background 0.15s;
  }

  .acc-qv__close:hover { background: #d0d0d0; }

  .acc-qv__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: start;
  }

  /* Gallery */
  .acc-qv__gallery {
    position: relative;
    border: 1px solid rgb(0 0 0 / .1);
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1;
    background: #fff;
  }

  .acc-qv__gallery-track {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .acc-qv__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.28s ease;
    pointer-events: none;
  }

  .acc-qv__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .acc-qv__slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6%;
    display: block;
  }

  .acc-qv__gprev,
  .acc-qv__gnext {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgb(0 0 0 / .1);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
    display: grid;
    place-items: center;
    box-shadow: 0 2px 8px rgb(0 0 0 / .08);
    transition: background 0.15s;
  }

  .acc-qv__gprev:hover,
  .acc-qv__gnext:hover { background: #fff; }

  .acc-qv__gprev { left: 10px; }
  .acc-qv__gnext { right: 10px; }

  .acc-qv__gprev[hidden],
  .acc-qv__gnext[hidden] { display: none; }

  .acc-qv__dots {
    position: absolute;
    bottom: 12px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 0;
    margin: 0;
  }

  .acc-qv__dots[hidden] { display: none; }

  .acc-qv__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(0 0 0 / .2);
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .acc-qv__dot.is-active { background: #000; }

  /* Body */
  .acc-qv__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-right: 8px;
  }

  .acc-qv__compat {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(0 0 0 / .45);
    margin: 0;
  }

  .acc-qv__compat[hidden] { display: none; }

  .acc-qv__title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0;
    color: #000;
  }

  .acc-qv__shortdesc {
    font-size: 15px;
    line-height: 1.55;
    color: #000;
    margin: 0;
  }

  .acc-qv__shortdesc * { font-size: 15px; color: inherit; }
  .acc-qv__shortdesc a { color: #000; text-decoration: none; }
  .acc-qv__shortdesc p { margin: 0; }
  .acc-qv__shortdesc h3 { font-size: 15px; font-weight: 700; margin: 16px 0 2px; }
  .acc-qv__shortdesc[hidden] { display: none; }

  .acc-qv__headline {
    font-size: 15px;
    line-height: 1.65;
    color: #000;
  }

  .acc-qv__headline * { font-size: 15px; color: inherit; }
  .acc-qv__headline a { color: #000; text-decoration: none; }
  .acc-qv__headline p { margin: 0 0 8px; }
  .acc-qv__headline p:last-child { margin-bottom: 0; }
  .acc-qv__headline[hidden] { display: none; }

  .acc-qv__foot {
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .acc-qv__price-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .acc-qv__price {
    font-family: var(--font-accent);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .acc-qv__form { margin: 0; }

  .acc-qv__atc {
    width: 100%;
    background: #000;
    color: #fff;
    border: 0;
    border-radius: 999px;
    padding: 14px 20px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .acc-qv__atc:hover:not(:disabled) { opacity: 0.8; }

  .acc-qv__atc--oos {
    background: #888;
    cursor: default;
  }

  .acc-qv__remind {
    font-size: 13px;
    font-weight: 500;
    color: #000;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-align: left;
  }

  .acc-qv__remind[hidden] { display: none; }

  .acc-qv__details {
    font-size: 14px;
    font-weight: 500;
    color: #000;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-align: left;
  }

  @media screen and (max-width: 749px) {
    .acc-qv__box { padding: 20px 16px; }
    .acc-qv__inner { grid-template-columns: 1fr; gap: 20px; }
    .acc-qv__title { font-size: 22px; }
    .acc-qv__gallery { max-height: 72vw; }
  }

  /* Toast uses global .atc-toast from base.css */
{% endstylesheet %}

{% javascript %}
  (function () {

    // ── Toast ──
    function showToast(msg) {
      let toast = document.getElementById('acc-cart-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'acc-cart-toast';
        toast.className = 'atc-toast';
        toast.setAttribute('aria-live', 'polite');
        toast.setAttribute('aria-atomic', 'true');
        document.body.appendChild(toast);
      }
      toast.textContent = msg;
      toast.classList.add('is-on');
      clearTimeout(toast._t);
      toast._t = setTimeout(() => toast.classList.remove('is-on'), 2800);
    }

    // ── Add to cart ──
    function handleAddToCart(form, qv, productTitle) {
      const btn = form.querySelector('[type="submit"]');
      const variantId = form.querySelector('input[name="id"]')?.value;
      const originalLabel = btn ? btn.innerHTML : '';
      if (btn) {
        btn.style.width = btn.offsetWidth + 'px';
        btn.innerHTML = '<span class="acc-btn-spinner"></span>';
        btn.disabled = true;
      }
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      })
        .then(r => r.json())
        .then(data => {
          showToast((data.product_title || productTitle) + ' added');
          if (qv) { qv.hidden = true; document.body.style.overflow = ''; }
          document.dispatchEvent(new CustomEvent('cart:updated'));
          fetch('/cart.js').then(r => r.json()).then(cart => {
            if (typeof updateCartItemCounts === 'function') {
              updateCartItemCounts(cart.item_count);
            } else {
              document.querySelectorAll('.cart-count').forEach(el => {
                el.textContent = cart.item_count;
                el.hidden = cart.item_count === 0;
              });
            }
          });
        })
        .catch(() => {})
        .finally(() => {
          if (btn) { btn.style.width = ''; btn.innerHTML = originalLabel; btn.disabled = false; }
        });
    }

    // ── Initialise each carousel instance ──
    function initCarousel(trackEl) {
      const shopifySection = trackEl.closest('.shopify-section');
      const prevBtn = shopifySection && shopifySection.querySelector('.acc-arrow--l');
      const nextBtn = shopifySection && shopifySection.querySelector('.acc-arrow--r');
      const qv      = shopifySection && shopifySection.querySelector('.acc-qv');

      // Arrows
      const cardWidth = () => {
        const card = trackEl.querySelector('.acc-card');
        return card ? card.getBoundingClientRect().width + 20 : 0;
      };
      if (prevBtn) prevBtn.addEventListener('click', () => trackEl.scrollBy({ left: -cardWidth(), behavior: 'smooth' }));
      if (nextBtn) nextBtn.addEventListener('click', () => trackEl.scrollBy({ left: cardWidth(), behavior: 'smooth' }));

      // ── Gallery builder (clears old images first = no stale flash) ──
      function buildGallery(images, defaultAlt) {
        const track   = qv.querySelector('.acc-qv__gallery-track');
        const dotsEl  = qv.querySelector('.acc-qv__dots');
        const gPrev   = qv.querySelector('.acc-qv__gprev');
        const gNext   = qv.querySelector('.acc-qv__gnext');

        // Clear immediately so old image never shows
        track.innerHTML  = '';
        dotsEl.innerHTML = '';

        let current = 0;

        images.forEach((src, i) => {
          const slide = document.createElement('div');
          slide.className = 'acc-qv__slide';
          const img = document.createElement('img');
          img.src = src;
          img.alt = defaultAlt;
          img.width = 600;
          img.height = 600;
          img.loading = i === 0 ? 'eager' : 'lazy';
          slide.appendChild(img);
          track.appendChild(slide);

          if (images.length > 1) {
            const dot = document.createElement('button');
            dot.className = 'acc-qv__dot';
            dot.type = 'button';
            dot.setAttribute('aria-label', 'Image ' + (i + 1) + ' of ' + images.length);
            dot.dataset.idx = i;
            dotsEl.appendChild(dot);
          }
        });

        const allSlides = () => track.querySelectorAll('.acc-qv__slide');
        const allDots   = () => dotsEl.querySelectorAll('.acc-qv__dot');

        function goTo(idx) {
          const slides = allSlides();
          const dots   = allDots();
          if (!slides.length) return;
          slides[current].classList.remove('is-active');
          dots[current]?.classList.remove('is-active');
          current = ((idx % images.length) + images.length) % images.length;
          slides[current].classList.add('is-active');
          dots[current]?.classList.add('is-active');
        }

        goTo(0);

        dotsEl.onclick = (e) => {
          const dot = e.target.closest('.acc-qv__dot');
          if (dot) goTo(parseInt(dot.dataset.idx));
        };

        gPrev.onclick = () => goTo(current - 1);
        gNext.onclick = () => goTo(current + 1);

        const multi = images.length > 1;
        gPrev.hidden = !multi;
        gNext.hidden = !multi;
        dotsEl.hidden = !multi;
      }

      // ── Check if rich-text HTML is empty ──
      function isEmptyHtml(html) {
        if (!html) return true;
        const tmp = document.createElement('div');
        tmp.innerHTML = html;
        return tmp.textContent.trim() === '';
      }

      // ── Populate & open popup ──
      function openQV(card) {
        if (!qv) return;
        const d = card.dataset;

        // Gallery — clear old content before showing popup
        const images = (d.popupImages || '').split(';').filter(Boolean);
        buildGallery(images.length ? images : [''], d.popupImgAlt || d.popupTitle || '');

        // Compatibility With (above title)
        const compatEl = qv.querySelector('.acc-qv__compat');
        if (d.popupCompat) {
          compatEl.textContent = d.popupCompat;
          compatEl.hidden = false;
        } else {
          compatEl.textContent = '';
          compatEl.hidden = true;
        }

        // Title
        qv.querySelector('.acc-qv__title').textContent = d.popupTitle || '';

        // Short Description
        const shortdescEl = qv.querySelector('.acc-qv__shortdesc');
        if (!isEmptyHtml(d.popupShortdesc)) {
          shortdescEl.innerHTML = d.popupShortdesc;
          shortdescEl.hidden = false;
        } else {
          shortdescEl.innerHTML = '';
          shortdescEl.hidden = true;
        }

        // Headline
        const headlineEl = qv.querySelector('.acc-qv__headline');
        if (!isEmptyHtml(d.popupHeadline)) {
          headlineEl.innerHTML = d.popupHeadline;
          headlineEl.hidden = false;
        } else {
          headlineEl.innerHTML = '';
          headlineEl.hidden = true;
        }

        // Price
        qv.querySelector('.acc-qv__price').textContent = d.popupPrice || '';

        // Variant id
        qv.querySelector('.acc-qv__form input[name="id"]').value = d.popupVariant || '';

        // ATC / OOS state
        const atcBtn   = qv.querySelector('.acc-qv__atc');
        const remindEl = qv.querySelector('.acc-qv__remind');
        const available = d.popupAvailable !== 'false';

        if (available) {
          atcBtn.textContent = 'Add to Cart';
          atcBtn.classList.remove('acc-qv__atc--oos');
          atcBtn.disabled = false;
          remindEl.hidden = true;
        } else {
          atcBtn.textContent = 'Out of Stock';
          atcBtn.classList.add('acc-qv__atc--oos');
          atcBtn.disabled = true;
          remindEl.href   = d.popupUrl || '';
          remindEl.hidden = false;
        }

        // View full details
        qv.querySelector('.acc-qv__details').href = d.popupUrl || '';

        // Show
        qv.hidden = false;
        document.body.style.overflow = 'hidden';
        qv.querySelector('.acc-qv__close').focus();
      }

      function closeQV() {
        if (!qv) return;
        qv.hidden = true;
        document.body.style.overflow = '';
      }

      if (qv) {
        qv.querySelector('.acc-qv__backdrop').addEventListener('click', closeQV);
        qv.querySelector('.acc-qv__close').addEventListener('click', closeQV);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !qv.hidden) closeQV(); });

        qv.querySelector('.acc-qv__form').addEventListener('submit', (e) => {
          e.preventDefault();
          const title = qv.querySelector('.acc-qv__title')?.textContent?.trim() || '';
          handleAddToCart(e.target, qv, title);
        });
      }

      // Click on card image or title → open popup
      trackEl.addEventListener('click', (e) => {
        const imgLink   = e.target.closest('.acc-card__img');
        const titleLink = e.target.closest('.acc-card__title a');
        if (!imgLink && !titleLink) return;
        const card = e.target.closest('.acc-card[data-popup-title]');
        if (!card) return;
        e.preventDefault();
        openQV(card);
      });

      // Card add-to-cart form
      trackEl.addEventListener('submit', (e) => {
        const form = e.target.closest('.acc-card__form');
        if (!form) return;
        e.preventDefault();
        const title = form.closest('.acc-card')?.querySelector('.acc-card__title')?.textContent?.trim() || '';
        handleAddToCart(form, qv, title);
      });
    }

    function boot() {
      document.querySelectorAll('.acc-track').forEach(trackEl => {
        if (trackEl.dataset.accInit) return;
        trackEl.dataset.accInit = '1';
        initCarousel(trackEl);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

  })();
{% endjavascript %}

