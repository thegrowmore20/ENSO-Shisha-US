{%- liquid
  assign coll = section.settings.collection
  assign heading = section.settings.heading
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link | default: coll.url | default: '/collections/all'
  assign limit = section.settings.products_limit
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="acc-section" aria-label="{{ heading | escape }}">
  {%- if heading != blank -%}
    <div class="container">
      <div class="acc-section__head">
        <h2 class="acc-section__heading">{{ heading }}</h2>
      </div>
    </div>
  {%- endif -%}

  <div class="acc-wrap">
    <button class="acc-arrow acc-arrow--l" type="button" id="AccArrowPrev-{{ section.id }}" aria-label="{{ 'accessibility.previous_slide' | t }}">&#8249;</button>

    <div class="acc-track" id="AccTrack-{{ section.id }}" role="region" aria-label="{{ heading | escape }}">
      {%- if coll != blank -%}
        {%- for product in coll.products limit: limit -%}
          {%- unless product.title contains 'Shipping Protection' -%}
            {%- render 'card-accessory', product: product -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- elsif request.design_mode -%}
        {%- for i in (1..4) -%}
          <article class="acc-card acc-card--placeholder">
            <div class="acc-card__img">{{ 'product-' | append: i | placeholder_svg_tag: 'acc-card__placeholder' }}</div>
            <h3 class="acc-card__title">Accessory {{ i }}</h3>
            <p class="acc-card__desc">Product description goes here.</p>
            <div class="acc-card__foot">
              <div class="acc-card__price"><b>€0.00</b></div>
              <span class="acc-card__btn">Add to cart</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <button class="acc-arrow acc-arrow--r" type="button" id="AccArrowNext-{{ section.id }}" aria-label="{{ 'accessibility.next_slide' | t }}">&#8250;</button>
  </div>

  {%- if cta_label != blank -%}
    <div class="container">
      <div class="acc-section__viewall">
        <a class="acc-section__viewall-btn" href="{{ cta_link }}">{{ cta_label }}</a>
      </div>
    </div>
  {%- endif -%}
</section>

<div class="acc-qv" id="AccQuickView-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t | default: 'Quick view' }}" hidden>
  <div class="acc-qv__backdrop"></div>
  <div class="acc-qv__box">
    <button class="acc-qv__close" aria-label="{{ 'accessibility.close' | t | default: 'Close' }}">&#215;</button>
    <div class="acc-qv__inner">
      <div class="acc-qv__media">
        <img class="acc-qv__img" src="" alt="" width="600" height="600" loading="lazy">
      </div>
      <div class="acc-qv__body">
        <p class="acc-qv__fits"></p>
        <h3 class="acc-qv__title"></h3>
        <div class="acc-qv__desc"></div>
        <div class="acc-qv__foot">
          <div class="acc-qv__price-row">
            <span class="acc-qv__price"></span>
            <form class="acc-qv__form" action="/cart/add" method="post">
              <input type="hidden" name="id" value="">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="acc-qv__atc">{{ 'products.product.add_to_cart' | t }}</button>
            </form>
          </div>
          <a class="acc-qv__details" href="">{{ 'products.product.view_full_details' | t | default: 'View full details' }} ›</a>
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .acc-section__head {
    text-align: center;
    margin-bottom: 32px;
  }

  .acc-section__heading {
    font-size: 32px;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .acc-section__heading { font-size: 40px; }
  }

  /* Carousel wrap — relative so arrows can position against it */
  .acc-wrap {
    position: relative;
    max-width: 1600px;
    margin: 0 auto;
    padding-top: 8px;
  }

  /* Arrow buttons */
  .acc-arrow {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: rgb(0 0 0 / .75);
    color: #fff;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
    display: grid;
    place-items: center;
    transition: background 0.2s;
  }

  .acc-arrow:hover { background: #000; }
  .acc-arrow--l { left: calc(50% - 640px - 24px); }
  .acc-arrow--r { right: calc(50% - 640px - 24px); }

  /* Scrollable track */
  .acc-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 0 0 8px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .acc-track::-webkit-scrollbar { display: none; }

  /* Cards */
  .acc-card {
    flex: 0 0 calc((100% - 60px) / 4);
    scroll-snap-align: start;
    border: 1px solid var(--color-border, rgb(0 0 0 / .12));
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: box-shadow 0.3s;
    min-width: 0;
  }

  .acc-card:hover { box-shadow: 0 12px 40px rgb(0 0 0 / .08); }

  /* Image block */
  .acc-card__img {
    position: relative;
    aspect-ratio: 1;
    border-radius: 12px;
    border: 1px solid var(--color-border, rgb(0 0 0 / .1));
    margin-bottom: 14px;
    background: #fff;
    overflow: hidden;
    display: block;
    text-decoration: none;
  }

  .acc-card__img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6%;
    transition: opacity 0.45s, transform 0.9s cubic-bezier(.2,.8,.2,1);
  }

  .acc-card__img img + img { opacity: 0; padding: 0; object-fit: cover; }
  .acc-card:hover .acc-card__img img + img { opacity: 1; }
  .acc-card:hover .acc-card__img img:first-child:last-child { transform: scale(1.04); }

  .acc-card__placeholder { width: 100%; height: 100%; opacity: 0.3; }

  /* Text */
  .acc-card__title {
    font-size: 16px;
    line-height: 22px;
    font-weight: var(--font-weight-semibold);
    margin: 0;
  }

  .acc-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .acc-card__title a:hover { text-decoration: underline; }

  .acc-card__desc {
    font-size: 13px;
    color: var(--color-text-muted, rgb(0 0 0 / .55));
    line-height: 19px;
    margin: 0;
  }

  /* Price + CTA row */
  .acc-card__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 6px;
  }

  .acc-card__price {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .acc-card__price b {
    font-family: var(--font-accent);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .acc-card__oos {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted, rgb(0 0 0 / .5));
  }

  /* CTA buttons */
  /* Loading spinner inside the button */
  .acc-btn-spinner {
    display: block;
    width: 15px;
    height: 15px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #fff;
    border-radius: 50%;
    animation: accSpin 0.65s linear infinite;
    flex-shrink: 0;
  }

  @keyframes accSpin {
    to { transform: rotate(360deg); }
  }

  .acc-card__form { margin: 0; }

  .acc-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #000;
    color: #fff;
    border: 0;
    border-radius: 999px;
    padding: 10px 18px;
    font-size: 12px;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .acc-card__btn:hover { opacity: 0.8; }

  .acc-card__btn--remind {
    background: transparent;
    color: #000;
    border: 1.5px solid rgb(0 0 0 / .3);
  }

  .acc-card__btn--remind:hover {
    border-color: #000;
    opacity: 1;
  }

  /* View all */
  .acc-section__viewall {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  .acc-section__viewall-btn {
    display: inline-flex;
    align-items: center;
    padding: 16px 32px;
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: #000;
    border: 1px solid rgb(0 0 0 / .25);
    border-radius: 999px;
    transition: border-color 0.2s;
  }

  .acc-section__viewall-btn:hover { border-color: #000; }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .acc-track { padding: 0 16px 8px; }
    .acc-card { flex: 0 0 72vw; }
    .acc-arrow { display: none; }
  }

  /* ── Quick-view popup ── */
  .acc-qv {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .acc-qv[hidden] { display: none; }

  .acc-qv__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / .45);
    backdrop-filter: blur(2px);
  }

  .acc-qv__box {
    position: relative;
    background: #fff;
    border-radius: 24px;
    width: min(860px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    padding: 32px;
    box-shadow: 0 24px 80px rgb(0 0 0 / .18);
    animation: accQvIn .22s ease;
  }

  @keyframes accQvIn {
    from { opacity: 0; transform: scale(.96); }
    to   { opacity: 1; transform: scale(1); }
  }

  .acc-qv__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgb(0 0 0 / .15);
    background: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    z-index: 1;
    transition: background 0.15s;
  }

  .acc-qv__close:hover { background: #f5f5f5; }

  .acc-qv__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  .acc-qv__media {
    border: 1px solid rgb(0 0 0 / .1);
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .acc-qv__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6%;
    display: block;
  }

  .acc-qv__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-right: 8px;
  }

  .acc-qv__fits {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(0 0 0 / .45);
    margin: 0;
  }

  .acc-qv__title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .acc-qv__desc {
    font-size: 14px;
    line-height: 1.65;
    color: rgb(0 0 0 / .7);
  }

  .acc-qv__desc p { margin: 0 0 8px; }
  .acc-qv__desc strong, .acc-qv__desc b { color: #000; font-weight: 700; display: block; margin-top: 12px; }

  .acc-qv__foot {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .acc-qv__price-row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 16px;
    border: 1px solid rgb(0 0 0 / .12);
    border-radius: 14px;
    padding: 16px 20px;
  }

  .acc-qv__price {
    font-family: var(--font-accent);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .acc-qv__form { margin: 0; }

  .acc-qv__atc {
    width: 100%;
    background: #000;
    color: #fff;
    border: 0;
    border-radius: 999px;
    padding: 14px 20px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .acc-qv__atc:hover { opacity: 0.8; }

  .acc-qv__details {
    font-size: 14px;
    font-weight: 500;
    color: #000;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .acc-qv__box { padding: 20px; }
    .acc-qv__inner { grid-template-columns: 1fr; gap: 20px; }
    .acc-qv__title { font-size: 22px; }
  }

  /* ── Centered add-to-cart toast ── */
  .acc-cart-toast {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.92);
    background: #000;
    color: #fff;
    padding: 16px 28px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .acc-cart-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
{% endstylesheet %}

{% javascript %}
  (function () {

    // ── Toast ──
    function showToast(msg) {
      let toast = document.getElementById('acc-cart-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'acc-cart-toast';
        toast.className = 'acc-cart-toast';
        document.body.appendChild(toast);
      }
      toast.textContent = msg;
      toast.classList.add('is-visible');
      clearTimeout(toast._t);
      toast._t = setTimeout(() => toast.classList.remove('is-visible'), 2800);
    }

    // ── Add to cart ──
    function handleAddToCart(form, qv, productTitle) {
      const btn = form.querySelector('[type="submit"]');
      const variantId = form.querySelector('input[name="id"]')?.value;
      const originalLabel = btn ? btn.innerHTML : '';
      if (btn) {
        btn.style.width = btn.offsetWidth + 'px';
        btn.innerHTML = '<span class="acc-btn-spinner"></span>';
        btn.disabled = true;
      }
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      })
        .then(r => r.json())
        .then(data => {
          showToast((data.product_title || productTitle) + ' added');
          if (qv) { qv.hidden = true; document.body.style.overflow = ''; }
          document.dispatchEvent(new CustomEvent('cart:updated'));
          fetch('/cart.js').then(r => r.json()).then(cart => {
            if (typeof updateCartItemCounts === 'function') {
              updateCartItemCounts(cart.item_count);
            } else {
              document.querySelectorAll('.cart-count').forEach(el => {
                el.textContent = cart.item_count;
                el.hidden = cart.item_count === 0;
              });
            }
          });
        })
        .catch(() => {})
        .finally(() => {
          if (btn) { btn.style.width = ''; btn.innerHTML = originalLabel; btn.disabled = false; }
        });
    }

    // ── Initialise each carousel instance ──
    function initCarousel(trackEl) {
      const shopifySection = trackEl.closest('.shopify-section');
      const prevBtn = shopifySection && shopifySection.querySelector('.acc-arrow--l');
      const nextBtn = shopifySection && shopifySection.querySelector('.acc-arrow--r');
      const qv      = shopifySection && shopifySection.querySelector('.acc-qv');

      // Arrows
      const cardWidth = () => {
        const card = trackEl.querySelector('.acc-card');
        return card ? card.getBoundingClientRect().width + 20 : 0;
      };
      if (prevBtn) prevBtn.addEventListener('click', () => trackEl.scrollBy({ left: -cardWidth(), behavior: 'smooth' }));
      if (nextBtn) nextBtn.addEventListener('click', () => trackEl.scrollBy({ left: cardWidth(), behavior: 'smooth' }));

      // Quick-view open/close
      function openQV(card) {
        if (!qv) return;
        const d = card.dataset;
        qv.querySelector('.acc-qv__img').src   = d.popupImg || '';
        qv.querySelector('.acc-qv__img').alt   = d.popupImgAlt || '';
        const fits = qv.querySelector('.acc-qv__fits');
        fits.textContent = d.popupFits || '';
        fits.hidden = !d.popupFits;
        qv.querySelector('.acc-qv__title').textContent = d.popupTitle || '';
        qv.querySelector('.acc-qv__desc').innerHTML    = d.popupDesc  || '';
        qv.querySelector('.acc-qv__price').textContent = d.popupPrice || '';
        qv.querySelector('.acc-qv__form input[name="id"]').value = d.popupVariant || '';
        qv.querySelector('.acc-qv__details').href = d.popupUrl || '';
        const atcBtn = qv.querySelector('.acc-qv__atc');
        const available = d.popupAvailable !== 'false';
        atcBtn.disabled = !available;
        qv.hidden = false;
        document.body.style.overflow = 'hidden';
        qv.querySelector('.acc-qv__close').focus();
      }

      function closeQV() {
        if (!qv) return;
        qv.hidden = true;
        document.body.style.overflow = '';
      }

      if (qv) {
        qv.querySelector('.acc-qv__backdrop').addEventListener('click', closeQV);
        qv.querySelector('.acc-qv__close').addEventListener('click', closeQV);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !qv.hidden) closeQV(); });

        qv.querySelector('.acc-qv__form').addEventListener('submit', (e) => {
          e.preventDefault();
          const title = qv.querySelector('.acc-qv__title')?.textContent?.trim() || '';
          handleAddToCart(e.target, qv, title);
        });
      }

      // Click on card image or title → open popup
      trackEl.addEventListener('click', (e) => {
        const imgLink   = e.target.closest('.acc-card__img');
        const titleLink = e.target.closest('.acc-card__title a');
        if (!imgLink && !titleLink) return;
        const card = e.target.closest('.acc-card[data-popup-title]');
        if (!card) return;
        e.preventDefault();
        openQV(card);
      });

      // Click on card Add-to-cart button
      trackEl.addEventListener('submit', (e) => {
        const form = e.target.closest('.acc-card__form');
        if (!form) return;
        e.preventDefault();
        const title = form.closest('.acc-card')?.querySelector('.acc-card__title')?.textContent?.trim() || '';
        handleAddToCart(form, qv, title);
      });
    }

    // Run on every .acc-track present now and after dynamic injection
    function boot() {
      document.querySelectorAll('.acc-track').forEach(trackEl => {
        if (trackEl.dataset.accInit) return;
        trackEl.dataset.accInit = '1';
        initCarousel(trackEl);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.accessories_carousel.name",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.accessories_carousel.settings.collection.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.accessories_carousel.settings.heading.label",
      "default": "Accessories for ENSŌ"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "t:sections.accessories_carousel.settings.products_limit.label",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:sections.accessories_carousel.settings.header_cta.content"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.accessories_carousel.settings.cta_label.label",
      "default": "View all accessories"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.accessories_carousel.settings.cta_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:sections.accessories_carousel.presets.name"
    }
  ]
}
{% endschema %}
