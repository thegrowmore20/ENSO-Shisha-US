{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
<section class="cl-sec">
  <h2>Every few sessions: the shaft</h2>
  <p class="cl-lead">The heating element never clogs. The shaft below it gets a brush and a rinse every few sessions. Always with the battery in.</p>
  <div class="slider tslider slider--grid" style="--n:3">
    <div class="slides">
      <figure class="slide ts">
        <figcaption class="ts__tx">
          <span class="st__n">1</span>
          <b>Battery in, latch closed</b>
          <p>Keep the battery bay closed and the battery in before any water touches the shaft.</p>
        </figcaption>
        <div class="ts__pic ts__pic--img">
          {%- if section.settings.img_step1 != blank -%}
            {{- section.settings.img_step1 | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.img_step1.alt | default: 'Battery in, latch closed', width: section.settings.img_step1.width, height: section.settings.img_step1.height -}}
          {%- else -%}
            <svg class="cl-placeholder" viewBox="0 0 4 5" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="4" height="5" fill="#f5f5f4"/><path d="M1.2 2.5a.6.6 0 1 1 1.2 0 .6.6 0 0 1-1.2 0zm-.6 1.3.8-1 .7.7.7-.9 1.2 1.2H.6z" fill="#c8b89a"/></svg>
          {%- endif -%}
        </div>
      </figure>
      <figure class="slide ts">
        <figcaption class="ts__tx">
          <span class="st__n">2</span>
          <b>Brush the shaft</b>
          <p>Use a small brush to loosen residue from the shaft walls.</p>
        </figcaption>
        <div class="ts__pic ts__pic--img">
          {%- if section.settings.img_step2 != blank -%}
            {{- section.settings.img_step2 | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.img_step2.alt | default: 'Brush the shaft', width: section.settings.img_step2.width, height: section.settings.img_step2.height -}}
          {%- else -%}
            <svg class="cl-placeholder" viewBox="0 0 4 5" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="4" height="5" fill="#f5f5f4"/><path d="M1.2 2.5a.6.6 0 1 1 1.2 0 .6.6 0 0 1-1.2 0zm-.6 1.3.8-1 .7.7.7-.9 1.2 1.2H.6z" fill="#c8b89a"/></svg>
          {%- endif -%}
        </div>
      </figure>
      <figure class="slide ts">
        <figcaption class="ts__tx">
          <span class="st__n">3</span>
          <b>Rinse from the top</b>
          <p>Hold the device upright and run water through the top. Shake dry, leave open to air out.</p>
        </figcaption>
        <div class="ts__pic ts__pic--img">
          {%- if section.settings.img_step3 != blank -%}
            {{- section.settings.img_step3 | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.img_step3.alt | default: 'Rinse the shaft from the top', width: section.settings.img_step3.width, height: section.settings.img_step3.height -}}
          {%- else -%}
            <svg class="cl-placeholder" viewBox="0 0 4 5" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="4" height="5" fill="#f5f5f4"/><path d="M1.2 2.5a.6.6 0 1 1 1.2 0 .6.6 0 0 1-1.2 0zm-.6 1.3.8-1 .7.7.7-.9 1.2 1.2H.6z" fill="#c8b89a"/></svg>
          {%- endif -%}
        </div>
      </figure>
    </div>
    <button class="nav prev" aria-label="Previous">‹</button>
    <button class="nav next" aria-label="Next">›</button>
  </div>
</section>

{% schema %}
{
  "name": "CL: The shaft",
  "presets": [{ "name": "CL: The shaft" }],
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "img_step1", "label": "Step 1 — battery in, latch closed" },
    { "type": "image_picker", "id": "img_step2", "label": "Step 2 — brush shaft" },
    { "type": "image_picker", "id": "img_step3", "label": "Step 3 — rinse from top" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top padding (mobile)", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom padding (mobile)", "default": 40 }
  ]
}
{% endschema %}
