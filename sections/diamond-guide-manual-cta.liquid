{% stylesheet %}

.dg-cta__inner {
  padding: 96px 0;
  border-top: 1px solid var(--color-border);
}

.dg-cta__head {
  max-width: 62ch;
  margin-bottom: 28px;
}

.dg-cta__head .eyebrow {
  margin: 0 0 10px;
  font-size: 13px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.dg-cta__head h2 {
  font-family: var(--font-accent);
  font-weight: 800;
  font-size: 44px;
  line-height: 50px;
  letter-spacing: -.025em;
  margin: 0 0 16px;
  text-wrap: balance;
}

.dg-cta__head p {
  font-size: 15px;
  color: rgb(0 0 0 / .72);
  margin: 0;
  line-height: 1.6;
}

@media screen and (max-width: 989px) {
  .dg-cta { padding: 64px 0; }
  .dg-cta__head h2 {
    font-size: 30px;
    line-height: 36px;
  }
}

{% endstylesheet %}

{% style %}
  #shopify-section-{{ section.id }} .dg-cta__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .dg-cta__inner {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section class="dg-cta" id="{{ section.settings.section_id | default: section.id }}">
  <div class="container">
    <div class="dg-cta__inner">
    <div class="dg-cta__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.body != blank -%}
        <p>{{ section.settings.body | escape }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.cta_url != blank -%}
      <a class="btn btn--primary" href="{{ section.settings.cta_url }}">
        {{ section.settings.cta_label | default: 'Read the full manual' | escape }}
      </a>
    {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.diamond_guide_manual_cta.name",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "t:sections.diamond_guide_manual_cta.settings.section_id.label",
      "info": "t:sections.diamond_guide_manual_cta.settings.section_id.info"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.diamond_guide_manual_cta.settings.eyebrow.label",
      "default": "Full manual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_guide_manual_cta.settings.heading.label",
      "default": "Every function, one chapter at a time"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:sections.diamond_guide_manual_cta.settings.body.label",
      "default": "The dial and the screen, pre-heat and profiles, battery, cup, cap, cleaning, safety and warranty."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:sections.diamond_guide_manual_cta.settings.cta_url.label"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.diamond_guide_manual_cta.settings.cta_label.label",
      "default": "Read the full manual"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding.padding_top_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.diamond_guide_manual_cta.presets.name"
    }
  ]
}
{% endschema %}
