{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
<div class="pk-sec">
  <h2>Pack it</h2>
  <div class="slider tslider slider--grid" style="--n:4">
    <div class="slides">
      <figure class="slide ts">
        <figcaption class="ts__tx">
          <span class="st__n">1</span>
          <b>Mix the tobacco</b>
          <p>Stir it in the tin first: the juice settles at the bottom.</p>
        </figcaption>
        <div class="ts__pic ts__pic--img">
          {%- if section.settings.pack_layer1 != blank -%}
            {{- section.settings.pack_layer1 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.pack_layer1.alt | default: '', width: section.settings.pack_layer1.width, height: section.settings.pack_layer1.height -}}
          {%- else -%}
            <img src="{{ 'dm-s-pack-layer1.jpg' | file_url }}" alt="" loading="lazy">
          {%- endif -%}
        </div>
      </figure>
      <figure class="slide ts">
        <figcaption class="ts__tx">
          <span class="st__n">2</span>
          <b>First layer, pressed a little</b>
          <p>Lay in about half of the 10–15 g and press it lightly.</p>
        </figcaption>
        <div class="ts__pic ts__pic--img">
          {%- if section.settings.pack_press != blank -%}
            {{- section.settings.pack_press | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.pack_press.alt | default: '', width: section.settings.pack_press.width, height: section.settings.pack_press.height -}}
          {%- else -%}
            <img src="{{ 'dm-s-pack-press.jpg' | file_url }}" alt="" loading="lazy">
          {%- endif -%}
        </div>
      </figure>
      <figure class="slide ts">
        <figcaption class="ts__tx">
          <span class="st__n">3</span>
          <b>Second layer to the edge</b>
          <p>The rest on top, pressed lightly again. To the edge of the basket.</p>
        </figcaption>
        <div class="ts__pic ts__pic--img">
          <picture><source media="(max-width:749px)" srcset="{{ 'pack-level-basket-m.webp' | file_url }}"><img src="{{ 'pack-level-basket.webp' | file_url }}" alt="Basket mesh filled to the edge of the basket" loading="lazy"></picture>
        </div>
      </figure>
      <figure class="slide ts">
        <figcaption class="ts__tx">
          <span class="st__n">4</span>
          <b>Flat screen: to the curve</b>
          <p>With the flat screen, fill to the curve of the cup instead, pressed lightly.</p>
        </figcaption>
        <div class="ts__pic ts__pic--img">
          <picture><source media="(max-width:749px)" srcset="{{ 'pack-level-m.webp' | file_url }}"><img src="{{ 'pack-level.webp' | file_url }}" alt="Flat screen cup filled to the curve of the cup" loading="lazy"></picture>
        </div>
      </figure>
    </div>
    <button class="nav prev" aria-label="Previous">‹</button>
    <button class="nav next" aria-label="Next">›</button>
  </div>
  <p class="pk-note"><b>One flavor?</b> One layer, semi-dense, to the curve with the flat screen or to the edge of the basket.</p>
</div>

{% schema %}
{
  "name": "PK: Pack it",
  "presets": [{ "name": "PK: Pack it" }],
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "pack_layer1", "label": "Step 1 photo (mix tobacco)" },
    { "type": "image_picker", "id": "pack_press", "label": "Step 2 photo (first layer)" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top padding (mobile)", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom padding (mobile)", "default": 40 }
  ]
}
{% endschema %}
