{% stylesheet %}
.d-heat {
  padding-top: var(--d-heat-pt, 80px);
  padding-bottom: var(--d-heat-pb, 80px);
}

.d-heat__inner {
  max-width: var(--page-width);
  margin-inline: auto;
  padding-inline: var(--page-margin);
}

.d-heat__grid {
  display: grid;
  grid-template-columns: 1fr 0.9fr;
  gap: 64px;
  align-items: center;
}

.d-heat__copy {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.d-heat__eyebrow {
  font-family: var(--font-subheading);
  font-size: 12px;
  font-weight: var(--font-weight-semibold);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.d-heat__heading {
  margin: 0;
  font-size: var(--font-size-h2);
  font-weight: var(--font-weight-bold);
  line-height: 1.1;
}

.d-heat__body {
  font-size: var(--font-size-body);
  line-height: 1.6;
  color: var(--color-text-muted);
  max-width: 480px;
}

.d-heat__media {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  background: #1a1410;
  aspect-ratio: 4 / 5;
  max-height: 680px;
}

.d-heat__media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50% 34%;
  display: block;
}

.d-heat__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

@media screen and (max-width: 749px) {
  .d-heat {
    padding-top: var(--d-heat-pt-m, 40px);
    padding-bottom: var(--d-heat-pb-m, 40px);
  }

  .d-heat__grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .d-heat__media {
    order: -1;
    max-height: 420px;
  }
}
{% endstylesheet %}

{%- liquid
  assign pt    = section.settings.padding_top    | default: 80
  assign pb    = section.settings.padding_bottom | default: 80
  assign pt_m  = section.settings.padding_top_mobile    | default: 40
  assign pb_m  = section.settings.padding_bottom_mobile | default: 40
  assign vid   = section.settings.video
  assign poster = section.settings.poster
  if poster == blank and vid != blank
    assign poster = vid.preview_image
  endif
-%}

<section
  class="d-heat"
  id="SectionDiamondHeat{{ section.id }}"
  style="--d-heat-pt:{{ pt }}px;--d-heat-pb:{{ pb }}px;--d-heat-pt-m:{{ pt_m }}px;--d-heat-pb-m:{{ pb_m }}px;"
>
  <div class="d-heat__inner">
    <div class="d-heat__grid">

      <div class="d-heat__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="d-heat__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="d-heat__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="d-heat__body">{{ section.settings.body | escape }}</p>
        {%- endif -%}
      </div>

      <div class="d-heat__media">
        {%- if vid != blank -%}
          <video
            muted
            loop
            playsinline
            preload="metadata"
            {%- if poster != blank -%}
              poster="{{ poster | image_url: width: 1200 }}"
            {%- endif -%}
          >
            {%- for source in vid.sources -%}
              {%- if source.format == 'mp4' -%}
                <source src="{{ source.url }}" type="video/mp4">
              {%- endif -%}
            {%- endfor -%}
          </video>
        {%- else -%}
          <div class="d-heat__placeholder" aria-hidden="true">
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="28" cy="28" r="23" stroke="#c8b89a" stroke-width="1.5"/>
              <polygon points="23,19 39,28 23,37" fill="#c8b89a"/>
            </svg>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<script>
(function () {
  var section = document.getElementById('SectionDiamondHeat{{ section.id }}');
  if (!section) return;
  var video = section.querySelector('video');
  if (!video) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  new IntersectionObserver(function (entries) {
    for (var i = 0; i < entries.length; i++) {
      entries[i].isIntersecting ? video.play().catch(function(){}) : video.pause();
    }
  }, { threshold: 0.35 }).observe(section);
})();
</script>

{% schema %}
{
  "name": "t:sections.diamond_heat.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.diamond_heat.settings.eyebrow.label",
      "default": "How the heat works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_heat.settings.heading.label",
      "default": "Heat from every side"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:sections.diamond_heat.settings.body.label",
      "default": "The element sits under the cup and around its wall, so the tobacco warms from below and from the sides at once. The plate in the cap closes the chamber from above and keeps the heat on the load, the way a lid keeps it in a classic bowl."
    },
    {
      "type": "header",
      "content": "t:sections.diamond_heat.settings.media_header.content"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.diamond_heat.settings.video.label"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "t:sections.diamond_heat.settings.poster.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top_mobile",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mobile",
      "default": 40
    }
  ],
  "presets": [
    { "name": "t:sections.diamond_heat.presets.name" }
  ]
}
{% endschema %}
