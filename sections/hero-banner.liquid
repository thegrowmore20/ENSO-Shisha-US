{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme

  assign has_image = false
  if section.settings.image != blank or section.settings.image_mobile != blank
    assign has_image = true
  endif

  assign heading_style = ''
  if section.settings.heading_color != blank
    assign heading_style = 'color: ' | append: section.settings.heading_color | append: ';'
  endif
-%}

<section
  class="banner {{ scheme_class }} banner--width-{{ section.settings.width }} {% if section.settings.width == 'page' %}container{% endif %} banner--height-{{ section.settings.height }} banner--align-{{ section.settings.content_alignment }}"
  style="
    --banner-margin-top: {{ section.settings.margin_top }}px;
    --banner-margin-bottom: {{ section.settings.margin_bottom }}px;
    --banner-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --banner-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --banner-overlay-color: {{ section.settings.overlay_color }};
    --banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  <div class="banner__inner">
    <div class="banner__media">
      {%- if section.settings.image_mobile != blank -%}
        <img
          class="banner__image banner__image--mobile"
          src="{{ section.settings.image_mobile | image_url: width: 800 }}"
          alt="{{ section.settings.image_mobile.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image_mobile.width }}"
          height="{{ section.settings.image_mobile.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}

      {%- if section.settings.image != blank -%}
        <img
          class="banner__image banner__image--desktop"
          src="{{ section.settings.image | image_url: width: 1600 }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- elsif section.settings.image_mobile == blank -%}
        <div class="banner__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'banner__placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- if has_image and section.settings.overlay_opacity > 0 -%}
        <div class="banner__overlay"></div>
      {%- endif -%}
    </div>

    {%- if section.settings.heading != blank -%}
      <div class="banner__content container">
        {% if section.settings.heading != blank %}
          <h1 class="banner__heading"{% if heading_style != blank %} style="{{ heading_style }}"{% endif %}>
            {{ section.settings.heading }}
          </h1>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="banner__subheading"{% if heading_style != blank %} style="{{ heading_style }}"{% endif %}>
            {{ section.settings.subheading }}
          </div>
        {% endif %}
        {% if section.settings.button != blank %}
          <a class="btn btn--primary" href="{{ section.settings.button_url }}">
            {{ section.settings.button }}
          </a>
        {% endif %}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .banner {
    position: relative;
    margin-top: var(--banner-margin-top);
    margin-bottom: var(--banner-margin-bottom);
  }

  .banner__inner {
    position: relative;
    width: 100%;
  }

  .banner--width-page .banner__inner {
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .banner__media {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .banner--width-page .banner__media {
    border-radius: 12px;
  }

  .banner__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .banner__image--mobile {
    display: none;
  }

  @media screen and (max-width: 767px) {
    .banner__image--mobile {
      display: block;
    }

    .banner__image--mobile ~ .banner__image--desktop {
      display: none;
    }
  }

  /* Fixed height variants: image and placeholder fill the box */
  .banner--height-small .banner__media,
  .banner--height-small .banner__placeholder {
    min-height: 260px;
  }
  .banner--height-medium .banner__media,
  .banner--height-medium .banner__placeholder {
    min-height: 380px;
  }
  .banner--height-large .banner__media,
  .banner--height-large .banner__placeholder {
    min-height: 520px;
  }
  .banner--height-auto .banner__placeholder {
    min-height: 320px;
  }

  @media screen and (min-width: 768px) {
    .banner--height-small .banner__media,
    .banner--height-small .banner__placeholder {
      min-height: 360px;
    }
    .banner--height-medium .banner__media,
    .banner--height-medium .banner__placeholder {
      min-height: 520px;
    }
    .banner--height-large .banner__media,
    .banner--height-large .banner__placeholder {
      min-height: 720px;
    }
    .banner--height-auto .banner__placeholder {
      min-height: 420px;
    }
  }

  .banner--height-small .banner__image,
  .banner--height-medium .banner__image,
  .banner--height-large .banner__image {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .banner__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: rgba(0, 0, 0, 0.05);
  }

  .banner__placeholder-svg {
    width: 40%;
    height: auto;
    opacity: 0.4;
  }

  .banner__overlay {
    position: absolute;
    inset: 0;
    background: var(--banner-overlay-color);
    opacity: var(--banner-overlay-opacity);
    pointer-events: none;
  }

  .banner__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--page-margin-mobile);
  }

  .banner--align-center .banner__content {
    align-items: center;
    text-align: center;
  }

  .banner--align-left .banner__content {
    align-items: flex-start;
    text-align: left;
  }

  .banner__heading {
    margin: 0;
    max-width: 20ch;
    font-size: var(--banner-heading-size-mobile);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  @media screen and (min-width: 768px) {
    .banner__heading {
      font-size: var(--banner-heading-size-desktop);
    }
    .banner__content {
        padding: var(--page-margin);    
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-paper"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (below 768px)",
      "info": "Optional. If empty, the desktop image is used on mobile too."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Add a heading"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "id": "subheading",
      "type": "richtext",
      "label": "Text"
    },
    {
      "id": "button",
      "type": "text",
      "label": "Button"
    },
    {
      "id": "button_url",
      "type": "url",
      "label": "Url"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "page", "label": "Page width" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "options": [
        { "value": "auto", "label": "Auto (based on image)" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
