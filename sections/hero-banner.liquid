{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text

  assign has_image = false
  if section.settings.image != blank or section.settings.image_mobile != blank or section.settings.image_file != blank
    assign has_image = true
  endif

  assign heading_style = ''
  if section.settings.heading_color != blank
    assign heading_style = 'color: ' | append: section.settings.heading_color | append: ';'
  endif

  assign content_width_desktop_css = 'none'
  if section.settings.content_width_desktop > 0
    assign content_width_desktop_css = section.settings.content_width_desktop | append: 'px'
  endif

  assign content_width_tablet_css = 'none'
  if section.settings.content_width_tablet > 0
    assign content_width_tablet_css = section.settings.content_width_tablet | append: 'px'
  endif

  assign content_width_mobile_css = 'none'
  if section.settings.content_width_mobile > 0
    assign content_width_mobile_css = section.settings.content_width_mobile | append: 'px'
  endif

  assign height_desktop_custom_css = section.settings.height_desktop_custom | append: 'px'
  assign height_tablet_custom_css = section.settings.height_tablet_custom | append: 'px'
  assign height_mobile_custom_css = section.settings.height_mobile_custom | append: 'px'

  assign v_justify = 'center'
  if section.settings.content_vertical_alignment == 'top'
    assign v_justify = 'flex-start'
  elsif section.settings.content_vertical_alignment == 'bottom'
    assign v_justify = 'flex-end'
  endif

  assign mobile_img_x = section.settings.image_mobile_x | default: 50
-%}

{% style %}
  #shopify-section-{{ section.id }} .banner__content {
    justify-content: {{ v_justify }};
  }

  {%- if section.settings.use_gradient -%}
    #shopify-section-{{ section.id }} .banner__overlay {
      background: linear-gradient({{ section.settings.gradient_direction }}deg, rgb(0 0 0 / .72) 0%, rgb(0 0 0 / .35) 45%, rgb(0 0 0 / 0) 70%);
      opacity: 1;
    }
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} .banner__overlay {
        background: linear-gradient(0deg, rgb(0 0 0 / .82) 0%, rgb(0 0 0 / .45) 45%, rgb(0 0 0 / 0) 72%);
      }
    }
  {%- endif -%}

  {%- unless mobile_img_x == 50 -%}
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} .banner__image {
        object-position: {{ mobile_img_x }}% 50%;
      }
    }
  {%- endunless -%}
{% endstyle %}

<section
  class="banner {{ scheme_class }} banner--width-{{ section.settings.width }} {% if section.settings.width == 'page' %}container{% endif %} banner--height-mobile-{{ section.settings.height_mobile }} banner--height-tablet-{{ section.settings.height_tablet }} banner--height-desktop-{{ section.settings.height_desktop }} banner--align-{{ section.settings.content_alignment }}"
  style="
    --banner-margin-top: {{ section.settings.margin_top }}px;
    --banner-margin-bottom: {{ section.settings.margin_bottom }}px;
    --banner-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --banner-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --banner-overlay-color: {{ section.settings.overlay_color }};
    --banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --banner-content-width-desktop: {{ content_width_desktop_css }};
    --banner-content-width-tablet: {{ content_width_tablet_css }};
    --banner-content-width-mobile: {{ content_width_mobile_css }};
    --banner-height-desktop-custom: {{ height_desktop_custom_css }};
    --banner-height-tablet-custom: {{ height_tablet_custom_css }};
    --banner-height-mobile-custom: {{ height_mobile_custom_css }};
  "
>
  <div class="banner__inner">
    <div class="banner__media">
      {%- if section.settings.image_mobile != blank -%}
        <img
          class="banner__image banner__image--mobile"
          src="{{ section.settings.image_mobile | image_url: width: 800 }}"
          alt="{{ section.settings.image_mobile.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image_mobile.width }}"
          height="{{ section.settings.image_mobile.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}

      {%- if section.settings.image != blank -%}
        <img
          class="banner__image banner__image--desktop"
          src="{{ section.settings.image | image_url: width: 1600 }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- elsif section.settings.image_file != blank -%}
        <img
          class="banner__image banner__image--desktop"
          src="{{ section.settings.image_file | file_url }}"
          alt="{{ section.settings.heading | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- elsif section.settings.image_mobile == blank -%}
        <div class="banner__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'banner__placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- assign show_overlay = false -%}
      {%- if section.settings.overlay_opacity > 0 or section.settings.use_gradient -%}
        {%- assign show_overlay = true -%}
      {%- endif -%}
      {%- if has_image and show_overlay -%}
        <div class="banner__overlay"></div>
      {%- endif -%}
    </div>

    {%- if section.settings.heading != blank -%}
      <div class="banner__content container">
        <div class="banner__content-inner">
          {% if section.settings.heading != blank %}
            <h2 class="banner__heading"{% if heading_style != blank %} style="{{ heading_style }}"{% endif %}>
              {{ section.settings.heading }}
            </h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <div class="banner__subheading"{% if heading_style != blank %} style="{{ heading_style }}"{% endif %}>
              {{ section.settings.subheading }}
            </div>
          {% endif %}
          {% if section.settings.button != blank %}
            {%- if section.settings.button_style == 'solid' -%}
              <a class="banner__button banner__button--solid" href="{{ section.settings.button_url }}">
                {{ section.settings.button }}
              </a>
            {%- else -%}
              <a class="btn btn--outline banner__button" href="{{ section.settings.button_url }}">
                {{ section.settings.button }}
              </a>
            {%- endif -%}
          {% endif %}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .banner {
    position: relative;
    margin-top: var(--banner-margin-top);
    margin-bottom: var(--banner-margin-bottom);
  }

  .banner__inner {
    position: relative;
    width: 100%;
  }

  .banner--width-page .banner__inner {
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .banner__media {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .banner--width-page .banner__media {
    border-radius: 12px;
  }

  .banner__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .banner__image--mobile {
    display: none;
  }

  @media screen and (max-width: 767px) {
    .banner__image--mobile {
      display: block;
    }

    .banner__image--mobile ~ .banner__image--desktop {
      display: none;
    }
  }

  /* Fixed height variants: image and placeholder fill the box.
     Each viewport tier (mobile / tablet / desktop) carries its own class
     on the section at all times — only the media query below decides
     which tier's rules are actually in effect at a given width. */
  @media screen and (max-width: 749px) {
    .banner--height-mobile-small .banner__media,
    .banner--height-mobile-small .banner__placeholder {
      min-height: 410px;
    }
    .banner--height-mobile-medium .banner__media,
    .banner--height-mobile-medium .banner__placeholder {
      min-height: 550px;
    }
    .banner--height-mobile-large .banner__media,
    .banner--height-mobile-large .banner__placeholder {
      min-height: 640px;
    }
    .banner--height-mobile-auto .banner__placeholder {
      min-height: 320px;
    }
    .banner--height-mobile-custom .banner__media,
    .banner--height-mobile-custom .banner__placeholder {
      min-height: var(--banner-height-mobile-custom);
    }
    .banner--height-mobile-small .banner__image,
    .banner--height-mobile-medium .banner__image,
    .banner--height-mobile-large .banner__image,
    .banner--height-mobile-custom .banner__image {
      position: absolute;
      inset: 0;
      height: 100%;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .banner--height-tablet-small .banner__media,
    .banner--height-tablet-small .banner__placeholder {
      min-height: 410px;
    }
    .banner--height-tablet-medium .banner__media,
    .banner--height-tablet-medium .banner__placeholder {
      min-height: 550px;
    }
    .banner--height-tablet-large .banner__media,
    .banner--height-tablet-large .banner__placeholder {
      min-height: 640px;
    }
    .banner--height-tablet-auto .banner__placeholder {
      min-height: 380px;
    }
    .banner--height-tablet-custom .banner__media,
    .banner--height-tablet-custom .banner__placeholder {
      min-height: var(--banner-height-tablet-custom);
    }
    .banner--height-tablet-small .banner__image,
    .banner--height-tablet-medium .banner__image,
    .banner--height-tablet-large .banner__image,
    .banner--height-tablet-custom .banner__image {
      position: absolute;
      inset: 0;
      height: 100%;
    }
  }

  @media screen and (min-width: 990px) {
    .banner--height-desktop-small .banner__media,
    .banner--height-desktop-small .banner__placeholder {
      min-height: 410px;
    }
    .banner--height-desktop-medium .banner__media,
    .banner--height-desktop-medium .banner__placeholder {
      min-height: 550px;
    }
    .banner--height-desktop-large .banner__media,
    .banner--height-desktop-large .banner__placeholder {
      min-height: 640px;
    }
    .banner--height-desktop-auto .banner__placeholder {
      min-height: 420px;
    }
    .banner--height-desktop-custom .banner__media,
    .banner--height-desktop-custom .banner__placeholder {
      min-height: var(--banner-height-desktop-custom);
    }
    .banner--height-desktop-small .banner__image,
    .banner--height-desktop-medium .banner__image,
    .banner--height-desktop-large .banner__image,
    .banner--height-desktop-custom .banner__image {
      position: absolute;
      inset: 0;
      height: 100%;
    }
  }

  .banner__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: rgba(0, 0, 0, 0.05);
  }

  .banner__placeholder-svg {
    width: 40%;
    height: auto;
    opacity: 0.4;
  }

  .banner__overlay {
    position: absolute;
    inset: 0;
    background: var(--banner-overlay-color);
    opacity: var(--banner-overlay-opacity);
    pointer-events: none;
  }

  .banner__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    /* justify-content overridden per-section via {% style %} */
    justify-content: center;
    padding: var(--page-margin-mobile);
  }

  .banner--align-center .banner__content {
    align-items: center;
    text-align: center;
  }

  .banner--align-left .banner__content {
    align-items: flex-start;
    text-align: left;
  }

  .banner--align-right .banner__content {
    align-items: flex-end;
    text-align: right;
  }

  .banner__content-inner {
    max-width: var(--banner-content-width-mobile);
  }

  .banner__heading {
    margin: 0;
    font-size: var(--banner-heading-size-mobile);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .banner__subheading {
    font-size: 15.5px;
    line-height: 1.5;
    margin: 0 0 1rem;
  }

  .banner__button {
    margin-top: var(--space-4);
    background-color: transparent;
    color: #fff;
    border-color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .banner__button:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-color: #fff;
  }

  /* Solid white pill — matches handoff .pill--light */
  .banner__button--solid {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    color: #000;
    border: 0;
    border-radius: 999px;
    padding: 20px 40px;
    font-size: 15px;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 0;
  }

  .banner__button--solid:hover {
    background: #f2f2f2;
    color: #000;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .banner__content-inner {
      max-width: var(--banner-content-width-tablet);
    }
  }

  @media screen and (min-width: 768px) {
    .banner__heading {
      font-size: var(--banner-heading-size-desktop);
    }
    .banner__content {
        padding: var(--page-margin);
    }
  }

  @media screen and (min-width: 990px) {
    .banner__content-inner {
      max-width: var(--banner-content-width-desktop);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "text",
      "id": "image_file",
      "label": "Desktop image (Shopify Files filename)",
      "info": "Filename only, e.g. acc-hero.webp. Used when no image picker image is set."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (below 768px)",
      "info": "Optional. If empty, the desktop image is used on mobile too."
    },
    {
      "type": "range",
      "id": "image_mobile_x",
      "label": "Mobile image focus X",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "info": "Shift the focal point of the image horizontally on mobile. 50% = centered."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Add a heading"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "id": "subheading",
      "type": "richtext",
      "label": "Text"
    },
    {
      "id": "button",
      "type": "text",
      "label": "Button"
    },
    {
      "id": "button_url",
      "type": "url",
      "label": "Url"
    },
    {
      "id": "button_style",
      "type": "select",
      "label": "Button style",
      "options": [
        { "value": "outline", "label": "Outline (white border)" },
        { "value": "solid", "label": "Solid white pill" }
      ],
      "default": "outline"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "page", "label": "Page width" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Banner height (desktop)",
      "options": [
        { "value": "auto", "label": "Auto (based on image)" },
        { "value": "small", "label": "Small — 410px" },
        { "value": "medium", "label": "Medium — 550px" },
        { "value": "large", "label": "Large — 640px" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "height_desktop_custom",
      "label": "Custom height (desktop)",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 520,
      "visible_if": "{{ section.settings.height_desktop == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height_tablet",
      "label": "Banner height (tablet)",
      "options": [
        { "value": "auto", "label": "Auto (based on image)" },
        { "value": "small", "label": "Small — 410px" },
        { "value": "medium", "label": "Medium — 550px" },
        { "value": "large", "label": "Large — 640px" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "height_tablet_custom",
      "label": "Custom height (tablet)",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 500,
      "visible_if": "{{ section.settings.height_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Banner height (mobile)",
      "options": [
        { "value": "auto", "label": "Auto (based on image)" },
        { "value": "small", "label": "Small — 410px" },
        { "value": "medium", "label": "Medium — 550px" },
        { "value": "large", "label": "Large — 640px" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "height_mobile_custom",
      "label": "Custom height (mobile)",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 500,
      "visible_if": "{{ section.settings.height_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content horizontal alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_vertical_alignment",
      "label": "Content vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width_desktop",
      "label": "Content width (desktop)",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 600,
      "info": "0 = no limit"
    },
    {
      "type": "range",
      "id": "content_width_tablet",
      "label": "Content width (tablet)",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 500,
      "info": "0 = no limit"
    },
    {
      "type": "range",
      "id": "content_width_mobile",
      "label": "Content width (mobile)",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 0,
      "info": "0 = no limit"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "use_gradient",
      "label": "Use directional gradient",
      "default": false,
      "info": "Replaces the flat colour overlay with a handoff-matched directional gradient. Mobile always uses a vertical (bottom-up) gradient."
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Gradient direction (desktop)",
      "options": [
        { "value": "90", "label": "Horizontal — left to right" },
        { "value": "0", "label": "Vertical — bottom to top" }
      ],
      "default": "90",
      "info": "Only applies when Use directional gradient is enabled.",
      "visible_if": "{{ section.settings.use_gradient }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Flat overlay colour",
      "default": "#000000",
      "info": "Only used when Use directional gradient is off."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Flat overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Only used when Use directional gradient is off."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
