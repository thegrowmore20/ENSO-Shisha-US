{% stylesheet %}

.d-acc-hero {
  padding: 80px 0;
}
@media screen and (max-width: 989px) {
  .d-acc-hero { padding: 40px 0; }
}

/* ── Card ── */
.d-acc-hero__card {
  display: block;
  position: relative;
  border-radius: 28px;
  overflow: hidden;
  background: #000;
  min-height: 760px;
  text-decoration: none;
  color: inherit;
}

/* top-to-bottom gradient keeps heading readable */
.d-acc-hero__card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgb(7 8 10 / .55) 0%, rgb(7 8 10 / .2) 45%, rgb(7 8 10 / 0) 70%);
  pointer-events: none;
  z-index: 1;
}
@media screen and (max-width: 989px) {
  .d-acc-hero__card::after {
    background: linear-gradient(180deg, rgb(7 8 10 / .85) 0%, rgb(7 8 10 / .5) 42%, rgb(7 8 10 / 0) 64%);
  }
}

/* ── Image ── */
.d-acc-hero__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50% 100%;
  transition: transform 0.5s ease;
  z-index: 0;
}
.d-acc-hero__card:hover .d-acc-hero__img {
  transform: scale(1.03);
}

.d-acc-hero__img--mobile {
  display: none;
}
@media screen and (max-width: 767px) {
  .d-acc-hero__img--mobile {
    display: block;
  }
  .d-acc-hero__img--mobile ~ .d-acc-hero__img--desktop {
    display: none;
  }
}

/* ── Placeholder ── */
.d-acc-hero__placeholder {
  position: absolute;
  inset: 0;
  background: #1a1a1a;
}

/* ── Copy column ── */
.d-acc-hero__copy {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  padding: 56px;
  z-index: 2;
}

.d-acc-hero__eyebrow {
  color: rgb(255 255 255 / .7);
  font-size: 15px;
  line-height: 1;
  margin: 0 0 6px;
  letter-spacing: .05em;
  text-transform: uppercase;
  font-weight: var(--font-weight-medium);
}

.d-acc-hero__heading {
  font-size: 64px;
  line-height: 68px;
  letter-spacing: -.03em;
  color: #fff;
  font-weight: var(--font-weight-heavy);
  margin: 0;
}

.d-acc-hero__body {
  font-size: 15px;
  line-height: 23px;
  color: rgb(255 255 255 / .9);
  max-width: 40ch;
  margin: 12px 0 0;
}

/* ── CTA pill ── */
.d-acc-hero__cta {
  display: inline-flex;
  align-items: center;
  background: var(--color-accent);
  color: #fff;
  border-radius: 999px;
  padding: 20px 40px;
  font-size: 15px;
  font-weight: var(--font-weight-bold);
  font-family: var(--font-heading);
  letter-spacing: .1em;
  text-transform: uppercase;
  text-decoration: none;
  margin-top: auto;
  align-self: flex-start;
  transition: opacity .2s;
}
.d-acc-hero__card:hover .d-acc-hero__cta {
  opacity: .85;
}

/* ── Mobile ── */
@media screen and (max-width: 989px) {
  .d-acc-hero__card {
    min-height: 560px;
  }
  .d-acc-hero__copy {
    padding: 24px 20px;
  }
  .d-acc-hero__heading {
    font-size: 40px;
    line-height: 44px;
  }
  .d-acc-hero__body {
    font-size: 14px;
    line-height: 21px;
    max-width: 30ch;
  }
}

{% endstylesheet %}

{%- liquid
  assign has_link = false
  if section.settings.link != blank
    assign has_link = true
  endif
-%}

<section class="d-acc-hero" id="DiamondAcc-{{ section.id }}">
  <div class="container">

    {%- if has_link -%}
      <a class="d-acc-hero__card" href="{{ section.settings.link }}">
    {%- else -%}
      <div class="d-acc-hero__card">
    {%- endif -%}

      {%- comment -%} ── IMAGES ── {%- endcomment -%}
      {%- if section.settings.image_mobile != blank -%}
        {%- assign mobile_alt = section.settings.image_mobile.alt | default: section.settings.heading -%}
        {{- section.settings.image_mobile | image_url: width: 800 | image_tag:
          class: 'd-acc-hero__img d-acc-hero__img--mobile',
          alt: mobile_alt,
          loading: 'lazy',
          widths: '600,800',
          sizes: '100vw'
        -}}
      {%- endif -%}

      {%- if section.settings.image != blank -%}
        {%- assign desktop_alt = section.settings.image.alt | default: section.settings.heading -%}
        {{- section.settings.image | image_url: width: 2000 | image_tag:
          class: 'd-acc-hero__img d-acc-hero__img--desktop',
          alt: desktop_alt,
          loading: 'lazy',
          widths: '1200,1600,2000',
          sizes: '(max-width: 1440px) 100vw, 1440px'
        -}}
      {%- else -%}
        <div class="d-acc-hero__placeholder" aria-hidden="true">
          <svg viewBox="0 0 16 9" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:100%;display:block;opacity:.3">
            <rect width="16" height="9" fill="#1a1a1a"/>
            <path d="M7 4.5 L8 3 L9 4.5 M7.5 4.5 L8.5 4.5 M8 4.5 L8 6" stroke="#555" stroke-width="0.3" stroke-linecap="round"/>
          </svg>
        </div>
      {%- endif -%}

      {%- comment -%} ── COPY ── {%- endcomment -%}
      <div class="d-acc-hero__copy">

        {%- if section.settings.eyebrow != blank -%}
          <p class="d-acc-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="d-acc-hero__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="d-acc-hero__body">{{ section.settings.body | escape }}</p>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <span class="d-acc-hero__cta" aria-hidden="true">{{ section.settings.cta_label | escape }}</span>
        {%- endif -%}

      </div>

    {%- if has_link -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "t:sections.diamond_acc_hero.name",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.diamond_acc_hero.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.diamond_acc_hero.settings.image_mobile.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.diamond_acc_hero.settings.link.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.diamond_acc_hero.settings.eyebrow.label",
      "default": "Accessories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.diamond_acc_hero.settings.heading.label",
      "default": "Extras for your Diamond"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:sections.diamond_acc_hero.settings.body.label",
      "default": "A second battery, spare cups and screens, so Diamond keeps going as long as you do."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.diamond_acc_hero.settings.cta_label.label",
      "default": "Shop accessories"
    }
  ],
  "presets": [
    {
      "name": "t:sections.diamond_acc_hero.presets.name"
    }
  ]
}
{% endschema %}
