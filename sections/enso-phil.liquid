{%- doc -%}
  Philosophy accordion — "Made for the ritual".
  Two-column grid: accordion on left, switching image/video on right.
  image_position is a per-block text setting (CSS object-position).
  image_scale and image_scale_origin are hardcoded per slot index.
{%- enddoc -%}

{% style %}
  #section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    #section-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<div id="section-{{ section.id }}" class="enso-phil-section">
  <div class="enso-phil-section__container">
    <enso-phil class="enso-phil">

      <div class="enso-phil__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="enso-phil__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.lead != blank -%}
          <p class="enso-phil__lead">{{ section.settings.lead | escape }}</p>
        {%- endif -%}

        <div class="enso-phil__list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign has_vid = false
              if block.settings.video and block.settings.video.sources.size > 0
                assign has_vid = true
              endif
              assign b_img_url = ''
              if block.settings.image != blank
                assign b_img_url = block.settings.image | image_url: width: 1200
              endif
              assign b_vid_url = ''
              if has_vid
                for bsrc in block.settings.video.sources
                  if bsrc.format == 'mp4'
                    assign b_vid_url = bsrc.url
                  endif
                endfor
              endif
              assign b_poster_url = ''
              if block.settings.video_poster != blank
                assign b_poster_url = block.settings.video_poster | image_url: width: 1200
              endif
              assign b_pos = block.settings.image_position | default: '50% 50%'
              assign b_scale = 1.0
              assign b_origin = '50% 50%'
              if forloop.index == 2
                assign b_scale = 1.35
                assign b_origin = '52% 58%'
              endif
            -%}
            <details
              {% if forloop.first %}open{% endif %}
              data-img="{{ b_img_url }}"
              data-pos="{{ b_pos }}"
              data-scale="{{ b_scale }}"
              data-scale-origin="{{ b_origin }}"
              {% if has_vid %}data-video="{{ b_vid_url }}" data-video-poster="{{ b_poster_url }}"{% endif %}
              {{ block.shopify_attributes }}
            >
              <summary>{{ block.settings.title | escape }}</summary>
              <div class="enso-phil__body">
                <div class="enso-phil__body-inner">{{ block.settings.body }}</div>
              </div>
            </details>
          {%- endfor -%}
        </div>
      </div>

      <div class="enso-phil__media">
        {%- assign first = section.blocks | first -%}
        {%- if first != blank -%}
          {%- liquid
            assign f_has_vid = false
            if first.settings.video and first.settings.video.sources.size > 0
              assign f_has_vid = true
            endif
            assign f_vid_url = ''
            if f_has_vid
              for fsrc in first.settings.video.sources
                if fsrc.format == 'mp4'
                  assign f_vid_url = fsrc.url
                endif
              endfor
            endif
            assign f_poster_url = ''
            if first.settings.video_poster != blank
              assign f_poster_url = first.settings.video_poster | image_url: width: 1200
            endif
          -%}
          <video
            data-phil-vid
            {% if f_has_vid %}src="{{ f_vid_url }}" poster="{{ f_poster_url }}"{% endif %}
            muted loop playsinline preload="none"
            aria-label="{{ first.settings.title | escape }}"
            {% unless f_has_vid %}hidden{% endunless %}
          ></video>
          <img
            data-phil-img
            {% if first.settings.image != blank %}
              src="{{ first.settings.image | image_url: width: 1200 }}"
              alt="{{ first.settings.title | escape }}"
              style="object-position: {{ first.settings.image_position | default: '50% 50%' }};"
            {% endif %}
            loading="lazy"
            {% if f_has_vid or first.settings.image == blank %}hidden{% endif %}
          >
        {%- endif -%}
      </div>

    </enso-phil>
  </div>
</div>

{% stylesheet %}
  /* ── Container ── */
  .enso-phil-section__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Two-column grid ── */
  .enso-phil {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: center;
  }

  /* ── Heading ── */
  .enso-phil__heading {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    font-size: 42px;
    line-height: 46px;
    letter-spacing: -0.025em;
    margin: 0 0 12px;
  }

  /* ── Lead paragraph ── */
  .enso-phil__lead {
    color: rgb(0 0 0 / 0.6);
    margin: 0 0 28px;
  }

  /* ── Accordion list ── */
  .enso-phil__list details {
    border-top: 1px solid rgb(0 0 0 / 0.12);
  }
  .enso-phil__list details:last-child {
    border-bottom: 1px solid rgb(0 0 0 / 0.12);
  }

  .enso-phil__list summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size: 18px;
    line-height: 24px;
    user-select: none;
  }

  .enso-phil__list summary::-webkit-details-marker { display: none; }

  .enso-phil__list summary::after {
    content: "+";
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    font-size: 22px;
    line-height: 1;
    flex-shrink: 0;
    margin-left: 12px;
    transition: color 0.2s;
  }

  .enso-phil__list details[open] summary::after {
    content: "−";
    color: rgb(0 0 0 / 0.45);
  }

  /* Smooth open/close via grid-template-rows.
     JS prevents default on summary click so the browser never
     applies display:none — CSS owns the transition entirely. */
  .enso-phil__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  details[open] .enso-phil__body {
    grid-template-rows: 1fr;
  }

  .enso-phil__body-inner {
    overflow: hidden;
    min-height: 0;
    padding-bottom: 10px;
  }

  .enso-phil__list p {
    margin: 0 0 14px;
    color: rgb(0 0 0 / 0.72);
    font-size: 15px;
    line-height: 24px;
  }

  /* ── Media column ── */
  .enso-phil__media {
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #0d0d0d;
    position: relative;
  }

  .enso-phil__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.25s;
  }

  [data-phil-vid] {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    display: block;
  }

  [data-phil-vid][hidden],
  [data-phil-img][hidden],
  [data-phil-img]:not([src]) {
    display: none !important;
  }

  /* ── Mobile (≤991px) ── */
  @media screen and (max-width: 991px) {
    .enso-phil-section__container {
      padding: 0 16px;
    }

    .enso-phil {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    /* display:contents flattens the copy wrapper so children
       participate in the grid and can be reordered */
    .enso-phil__copy {
      display: contents;
    }

    .enso-phil__heading { order: 1; }

    .enso-phil__lead {
      order: 2;
      margin-bottom: 20px;
    }

    .enso-phil__media {
      order: 3;
      margin-bottom: 8px;
    }

    .enso-phil__list { order: 4; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('enso-phil')) {
    class EnsoPhill extends HTMLElement {
      #img = null;
      #vid = null;
      #items = [];

      connectedCallback() {
        this.#img = this.querySelector('[data-phil-img]');
        this.#vid = this.querySelector('[data-phil-vid]');
        this.#items = [...this.querySelectorAll('.enso-phil__list details')];

        for (const item of this.#items) {
          const summary = item.querySelector('summary');
          if (summary) {
            summary.addEventListener('click', (e) => {
              e.preventDefault();
              this.#handleClick(item);
            });
          }
        }
      }

      #handleClick(item) {
        if (item.open) {
          const idx = this.#items.indexOf(item);
          const next = this.#items[(idx + 1) % this.#items.length];
          item.removeAttribute('open');
          if (!this.#items.some(x => x.open)) {
            next.setAttribute('open', '');
            this.#updateMedia(next);
          }
        } else {
          for (const x of this.#items) {
            if (x !== item) x.removeAttribute('open');
          }
          item.setAttribute('open', '');
          this.#updateMedia(item);
        }
      }

      #updateMedia(item) {
        if (!this.#img) return;
        this.#img.style.opacity = '0';

        setTimeout(() => {
          if (item.dataset.video) {
            this.#img.hidden = true;
            if (this.#vid) {
              this.#vid.hidden = false;
              this.#vid.src = item.dataset.video;
              this.#vid.poster = item.dataset.videoPoster || '';
              this.#vid.play().catch(() => {});
            }
          } else {
            if (this.#vid) { this.#vid.pause(); this.#vid.hidden = true; }
            if (item.dataset.img) {
              this.#img.setAttribute('src', item.dataset.img);
              this.#img.hidden = false;
            } else {
              this.#img.removeAttribute('src');
              this.#img.hidden = true;
            }
            this.#img.style.objectPosition = item.dataset.pos || '50% 50%';
            this.#img.alt = item.querySelector('summary')?.textContent.trim() || '';
            const scale = parseFloat(item.dataset.scale) || 1;
            this.#img.style.transform = scale !== 1 ? `scale(${scale})` : '';
            this.#img.style.transformOrigin = scale !== 1 ? (item.dataset.scaleOrigin || '50% 50%') : '';
            this.#img.style.opacity = '1';
          }
        }, 200);
      }
    }

    customElements.define('enso-phil', EnsoPhill);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.enso_phil.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.enso_phil.settings.heading.label",
      "default": "Made for the ritual"
    },
    {
      "type": "text",
      "id": "lead",
      "label": "t:sections.enso_phil.settings.lead.label",
      "default": "What ENSŌ is built on"
    },
    {
      "type": "header",
      "content": "t:sections.enso_phil.settings.padding_header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.enso_phil.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.enso_phil.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.enso_phil.settings.padding_top_mobile.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.enso_phil.settings.padding_bottom_mobile.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.enso_phil.blocks.item.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.enso_phil.blocks.item.settings.title.label",
          "default": "Item title"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "t:sections.enso_phil.blocks.item.settings.body.label",
          "default": "<p>Body text goes here.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.enso_phil.blocks.item.settings.image.label"
        },
        {
          "type": "text",
          "id": "image_position",
          "label": "t:sections.enso_phil.blocks.item.settings.image_position.label",
          "info": "t:sections.enso_phil.blocks.item.settings.image_position.info",
          "default": "50% 50%"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.enso_phil.blocks.item.settings.video.label",
          "info": "t:sections.enso_phil.blocks.item.settings.video.info"
        },
        {
          "type": "image_picker",
          "id": "video_poster",
          "label": "t:sections.enso_phil.blocks.item.settings.video_poster.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.enso_phil.presets.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Stay in the moment",
            "body": "<p>A hookah is an evening, not a task. No turning coals, no checking the heat, no numbers to watch.</p><p>Set it once and let it run: the temperature holds on its own for the whole session. What is left is the taste, the people around the table and the time itself, the clean moment the ritual was always about.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "A ritual you already know",
            "body": "<p>Nothing new to learn. You fill the cup the way you have always filled a bowl: your own tobacco, fluffed and airy or pressed and dense, a mesh on top.</p><p>No pods and no cartridges: any brand, any cut you like. The same hands and the same habit, only the coal is gone.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Why the charcoal had to go",
            "body": "<p>Coal is the one part of the evening nobody loves. Ten minutes over a burner, tongs, ash on the table, the smell of coal in the room, and a burnt edge on the flavour whenever a piece sits too long.</p><p>ENSŌ replaces it with electric heat set to the degree. The blend warms evenly and never meets a flame, so what you taste is the tobacco you chose.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
