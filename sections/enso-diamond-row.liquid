{%- doc -%}
  ENSŌ Diamond product row — dark 2-column card linking to the Diamond PDP.
  Left: eyebrow, heading, feature list, CTA. Right: product image.
  Matches handoff section #shopify-section-enso-diamond-row.
{%- enddoc -%}

{% style %}
  #section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    #section-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<div id="section-{{ section.id }}" class="enso-drow-section">
  <div class="enso-drow-section__container">
    <div class="enso-drow">
      <div class="enso-drow__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="enso-drow__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="enso-drow__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="enso-drow__list" aria-label="Features">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <b>{{ block.settings.title | escape }}</b>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <span>{{ block.settings.description | escape }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--accent" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>

      <div class="enso-drow__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              widths: '600, 900, 1200',
              sizes: '(max-width: 991px) 100vw, 50vw',
              alt: section.settings.image.alt | default: section.settings.heading,
              loading: 'lazy',
              style: 'object-position: ' | append: section.settings.image_position | append: ';'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'enso-drow__placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .enso-drow-section__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .enso-drow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    border-radius: 28px;
    overflow: hidden;
    background: #1d1d1f;
    color: #fff;
    text-decoration: none;
    height: 560px;
  }

  .enso-drow__copy {
    padding: 48px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .enso-drow__eyebrow {
    margin: 0 0 10px;
    color: var(--palette-sand, #c8943a);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: var(--font-weight-bold);
    font-family: var(--font-heading);
  }

  .enso-drow__heading {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-heavy);
    font-size: 40px;
    line-height: 44px;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 24px;
  }

  .enso-drow__list {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .enso-drow__list li {
    display: grid;
    gap: 2px;
    padding-left: 18px;
    border-left: 2px solid var(--palette-sand, #c8943a);
  }

  .enso-drow__list b {
    font-size: 16px;
    font-weight: var(--font-weight-semibold);
    color: #fff;
  }

  .enso-drow__list span {
    color: rgb(255 255 255 / 0.75);
    font-size: 14px;
    line-height: 21px;
  }

  .enso-drow .btn--accent {
    align-self: flex-start;
  }

  .enso-drow__media {
    order: 2;
    height: 560px;
    overflow: hidden;
  }

  .enso-drow__media img {
    display: block;
    width: 100%;
    height: 560px;
    object-fit: cover;
  }

  .enso-drow__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.15;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 991px) {
    .enso-drow-section__container {
      padding: 0 16px;
    }

    .enso-drow {
      grid-template-columns: minmax(0, 1fr);
      height: auto;
    }

    .enso-drow__media {
      order: -1;
      height: auto;
    }

    .enso-drow__media img {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }

    .enso-drow__copy {
      padding: 28px 20px 32px;
    }

    .enso-drow__heading {
      font-size: 30px;
      line-height: 34px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.enso_diamond_row.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.enso_diamond_row.settings.eyebrow.label",
      "default": "ENSŌ Diamond · Pre-order"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.enso_diamond_row.settings.heading.label",
      "default": "Electric heat for the hookah you already own"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.enso_diamond_row.settings.cta_label.label",
      "default": "Shop Diamond"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.enso_diamond_row.settings.cta_link.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.enso_diamond_row.settings.image.label"
    },
    {
      "type": "text",
      "id": "image_position",
      "label": "t:sections.enso_diamond_row.settings.image_position.label",
      "default": "50% 38%",
      "info": "t:sections.enso_diamond_row.settings.image_position.info"
    },
    {
      "type": "header",
      "content": "t:sections.enso_diamond_row.settings.padding_header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.enso_diamond_row.settings.padding_top.label",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.enso_diamond_row.settings.padding_bottom.label",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.enso_diamond_row.settings.padding_top_mobile.label",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.enso_diamond_row.settings.padding_bottom_mobile.label",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.enso_diamond_row.blocks.feature.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.enso_diamond_row.blocks.feature.settings.title.label",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:sections.enso_diamond_row.blocks.feature.settings.description.label",
          "default": "Feature description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.enso_diamond_row.presets.name",
      "blocks": [
        { "type": "feature", "settings": { "title": "Fits your hookah", "description": "Sits where the bowl sits, on the stem you already have" } },
        { "type": "feature", "settings": { "title": "Pre-heat your way", "description": "0–15 minutes and 180–320 °C, you choose both" } },
        { "type": "feature", "settings": { "title": "Profiles", "description": "Default, Phoenix, Wraith and Oracle, each in its own colour" } },
        { "type": "feature", "settings": { "title": "Charge while you smoke", "description": "USB-C in, the session goes on" } }
      ]
    }
  ]
}
{% endschema %}
