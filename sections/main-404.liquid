{%- liquid
  assign scheme_class = 'color-surface'
  render 'surface-colors', background: section.settings.color_background, text: section.settings.color_text
-%}

<div class="not-found {{ scheme_class }} section-padding">
  <div class="container text-center not-found__inner">
    
    <h1 class="h-section">{{ 'general.404.title' | t }}</h1>
    <p class="body-text text-muted">{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary">{{ 'general.404.link' | t }}</a>
  </div>
</div>

{% stylesheet %}
  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-8);
  }

  .not-found__mark {
    width: 48px;
    color: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main-404.name",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.background_color.label",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.text_color.label",
      "default": "{{ settings.color_palette.foreground }}"
    }
  ]
}
{% endschema %}
