{%- liquid
  assign has_devices   = false
  assign has_accs      = false
  assign device_count  = 0
  assign solo_family   = ''

  for item in cart.items
    if item.product.tags contains 'device'
      assign has_devices  = true
      assign device_count = device_count | plus: 1
      assign solo_family  = item.product.metafields.custom.device_family.value | default: ''
    else
      assign has_accs = true
    endif
  endfor

  if device_count > 1
    assign solo_family = ''
  endif

  if cart.item_count == 0
    assign cart_mode = 'empty'
  elsif has_devices and has_accs
    assign cart_mode = 'mixed'
  elsif has_devices
    assign cart_mode = 'device'
  else
    assign cart_mode = 'accessories'
  endif

  if cart_mode == 'device'
    if solo_family == 'diamond'
      assign cart_heading = 'cart.heading.choose_diamond' | t
    else
      assign cart_heading = 'cart.heading.choose_enso' | t
    endif
    assign cart_lead = 'cart.lead.device' | t
  elsif cart_mode == 'accessories'
    assign cart_heading = 'cart.heading.accessories' | t
    assign cart_lead    = 'cart.lead.accessories' | t
  elsif cart_mode == 'mixed'
    assign cart_heading = 'cart.heading.mixed' | t
    assign cart_lead    = 'cart.lead.mixed' | t
  endif

  if cart_mode == 'device'
    if solo_family == 'diamond'
      assign back_url   = section.settings.diamond_url | default: '/products/enso-diamond-pre-order'
      assign back_label = 'cart.back.diamond' | t
    else
      assign back_url   = section.settings.enso_url | default: '/products/enso-2026'
      assign back_label = 'cart.back.enso' | t
    endif
  elsif cart_mode == 'accessories'
    assign back_url   = routes.collections_url | append: '/accessories'
    assign back_label = 'cart.back.keep' | t
  else
    assign back_url   = '/'
    assign back_label = 'cart.back.keep' | t
  endif

  capture device_pid_list
    for item in cart.items
      if item.product.tags contains 'device'
        echo item.product.id
        echo ','
      endif
    endfor
  endcapture
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 32 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 80 }}px;
  }
  @media screen and (min-width: 991px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 56 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 96 }}px;
    }
  }
{% endstyle %}

<cart-page
  class="cart-page"
  data-mode="{{ cart_mode }}"
  data-money-format="{{ shop.money_format | replace: "'", '"' | escape }}"
  data-device-pids="{{ device_pid_list | strip }}">

  {%- comment -%}——— TOAST ———{%- endcomment -%}
  <div class="cp-toast" id="cp-toast" role="status" aria-live="polite" aria-atomic="true"></div>

  {%- if cart_mode == 'empty' -%}
    <div class="container">
      <div class="cp-empty-wrap">
        <h1 class="cp-empty-title">{{ 'cart.heading.empty' | t }}</h1>
        <p class="cp-empty-lead">{{ 'cart.lead.empty' | t }}</p>
        <div class="cp-empty">

          <a class="cp-ec" href="{{ section.settings.diamond_url | default: '/products/enso-diamond-pre-order' }}">
            <div class="cp-ec__img">
              {%- if section.settings.empty_diamond_image != blank -%}
                <img src="{{ section.settings.empty_diamond_image | image_url: width: 600 }}"
                     srcset="{{ section.settings.empty_diamond_image | image_url: width: 400 }} 400w, {{ section.settings.empty_diamond_image | image_url: width: 600 }} 600w"
                     sizes="(max-width: 749px) 90vw, 30vw"
                     alt="{{ section.settings.empty_diamond_image.alt | default: section.settings.empty_diamond_title | escape }}"
                     width="{{ section.settings.empty_diamond_image.width }}"
                     height="{{ section.settings.empty_diamond_image.height }}"
                     loading="eager">
              {%- else -%}
                <svg aria-hidden="true" viewBox="0 0 400 400" fill="none"><rect width="400" height="400" fill="#f0ede8"/><rect x="140" y="140" width="120" height="120" rx="16" fill="#c8b89a"/></svg>
              {%- endif -%}
            </div>
            <div class="cp-ec__txt">
              <b>{{ section.settings.empty_diamond_title | default: 'ENSŌ Diamond' }}</b>
              <span>{{ section.settings.empty_diamond_subtitle | default: 'The electric heater for the hookah you already own' }}</span>
            </div>
            <span class="btn btn--primary btn--full">{{ section.settings.empty_diamond_cta | default: 'SHOP DIAMOND' }}</span>
          </a>

          <a class="cp-ec" href="{{ section.settings.enso_url | default: '/products/enso-2026' }}">
            <div class="cp-ec__img">
              {%- if section.settings.empty_enso_image != blank -%}
                <img src="{{ section.settings.empty_enso_image | image_url: width: 600 }}"
                     srcset="{{ section.settings.empty_enso_image | image_url: width: 400 }} 400w, {{ section.settings.empty_enso_image | image_url: width: 600 }} 600w"
                     sizes="(max-width: 749px) 90vw, 30vw"
                     alt="{{ section.settings.empty_enso_image.alt | default: section.settings.empty_enso_title | escape }}"
                     width="{{ section.settings.empty_enso_image.width }}"
                     height="{{ section.settings.empty_enso_image.height }}"
                     loading="eager">
              {%- else -%}
                <svg aria-hidden="true" viewBox="0 0 400 400" fill="none"><rect width="400" height="400" fill="#f0ede8"/><rect x="140" y="140" width="120" height="120" rx="16" fill="#c8b89a"/></svg>
              {%- endif -%}
            </div>
            <div class="cp-ec__txt">
              <b>{{ section.settings.empty_enso_title | default: 'ENSŌ 2026 Edition' }}</b>
              <span>{{ section.settings.empty_enso_subtitle | default: 'The all-in-one electric hookah' }}</span>
            </div>
            <span class="btn btn--outline btn--full">{{ section.settings.empty_enso_cta | default: 'SEE THE 2026 EDITION' }}</span>
          </a>

          <a class="cp-ec" href="{{ section.settings.empty_acc_url | default: routes.collections_url | append: '/accessories' }}">
            <div class="cp-ec__img">
              {%- if section.settings.empty_acc_image != blank -%}
                <img src="{{ section.settings.empty_acc_image | image_url: width: 600 }}"
                     srcset="{{ section.settings.empty_acc_image | image_url: width: 400 }} 400w, {{ section.settings.empty_acc_image | image_url: width: 600 }} 600w"
                     sizes="(max-width: 749px) 90vw, 30vw"
                     alt="{{ section.settings.empty_acc_image.alt | default: section.settings.empty_acc_title | escape }}"
                     width="{{ section.settings.empty_acc_image.width }}"
                     height="{{ section.settings.empty_acc_image.height }}"
                     loading="eager">
              {%- else -%}
                <svg aria-hidden="true" viewBox="0 0 400 400" fill="none"><rect width="400" height="400" fill="#f0ede8"/><rect x="140" y="140" width="120" height="120" rx="16" fill="#c8b89a"/></svg>
              {%- endif -%}
            </div>
            <div class="cp-ec__txt">
              <b>{{ section.settings.empty_acc_title | default: 'Accessories' }}</b>
              <span>{{ section.settings.empty_acc_subtitle | default: 'Batteries, cups, screens, tools and the backpack' }}</span>
            </div>
            <span class="btn btn--outline btn--full">{{ section.settings.empty_acc_cta | default: 'SHOP ACCESSORIES' }}</span>
          </a>

        </div>
      </div>
    </div>

  {%- else -%}
    <div class="container">
      <div class="cp-layout">

        {%- comment -%}——— LEFT: MAIN CONTENT ———{%- endcomment -%}
        <div class="cp-main">
          <h1 class="cp-heading">{{ cart_heading }}</h1>
          <p class="cp-lead">{{ cart_lead }}</p>

          {%- comment -%}DEVICES{%- endcomment -%}
          {%- if has_devices -%}
            {%- if cart_mode == 'mixed' -%}
              <h2 class="cp-section-h">{{ 'cart.section.in_your_cart' | t }}</h2>
            {%- endif -%}

            {%- for item in cart.items -%}
              {%- unless item.product.tags contains 'device' -%}{%- continue -%}{%- endunless -%}
              {%- liquid
                assign dv_family  = item.product.metafields.custom.device_family.value | default: ''
                if dv_family == 'diamond'
                  assign dv_col = section.settings.diamond_sets_collection
                  if dv_col == blank
                    assign dv_col = collections['diamond-sets']
                  endif
                else
                  assign dv_col = section.settings.enso_sets_collection
                  if dv_col == blank
                    assign dv_col = collections['enso-sets']
                  endif
                endif
                assign ess_accs   = item.product.metafields.custom.essential_accessories.value
                assign spr_accs   = item.product.metafields.custom.spare_accessories.value
                assign dev_subtitle = item.product.metafields.custom.headline | metafield_tag | strip_html | strip

                assign spare_hidden_count = 0
                if spr_accs != blank
                  for sa in spr_accs
                    if forloop.index <= 2
                      continue
                    endif
                    assign spc_in = false
                    for ci in cart.items
                      if ci.product.id == sa.id
                        assign spc_in = true
                        break
                      endif
                    endfor
                    unless spc_in
                      assign spare_hidden_count = spare_hidden_count | plus: 1
                    endunless
                  endfor
                endif
              -%}

              <details class="cp-dev"
                       data-key="{{ item.key }}"
                       data-pid="{{ item.product.id }}"
                       data-family="{{ dv_family }}"
                       {% if cart_mode == 'device' %}open{% endif %}>
                <summary class="cp-dev__summary">
                  <a class="cp-dev__thumb" href="{{ item.product.url }}" tabindex="-1" aria-hidden="true">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 144 }}"
                           alt="{{ item.image.alt | default: item.title | escape }}"
                           width="72" height="72" loading="lazy">
                    {%- endif -%}
                  </a>
                  <div class="cp-dev__t">
                    <a class="cp-dev__name" href="{{ item.product.url }}">{{ item.product.title }}</a>
                    {%- if dev_subtitle != blank -%}
                      <small class="cp-dev__sub">{{ dev_subtitle }}</small>
                    {%- endif -%}
                  </div>
                  <em class="cp-dev__price">{{ item.final_price | money }}</em>
                  <button type="button" class="cp-dev__x" data-remove="{{ item.key }}"
                          aria-label="{{ 'cart.device.remove' | t: title: item.product.title }}">×</button>
                  <div class="cp-dev__tog">
                    <span class="cp-dev__tog-show">{{ 'cart.device.show_addons' | t }}</span>
                    <span class="cp-dev__tog-hide">{{ 'cart.device.hide_addons' | t }}</span>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </div>
                </summary>

                <div class="cp-dev__body">

                  {%- comment -%}PICK A SET{%- endcomment -%}
                  {%- if dv_col != blank -%}
                    <div class="cp-sets block">
                      <h2 class="cp-sets__h">{{ 'cart.sets.heading' | t }}</h2>
                      <p class="cp-sets__sub">
                        {%- if dv_family == 'diamond' -%}{{ 'cart.sets.sub_diamond' | t }}{%- else -%}{{ 'cart.sets.sub_enso' | t }}{%- endif -%}
                      </p>
                      <div class="cp-sets__grid">
                        {%- for sp in dv_col.products -%}
                          {%- liquid
                            assign sp_var    = sp.selected_or_first_available_variant
                            assign sp_active = false
                            if sp.id == item.product.id
                              assign sp_active = true
                            endif
                            assign sp_badge = sp.metafields.custom.badge.value | default: ''
                          -%}
                          <label class="cp-set{% if sp_active %} is-active{% endif %}">
                            <input class="visually-hidden" type="radio"
                                   name="cp-set-{{ item.key }}"
                                   value="{{ sp.id }}"
                                   data-old-key="{{ item.key }}"
                                   data-new-pid="{{ sp.id }}"
                                   data-new-vid="{{ sp_var.id }}"
                                   {% if sp_active %}checked{% endif %}>
                            {%- if sp_badge != blank -%}
                              <span class="cp-set__badge{% if sp_badge contains 'MOST' or sp_badge contains 'Most' %} cp-set__badge--accent{% endif %}">{{ sp_badge }}</span>
                            {%- endif -%}
                            <div class="cp-set__img">
                              {%- if sp.featured_image -%}
                                <img src="{{ sp.featured_image | image_url: width: 300 }}"
                                     alt="{{ sp.featured_image.alt | default: sp.title | escape }}"
                                     width="200" height="200" loading="lazy">
                              {%- else -%}
                                <svg aria-hidden="true" viewBox="0 0 200 200" fill="none"><rect width="200" height="200" fill="#f0ede8"/></svg>
                              {%- endif -%}
                            </div>
                            <div class="cp-set__info">
                              <b class="cp-set__name">{{ sp.title }}</b>
                              <span class="cp-set__price">
                                {%- if sp_var.compare_at_price > sp_var.price -%}<s>{{ sp_var.compare_at_price | money }}</s>{%- endif -%}
                                {{ sp_var.price | money }}
                              </span>
                              {%- assign sp_witb = sp.metafields.custom.what_s_in_the_box -%}
                              {%- if sp_witb != blank -%}
                                <div class="cp-set__desc">{{ sp_witb | metafield_tag }}</div>
                              {%- endif -%}
                            </div>
                          </label>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}

                  {%- comment -%}ADD ACCESSORIES{%- endcomment -%}
                  {%- if ess_accs != blank or spr_accs != blank -%}
                    <div class="cp-addons block">
                      <h2 class="cp-addons__h">{{ 'cart.addons.heading' | t }}</h2>
                      <p class="cp-addons__sub">
                        {%- if dv_family == 'diamond' -%}{{ 'cart.addons.sub_diamond' | t }}{%- else -%}{{ 'cart.addons.sub_enso' | t }}{%- endif -%}
                      </p>

                      {%- if ess_accs != blank -%}
                        <h3 class="cp-addons__group-h">{{ 'cart.addons.essentials' | t }}</h3>
                        <div class="cp-addons__grid">
                          {%- for acc in ess_accs -%}
                            {%- if acc.id == item.product.id -%}{%- continue -%}{%- endif -%}
                            {%- render 'cart-addon-card', product: acc -%}
                          {%- endfor -%}
                        </div>
                      {%- endif -%}

                      {%- if spr_accs != blank -%}
                        <h3 class="cp-addons__group-h">{{ 'cart.addons.spares' | t }}</h3>
                        <div class="cp-addons__grid cp-addons__grid--spares"
                             data-spares-for="{{ item.key }}">
                          {%- for acc in spr_accs -%}
                            {%- if acc.id == item.product.id -%}{%- continue -%}{%- endif -%}
                            {%- liquid
                              assign spc_in = false
                              for ci in cart.items
                                if ci.product.id == acc.id
                                  assign spc_in = true
                                  break
                                endif
                              endfor
                              if forloop.index > 2 and spc_in == false
                                assign spr_hidden = true
                              else
                                assign spr_hidden = false
                              endif
                            -%}
                            {%- render 'cart-addon-card', product: acc, hidden: spr_hidden -%}
                          {%- endfor -%}
                        </div>
                        {%- if spare_hidden_count > 0 -%}
                          <button type="button" class="cp-addons__more"
                                  data-spares-toggle="{{ item.key }}"
                                  aria-expanded="false">
                            {{ 'cart.addons.show_more_spares' | t: count: spare_hidden_count }}
                          </button>
                        {%- endif -%}
                      {%- endif -%}

                    </div>
                  {%- endif -%}

                  <button type="button" class="cp-dev__remove" data-remove="{{ item.key }}"
                          aria-label="{{ 'cart.device.remove_link' | t: title: item.product.title }}">
                    {{ 'cart.device.remove_from_cart' | t: title: item.product.title }}
                  </button>

                </div>
              </details>
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%}STANDALONE ACCESSORIES LIST{%- endcomment -%}
          {%- if has_accs -%}
            <div class="cp-acc-section">
              {%- if cart_mode == 'mixed' -%}
                <h2 class="cp-section-h">{{ 'cart.section.accessories' | t }}</h2>
              {%- endif -%}
              <ul class="cp-acc-list" id="cp-acc-list" role="list">
                {%- for item in cart.items -%}
                  {%- if item.product.tags contains 'device' -%}{%- continue -%}{%- endif -%}
                  {%- assign acc_sub = item.product.metafields.custom.headline | metafield_tag | strip_html | strip -%}
                  <li class="cp-acc-row" data-key="{{ item.key }}">
                    <a class="cp-acc-row__img" href="{{ item.product.url }}" aria-label="{{ item.product.title | escape }}">
                      {%- if item.image -%}
                        <img src="{{ item.image | image_url: width: 128 }}"
                             alt="{{ item.image.alt | default: item.title | escape }}"
                             width="64" height="64" loading="lazy">
                      {%- else -%}
                        <svg aria-hidden="true" width="64" height="64" viewBox="0 0 64 64" fill="none"><rect width="64" height="64" rx="10" fill="#f0ede8"/></svg>
                      {%- endif -%}
                    </a>
                    <div class="cp-acc-row__info">
                      <a class="cp-acc-row__name" href="{{ item.product.url }}">{{ item.product.title }}</a>
                      {%- if acc_sub != blank -%}
                        <small class="cp-acc-row__sub">{{ acc_sub }}</small>
                      {%- endif -%}
                    </div>
                    <div class="cp-acc-row__qty">
                      <button type="button" class="cp-acc-row__qty-btn" data-d="-1" aria-label="{{ 'cart.qty.decrease' | t }}">−</button>
                      <span class="cp-acc-row__qty-num">{{ item.quantity }}</span>
                      <button type="button" class="cp-acc-row__qty-btn" data-d="1" aria-label="{{ 'cart.qty.increase' | t }}">+</button>
                    </div>
                    <em class="cp-acc-row__price">{{ item.final_line_price | money }}</em>
                    <button type="button" class="cp-acc-row__remove" data-remove="{{ item.key }}"
                            aria-label="{{ 'cart.general.remove' | t: title: item.product.title }}">×</button>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- comment -%}DID YOU FORGET ANYTHING?{%- endcomment -%}
          {%- liquid
            assign fav_source = null
            if has_devices
              for item in cart.items
                if item.product.tags contains 'device'
                  assign fav_source = item.product.metafields.custom.featured_accessories.value
                  break
                endif
              endfor
            endif
            unless fav_source
              assign fav_col = collections['accessories']
              if fav_col != blank
                assign fav_source = fav_col.products
              endif
            endunless

            assign fav_count = 0
            assign fav_has   = false
            if fav_source != blank
              for fp in fav_source
                if fav_count >= 4
                  break
                endif
                assign fp_in = false
                for ci in cart.items
                  if ci.product.id == fp.id
                    assign fp_in = true
                    break
                  endif
                endfor
                unless fp_in
                  assign fav_has   = true
                  assign fav_count = fav_count | plus: 1
                endunless
              endfor
            endif
          -%}

          {%- if fav_has and cart_mode != 'device' -%}
            <div class="cp-favs" id="cp-favs">
              <div class="cp-favs__header">
                <h2 class="cp-favs__h">{{ 'cart.favs.heading' | t }}</h2>
              </div>
              <div class="cp-favs__grid" id="cp-favs-grid">
                {%- assign fav_count = 0 -%}
                {%- for fp in fav_source -%}
                  {%- if fav_count >= 4 -%}{%- break -%}{%- endif -%}
                  {%- assign fp_in = false -%}
                  {%- for ci in cart.items -%}
                    {%- if ci.product.id == fp.id -%}{%- assign fp_in = true -%}{%- break -%}{%- endif -%}
                  {%- endfor -%}
                  {%- unless fp_in -%}
                    {%- render 'cart-fav-card', product: fp -%}
                    {%- assign fav_count = fav_count | plus: 1 -%}
                  {%- endunless -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

        </div>{%- comment -%}end .cp-main{%- endcomment -%}

        {%- comment -%}——— RIGHT: SIDEBAR ———{%- endcomment -%}
        <aside class="cp-sidebar" id="cp-sidebar" aria-label="{{ 'cart.summary.heading' | t }}">
          <h2 class="cp-sidebar__h">{{ 'cart.summary.heading' | t }}</h2>

          <ul id="cp-sidebar-items" role="list">
            {%- for item in cart.items -%}
              {%- assign item_sub = item.product.metafields.custom.headline | metafield_tag | strip_html | strip -%}
              <li data-line-key="{{ item.key }}">
                <span>
                  <span class="cp-sidebar__row-name">{{ item.product.title }}{% if item.quantity > 1 %} × {{ item.quantity }}{% endif %}</span>
                  {%- if item_sub != blank -%}
                    <small>{{ item_sub }}</small>
                  {%- endif -%}
                </span>
                <span>{{ item.final_line_price | money }}</span>
              </li>
            {%- endfor -%}
          </ul>

          <div class="cp-sidebar__total" id="cp-sidebar-total">
            <span>{{ 'cart.general.total' | t }}</span>
            <span id="cp-sidebar-total-price">{{ cart.total_price | money }}</span>
          </div>
          <p class="cp-sidebar__vat">{{ 'cart.summary.vat_note' | t }}</p>

          <a href="/checkout" class="btn btn--primary btn--full cp-sidebar__cta">
            {{- section.settings.cta_label | default: 'Checkout' | upcase -}}
          </a>

          {%- if section.settings.usp_1 != blank or section.settings.usp_2 != blank or section.settings.usp_3 != blank -%}
            <ul class="cp-sidebar__trust" role="list">
              {%- if section.settings.usp_1 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5"/></svg>
                  {{ section.settings.usp_1 }}
                </li>
              {%- endif -%}
              {%- if section.settings.usp_2 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>
                  {{ section.settings.usp_2 }}
                </li>
              {%- endif -%}
              {%- if section.settings.usp_3 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 8.5 12 4l9 4.5v8L12 21l-9-4.5v-8Z"/><path d="M3 8.5 12 13l9-4.5M12 13v8"/></svg>
                  {{ section.settings.usp_3 }}
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}

          <a href="{{ back_url }}" class="cp-sidebar__back">{{ back_label }}</a>
        </aside>

      </div>
    </div>
  {%- endif -%}

  {%- unless cart.item_count == 0 -%}
    <div class="cp-mbar" aria-hidden="true">
      <div class="cp-mbar__total">
        <span class="cp-mbar__label">{{ 'cart.general.total' | t }}</span>
        <span class="cp-mbar__price" id="cp-mbar-total">{{ cart.total_price | money }}</span>
      </div>
      <a href="/checkout" class="btn btn--primary">
        {{- section.settings.cta_label | default: 'Checkout' | upcase -}}
      </a>
    </div>
  {%- endunless -%}

</cart-page>

<script src="{{ 'cart-page.js' | asset_url }}" defer></script>

{% stylesheet %}
/* ── Layout ─────────────────────────────────────────────────────── */
.cart-page {
  display: block;
  background: var(--color-background);
}

.cp-layout {
  display: grid;
  grid-template-columns: minmax(0,1fr) 420px;
  gap: 60px;
  align-items: start;
}
@media screen and (max-width: 989px) {
  .cp-layout { grid-template-columns: 1fr; gap: 32px; }
}

.cp-heading {
  font-family: var(--font-accent);
  font-size: var(--font-size-h2);
  font-weight: var(--font-weight-heavy);
  letter-spacing: -.02em;
  margin-bottom: 8px;
  line-height: 1.1;
}
.cp-lead {
  margin-bottom: 28px;
  color: var(--color-text-muted);
  line-height: 1.6;
}
.cp-section-h {
  font-size: var(--font-size-h5);
  font-weight: var(--font-weight-bold);
  margin-bottom: var(--space-5);
  margin-top: var(--space-7);
}
.cp-section-h:first-child { margin-top: 0; }

/* ── Toast ───────────────────────────────────────────────────────── */
.cp-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(.92);
  background: var(--color-text);
  color: var(--color-background);
  border-radius: var(--radius-pill);
  padding: 10px 20px;
  font-size: 13px;
  font-weight: var(--font-weight-semibold);
  opacity: 0;
  transition: opacity .2s, transform .2s;
  z-index: 9001;
  pointer-events: none;
  white-space: nowrap;
  display: none;
}
.cp-toast.is-on {
  display: block;
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

/* ── Empty state ─────────────────────────────────────────────────── */
.cp-empty-wrap { padding: 8px 0 88px; }
.cp-empty-title { margin-bottom: 8px; }
.cp-empty-lead  { margin-bottom: 28px; color: var(--color-text-muted); }
.cp-empty {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 20px;
}
@media screen and (max-width: 991px) {
  .cp-empty { grid-template-columns: 1fr; }
}

.cp-ec {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--color-border);
  border-radius: 24px;
  padding: 16px 16px 22px;
  text-decoration: none;
  color: inherit;
  background: var(--color-background);
  transition: transform .25s, box-shadow .25s;
}
.cp-ec:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

.cp-ec__img {
  aspect-ratio: 1;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-background);
  margin-bottom: 16px;
}
.cp-ec__img img,
.cp-ec__img svg {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.cp-ec__txt { padding: 0 6px; flex: 1; margin-bottom: 18px; }
.cp-ec__txt b {
  display: block;
  font-family: var(--font-accent);
  font-size: var(--font-size-h4);
  font-weight: var(--font-weight-heavy);
  letter-spacing: -.02em;
  margin-bottom: 6px;
  line-height: 1.15;
}
.cp-ec__txt span {
  display: block;
  color: var(--color-text-muted);
  font-size: 14px;
  line-height: 21px;
}

.cp-ec .btn { align-self: flex-start; }

/* ── Device accordion ────────────────────────────────────────────── */
.cp-dev {
  border: 1.5px solid var(--color-border);
  border-radius: 22px;
  background: var(--color-background);
  margin-bottom: 16px;
  overflow: hidden;
  position: relative;
}

.cp-dev > summary { list-style: none; cursor: pointer; }
.cp-dev > summary::-webkit-details-marker { display: none; }

.cp-dev__summary {
  display: grid;
  grid-template-columns: 72px minmax(0,1fr) auto;
  gap: 0 16px;
  align-items: center;
  padding: 16px 56px 16px 20px;
  background: var(--color-background);
  user-select: none;
}

.cp-dev__thumb {
  grid-row: 1 / span 2;
  width: 72px;
  height: 72px;
  border-radius: 12px;
  overflow: hidden;
  background: var(--color-background-raised);
  border: 1px solid var(--color-border);
  display: block;
  text-decoration: none;
  align-self: center;
}
.cp-dev__thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }

.cp-dev__t {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-top: 4px;
}
.cp-dev__name {
  display: block;
  font-family: var(--font-accent);
  font-size: 17px;
  font-weight: var(--font-weight-heavy);
  letter-spacing: -.02em;
  line-height: 22px;
  color: inherit;
  text-decoration: none;
}
.cp-dev__name:hover { text-decoration: underline; }
.cp-dev__sub { font-size: 13px; color: var(--color-text-muted); margin-top: 2px; }

.cp-dev__price {
  font-family: var(--font-accent);
  font-weight: var(--font-weight-heavy);
  font-size: 18px;
  font-style: normal;
  white-space: nowrap;
  align-self: flex-start;
  padding-top: 4px;
}

/* × button */
.cp-dev__x {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid var(--color-border);
  background: var(--color-background);
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
  color: var(--color-text);
  display: grid;
  place-items: center;
  padding: 0;
  transition: border-color .15s, background .15s;
  z-index: 1;
}
.cp-dev__x:hover { border-color: var(--color-text); }

/* Toggle row — spans all columns */
.cp-dev__tog {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--color-text-muted);
  font-size: 13px;
  margin: 15px 0 0;
}
.cp-dev__tog svg { transition: transform .2s; margin-left: 2px; }
.cp-dev__tog-show { display: block; margin: 0; padding: 0; }
.cp-dev__tog-hide { display: none; margin: 0; padding: 0; }
details.cp-dev[open] .cp-dev__tog { margin: 15px 0 0; }
details.cp-dev[open] .cp-dev__tog svg { transform: rotate(180deg); }
details.cp-dev[open] .cp-dev__tog-show { display: none; }
details.cp-dev[open] .cp-dev__tog-hide { display: block; margin: 0; padding: 0; }

.cp-dev__body {
  padding: 20px;
  border-top: 1px solid var(--color-border);
}

@media screen and (max-width: 990px) {
  .cp-dev__summary {
    grid-template-columns: 56px minmax(0,1fr) auto;
    padding: 14px 52px 12px 16px;
  }
  .cp-dev__thumb { width: 56px; height: 56px; }
  .cp-dev__body { padding: 8px 16px 16px; }
  .cp-dev__x { top: 10px; right: 10px; }
}

/* ── Pick a set ──────────────────────────────────────────────────── */
.cp-sets { margin-bottom: 28px; }
.cp-sets__h {
  font-family: var(--font-accent);
  font-size: 20px;
  font-weight: var(--font-weight-heavy);
  margin: 0 0 6px;
  letter-spacing: -.01em;
}
.cp-sets__sub { color: var(--color-text-muted); margin-bottom: 16px; font-size: 14px; }

.cp-sets__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 16px;
}
@media screen and (max-width: 990px) {
  .cp-sets__grid { grid-template-columns: 1fr; }
}

.cp-set {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 18px;
  border: 1.5px solid var(--color-border);
  border-radius: 18px;
  cursor: pointer;
  background: var(--color-background);
  transition: border-color .2s, box-shadow .2s;
}
.cp-set:hover { box-shadow: var(--shadow-sm); }
.cp-set.is-active,
.cp-set:has(input:checked) {
  border-color: var(--color-text);
  border-width: 2px;
  padding: 17.5px;
}

.cp-set__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: var(--color-text);
  color: var(--color-background);
  font-size: 10px;
  font-weight: var(--font-weight-bold);
  letter-spacing: .1em;
  padding: 5px 9px;
  border-radius: var(--radius-pill);
  text-transform: uppercase;
}
.cp-set__badge--accent { background: var(--palette-sand, #c8943a); }

.cp-set__img {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12px;
  overflow: hidden;
  background: var(--color-background-raised);
}
.cp-set__img img, .cp-set__img svg { width: 100%; height: 100%; object-fit: cover; display: block; }

.cp-set__name  { font-size: 14px; font-weight: var(--font-weight-semibold); }
.cp-set__price {
  font-family: var(--font-accent);
  font-weight: var(--font-weight-heavy);
  font-size: 22px;
  line-height: 26px;
  letter-spacing: -.02em;
}
.cp-set__price s {
  font-size: 14px;
  font-weight: var(--font-weight-regular);
  color: var(--color-text-muted);
  margin-left: 6px;
  text-decoration: line-through;
}
.cp-set__desc { font-size: 14px; color: var(--color-text-muted); line-height: 22px; }
.cp-set__desc p { margin: 0; }
.cp-set__desc ul { margin: 0; padding: 0; list-style: none; }
.cp-set__desc li::before { content: "·"; margin-right: 6px; }

/* ── Add accessories ─────────────────────────────────────────────── */
.cp-addons__h {
  font-family: var(--font-accent);
  font-size: 20px;
  font-weight: var(--font-weight-heavy);
  margin: 0 0 6px;
  letter-spacing: -.01em;
}
.cp-addons__sub { color: var(--color-text-muted); margin-bottom: 16px; font-size: 14px; }
.cp-addons__group-h {
  font-size: 16px;
  font-weight: var(--font-weight-bold);
  margin: 20px 0 12px;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: .06em;
  font-size: 12px;
}

.cp-addons__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 28px;
}
@media screen and (max-width: 990px) {
  .cp-addons__grid { grid-template-columns: 1fr; }
}

/* Addon card */
.cp-addon--hidden { display: none !important; }

.cp-addon {
  display: grid;
  grid-template-columns: 72px minmax(0,1fr);
  gap: 12px;
  align-items: start;
  padding: 14px;
  border: 1.5px solid var(--color-border);
  border-radius: 16px;
  background: var(--color-background);
  transition: border-color .15s;
}
.cp-addon.is-added { border-color: var(--color-text); border-width: 2px; padding: 13.5px; }

.cp-addon__img {
  width: 72px;
  height: 72px;
  border-radius: 10px;
  overflow: hidden;
  background: var(--color-background-raised);
  border: 1px solid var(--color-border);
  display: block;
  text-decoration: none;
}
.cp-addon__img img,
.cp-addon__img svg { width: 100%; height: 100%; object-fit: contain; display: block; }

.cp-addon__body { display: flex; flex-direction: column; min-width: 0; padding-top: 2px; }
.cp-addon__name {
  display: block;
  font-size: 14px;
  font-weight: var(--font-weight-semibold);
  line-height: 19px;
  color: inherit;
  text-decoration: none;
  margin-bottom: 2px;
}
.cp-addon__name:hover { text-decoration: underline; }
.cp-addon__sub {
  display: block;
  font-size: 12px;
  color: var(--color-text-muted);
  line-height: 17px;
  margin-bottom: 10px;
}

.cp-addon__row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: auto;
}
.cp-addon__price {
  font-family: var(--font-accent);
  font-size: 15px;
  font-weight: var(--font-weight-heavy);
  font-style: normal;
  margin-right: auto;
}

.cp-addon__atc {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  height: 32px;
  padding: 0 14px;
  border-radius: var(--radius-pill);
  background: var(--color-text);
  color: var(--color-background);
  font-size: 10px;
  font-weight: var(--font-weight-bold);
  letter-spacing: .09em;
  text-transform: uppercase;
  white-space: nowrap;
  border: none;
  cursor: pointer;
  transition: background .15s, opacity .15s;
  position: relative;
}
.cp-addon__atc:hover:not(.is-on) { opacity: .75; }
.cp-addon__atc.is-on { background: #96671f; color: #fff; }
.cp-addon__atc.is-on:hover { opacity: .8; }
.cp-addon__atc.is-loading { pointer-events: none; opacity: .5; }

.cp-addon__qty {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.cp-addon__qty-btn {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1px solid var(--color-border);
  background: var(--color-background);
  cursor: pointer;
  font-size: 15px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color .15s;
  padding: 0;
}
.cp-addon__qty-btn:hover { border-color: var(--color-text); }
.cp-addon__qty-num { font-size: 13px; font-weight: var(--font-weight-bold); min-width: 14px; text-align: center; }

.cp-addons__more {
  margin: 12px 0 4px;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 13px;
  font-weight: var(--font-weight-semibold);
  text-decoration: underline;
  text-underline-offset: 3px;
  color: var(--color-text);
  padding: 0;
}
.cp-addons__more:hover { opacity: .7; }

/* ── Standalone accessories list ─────────────────────────────────── */
.cp-acc-section { margin-top: 24px; }

.cp-acc-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.cp-acc-row {
  display: grid;
  grid-template-columns: 64px minmax(0,1fr) auto auto auto;
  gap: 0 14px;
  align-items: center;
  padding: 16px 0;
  border-bottom: 1px solid var(--color-border);
}

.cp-acc-row__img {
  width: 64px;
  height: 64px;
  border-radius: 10px;
  overflow: hidden;
  background: var(--color-background-raised);
  border: 1px solid var(--color-border);
  display: block;
  text-decoration: none;
}
.cp-acc-row__img img, .cp-acc-row__img svg { width: 100%; height: 100%; object-fit: contain; display: block; }

.cp-acc-row__name {
  display: block;
  font-size: 15px;
  font-weight: var(--font-weight-semibold);
  line-height: 20px;
  color: inherit;
  text-decoration: none;
}
.cp-acc-row__name:hover { text-decoration: underline; }
.cp-acc-row__sub { display: block; font-size: 13px; color: var(--color-text-muted); line-height: 18px; margin-top: 2px; }

.cp-acc-row__qty {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.cp-acc-row__qty-btn {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--color-border);
  background: var(--color-background);
  cursor: pointer;
  font-size: 16px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color .15s;
  padding: 0;
}
.cp-acc-row__qty-btn:hover { border-color: var(--color-text); }
.cp-acc-row__qty-num { font-size: 14px; font-weight: var(--font-weight-bold); min-width: 16px; text-align: center; }

.cp-acc-row__price {
  font-family: var(--font-accent);
  font-size: 15px;
  font-weight: var(--font-weight-heavy);
  font-style: normal;
  white-space: nowrap;
  min-width: 60px;
  text-align: right;
}

.cp-acc-row__remove {
  background: #f5f5f4;
  border: none;
  cursor: pointer;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  font-size: 18px;
  line-height: 1;
  display: grid;
  place-items: center;
  color: var(--color-text-muted);
  transition: background .15s, color .15s;
  padding: 0;
}
.cp-acc-row__remove:hover { background: #e5e5e3; color: var(--color-text); }

@media screen and (max-width: 990px) {
  .cp-acc-row {
    grid-template-columns: 56px minmax(0,1fr) auto;
    grid-template-areas:
      'img info rem'
      'img qty  price';
    row-gap: 8px;
  }
  .cp-acc-row__img    { grid-area: img; width: 56px; height: 56px; }
  .cp-acc-row__info   { grid-area: info; }
  .cp-acc-row__qty    { grid-area: qty; }
  .cp-acc-row__price  { grid-area: price; text-align: right; }
  .cp-acc-row__remove { grid-area: rem; justify-self: end; }
}

/* ── Did you forget anything? ────────────────────────────────────── */
.cp-favs { margin-top: 44px; }
.cp-favs__header {
  display: flex;
  align-items: baseline;
  gap: 16px;
  margin-bottom: 18px;
}
.cp-favs__h {
  font-family: var(--font-accent);
  font-size: 22px;
  font-weight: var(--font-weight-heavy);
  letter-spacing: -.02em;
  margin: 0;
}

.cp-favs__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 16px;
}
@media screen and (max-width: 990px) {
  .cp-favs__grid { grid-template-columns: 1fr; }
}

/* Fav card */
.cp-fav {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--color-border);
  border-radius: 18px;
  padding: 14px 14px 16px;
  background: var(--color-background);
}
.cp-fav__img {
  aspect-ratio: 1;
  border-radius: 12px;
  overflow: hidden;
  background: var(--color-background-raised);
  margin-bottom: 12px;
}
.cp-fav__img img, .cp-fav__img svg { width: 100%; height: 100%; object-fit: contain; display: block; }
.cp-fav__name {
  display: block;
  font-size: 14px;
  font-weight: var(--font-weight-semibold);
  line-height: 20px;
  margin-bottom: 2px;
}
.cp-fav__sub {
  display: block;
  font-size: 12px;
  color: var(--color-text-muted);
  line-height: 17px;
  margin-bottom: 8px;
}
.cp-fav__price {
  display: block;
  font-family: var(--font-accent);
  font-size: 15px;
  font-weight: var(--font-weight-heavy);
  margin-bottom: 12px;
  margin-top: auto;
}
.cp-fav__add { align-self: stretch; }

/* ── Sidebar ─────────────────────────────────────────────────────── */
.cp-sidebar {
  position: sticky;
  top: calc(var(--announcement-bar-height, 0px) + 72px);
  border: 1px solid var(--color-border);
  border-radius: 24px;
  padding: 26px;
  background: var(--color-background);
}
@media screen and (max-width: 990px) {
  .cp-sidebar { position: static; }
}

.cp-sidebar__h {
  font-family: var(--font-accent);
  font-size: 20px;
  font-weight: var(--font-weight-heavy);
  margin: 0 0 16px;
  letter-spacing: -.01em;
}

#cp-sidebar-items {
  margin: 0;
  padding: 0;
  list-style: none;
  border-top: 1px solid var(--color-border);
}
#cp-sidebar-items li {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 11px 0;
  border-bottom: 1px solid var(--color-border);
  font-size: 14px;
  line-height: 20px;
}
#cp-sidebar-items li > span:first-child { flex: 1; }
#cp-sidebar-items li small { display: block; color: var(--color-text-muted); font-size: 12px; }

.cp-sidebar__total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16px 0 6px;
  font-family: var(--font-accent);
  font-size: 24px;
  font-weight: var(--font-weight-heavy);
  letter-spacing: -.02em;
}

.cp-sidebar__vat {
  margin: 0 0 16px;
  color: var(--color-text-muted);
  font-size: 12px;
  line-height: 18px;
}

.cp-sidebar__cta { margin-bottom: 4px; }

.cp-sidebar__trust {
  list-style: none;
  margin: 16px 0 0;
  padding: 14px 0 0;
  border-top: 1px solid var(--color-border);
  display: grid;
  gap: 8px;
}
.cp-sidebar__trust li {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  font-size: 14px;
  line-height: 20px;
  color: var(--color-text-muted);
}
.cp-sidebar__trust svg { flex: none; margin-top: 2px; stroke: currentColor; fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

.cp-sidebar__back {
  display: block;
  margin-top: 16px;
  text-align: center;
  font-size: 14px;
  color: var(--color-text-muted);
  text-decoration: none;
}
.cp-sidebar__back:hover { text-decoration: underline; color: var(--color-text); }

/* ── Block spacing ───────────────────────────────────────────────── */
.cp-dev__body .block { margin-bottom: 64px; }
.cp-dev__body .block:last-child { margin-bottom: 0; }

/* ── Page spinner overlay ────────────────────────────────────────── */
#cp-page-spinner {
  position: fixed;
  inset: 0;
  background: rgba(255,255,255,.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9998;
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s;
}
#cp-page-spinner.is-on { opacity: 1; pointer-events: all; }
#cp-page-spinner::after {
  content: '';
  width: 36px;
  height: 36px;
  border: 3px solid var(--color-border);
  border-top-color: var(--color-text);
  border-radius: 50%;
  animation: cp-spin .7s linear infinite;
}
@keyframes cp-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes cp-spin-c { from { transform: translate(-50%,-50%) rotate(0deg); } to { transform: translate(-50%,-50%) rotate(360deg); } }

/* ── Button loading state ────────────────────────────────────────── */
.cp-addon__atc.is-loading {
  pointer-events: none;
  opacity: .7;
  color: transparent;
}
.cp-addon__atc.is-loading::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 13px;
  height: 13px;
  border: 2px solid rgba(255,255,255,.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: cp-spin-c .6s linear infinite;
}
.cp-dev__x.is-loading,
.cp-dev__remove.is-loading { pointer-events: none; opacity: .45; }

/* ── Qty update loading state ────────────────────────────────────── */
.cp-addon--qty-loading { pointer-events: none; opacity: .5; }

/* Section-level loading — pointer events blocked; spinner routed through #cp-page-spinner */
.cp-main { position: relative; }
.cp-main.is-loading { pointer-events: none; }
.cp-addon__qty[hidden],
.cp-fav__add.is-loading { opacity: .6; pointer-events: none; color: transparent; }
.cp-addon__qty[hidden] { display: none; }

/* ── Remove device link ──────────────────────────────────────────── */
.cp-dev__remove {
  display: inline-block;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 14px;
  color: var(--color-text-muted);
  text-decoration: underline;
  text-underline-offset: 3px;
  padding: 0;
  margin-top: 16px;
}
.cp-dev__remove:hover { color: var(--color-text); }

/* ── Mobile sticky checkout bar ──────────────────────────────────── */
.cp-mbar {
  display: none;
}
@media screen and (max-width: 990px) {
  .cp-mbar {
    display: flex;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
    padding: 12px 16px;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
  }
  .cp-mbar__total {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .cp-mbar__label {
    font-size: 11px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
    font-weight: var(--font-weight-semibold);
  }
  .cp-mbar__price {
    font-family: var(--font-accent);
    font-size: 18px;
    font-weight: var(--font-weight-heavy);
    letter-spacing: -.02em;
  }
  .cp-mbar .btn {
    flex-shrink: 0;
  }
  .cart-page { padding-bottom: 100px; }
}
{% endstylesheet %}

