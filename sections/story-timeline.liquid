{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
-%}

<section class="story-timeline {{ scheme_class }} section-padding">
  <div class="container">
    <div class="story-timeline__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h-section story-timeline__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="body-text text-muted story-timeline__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    <ol class="story-timeline__list" tabindex="0">
      {%- for block in section.blocks -%}
        <li class="story-timeline__item" {{ block.shopify_attributes }}>
          <div class="story-timeline__media">
            {%- if block.settings.image -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                class="story-timeline__image"
              >
            {%- else -%}
              <div class="media-placeholder story-timeline__placeholder">
                {%- render 'icon-enso', class: 'media-placeholder__mark' -%}
              </div>
            {%- endif -%}
          </div>

          <div class="story-timeline__marker" aria-hidden="true">
            <span class="story-timeline__dot"></span>
          </div>

          <div class="story-timeline__content">
            {%- if block.settings.year != blank -%}
              <span class="h-catalog story-timeline__year">{{ block.settings.year }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="card__title story-timeline__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="body-text text-muted">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .story-timeline__header {
    max-width: 640px;
    margin-bottom: var(--space-8);
  }

  .story-timeline__heading {
    margin-bottom: var(--space-4);
  }

  .story-timeline__intro {
    max-width: 56ch;
  }

  /*
    Horizontal timeline. Column gap is 0 so each item's marker rule butts against
    its neighbour to form one continuous line; items use inline padding instead.
  */
  .story-timeline__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 1fr);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: var(--space-2);
  }

  .story-timeline__list::-webkit-scrollbar {
    display: none;
  }

  .story-timeline__item {
    display: grid;
    grid-template-rows: auto auto 1fr;
    scroll-snap-align: center;
    padding-inline: var(--space-4);
    text-align: center;
  }

  .story-timeline__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-background-raised);
    box-shadow: var(--shadow-sm);
  }

  .story-timeline__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-timeline__placeholder {
    aspect-ratio: auto;
    width: 100%;
    height: 100%;
  }

  .story-timeline__marker {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 22px;
    margin-block: var(--space-5);
  }

  .story-timeline__marker::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(-1 * var(--space-4));
    right: calc(-1 * var(--space-4));
    height: 1px;
    background-color: var(--color-border);
  }

  .story-timeline__item:first-child .story-timeline__marker::before {
    left: 50%;
  }

  .story-timeline__item:last-child .story-timeline__marker::before {
    right: 50%;
  }

  .story-timeline__dot {
    position: relative;
    z-index: 1;
    width: 12px;
    height: 12px;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-background);
  }

  .story-timeline__year {
    display: block;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .story-timeline__title {
    margin-bottom: var(--space-2);
  }

  @media screen and (max-width: 749px) {
    .story-timeline__list {
      grid-auto-columns: minmax(220px, 78%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.story_timeline.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.story_timeline.settings.color_scheme.label",
      "default": "scheme-paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.story_timeline.settings.eyebrow.label",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.story_timeline.settings.heading.label",
      "default": "A Decade in the Making"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "t:sections.story_timeline.settings.intro.label",
      "default": "The Story: how a decade of AirVape heating expertise became ENSŌ, the coal-free hookah system."
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "t:sections.story_timeline.blocks.milestone.name",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "t:sections.story_timeline.blocks.milestone.settings.year.label",
          "default": "2016"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.story_timeline.blocks.milestone.settings.title.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.story_timeline.blocks.milestone.settings.text.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.story_timeline.blocks.milestone.settings.image.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.story_timeline.presets.name",
      "blocks": [
        {
          "type": "milestone",
          "settings": {
            "year": "A decade earlier",
            "title": "AirVape heats the way",
            "text": "Ten years spent perfecting fast, precise heating technology — the foundation everything ENSŌ would build on."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2020",
            "title": "AirVape × ENSŌ",
            "text": "AirVape partners with the ENSŌ team to reimagine the hookah ritual — coal-free, cordless, built to travel."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "In development",
            "title": "Coal-free by design",
            "text": "Porcelain chamber, glass water tank, swap-out battery and magnetic mouthpieces — engineered so nothing about the ritual feels compromised."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "Today",
            "title": "ENSŌ, ready to ship",
            "text": "ENSŌ ships worldwide, with DIAMOND — a faceted, light-catching finish on the same system — now taking pre-orders."
          }
        }
      ]
    }
  ]
}
{% endschema %}
