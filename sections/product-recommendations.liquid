{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
  assign is_carousel = false
  if section.settings.layout == 'carousel'
    assign is_carousel = true
  endif

  assign fallback_collection = section.settings.collection
  assign products_source = blank

  if recommendations.performed and recommendations.products_count > 0
    assign products_source = recommendations.products
  elsif fallback_collection != blank and fallback_collection.products_count > 0
    assign products_source = fallback_collection.products
  endif
-%}

{% render 'carousel-styles',
  section_id: section.id,
  columns_desktop: section.settings.columns,
  columns_mobile: section.settings.columns_mobile,
  gap: section.settings.card_gap,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  padding_top_mobile: section.settings.padding_top_mobile,
  padding_bottom_mobile: section.settings.padding_bottom_mobile
%}

{%- if product -%}
  <product-recommendations
    class="product-recommendations"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_limit }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {%- if products_source != blank -%}
      <carousel-slider
        id="Carousel-{{ section.id }}"
        class="product-recommendations__carousel {{ scheme_class }}"
        {% unless is_carousel %}data-static="true"{% endunless %}
      >
        <div class="container">
          <div class="carousel__header">
            <div>
              {%- if section.settings.eyebrow != blank -%}
                <p class="eyebrow">{{ section.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if section.settings.heading != blank -%}
                <h2 class="h-section">{{ section.settings.heading }}</h2>
              {%- endif -%}
            </div>

            <div class="carousel__actions">
              {%- if section.settings.cta_label != blank -%}
                <a href="{{ section.settings.cta_link | default: fallback_collection.url | default: '#' }}" class="btn btn--outline">
                  {{ section.settings.cta_label }}
                </a>
              {%- endif -%}

              {%- if is_carousel -%}
                <div class="carousel__controls">
                  <button type="button" class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
                    {%- render 'icon-chevron' -%}
                  </button>
                  <button type="button" class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="{{ 'accessibility.next_slide' | t }}">
                    {%- render 'icon-chevron' -%}
                  </button>
                </div>
              {%- endif -%}
            </div>
          </div>

          <div
            class="carousel__track {% unless is_carousel %}carousel__track--grid{% endunless %}"
            {% if is_carousel %}data-carousel-track tabindex="0"{% endif %}
            role="group"
            aria-label="{{ section.settings.heading | escape }}"
          >
            {%- for card_product in products_source limit: section.settings.products_limit -%}
              {%- render 'card-product', product: card_product, section: section, quick_add: section.settings.enable_quickadd -%}
            {%- endfor -%}
          </div>
        </div>
      </carousel-slider>
    {%- elsif request.design_mode -%}
      <div class="container">
        <p class="body-text text-muted">{{ 'sections.product_recommendations.onboarding' | t }}</p>
      </div>
    {%- endif -%}
  </product-recommendations>

  <script src="{{ 'product-recommendations.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-paper"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection",
      "info": "Shown only when Shopify has no recommendations for this product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel (scrollable row)" },
        { "value": "grid", "label": "Simple grid (wraps into rows)" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Cards per row — desktop",
      "options": [
        { "value": "2", "label": "2 cards" },
        { "value": "3", "label": "3 cards" },
        { "value": "4", "label": "4 cards" },
        { "value": "5", "label": "5 cards" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Cards per row — mobile",
      "options": [
        { "value": "1", "label": "1 card" },
        { "value": "2", "label": "2 cards" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between cards",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "info": "Shopify's recommendation engine returns at most 10 products",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "enable_quickadd",
      "label": "Enable quick add"
    }
  ],
  "presets": [
    { "name": "Product recommendations" }
  ]
}
{% endschema %}
