{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
-%}

<section class="awards {{ scheme_class }} section-padding">
  <div class="container">
    <div class="awards__header text-center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h-section">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="awards__grid {% if section.settings.logo_list %}awards__logo-list{% endif %}">
      {%- for block in section.blocks -%}
        <div class="award column-design-{{ section.settings.cards_layout }} text-center" {{ block.shopify_attributes }}>
          <div class="award__medallion">
            {%- if block.settings.image -%}
              <img
                src="{{ block.settings.image | image_url: width: 240 }}"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                class="award__image"
              >
            {%- else -%}
              {%- render 'icon-enso', class: 'award__placeholder-mark' -%}
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="h-feature award__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.subtitle != blank -%}
            <p class="caption award__subtitle">{{ block.settings.subtitle }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="body-text text-muted award__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  .awards__header {
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-7);
  }

  .awards__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: {{ section.settings.section_gap }}px;
  }

  .awards__logo-list {
    display: flex;
    justify-content: center;
  }

  .award {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-radius: var(--radius-xl);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .award.column-design-card {
    background-color: var(--color-background-raised);
    box-shadow: var(--shadow-sm);
    padding: var(--space-7) var(--space-5);
  }

  .award.column-design-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .award__medallion {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    margin-bottom: var(--space-5);
    border-radius: var(--radius-pill);
    background: linear-gradient(150deg, var(--color-accent) 0%, var(--color-accent-soft) 100%);
    box-shadow: var(--shadow-sm);
  }

  .awards__logo-list .award__medallion {
    background: transparent;
    box-shadow: none;
  }

  .award__image {
    width: 60%;
    height: 60%;
    object-fit: contain;
  }
  
  .awards__logo-list .award__image {
    width: 100%;
    height: 100%;
  }

  .award__placeholder-mark {
    width: 38px;
    height: 38px;
    color: var(--color-accent);
  }

  .award__subtitle {
    margin-top: var(--space-2);
  }

  .award__text {
    margin-top: var(--space-4);
    max-width: 36ch;
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.awards.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.awards.settings.color_scheme.label",
      "default": "scheme-graphite"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.awards.settings.eyebrow.label",
      "default": "Recognition"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.awards.settings.heading.label",
      "default": "Industry Validation"
    },
    {
      "id": "section_gap",
      "type": "range",
      "label": "Gap",
      "default": 48,
      "min": 16,
      "max": 48,
      "step": 4
    },
    {
      "id": "cards_layout",
      "type": "select",
      "label": "Cards Design",
      "default": "card",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "card",
          "label": "Card"
        }
      ]
    },
    {
      "id": "logo_list",
      "type": "checkbox",
      "label": "Logo List Design",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "award",
      "name": "t:sections.awards.blocks.award.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.awards.blocks.award.settings.image.label"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.awards.blocks.award.settings.title.label",
          "default": "Red Dot Winner",
          "visible_if": "{{ section.settings.logo_list == false }}"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "t:sections.awards.blocks.award.settings.subtitle.label",
          "default": "Design Award · 2026",
          "visible_if": "{{ section.settings.logo_list == false }}"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.awards.blocks.award.settings.text.label",
          "visible_if": "{{ section.settings.logo_list == false }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.awards.presets.name",
      "blocks": [
        {
          "type": "award",
          "settings": {
            "title": "Red Dot Winner",
            "subtitle": "Design Award · 2026"
          }
        },
        {
          "type": "award",
          "settings": {
            "title": "Best Hookah",
            "subtitle": "Shisha of the Year · 2025"
          }
        }
      ]
    }
  ]
}
{% endschema %}
