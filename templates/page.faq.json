        "question_AWFNDz": {
          "type": "question",
          "settings": {
            "tab": "enso",
            "question": "Can two people use ENSŌ at once?",
            "answer": "<p>Technically yes with a Y-adapter, but airflow drops. For best performance share one hose sequentially.</p>"
