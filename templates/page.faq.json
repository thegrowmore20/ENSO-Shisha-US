          "settings": {
            "question": "Where can I buy ENSŌ?",
            "answer": "<p>Order directly at <a href=\"https://ensoshisha.com\" title=\"https://ensoshisha.com\">ensoshisha.com</a> or through resellers in your country.</p>"
          }
        },
        "question_BQQxzy": {
          "type": "question",
          "settings": {
            "question": "Can I order ENSŌ outside the US?",
            "answer": "<p>Yes. We ship to the European Union, Canada, Malaysia, Hong Kong SAR, Israel,<br/>Japan, Qatar, Singapore, and South Korea via <a href=\"https://ensoshisha.com\" title=\"https://ensoshisha.com\">ensoshisha.com</a>. For Russia and<br/>the CIS, visit <a href=\"https://ensoshisha.ru\" title=\"https://ensoshisha.ru\">ensoshisha.ru</a>.</p>"
          }
        },
        "question_hp4LDt": {
          "type": "question",
          "settings": {
            "question": "How fast will my order ship and arrive?",
            "answer": "<p>In-stock items leave the warehouse within 24h; typical shipping is 2-4 business days inside the US.</p>"
          }
        },
        "question_nb6JAr": {
          "type": "question",
          "settings": {
            "question": "My country isn’t listed—can you still deliver?",
            "answer": "<p>E-mail <a href=\"mailto:hello@ensoshisha.com\" title=\"mailto:hello@ensoshisha.com\">hello@ensoshisha.com</a> with your address and we’ll arrange a quote or put you in touch with a local partner.</p>"
