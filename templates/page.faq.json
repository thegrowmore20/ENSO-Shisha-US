        "question_4mQKPc": {
          "type": "question",
          "settings": {
            "question": "How will I know my order was placed successfully?",
            "answer": "<p>Within a minute of checkout you’ll receive a confirmation e-mail with your order<br/>number. A second e-mail goes out once the parcel ships, followed by automatic<br/>tracking updates.</p>"
          }
        },
        "question_YhcDK3": {
          "type": "question",
          "settings": {
            "question": "Can I edit or cancel my order?",
            "answer": "<p>If the parcel hasn’t been packed, we can still change the address, items, or quantities. Contact Support at <a href=\"mailto:support@ensoshisha.eu\" title=\"mailto:support@ensoshisha.eu\">support@ensoshisha.eu</a> immediately; once the label has been printed, the order is locked.</p>"
          }
        },
        "question_BYVKtQ": {
          "type": "question",
          "settings": {
            "question": "How do I return or replace a damaged or defective item?",
            "answer": "<p>Photograph any damage or record a video of the issue, and contact Support at <a href=\"mailto:support@ensoshisha.com\" title=\"mailto:support@ensoshisha.com\">support@ensoshisha.com</a> within 48h of delivery. We’ll issue a prepaid label or ship a replacement at no cost once the claim is approved.</p>"
          }
        },
        "question_XktBWD": {
          "type": "question",
          "settings": {
            "question": "Can I return an unused product for a refund?",
            "answer": "<p>An unopened box can be returned within 14 days for a full refund. Opened units in<br/>Like-new condition may be returned within 30 days; a $25 refurbishment fee applies.</p>"
          }
        },
        "question_GwkDDK": {
          "type": "question",
          "settings": {
            "question": "Do you offer wholesale pricing?",
            "answer": "<p>Yes—write to <a href=\"mailto:hello@ensoshisha.com\" title=\"mailto:hello@ensoshisha.com\">hello@ensoshisha.com</a> with a short description of your company<br/>and the quantities required.<br/><br/></p>"
