          "settings": {
            "tab": "orders",
            "question": "How is my personal data used?",
            "answer": "<p>We comply with GDPR. Your details are used solely to process orders, provide support, and — if you opt in — send product updates. We never sell or trade customer data. See our Privacy Policy for full details.</p>"
          }
        },
        "question_RrAcTi": {
          "type": "question",
          "settings": {
