          "type": "question",
          "settings": {
            "question": "Is ENSŌ healthier than a charcoal hookah?",
            "answer": "<p>Replacing coal cuts ~95 % of carbon monoxide, ash and embers, producing a<br/>smoother, cleaner vapour with far fewer indoor pollutants.</p>"
          }
        },
        "question_cqpaRH": {
          "type": "question",
          "settings": {
            "question": "Will ENSŌ set off smoke detectors?",
            "answer": "<p>Unlikely in normal use. Heavy exhaled vapour directly into a detector may trigger particulate sensors; maintain ventilation.</p>"
          }
        },
        "question_fXgqEH": {
