          "settings": {
            "tab": "enso",
            "question": "Is ENSŌ suitable for outdoor use?",
            "answer": "<p>Yes — its sealed alloy body and cordless design suit patios, rooftops and parks. Avoid heavy rain or sand.</p>"
          }
        },
        "question_4U9ADi": {
          "type": "question",
          "settings": {
            "tab": "enso",
            "question": "What is the minimum and maximum ambient temperature for operation?",
            "answer": "<p>Operate the ENSŌ only within 5 °C – 40 °C (41 °F – 104 °F) to protect the battery and electronics.</p>"
          }
        },
        "question_QHUUiK": {
          "type": "question",
          "settings": {
            "tab": "enso",
            "question": "Which optional accessories are available?",
            "answer": "<p>Extra batteries · Set of 3 ceramic cups · Thermocap · Set of 2 Flower Cup · Glass Collar · 20-/50-pack disposable cups · Gold-plated herb cup · Wax cup · Acrylic water tank with extended dip tube · Travel bag · 1.5 m hose and magnetic mouthpiece · Mouthpiece extension · Cup removal tool · Replacement glass and dip tube · Mesh screen kit · Scrub tool · Straps<br/>(See ▶ <a href=\"/collections/accesories\">Accessories</a>)</p>"
