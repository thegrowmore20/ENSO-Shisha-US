        },
        "question_VWMMe4": {
          "type": "question",
          "settings": {
            "tab": "enso",
            "question": "Which tobaccos or herbal blends work best with ENSŌ?",
            "answer": "<p>ENSŌ handles any moist, molasses-based shisha — dark-leaf or blonde — as well as herbal mixes. Smaller leafs and semi-dense packing works the best. If your chosen tobacco have large leafs, you can cut them with scissors before loading into the bowl.</p>"
          }
        },
