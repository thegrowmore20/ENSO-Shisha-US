        },
        "question_iFqbxe": {
          "type": "question",
          "settings": {
            "question": "What if my card payment is declined?",
            "answer": "<p>There are many reasons a card might be declined. You can always use another<br/>payment method.<br/>If you still have problems, please contact customer service by emailing:<br/><a href=\"mailto:support@ensoshisha.eu\" title=\"mailto:support@ensoshisha.eu\">support@ensoshisha.eu</a></p>"
          }
