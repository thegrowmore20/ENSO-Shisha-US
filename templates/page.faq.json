            "question": "Can I use ENSŌ in bars, restaurants or hotels?",
            "answer": "<p>Most venues that prohibit open flames accept ENSŌ. Always verify local rules and ventilation requirements first.</p>"
          }
        },
        "question_kLhPHd": {
          "type": "question",
          "settings": {
            "question": "How do I dispose of batteries and cups?",
            "answer": "<p>Take spent Li-ion packs to any e-waste centre. Rinse aluminium cups and recycle with metal waste.</p>"
