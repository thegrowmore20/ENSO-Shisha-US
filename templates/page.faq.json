    "faqs_page_qPxdTg": {
      "type": "faqs-page",
      "blocks": {
        "q_diamond_what_is": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-what-is-diamond",
            "question": "What is Diamond?",
            "answer": "<p>An electric heater that replaces charcoal on a traditional hookah. It sits where the bowl sits: pack the cup, set the temperature, start. No coals, no lighting, no waiting.</p>"
          }
        },
        "q_diamond_fit": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-will-it-fit-my-hookah",
            "question": "Will it fit my hookah?",
            "answer": "<p>It fits stems that take a standard bowl, using one of the two adapters in the box, long or short. Not sure? Send a photo of your stem top to <a href=\"mailto:support@ensoshisha.eu\">support@ensoshisha.eu</a>.</p>"
          }
        },
        "q_diamond_taste": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-does-the-tobacco-taste-different",
            "question": "Does the tobacco taste different?",
            "answer": "<p>Cleaner. The blend is warmed to a set temperature instead of being scorched from above, so you taste the leaf and the molasses, not the coal.</p>"
          }
        },
        "q_diamond_temp": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-what-temperature-should-i-use",
            "question": "What temperature should I use?",
            "answer": "<p>Most blends sit well at 250–270 °C. For a dark blend, start at 290 °C for the first minutes, then come down to 270 and 250 °C. Every tobacco is made for coal and behaves a little differently, so note what works and save it as a profile.</p>"
          }
        },
        "q_diamond_battery": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-how-long-does-the-battery-last",
            "question": "How long does the battery last?",
            "answer": "<p>About 90 minutes, pre-heat not included. Charge over USB-C while you smoke, or switch Diamond off, swap to a second Diamond Battery and switch it back on.</p>"
          }
        },
        "q_diamond_clean": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-how-do-i-clean-it",
            "question": "How do I clean it?",
            "answer": "<p>After every session, lift the cup out with the removal tool, empty it and brush the chamber. Once a week, soak the basket and the screens, rinse the cap and wipe the body with a cloth.</p>"
          }
        },
        "q_diamond_tobacco_amount": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-how-much-tobacco-does-it-take",
            "question": "How much tobacco does it take?",
            "answer": "<p>10–15 g. Use the basket mesh for a loose, airy pack, or a flat screen for a denser pack. The packing guide has a starting point for each.</p>"
          }
        },
        "q_diamond_preheat": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-how-does-pre-heat-work",
            "question": "How does pre-heat work?",
            "answer": "<p>You set both the time, 0–15 minutes, and the temperature it warms to. Default is 7 minutes at 275 °C. Diamond tells you when it is ready.</p>"
          }
        },
        "q_diamond_profiles": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-what-are-profiles",
            "question": "What are profiles?",
            "answer": "<p>Four presets on the dial. Default always starts at 7 minutes and 275 °C. Phoenix, Wraith and Oracle keep the time and temperature you set last, each in its own colour. Open Menu, Profiles, and turn to choose.</p>"
          }
        },
        "q_diamond_charge": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-how-do-i-charge-it",
            "question": "How do I charge it?",
            "answer": "<p>Over USB-C, about 1.5 hours with a 30 W supply. The battery also charges on its own, outside Diamond. There is no charger in the box.</p>"
          }
        },
        "q_diamond_app": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-do-i-need-an-app-wi-fi-or-an-account",
            "question": "Do I need an app, Wi-Fi or an account?",
            "answer": "<p>No. Everything is on the dial. Firmware updates run over USB-C from a page on ensoshisha.eu, coming with the first update.</p>"
          }
        },
        "q_diamond_touch": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-can-i-touch-it-during-a-session",
            "question": "Can I touch it during a session?",
            "answer": "<p>Yes, by the band and the lower body. The cup and the cap are hot, the way a bowl and its foil would be. Let it cool 10 minutes before you open it.</p>"
          }
        },
        "q_diamond_plane": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-can-i-take-it-on-a-plane",
            "question": "Can I take it on a plane?",
            "answer": "<p>Yes, in hand luggage, like any device with a lithium battery. Take the pack out and carry it with you; never check it in.</p>"
          }
        },
        "q_diamond_spares": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-what-wears-out-and-can-i-buy-spares",
            "question": "What wears out, and can I buy spares?",
            "answer": "<p>The cups, screens, mesh and adapters wear like any bowl and grommet. Every one of them, plus the cap, battery and cable, is sold separately.</p>"
          }
        },
        "q_diamond_warranty": {
          "type": "question",
          "settings": {
            "tab": "diamond",
            "anchor_id": "q-warranty-and-returns",
            "question": "Warranty and returns?",
            "answer": "<p>Two years on Diamond, one year on the battery. Returns: 14 days from delivery for an unopened box, 30 days for an opened one. Write to <a href=\"mailto:support@ensoshisha.eu\">support</a> first.</p>"
          }
        },
