          "settings": {
            "image": "shopify://shop_images/s-feat-cup-swap.webp",
            "alt": "The cup removal tool lifting the packed ceramic cup out of Diamond",
            "title": "Change the cup mid-session",
            "sub": "Lift the cup out, drop the next one in",
            "text": "The cup lifts out of the chamber with the tool, even hot. Pack the second cup while the first one runs, then swap and carry on with a new flavor without waiting for the device to cool.",
