        "feat_blend": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/s-feat-blend-open.webp",
            "alt": "A hand lifting the thermo cap off Diamond, the cup packed with tobacco",
            "title": "Any blend you like",
            "sub": "Blonde, dark or your own mix, 10–15 g in the cup",
            "text": "Pack the cup the way you pack a bowl. Light blonde leaf, heavy dark leaf, creamy or minty, one flavor or your own mix: Diamond takes the tobacco you already buy, with no pods and no cartridges.",
            "small": "No pods, no cartridges",
            "more1_h": "Blonde and dark",
            "more1_p": "Blonde leaf likes a gentler start; dark leaf takes more heat and a longer pre-heat. Both hold for the whole session because the controller keeps the temperature to the degree.",
            "more2_h": "Your own mix",
            "more2_p": "Layer two flavors or split the cup half and half. Keep the load at 10–15 g and leave the center loose so the air moves.",
            "more3_h": "Basket or screen",
            "more3_p": "Wet, heavy blends breathe in the steel basket; dry, fine cuts sit under the flat screen. Both are in the box."
          }
        },
        "feat_swap": {
