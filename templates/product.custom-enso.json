    "faqs_page_Tbjgat": {
      "type": "faqs-page",
      "blocks": {
        "question_zgbhyB": {
          "type": "question",
          "settings": {
            "question": "What changed in ENSŌ 2026?",
            "answer": "<p>A new glass top (Glass ThermoCap), a wider 1.5 m vapor hose, a redesigned 15 cm mouthpiece, and a fast-charge Battery Plus (full in ~1.5 h, down from ~3 h). Key features: magnetic mouthpiece, cordless operation, portability, and temperature control. The design also received the Red Dot Design Award 2026 in Product Design.</p>"
          }
        },
        "question_WMtzmA": {
          "type": "question",
          "settings": {
            "question": "How does the heat work?",
            "answer": "<p>A stepless electronic dial sets the temperature from 180 to 330 °C in 5° steps. A fixed 5-minute pre-heat reaches your setting, then holds it steady through the session — so the last draw lands like the first.</p>"
          }
        },
        "question_x4ND8H": {
          "type": "question",
          "settings": {
            "question": "Has the airflow improved for 2026?",
            "answer": "<p>Yes. The wider, longer 1.5 m hose and the redesigned 15 cm magnetic mouthpiece open up the draw — less resistance, more air, a smoother and more even pull from the first minute to the last.</p>"
          }
        },
        "question_MrFrAn": {
          "type": "question",
          "settings": {
            "question": "Can I use my own molasses?",
            "answer": "<p>Yes. ENSŌ is an open system — the medical porcelain chamber accepts any standard shisha brand or loose-leaf blend. No proprietary pods. No charcoal, no fire, no ash.</p>"
          }
        },
        "question_7PJXzz": {
          "type": "question",
          "settings": {
            "question": "How long does the battery last?",
            "answer": "<p>Approximately 90 to 120 minutes per charge depending on temperature. The fast-charge Battery Plus reaches a full charge in about 1.5 hours — down from ~3 h on the previous edition.</p>"
          }
        },
        "question_7k4K7g": {
          "type": "question",
          "settings": {
            "question": "How does shipping work?",
            "answer": "<p>ENSŌ ships globally. Region-specific shipping is calculated at checkout. Average delivery is about 2 weeks; tracking is provided once the order ships.</p>"
          }
        }
      },
      "block_order": [
        "question_zgbhyB",
