    "dm_cleaning": {
      "type": "dm-cleaning",
      "blocks": {
        "cup_step1": {
          "type": "cup_step",
          "settings": {
            "image": "shopify://shop_images/clean-01-lift-cup-out.webp",
            "step_title": "Let it cool, then lift it out",
            "step_body": "<p>After 20–30 minutes, slide the fork under the brim and lift the cup straight out.</p>"
          }
        },
        "cup_step2": {
          "type": "cup_step",
          "settings": {
            "image": "shopify://shop_images/clean-00b-loosen-edge.webp",
            "step_title": "Loosen around the edge",
            "step_body": "<p>Flat screen: run the tip of the fork around the inside edge of the cup so the tobacco comes away from the wall. Basket: lift the basket out first and run the fork around its edge the same way.</p>"
          }
        },
        "cup_step3": {
          "type": "cup_step",
          "settings": {
            "image": "shopify://shop_images/clean-02-push-mesh-out.webp",
            "step_title": "Push it out from below",
            "step_body": "<p>Then push from below, through the hole in the bottom, with the tool. The tobacco comes out with the screen or the basket.</p>"
          }
        },
        "cup_step4": {
          "type": "cup_step",
          "settings": {
            "image": "shopify://shop_images/clean-03-out-in-one-piece.webp",
            "step_title": "Out in one piece",
            "step_body": "<p>The tobacco comes out with the mesh. Tip it into the bin and pull the last bits off the mesh.</p>"
          }
        },
        "cup_step5": {
          "type": "wash_step",
          "settings": {
            "image": "shopify://shop_images/clean-04-rinse.webp",
            "step_title": "Rinse",
            "step_body": "<p>Rinse the cup and the mesh under warm running water.</p>"
          }
        },
        "cup_step6": {
          "type": "wash_step",
          "settings": {
            "image": "shopify://shop_images/clean-05-scrubber.webp",
            "step_title": "Sponge or steel scrubber",
            "step_body": "<p>Run a sponge over the inside of the cup and over the mesh. A steel scrubber pad takes off anything that sticks.</p>"
          }
        },
        "cup_step7": {
          "type": "wash_step",
          "settings": {
            "image": "shopify://shop_images/clean-06-soak.webp",
            "step_title": "Stuck? Soak it",
            "step_body": "<p>Leave the cup and the mesh in warm water for a while, then sponge again. The dishwasher works, but we do not recommend it: the ceramic gets more brittle.</p>"
          }
        },
        "cap_step1": {
          "type": "cap_step",
          "settings": {
            "image": "shopify://shop_images/cap-parts-rinse.webp",
            "step_title": "Rinse all three parts",
            "step_body": "<p>The shell, the plate and the insert. Let them dry fully before the next session.</p>"
          }
        },
        "cap_step2": {
          "type": "shaft_step",
          "settings": {
            "image": "shopify://shop_images/clean-capoff-back-brush.webp",
            "step_title": "Battery in, latch closed",
            "step_body": "<p>Give Diamond an hour to an hour and a half to cool, then lift the cap off. Leave the battery in with the latch closed the whole time: it closes the bay so no water reaches the contacts.</p>"
          }
        },
        "shaft_step1": {
          "type": "shaft_step",
          "settings": {
            "image": "shopify://shop_images/clean-shaft-brush.webp",
            "step_title": "Brush the shaft",
            "step_body": "<p>Push the cleaning brush through the shaft from the top.</p>"
          }
        },
        "shaft_step2": {
          "type": "shaft_step",
          "settings": {
            "image": "shopify://shop_images/ok-rinse-shaft.webp",
            "step_title": "Rinse from the top",
            "step_body": "<p>A gentle stream from the top only, the battery fitted. Let everything dry fully.</p>"
          }
        },
        "never_step1": {
          "type": "never_step",
          "settings": {
            "image": "shopify://shop_images/dont-water-bay.webp",
            "step_title": "No water in the battery bay",
            "step_body": "<p>Rinse from the top only, with the battery fitted.</p>"
          }
        },
        "never_step2": {
          "type": "never_step",
          "settings": {
            "image": "shopify://shop_images/dont-water-battery.webp",
            "step_title": "Keep the battery dry",
            "step_body": "<p>The battery never goes under water. Neither do the body and the dial, and none of it goes into a dishwasher.</p>"
          }
        }
      },
