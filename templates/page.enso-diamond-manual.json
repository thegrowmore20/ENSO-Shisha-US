    "dm_cap": {
      "type": "dm-cap",
      "blocks": {
        "cap_step_parts": {
          "type": "cap_step",
          "settings": {
            "image": "shopify://shop_images/cap-parts-white.webp",
            "contain_image": true,
            "step_title": "Three parts",
            "step_body": "<p>The shell that holds the heat, the plate that sets the draw, and the insert that holds them.</p>"
          }
        },
        "cap_step_fork": {
          "type": "cap_step",
          "settings": {
            "image": "shopify://shop_images/plate-fork-macro.webp",
            "contain_image": false,
            "step_title": "Five positions",
            "step_body": "<p>Four open settings and fully closed. Closed there is no draw. Turn it with the cup tool, even during a session.</p>"
          }
        },
        "cap_step_holes": {
          "type": "cap_step",
          "settings": {
            "image": "shopify://shop_images/cap-holes.webp",
            "contain_image": false,
            "step_title": "Where to start",
            "step_body": "<p>Fully open, all four holes free. Start there and close it a step only if you want a denser draw.</p>"
          }
        },
        "cap_step_off": {
          "type": "cap_step",
          "settings": {
            "image": "shopify://shop_images/cap-off.webp",
            "contain_image": false,
            "step_title": "Lift by the pads",
            "step_body": "<p>Hold the cap only by its rubber side pads and lift it straight up. It is hot during a session.</p>"
          }
        },
        "cap_step_press": {
          "type": "cap_step",
          "settings": {
            "image": "shopify://shop_images/cap-on-press-pad.webp",
            "contain_image": false,
            "step_title": "Cap on",
            "step_body": "<p>Set it back flush and press on the rubber pad, never on the hot top.</p>"
          }
        }
      },
