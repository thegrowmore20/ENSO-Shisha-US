<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background | default: '#ffffff' }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

  {%- render 'meta-tags' -%}

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- render 'theme-fonts' -%}
  {%- render 'css-variables' -%}
  {{ 'base.css' | asset_url | stylesheet_tag }}

  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'wishlist-reveal.js' | asset_url }}" defer="defer"></script>

  {{ content_for_header }}

  {%- if settings.cart_type == 'drawer' -%}
    {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
</head>

<body class="template-{{ request.page_type | handleize }}">
  <div class="scroll-progress-bar" data-scroll-progress></div>

  <a class="skip-to-content-link" href="#MainContent">
    {{ 'accessibility.skip_to_content' | t }}
  </a>

  {% sections 'header-group' %}

  <main id="MainContent" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {%- comment -%}
    Theme settings > Cart > Cart type. With "drawer" the cart opens in a
    side panel and add-to-cart stays on the page; with "page" neither the
    drawer nor its script is loaded, so the cart icon and add-to-cart forms
    fall back to the cart page.
  {%- endcomment -%}
  {%- if settings.cart_type == 'drawer' -%}
    {% section 'cart-drawer' %}
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if settings.enable_product_card_swatches -%}
    <script src="{{ 'product-card-swatches.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% render 'product-popup' %}
  {% render 'age-verification-popup' %}
</body>
</html>
