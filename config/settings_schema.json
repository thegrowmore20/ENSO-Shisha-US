[
  {
    "name": "theme_info",
    "theme_name": "ENSO",
    "theme_version": "0.2.0",
    "theme_author": "ENSO",
    "theme_documentation_url": "https://ensoshisha.com/",
    "theme_support_url": "https://ensoshisha.com/pages/support"
  },
  {
    "name": "t:settings.logo.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.logo.headers.logo"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings.logo.logo.label",
        "info": "t:settings.logo.logo.info"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 2,
        "default": 112,
        "unit": "px",
        "label": "t:settings.logo.logo_width.label"
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 60,
        "max": 200,
        "step": 2,
        "default": 92,
        "unit": "px",
        "label": "t:settings.logo.logo_width_mobile.label"
      },
      {
        "type": "image_picker",
        "id": "logo_inverse",
        "label": "t:settings.logo.logo_inverse.label",
        "info": "t:settings.logo.logo_inverse.info"
      },
      {
        "type": "header",
        "content": "t:settings.logo.headers.favicon"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.logo.favicon.label",
        "info": "t:settings.logo.favicon.info"
      }
    ]
  },
  {
    "name": "t:settings.colors.name",
    "settings": [
      {
        "type": "color_palette",
        "id": "color_palette",
        "default": {
          "background": "#FFFFFF",
          "foreground": "#000000",
          "white": "#FFFFFF",
          "ink": "#1D1D1F",
          "graphite": "#1A1813",
          "sand": "#C8943A",
          "sand_deep": "#B3832F",
          "bronze": "#96671F",
          "gold": "#FBBC05",
          "paper": "#FAF6EC",
          "cream": "#F0E8D8",
          "ivory": "#F8F5EF",
          "linen": "#F5F1E6",
          "mist": "#F5F5F4",
          "stone": "#333333",
          "line": "#E6E6E6",
          "champagne": "#A8875A",
          "error": "#9B3B2A",
          "sale": "#EA4335"
        }
      },
      {
        "type": "header",
        "content": "t:settings.colors.headers.page"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "t:settings.colors.color_background.label",
        "default": "{{ settings.color_palette.background }}"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "t:settings.colors.color_text.label",
        "default": "{{ settings.color_palette.foreground }}"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "t:settings.colors.color_text_muted.label",
        "default": "{{ settings.color_palette.stone }}"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "t:settings.colors.color_surface.label",
        "info": "t:settings.colors.color_surface.info",
        "default": "{{ settings.color_palette.mist }}"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "t:settings.colors.color_border.label",
        "default": "{{ settings.color_palette.line }}"
      },
      {
        "type": "header",
        "content": "t:settings.colors.headers.accent"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "t:settings.colors.color_accent.label",
        "info": "t:settings.colors.color_accent.info",
        "default": "{{ settings.color_palette.sand }}"
      },
      {
        "type": "color",
        "id": "color_accent_hover",
        "label": "t:settings.colors.color_accent_hover.label",
        "default": "{{ settings.color_palette.sand_deep }}"
      },
      {
        "type": "color",
        "id": "color_focus",
        "label": "t:settings.colors.color_focus.label",
        "default": "{{ settings.color_palette.bronze }}"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "t:settings.colors.color_error.label",
        "default": "{{ settings.color_palette.error }}"
      },
      {
        "type": "header",
        "content": "t:settings.colors.headers.inverse"
      },
      {
        "type": "paragraph",
        "content": "t:settings.colors.inverse_paragraph"
      },
      {
        "type": "color",
        "id": "color_inverse_background",
        "label": "t:settings.colors.color_inverse_background.label",
        "default": "{{ settings.color_palette.ink }}"
      },
      {
        "type": "color",
        "id": "color_inverse_text",
        "label": "t:settings.colors.color_inverse_text.label",
        "default": "{{ settings.color_palette.white }}"
