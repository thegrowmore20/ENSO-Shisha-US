  {
    "name": "Cart",
    "settings": [
      {
        "type": "header",
        "content": "Free shipping bar"
      },
      {
        "type": "checkbox",
        "id": "free_shipping_bar_enable",
        "label": "Show free shipping progress bar in cart",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_bar_threshold",
        "label": "Free shipping threshold",
        "info": "Amount in your store's currency, e.g. 75 for $75.00",
        "default": 75
      },
      {
        "type": "text",
        "id": "free_shipping_bar_message_below",
        "label": "Message before threshold is reached",
        "info": "Use [amount] to insert the remaining amount",
        "default": "Spend [amount] more for free shipping!"
      },
      {
        "type": "text",
        "id": "free_shipping_bar_message_achieved",
        "label": "Message once threshold is reached",
        "default": "You've unlocked free shipping!"
      },
      {
        "type": "color",
        "id": "free_shipping_bar_fill_color",
        "label": "Progress bar fill color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "free_shipping_bar_track_color",
        "label": "Progress bar track color",
        "default": "#E5E5E5"
      },
      {
        "type": "header",
        "content": "Empty cart"
      },
      {
        "type": "url",
        "id": "cart_empty_button_link",
        "label": "Empty cart button link",
        "info": "Where the \"Continue shopping\" button links to when the cart is empty. Defaults to all products if left blank."
      }
    ]
  },
  {
    "name": "Badges",
    "settings": [
      {
        "type": "header",
        "content": "Sold out badge"
      },
      {
        "type": "color",
        "id": "badge_sold_out_bg",
        "label": "Background color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "badge_sold_out_text",
        "label": "Text color",
        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "Sale / savings badge"
      },
      {
        "type": "color",
        "id": "badge_sale_bg",
        "label": "Background color",
        "default": "#EA4335"
      },
      {
        "type": "color",
        "id": "badge_sale_text",
        "label": "Text color",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Product Cards",
    "settings": [
      {
        "type": "header",
        "content": "Swatches"
      },
      {
        "type": "checkbox",
        "id": "enable_product_card_swatches",
        "label": "Enable variant swatches on product cards",
        "info": "Shows selectable image swatches in the bottom-left corner of the card image. Only appears on products that have a matching option below — other products are unaffected.",
        "default": false
      },
      {
        "type": "text",
        "id": "swatch_color_option_name",
        "label": "Color option name",
        "default": "Color",
        "info": "The exact option name (case-insensitive) products use for color, e.g. \"Color\" or \"Colour\". Leave blank to disable matching on color."
      },
      {
        "type": "text",
        "id": "swatch_size_option_name",
        "label": "Size option name",
        "default": "Size",
        "info": "Used only when a product has no matching color option. Leave blank to disable matching on size."
      }
    ]
  }
]
