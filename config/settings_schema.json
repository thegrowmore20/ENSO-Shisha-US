  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.typography.headers.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "montserrat_n7",
        "label": "t:settings.typography.type_heading_font.label",
        "info": "t:settings.typography.type_heading_font.info"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "montserrat_n4",
        "label": "t:settings.typography.type_body_font.label",
        "info": "t:settings.typography.type_body_font.info"
      },
      {
        "type": "font_picker",
        "id": "type_subheading_font",
        "default": "montserrat_n5",
        "label": "t:settings.typography.type_subheading_font.label",
        "info": "t:settings.typography.type_subheading_font.info"
      },
      {
        "type": "font_picker",
        "id": "type_accent_font",
        "default": "inter_n8",
        "label": "t:settings.typography.type_accent_font.label",
        "info": "t:settings.typography.type_accent_font.info"
      },
      {
        "type": "header",
        "content": "t:settings.typography.headers.sizes"
      },
      {
        "type": "range",
        "id": "type_body_size",
        "min": 14,
        "max": 18,
        "step": 1,
        "default": 16,
        "unit": "px",
        "label": "t:settings.typography.type_body_size.label"
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "min": 80,
        "max": 120,
        "step": 5,
        "default": 100,
        "unit": "%",
        "label": "t:settings.typography.type_heading_scale.label",
        "info": "t:settings.typography.type_heading_scale.info"
      }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 960,
        "max": 1800,
        "step": 20,
        "default": 1440,
        "unit": "px",
        "label": "t:settings.layout.page_width.label"
      }
    ]
  },
  {
    "name": "t:settings.cart.name",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings.cart.cart_type.label",
        "info": "t:settings.cart.cart_type.info",
        "options": [
          {
            "value": "drawer",
            "label": "t:settings.cart.cart_type.options.drawer"
          },
          {
            "value": "page",
            "label": "t:settings.cart.cart_type.options.page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "url",
        "id": "cart_empty_button_link",
        "label": "t:settings.cart.cart_empty_button_link.label",
        "info": "t:settings.cart.cart_empty_button_link.info"
      },
      {
        "type": "header",
        "content": "t:settings.cart.headers.free_shipping"
      },
      {
        "type": "checkbox",
        "id": "free_shipping_enable",
        "label": "t:settings.cart.free_shipping_enable.label",
        "default": false
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "t:settings.cart.free_shipping_threshold.label",
        "info": "t:settings.cart.free_shipping_threshold.info",
        "default": 75,
        "visible_if": "{{ settings.free_shipping_enable }}"
      },
      {
        "type": "text",
        "id": "free_shipping_message_before",
        "label": "t:settings.cart.free_shipping_message_before.label",
        "info": "t:settings.cart.free_shipping_message_before.info",
        "default": "Spend [amount] more for free shipping",
        "visible_if": "{{ settings.free_shipping_enable }}"
      },
      {
        "type": "text",
        "id": "free_shipping_message_after",
        "label": "t:settings.cart.free_shipping_message_after.label",
        "default": "You have unlocked free shipping",
        "visible_if": "{{ settings.free_shipping_enable }}"
      },
      {
        "type": "color",
        "id": "free_shipping_fill_color",
        "label": "t:settings.cart.free_shipping_fill_color.label",
        "default": "{{ settings.color_palette.sand }}",
        "visible_if": "{{ settings.free_shipping_enable }}"
      },
      {
        "type": "color",
        "id": "free_shipping_track_color",
        "label": "t:settings.cart.free_shipping_track_color.label",
        "default": "{{ settings.color_palette.line }}",
        "visible_if": "{{ settings.free_shipping_enable }}"
      },
      {
        "type": "textarea",
        "id": "free_shipping_markets",
        "label": "t:settings.cart.free_shipping_markets.label",
        "info": "t:settings.cart.free_shipping_markets.info",
        "visible_if": "{{ settings.free_shipping_enable }}"
      },
      {
        "type": "textarea",
        "id": "free_shipping_countries",
        "label": "t:settings.cart.free_shipping_countries.label",
        "info": "t:settings.cart.free_shipping_countries.info",
        "visible_if": "{{ settings.free_shipping_enable }}"
      }
    ]
  },
