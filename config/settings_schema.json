  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 960,
        "max": 1800,
        "step": 20,
        "default": 1600,
        "unit": "px",
        "label": "t:settings.layout.page_width.label"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
