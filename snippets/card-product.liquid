{%- doc -%}
  @param {object} product - The product to render
  @param {object} section - The parent section
{%- enddoc -%}

{%- liquid
  assign card_product = product
  assign card_image = card_product.featured_image
  assign badge_label = blank
  if card_product.tags contains 'bestseller'
    assign badge_label = 'Best Seller'
  elsif card_product.tags contains 'new'
    assign badge_label = 'New'
  elsif card_product.tags contains 'pre-order'
    assign badge_label = 'Pre-Order'
  endif
  
  assign card_price = card_product.selected_or_first_available_variant.price
  assign card_compare_price = card_product.selected_or_first_available_variant.compare_at_price
  if card_compare_price > card_price
    assign saved_compare_amount = card_compare_price | minus: card_price
  endif

  comment
    Card swatches: pick whichever of the two configured option names
    (Theme Settings → Product Cards) actually exists on this product,
    color preferred over size — products with neither option render no
    swatches at all.
  endcomment
  assign show_swatches = false
  assign swatch_option = blank
  assign swatch_option_index = -1
  assign swatch_color_name_down = settings.swatch_color_option_name | strip | downcase
  assign swatch_size_name_down = settings.swatch_size_option_name | strip | downcase

  if settings.enable_product_card_swatches
    if swatch_color_name_down != blank
      for option in card_product.options_with_values
        assign option_name_down = option.name | downcase
        if option_name_down == swatch_color_name_down
          assign swatch_option = option
          assign swatch_option_index = forloop.index0
          break
        endif
      endfor
    endif

    if swatch_option == blank and swatch_size_name_down != blank
      for option in card_product.options_with_values
        assign option_name_down = option.name | downcase
        if option_name_down == swatch_size_name_down
          assign swatch_option = option
          assign swatch_option_index = forloop.index0
          break
        endif
      endfor
    endif

    if swatch_option != blank and swatch_option.values.size > 1
      assign show_swatches = true
    endif
  endif

  assign swatch_group_name = card_product.id | append: '-swatch-' | append: section.id
  assign swatch_max_shown = 3
-%}

<a href="{{ card_product.url }}" class="product-card {% if card_product.media[1] != blank %}has-secondary-image{% endif %}">
  <div class="product-card__media">
    {% render 'wishlist-button', card_product: card_product %}
    {%- unless card_product.available -%}
      <span class="badge product-card__badge">{{ 'products.product.sold_out' | t }}</span>
    {%- else -%}
      {%- if badge_label != blank -%}
        <span class="badge product-card__badge">{{ badge_label }}</span>
      {%- endif -%}
      {% if saved_compare_amount > 0 %}
        <span class="badge product-card__badge product-card__badge-save">Save {{ saved_compare_amount | money }}</span>
      {% endif %}  
    {%- endunless -%}
    {%- if card_image -%}
      <img
        src="{{ card_image | image_url: width: 700 }}"
        alt="{{ card_image.alt | default: card_product.title | escape }}"
        width="{{ card_image.width }}"
        height="{{ card_image.height }}"
        loading="lazy"
        class="product-card__image product-card__primary-image"
      >
      {% if card_product.media[1] %}
       <img
          src="{{ card_product.media[1] | image_url: width: 700 }}"
          alt="{{ card_product.media[1].alt | default: card_product.title | escape }}"
          width="{{ card_product.media[1].width }}"
          height="{{ card_product.media[1].height }}"
          loading="lazy"
          class="product-card__image product-card__secondary-image"
        > 
      {% endif %}  
    {%- else -%}
      <div class="product-card__placeholder">
        {%- render 'icon-enso', class: 'product-card__placeholder-mark' -%}
      </div>
    {%- endif -%}

    {%- if show_swatches -%}
      <product-card-swatches class="product-card-swatches">
        {%- assign swatches_shown = 0 -%}
        {%- for swatch_value in swatch_option.values -%}
          {%- assign swatch_variant = blank -%}
          {%- for variant in card_product.variants -%}
            {%- if variant.options[swatch_option_index] == swatch_value -%}
              {%- if swatch_variant == blank -%}
                {%- assign swatch_variant = variant -%}
              {%- endif -%}
              {%- if variant.available -%}
                {%- assign swatch_variant = variant -%}
                {%- break -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if swatch_variant != blank and swatches_shown < swatch_max_shown -%}
            {%- assign swatches_shown = swatches_shown | plus: 1 -%}
            {%- assign swatch_image = swatch_variant.featured_image | default: card_image -%}
            {%- assign swatch_id = 'CardSwatch-' | append: card_product.id | append: '-' | append: swatch_variant.id | append: '-' | append: section.id -%}
            <div class="card-swatch-item{% unless swatch_variant.available %} is-unavailable{% endunless %}">
              <input
                type="radio"
                id="{{ swatch_id }}"
                name="{{ swatch_group_name }}"
                value="{{ swatch_value | escape }}"
                class="card-swatch-input"
                data-variant-id="{{ swatch_variant.id }}"
                data-url="{{ card_product.url }}?variant={{ swatch_variant.id }}"
                data-image="{{ swatch_image | image_url: width: 700 }}"
                data-available="{{ swatch_variant.available }}"
                {% if swatch_variant.id == card_product.selected_or_first_available_variant.id %}checked{% endif %}
              >
              <label for="{{ swatch_id }}" title="{{ swatch_value | escape }}">
                <img src="{{ swatch_image | image_url: width: 64 }}" alt="" loading="lazy" width="32" height="32">
              </label>
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if swatch_option.values.size > swatch_max_shown -%}
          <span class="card-swatch-more">+{{ swatch_option.values.size | minus: swatch_max_shown }}</span>
        {%- endif -%}
      </product-card-swatches>
    {%- endif -%}
  </div>
  <div class="product-card__info">
    <h3 class="h-feature product-card__title">{{ card_product.title }}</h3>
    <div class="card-product-rating" 
      aria-label="Rated {{ card_product.metafields.loox.avg_rating }} out of 5 based on {{ card_product.metafields.loox.num_reviews }} reviews">
      <div class="loox-rating"
        data-pattern="[rating] ([count])"
          data-show-empty-stars="true"
          data-id="{{ card_product.id }}"
          data-rating="{{ card_product.metafields.loox.avg_rating }}"
          data-raters="{{ card_product.metafields.loox.num_reviews }}"
          data-floating-product-reviews-enabled="true">
      </div>
    </div>
    <div class="caption product-card__price">
      {% render 'price', product: card_product %}
    </div>
    {% if section.settings.enable_quickadd %}
      <div class="product-card-quickadd">
        {% form 'product', card_product, class: 'quick-add-form' %}
          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
            data-variant-id-input
          >

          <button
            type="submit"
            class="quick-add-button btn btn--{{ section.settings.quickadd_design }} btn--full"
            {% unless product.available %}disabled{% endunless %}
          >
            <span data-quick-add-label data-label-available="Add To Cart" data-label-sold-out="Sold Out">
            {% if product.available %}
              Add To Cart
            {% else %}
              Sold Out
            {% endif %}
            </span>
            <span class="btn__spinner" data-add-to-cart-spinner hidden></span>
          </button>
        {% endform %}
      </div>
    {% endif %}  
  </div>
</a>

{% stylesheet %}
  .product-card {
    padding: 10px;
    border: 1px solid #f5ebeb;
    border-radius: var(--radius-lg);
  }

  @media screen and (max-width: 749px) {
    .product-card {
      padding: 5px;
    }
  }

  .product-card__secondary-image {
    display: none;
  }
  .product-card.has-secondary-image:hover .product-card__secondary-image {
    display: block;
  }
  .product-card.has-secondary-image:hover .product-card__primary-image {
    display: none;
  }

  .product-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-background-raised);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.35s var(--ease-out);
  }

  .product-card:hover .product-card__media {
    box-shadow: var(--shadow-md);
  }

  .product-card__media .custom-wishlist-button {
    position: absolute;
    right: 10px;
    top: 10px;
    z-index: 1;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .product-card:hover .product-card__image {
    transform: scale(1.06);
  }

  .product-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .product-card__placeholder-mark {
    width: 30%;
    color: var(--color-accent);
    opacity: 0.5;
  }

  .product-card__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
  }

  .product-card__badge-save {
    background: #ea4335;
    color: #fff;
  }

  /* ---------- Card swatches ---------- */
  .product-card-swatches {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .card-swatch-item {
    position: relative;
    flex-shrink: 0;
  }

  .card-swatch-item label {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.7), inset 0 0 0 1px rgba(0, 0, 0, 0.15);
    transition: box-shadow 0.15s ease;
  }

  .card-swatch-item label img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-swatch-input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .card-swatch-input:checked + label {
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--color-accent);
  }

  .card-swatch-input:focus-visible + label {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .card-swatch-item.is-unavailable label {
    opacity: 0.45;
  }

  .card-swatch-more {
    font-size: 11px;
    font-weight: 600;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .product-card__info {
    padding-top: var(--space-4);
  }

  .product-card__info .price__sold-out {
    display: none;
  }

  .product-card__title {
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-line-clamp: 1;
    text-overflow: ellipsis;
  }

  .product-card:hover .product-card__title {
    color: var(--color-accent);
  }

  .product-card__price,
  .product-card-quickadd {
    margin-top: var(--space-2);
  }

  .product-card__price .price__current {
    font-size: 18px;
  }

  .product-card__price .price__compare-at {
    font-size: 16px;
  }

{% endstylesheet %}
