{% liquid
  assign link = link | default: section.settings.button_link
  assign style = style | default: section.settings.button_style
  assign size = size | default: section.settings.button_size
  assign text = text | default: section.settings.button_text
  assign background_color = background_color | default: section.settings.button_background_color
  assign text_color = text_color | default: section.settings.button_text_color

  assign tag = 'button'

  if link != blank
    assign tag = 'a'
  endif
%}

<{{ tag }}
  {% if link != blank %}
    href="{{ link }}"
    data-instant
  {% endif %}
  class="button {{ style }} {{ size }}"
  style="{% render 'button-vars', background: background_color, text: text_color %}"
  {{ attrs }}
>
  {{ text }}
</{{ tag }}>
