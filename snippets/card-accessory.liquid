{%- doc -%}
  Accessory product card — handoff `.acc article` design.
  Parameters:
    product       {object}  Shopify product object (required)
    show_fits     {bool}    Show the "Fits Diamond / ENSŌ 2026 / Universal" badge (default: false)
    show_details  {bool}    Show the "Details" popup-trigger link (default: false)
{%- enddoc -%}

{%- liquid
  assign show_fits    = show_fits    | default: false
  assign show_details = show_details | default: false
  assign variant = product.selected_or_first_available_variant
  assign img     = product.featured_image
  assign img2    = product.images[1]

  comment
    Device family metafield drives the "Fits" badge.
    Falls back to tag-derived label when metafield is blank.
  endcomment
  assign popup_compat = product.metafields.custom.device_family | default: ''

  comment
    data-dev: used by accessories-shop JS for device-tab filtering.
    Tags: "diamond", "enso", "universal", "both"
    diamond only → "diamond" | enso only → "enso" | universal/both/mixed → "both"
  endcomment
  assign _has_diamond = false
  assign _has_enso    = false
  if product.tags contains 'diamond'
    assign _has_diamond = true
  endif
  if product.tags contains 'enso'
    assign _has_enso = true
  endif
  if product.tags contains 'universal'
    assign _has_diamond = true
    assign _has_enso    = true
  endif
  if product.tags contains 'both'
    assign _has_diamond = true
    assign _has_enso    = true
  endif
  if product.tags contains 'mixed'
    assign _has_diamond = true
    assign _has_enso    = true
  endif
  if _has_diamond and _has_enso
    assign _dev_val = 'both'
  elsif _has_diamond
    assign _dev_val = 'diamond'
  elsif _has_enso
    assign _dev_val = 'enso'
  else
    assign _dev_val = 'both'
  endif

  if popup_compat != blank
    assign _fits_label = popup_compat
  elsif _has_diamond and _has_enso
    assign _fits_label = ''
  elsif _has_diamond
    assign _fits_label = 'Diamond'
  elsif _has_enso
    assign _fits_label = 'ENSŌ 2026'
  else
    assign _fits_label = ''
  endif
-%}

{%- capture img_url_list -%}
  {%- for pimg in product.images limit: 5 -%}
    {%- unless forloop.first -%};{%- endunless -%}
    {{- pimg | image_url: width: 800 -}}
  {%- endfor -%}
{%- endcapture -%}

{%- capture popup_headline -%}{{ product.metafields.custom.headline | metafield_tag }}{%- endcapture -%}
{%- capture popup_shortdesc -%}{{ product.metafields.custom.short_description | metafield_tag }}{%- endcapture -%}

<article class="acc-card"
  data-dev="{{ _dev_val }}"
  data-price="{{ variant.price }}"
  data-available="{{ product.available }}"
  data-title="{{ product.title | downcase | escape }}"
  data-popup-title="{{ product.title | escape }}"
  data-popup-images="{{ img_url_list | strip }}"
  data-popup-img-alt="{{ img.alt | default: product.title | escape }}"
  data-popup-price="{{ variant.price | money }}"
  data-popup-variant="{{ variant.id }}"
  data-popup-url="{{ product.url }}"
  data-popup-available="{{ product.available }}"
  data-popup-compat="{{ _fits_label | escape }}"
  data-popup-headline="{{ popup_headline | escape }}"
  data-popup-shortdesc="{{ popup_shortdesc | escape }}"
>
  <a class="acc-card__img" href="{{ product.url }}" tabindex="-1">
    {%- if show_fits and _fits_label != blank -%}
      <span class="acc-card__fits">{{ _fits_label }}</span>
    {%- endif -%}
    {%- if img != blank -%}
      <img
        src="{{ img | image_url: width: 600 }}"
        srcset="{{ img | image_url: width: 300 }} 300w, {{ img | image_url: width: 600 }} 600w"
        sizes="(max-width: 749px) 72vw, 25vw"
        alt="{{ img.alt | default: product.title | escape }}"
        width="{{ img.width }}"
        height="{{ img.height }}"
        loading="lazy"
      >
      {%- if img2 != blank -%}
        <img
          src="{{ img2 | image_url: width: 600 }}"
          srcset="{{ img2 | image_url: width: 300 }} 300w, {{ img2 | image_url: width: 600 }} 600w"
          sizes="(max-width: 749px) 72vw, 25vw"
          alt="{{ img2.alt | default: product.title | escape }}"
          width="{{ img2.width }}"
          height="{{ img2.height }}"
          loading="lazy"
          aria-hidden="true"
        >
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'acc-card__placeholder' }}
    {%- endif -%}
  </a>

  <h3 class="acc-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
  {%- if product.variants.size > 1 and product.options[0] != 'Title' -%}
    <div class="acc-card__opts" role="group" aria-label="{{ product.options[0] | escape }}">
      {%- for v in product.variants -%}
        <button class="acc-card__opt{% if forloop.first %} is-active{% endif %}"
                type="button"
                aria-pressed="{{ forloop.first }}"
                data-vid="{{ v.id }}"
                data-price="{{ v.price }}"
                data-money="{{ v.price | money }}"
                data-available="{{ v.available }}">{{ v.title }}</button>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- liquid
    assign _desc_text = product.metafields.custom.headline | metafield_tag | strip_html | strip
    if _desc_text == blank
      assign _desc_text = product.description | strip_html | strip | truncate: 100
    endif
  -%}
  {%- if _desc_text != blank -%}
    <p class="acc-card__desc">{{ _desc_text }}</p>
  {%- endif -%}
  {%- if show_details -%}
    <a class="acc-card__details" href="{{ product.url }}" aria-label="{{ 'accessibility.open_details' | t: title: product.title }}">{{ 'products.product.details' | t | default: 'Details' }}</a>
  {%- endif -%}

  {%- liquid
    assign _atc_label = 'products.product.add_to_cart' | t
    if product.tags contains 'pre-order' or product.tags contains 'preorder'
      assign _atc_label = 'products.product.pre_order' | t | default: 'Pre-order'
    endif
  -%}
  <div class="acc-card__foot">
    <div class="acc-card__price">
      <b>{{ variant.price | money }}</b>
      <small class="acc-card__oos"{% if variant.available %} hidden{% endif %}>{{ 'products.product.sold_out' | t }}</small>
    </div>

    <form action="{{ routes.cart_add_url }}" method="post" class="acc-card__form"{% unless variant.available %} hidden{% endunless %}>
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="btn btn--accent acc-card__btn">
        <span class="acc-card__btn-label" data-quick-add-label data-label-available="{{ _atc_label | escape }}">{{ _atc_label }}</span>
        <span class="btn__spinner" data-add-to-cart-spinner hidden aria-hidden="true"></span>
        <span class="acc-card__btn-icon acc-card__btn-icon--add" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/><path d="M12 11.5v5M9.5 14h5"/></svg>
        </span>
        <span class="acc-card__btn-icon acc-card__btn-icon--check" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
        </span>
      </button>
    </form>
    <button type="button" class="btn btn--outline acc-card__btn acc-card__btn--oos" disabled{% if variant.available %} hidden{% endif %}>
      <span class="acc-card__btn-label">{{ 'products.product.sold_out' | t }}</span>
      <span class="acc-card__btn-icon acc-card__oos-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/><path d="M12 11.5v5M9.5 14h5"/></svg>
      </span>
    </button>
  </div>
</article>
