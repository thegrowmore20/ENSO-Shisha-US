{%- doc -%}
  A row of social network links, one per profile filled in under
  Theme settings > Social media. Renders nothing when none is set. Use it
  anywhere a row of social icons is needed (header drawer, footer, contact).

  @param {string} [class] - Extra classes for the wrapper

  @example
  {% render 'social-icons' %}
{%- enddoc -%}

{%- liquid
  assign has_social = false
  if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank
    assign has_social = true
  endif
  if settings.social_tiktok_link != blank or settings.social_pinterest_link != blank or settings.social_x_link != blank
    assign has_social = true
  endif
  assign new_tab = 'accessibility.new_tab' | t
-%}

{%- if has_social -%}
  <div class="social-icons {{ class }}">
    {%- if settings.social_facebook_link != blank -%}
      <a href="{{ settings.social_facebook_link }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="Facebook {{ new_tab }}">
        {%- render 'icon-facebook' -%}
      </a>
    {%- endif -%}
    {%- if settings.social_instagram_link != blank -%}
      <a href="{{ settings.social_instagram_link }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="Instagram {{ new_tab }}">
        {%- render 'icon-instagram' -%}
      </a>
    {%- endif -%}
    {%- if settings.social_youtube_link != blank -%}
      <a href="{{ settings.social_youtube_link }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="YouTube {{ new_tab }}">
        {%- render 'icon-youtube' -%}
      </a>
    {%- endif -%}
    {%- if settings.social_tiktok_link != blank -%}
      <a href="{{ settings.social_tiktok_link }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="TikTok {{ new_tab }}">
        {%- render 'icon-tiktok' -%}
      </a>
    {%- endif -%}
    {%- if settings.social_pinterest_link != blank -%}
      <a href="{{ settings.social_pinterest_link }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="Pinterest {{ new_tab }}">
        {%- render 'icon-pinterest' -%}
      </a>
    {%- endif -%}
    {%- if settings.social_x_link != blank -%}
      <a href="{{ settings.social_x_link }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="X {{ new_tab }}">
        {%- render 'icon-x' -%}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .social-icons {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .social-icons__link {
    display: flex;
    width: 20px;
    height: 20px;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .social-icons__link svg {
    width: 100%;
    height: 100%;
  }

  .social-icons__link:hover {
    color: var(--color-accent);
  }
{% endstylesheet %}
