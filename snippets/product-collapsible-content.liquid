{% if block.settings.content != blank %}
  <details
    {{ block.shopify_attributes }}
    class="product-collapse-wrapper product-collapse block"
    {% if block.settings.collapse_open %}
      open
    {% endif %}
  >
    <summary>
      <div class="font-accordion product-info-heading">{{ block.settings.heading }}</div>
      {% render 'icon-chevron' %}
    </summary>

    <div class="prose  max-w-none">
      {{ block.settings.content }}
    </div>
  </details>
{% endif %}
