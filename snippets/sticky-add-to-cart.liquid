{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign sticky_form_id = 'StickyProductForm-' | append: section.id
-%}

<sticky-add-to-cart class="sticky-atc" data-watch-target="{{ watch_target_id }}" hidden>
  <div class="sticky-atc__inner container">

    <span class="sticky-atc__name">{{ product.title }}</span>

    {%- form 'product', product, id: sticky_form_id, class: 'sticky-atc__form' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-sticky-variant-id>

      <span class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</span>

      <button
        type="submit"
        name="add"
        class="btn product-form__submit sticky-atc__submit"
        data-add-to-cart
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span
          data-add-to-cart-text
          data-label-available="{{ 'products.product.add_to_cart' | t }}"
          data-label-sold-out="{{ 'products.product.join_waitlist' | t }}"
        >
          {%- if current_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.join_waitlist' | t }}
          {%- endif -%}
        </span>
      </button>

      <template data-sticky-price-templates>
        {%- for variant in product.variants -%}
          <span data-variant-price-id="{{ variant.id }}">{{ variant.price | money }}</span>
        {%- endfor -%}
      </template>
    {%- endform -%}

  </div>
</sticky-add-to-cart>

{% style %}
  /* ── Desktop: fixed below header, slides down from top ── */
  .sticky-atc {
    position: fixed;
    left: 0;
    right: 0;
    top: var(--site-header-height, 0px);
    bottom: auto;
    z-index: 40;
    background: var(--color-background, #fff);
    color: var(--color-text, #1a1a1a);
    border-bottom: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
    border-top: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
    transform: translateY(-100%);
    opacity: 0;
    transition: transform 0.25s ease, opacity 0.25s ease, top 0.25s ease;
    pointer-events: none;
  }

  /* When header slides away, snap sticky ATC to top of viewport */
  body:has(.site-header--hidden) .sticky-atc,
  body:not(:has(.site-header)) .sticky-atc {
    top: 0;
  }

  .sticky-atc__inner.container {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 24px);
  }

  /* Visible state */
  .sticky-atc:not([hidden]) {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  /* Keep mounted so CSS transition can run */
  .sticky-atc[hidden] {
    display: block;
  }

  .sticky-atc__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: 8px;
  }

  /* Title: takes all remaining space, truncates */
  .sticky-atc__name {
    font-size: 15px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Form row: price + button, won't shrink */
  .sticky-atc__form {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .sticky-atc__price {
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .sticky-atc__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    border-radius: 999px;
    padding: 10px 24px;
    font-size: 13px;
    line-height: 1;
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .sticky-atc__name { font-size: 16px; }
    .sticky-atc__submit { padding: 11px 28px; }
  }

  /* ── Mobile: fixed at bottom, slides up from bottom ── */
  @media screen and (max-width: 749px) {
    .sticky-atc {
      top: auto;
      bottom: 0;
      border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
      border-bottom: none;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.07);
      transform: translateY(100%);
    }

    .sticky-atc:not([hidden]) {
      transform: translateY(0);
    }

    .sticky-atc__inner {
      gap: var(--space-2);
      padding-block: 8px;
    }

    .sticky-atc__name { font-size: 13px; }

    .sticky-atc__price {
      display: block;
      font-size: 13px;
    }

    .sticky-atc__submit {
      padding: 10px 16px;
      font-size: 12px;
    }
  }
{% endstyle %}
