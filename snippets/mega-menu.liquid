{%- comment -%}
  Mega menu panel, driven by a `mega_menu` block whose mega_target_item
  matches this top-level link's title (matched case/whitespace-insensitively
  in header.liquid before this is rendered).

  Layout: one column per direct child link (grandchildren listed beneath
  their parent child), optional product cards for direct child links that
  point straight at a product, optional promo image. Not gated on the link
  having children — a mega block can be promo-image-only.

  Accepts: link (the top-level link object), block (the mega_menu block)
{%- endcomment -%}

{%- liquid
  assign max_products = block.settings.max_products | default: 4
  assign product_links = link.links | where: 'type', 'product_link'
-%}

<div class="site-header__mega" data-dropdown {{ block.shopify_attributes }}>
  <div class="container site-header__mega-inner">
    {%- if link.links.size > 0 -%}
      <div class="site-header__mega-columns">
        {%- for child in link.links -%}
          {%- liquid
            assign is_product_link = false
            if child.type == 'product_link'
              assign is_product_link = true
            endif
          -%}
          {%- unless is_product_link and block.settings.show_products -%}
            <div class="site-header__mega-column">
              <a
                href="{{ child.url }}"
                class="site-header__mega-column-title h-catalog"
                {% if child.active %}aria-current="page"{% endif %}
              >
                {{ child.title }}
              </a>
              {%- if child.links.size > 0 -%}
                <ul class="site-header__mega-sublist">
                  {%- for grandchild in child.links -%}
                    <li>
                      <a
                        href="{{ grandchild.url }}"
                        class="caption site-header__mega-sublink"
                        {% if grandchild.active %}aria-current="page"{% endif %}
                      >
                        {{ grandchild.title }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if block.settings.show_products and product_links.size > 0 -%}
      <div class="site-header__mega-products">
        {%- for product_link in product_links limit: max_products -%}
          {%- assign product = product_link.object -%}
          {%- if product -%}
            {%- render 'card-product', product: product, section: section -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if block.settings.image != blank -%}
      <a href="{{ block.settings.image_url | default: link.url }}" class="site-header__mega-promo">
        <img
          src="{{ block.settings.image | image_url: width: 600 }}"
          alt="{{ block.settings.image.alt | default: block.settings.image_heading }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
        {%- if block.settings.image_heading != blank -%}
          <span class="site-header__mega-promo-heading caption">{{ block.settings.image_heading }}</span>
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .site-header__mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-background, #fff);
    border-top: 1px solid var(--color-border, #e5e5e5);
    border-bottom: 1px solid var(--color-border, #e5e5e5);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    z-index: 41;
    visibility: hidden;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
  }

  .site-header__nav-item:hover .site-header__mega,
  .site-header__nav-item:focus-within .site-header__mega,
  .site-header__nav-item.is-open .site-header__mega {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  .site-header__mega-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7, 2.5rem);
    padding-block: var(--space-6, 2rem);
  }

  .site-header__mega-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-6, 2rem);
    flex: 2;
  }

  .site-header__mega-columns:empty {
    display: none;
  }

  body:has(#MainContent>.shopify-section:first-child .video-hero-slider) .site-header__mega .site-header__mega-column-title {
    display: block;
    margin-bottom: var(--space-3, 0.75rem);
    color: var(--color-text);
  }

  .site-header__nav ul .site-header__mega-sublist {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  body:has(#MainContent>.shopify-section:first-child .video-hero-slider) .site-header__mega .site-header__mega-sublink {
    display: block;
    color: var(--color-text-muted, #6b6b6b);
  }

  .site-header__mega-products {
    flex: 3;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 200px));
    gap: var(--space-4, 1rem);
    justify-content: center;
  }
  
  .site-header__mega-products .product-card .h-feature {
    color: var(--color-text);
    font-size: 16px;
    display: -webkit-box;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }
  .site-header__mega-products .product-card .card-product-rating {
    scale: 0.9;
    transform-origin: left;
  }
  .site-header__mega-products .product-card .product-card__price {
    display: none;
  }

  .site-header__mega-promo {
    flex: 1;
    min-width: 180px;
    position: relative;
    display: block;
    border-radius: var(--radius-sm, 4px);
    overflow: hidden;
  }

  .site-header__mega-promo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site-header__mega-promo-heading {
    position: absolute;
    left: var(--space-4, 1rem);
    bottom: var(--space-4, 1rem);
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }
{% endstylesheet %}
