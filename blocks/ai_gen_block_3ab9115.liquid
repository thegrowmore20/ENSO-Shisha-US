{% doc %}
  @prompt
    I need a section where the subheading is: Founder Edition, The title is: Get your founder spot. Text under title is: Reserve ENSŌ Diamond from the first production run with a €100 deposit.. Under this text there should be 4 separate text boxes next to each other separated by a thin line on both sides of the middle ones. The texts in the boxes should have a subheading on top , a title underneath and a text under that. Here is the content for the boxes1: subheading : Full price, title:€270, text : €170 balance on shipping. Box 2 : Subheading : Regular price Title: €330, text : After first batchBox 3: Subheading:Estimated shipping, Title :August 2026, Text: Confirmed two weeks before dispatch. Box 4: Subheading: Guarantee, title: 30 days, text: Money-back after receiving the unit
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-founder-edition-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    padding: 32px 0;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-founder-edition__container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 24px);
  }

  .ai-founder-edition__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 28px;
  }

  .ai-founder-edition__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .ai-founder-edition__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
    font-weight: 700;
  }

  .ai-founder-edition__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0.75;
  }

  .ai-founder-edition__boxes-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .ai-founder-edition__box-{{ ai_gen_id }} {
    padding: 18px 16px;
    text-align: center;
    position: relative;
    border: 1px solid {{ block.settings.divider_color }};
    border-radius: 10px;
  }

  .ai-founder-edition__box-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.box_subheading_size }}px;
    color: {{ block.settings.box_subheading_color }};
    margin: 0 0 6px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .ai-founder-edition__box-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.box_title_size }}px;
    color: {{ block.settings.box_title_color }};
    margin: 0 0 6px;
    font-weight: 700;
  }

  .ai-founder-edition__box-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.box_text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.4;
    opacity: 0.7;
  }

  @media screen and (max-width: 989px) {
    .ai-founder-edition__container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-founder-edition__boxes-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-founder-edition-{{ ai_gen_id }} {
      padding: 24px 0;
    }

    .ai-founder-edition__header-{{ ai_gen_id }} {
      margin-bottom: 20px;
    }

    .ai-founder-edition__boxes-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
{% endstyle %}

<div class="ai-founder-edition-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-founder-edition__container-{{ ai_gen_id }}">
  <div class="ai-founder-edition__header-{{ ai_gen_id }}">
    {%- if block.settings.subheading != blank -%}
      <div class="ai-founder-edition__subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {%- endif -%}
    
    {%- if block.settings.title != blank -%}
      <h2 class="ai-founder-edition__title-{{ ai_gen_id }}">
        {{ block.settings.title }}
      </h2>
    {%- endif -%}
    
    {%- if block.settings.description != blank -%}
      <div class="ai-founder-edition__description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {%- endif -%}
  </div>

  <div class="ai-founder-edition__boxes-{{ ai_gen_id }}">
    <div class="ai-founder-edition__box-{{ ai_gen_id }}">
      {%- if block.settings.box_1_subheading != blank -%}
        <div class="ai-founder-edition__box-subheading-{{ ai_gen_id }}">
          {{ block.settings.box_1_subheading }}
        </div>
      {%- endif -%}
      {%- if block.settings.box_1_title != blank -%}
        <div class="ai-founder-edition__box-title-{{ ai_gen_id }}">
          {{ block.settings.box_1_title }}
        </div>
      {%- endif -%}
      {%- if block.settings.box_1_text != blank -%}
        <div class="ai-founder-edition__box-text-{{ ai_gen_id }}">
          {{ block.settings.box_1_text }}
        </div>
      {%- endif -%}
    </div>

    <div class="ai-founder-edition__box-{{ ai_gen_id }}">
      {%- if block.settings.box_2_subheading != blank -%}
        <div class="ai-founder-edition__box-subheading-{{ ai_gen_id }}">
          {{ block.settings.box_2_subheading }}
        </div>
      {%- endif -%}
      {%- if block.settings.box_2_title != blank -%}
        <div class="ai-founder-edition__box-title-{{ ai_gen_id }}">
          {{ block.settings.box_2_title }}
        </div>
      {%- endif -%}
      {%- if block.settings.box_2_text != blank -%}
        <div class="ai-founder-edition__box-text-{{ ai_gen_id }}">
          {{ block.settings.box_2_text }}
        </div>
      {%- endif -%}
    </div>

    <div class="ai-founder-edition__box-{{ ai_gen_id }}">
      {%- if block.settings.box_3_subheading != blank -%}
        <div class="ai-founder-edition__box-subheading-{{ ai_gen_id }}">
          {{ block.settings.box_3_subheading }}
        </div>
      {%- endif -%}
      {%- if block.settings.box_3_title != blank -%}
        <div class="ai-founder-edition__box-title-{{ ai_gen_id }}">
          {{ block.settings.box_3_title }}
        </div>
      {%- endif -%}
      {%- if block.settings.box_3_text != blank -%}
        <div class="ai-founder-edition__box-text-{{ ai_gen_id }}">
          {{ block.settings.box_3_text }}
        </div>
      {%- endif -%}
    </div>

    <div class="ai-founder-edition__box-{{ ai_gen_id }}">
      {%- if block.settings.box_4_subheading != blank -%}
        <div class="ai-founder-edition__box-subheading-{{ ai_gen_id }}">
          {{ block.settings.box_4_subheading }}
        </div>
      {%- endif -%}
      {%- if block.settings.box_4_title != blank -%}
        <div class="ai-founder-edition__box-title-{{ ai_gen_id }}">
          {{ block.settings.box_4_title }}
        </div>
      {%- endif -%}
      {%- if block.settings.box_4_text != blank -%}
        <div class="ai-founder-edition__box-text-{{ ai_gen_id }}">
          {{ block.settings.box_4_text }}
        </div>
      {%- endif -%}
    </div>
  </div>
  </div>
</div>

